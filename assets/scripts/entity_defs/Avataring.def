<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>   iClient     </Interface>
        <Interface>   iTimerBase  </Interface>
        <Interface>   iTimerCell  </Interface>
    </Interfaces>

    <Properties>
        <methodPoolBase>
            <Type>          METHOD_POOL_INFO    </Type>
            <Flags>         BASE        </Flags>
        </methodPoolBase>

        <delayDestroyTimer>
            <Type>          TIMER_ID            </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                   </Default>
        </delayDestroyTimer>

        <sendWorldMsgTime>
            <Type>          LONGTIME            </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                   </Default>
        </sendWorldMsgTime>

        <accountingID>
            <Type>          OBJECT_ID            </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                   </Default>
        </accountingID>

        <gbID>
            <Type>    PLAYER_GBID                        </Type>
            <Flags>    BASE                       </Flags>
        </gbID>

        <gbId>
            <Type>    PLAYER_GBID                        </Type>
            <Flags>    ALL_CLIENTS                       </Flags>
            <WitnessName>     true                       </WitnessName>
        </gbId>

        <spaceno>
            <Type>          SPACE_NO                       </Type>
            <Flags>         BASE                           </Flags>
            <Default>       0                              </Default>
        </spaceno>

        <spaceNo>
            <Type>          SPACE_NO                </Type>
            <Flags>         OWN_CLIENT     </Flags>
            <Default>       0                              </Default>
        </spaceNo>

        <appearance>
            <Type>          APPEARANCE_INFO     </Type>
            <Flags>         ALL_CLIENTS         </Flags>
        </appearance>

        <name>
            <Type>          UNICODE                 </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <WitnessName>   true                </WitnessName>
        </name>

        <school>
            <Type>          SCHOOL                 </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <WitnessName>   true                </WitnessName>
        </school>

        <sex>
            <Type>          SEX                 </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <WitnessName>   true                </WitnessName>
        </sex>

        <state>
            <Type>          STATE64             </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Default>       0                   </Default>
        </state>

        <state2>
            <Type>          STATE64             </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Default>       0                   </Default>
        </state2>

        <speed>
            <Type>          FLOATATTR          </Type>
            <Flags>         ALL_CLIENTS     </Flags>
        </speed>

        <isWitnessComplete>
            <Type>            UINT8                </Type>
            <Flags>        ALL_CLIENTS             </Flags>
            <Default>         2                    </Default>
        </isWitnessComplete>

        <viewEntityDict>
            <Type>          PYTHON                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       {}                      </Default>
        </viewEntityDict>

        <viewCompleteSet>
            <Type>          PYTHON              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       set()               </Default>
        </viewCompleteSet>

        <viewNameSet>
            <Type>          PYTHON              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       set()               </Default>
        </viewNameSet>

        <isNeedResortView>
            <Type>          BOOL                </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </isNeedResortView>

        <showCompleteNum>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </showCompleteNum>

        <lastSetCompleteNumTime>
            <Type>          LONGTIME            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </lastSetCompleteNumTime>

        <showCompleteNumTimer>
            <Type>          TIMER_ID            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </showCompleteNumTimer>

        <lastResortTimes>
            <Type>          UINT64                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </lastResortTimes>
    </Properties>

    <BaseMethods>
        <sendWorldChatMsg> <Exposed/>
            <Arg>       CHAT_MSG_DATA       </Arg>
        </sendWorldChatMsg>

        <onRecvChannelMsg>
            <Arg>       CHAT_CHANNEL            </Arg>
            <Arg>       CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>       CHAT_MSG_DATA       </Arg>
        </onRecvChannelMsg>

        <onRecvChannelMsgBatch>
            <Arg>       AVATARING_CHAT_MSG_BATCH    </Arg>
        </onRecvChannelMsgBatch>

        <onEnterWaitMapSpace>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       MAILBOX         </Arg>
        </onEnterWaitMapSpace>

        <createCellNearHere>
            <Arg>       MAILBOX     </Arg>
        </createCellNearHere>

        <onGetCellSpaceNo>
            <Arg>       SPACE_NO        </Arg>
        </onGetCellSpaceNo>

        <onCellGetWitness>
            <Arg>         UINT8                 </Arg>
        </onCellGetWitness>

        <kickAvataring>
            <Arg>         UINT8                 </Arg>
        </kickAvataring>

        <startOffline>
            <Arg>         UINT8                 </Arg>
        </startOffline>

        <checkTextSecurityReq> <Exposed/>
            <Arg>        CHECK_TEXT_SECURITY_REQ      </Arg>
        </checkTextSecurityReq>
    </BaseMethods>

    <CellMethods>
        <onBaseGetCell>
        </onBaseGetCell>

        <clientSetState> <Exposed/>
            <Arg>       UINT8       </Arg>
        </clientSetState>

        <clientRemoveState> <Exposed/>
            <Arg>       UINT8       </Arg>
        </clientRemoveState>

        <offline> <Exposed/>
            <Arg>       UINT8                 </Arg>
        </offline>

        <jump> <Exposed/>
            <Arg>       UINT8           </Arg>
            <Arg>       SPACE_NO        </Arg>
        </jump>

        <breakAwayStuck> <Exposed/>
        </breakAwayStuck>

        <reqPlayEmote> <Exposed/>
            <Arg>       UINT16       </Arg>
        </reqPlayEmote>

        <reqStopPlayEmote> <Exposed/>
        </reqStopPlayEmote>

        <setShowCompleteNum> <Exposed/>
            <Arg>       UINT8           </Arg>
        </setShowCompleteNum>
    </CellMethods>

    <ClientMethods>
        <syncServerTime>
            <Arg>       INT64       </Arg>
            <Arg>       FLOAT       </Arg>
        </syncServerTime>

        <onClientDataSyncFinished>
        </onClientDataSyncFinished>

        <onAnotherClientLogin>
        </onAnotherClientLogin>

        <onRecvAvatarChannelMsg>
            <Arg>       CHAT_CHANNEL            </Arg>
            <Arg>       CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>       CHAT_MSG_DATA       </Arg>
        </onRecvAvatarChannelMsg>

        <onBreakAwayStuckSuccess>
        </onBreakAwayStuckSuccess>

        <onStartPlayEmote>
            <Arg>       UINT16       </Arg>
        </onStartPlayEmote>

        <onStopPlayEmote>
        </onStopPlayEmote>

        <onRemoveCompleteWitness>
            <Arg>        ARRAY <of> OBJECT_ID </of>   </Arg>
        </onRemoveCompleteWitness>

        <onMessage>
            <Arg>        INT32                        </Arg>
            <Arg>        ARRAY <of> UNICODE </of>     </Arg>
        </onMessage>

        <checkTextSecurityResp>
            <Arg>           CHECK_TEXT_SECURITY_RESP     </Arg>
        </checkTextSecurityResp>
    </ClientMethods>
</root>
