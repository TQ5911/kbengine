<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>     iBaseWithCell   </Interface>
        <Interface>     iClient         </Interface>
        <Interface>	    iAICombatUnit   </Interface>
        <Interface>	    iTimerCell      </Interface>
        <Interface>	    iEventMgr       </Interface>
        <Interface>	    iFubenSpace     </Interface>
        <Interface>     iGameEntity     </Interface>
        <Interface>     iEntityRefresh     </Interface>
        <Interface>     iMonsterDungeon </Interface>
        <Interface>     iRoute          </Interface>
    </Interfaces>

    <Properties>
        <npcId>
            <Type>	OBJECT_ID						</Type>
            <Flags>	OTHER_CLIENTS					</Flags>
        </npcId>

        <npcCreepId>
            <Type>  OBJECT_ID    </Type>
            <Flags> CELL_PRIVATE    </Flags>
        </npcCreepId>

        <name>
            <Type>	UNICODE							</Type>
            <Flags>	OTHER_CLIENTS				</Flags>
        </name>

        <belongFestivalId>
            <Type>      UINT32           </Type>
            <Flags>     CELL_PRIVATE     </Flags>
            <Default>   0                </Default>
        </belongFestivalId>

        <deathTime>
            <Type>      LONGTIME        </Type>
            <Flags>     ALL_CLIENTS     </Flags>
            <Default>   0               </Default>
        </deathTime>

    </Properties>

    <CellMethods>
        <setAI>
            <Arg>        STRING        </Arg>
            <Arg>        PYTHON        </Arg>
        </setAI>

        <doDialogEvent> <Exposed/>
            <Arg>        UINT32        </Arg>
        </doDialogEvent>

    </CellMethods>

    <ClientMethods>
        <onDead>
            <Arg>        OBJECT_ID        </Arg>
        </onDead>
        <onBornAction>
        </onBornAction>

    </ClientMethods>
</root>
