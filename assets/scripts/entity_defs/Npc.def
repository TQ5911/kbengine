<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>     iBaseWithCell   </Interface>
        <Interface>     iClient         </Interface>
        <Interface>	    iAICombatUnit   </Interface>
        <Interface>	    iTimerCell      </Interface>
        <Interface>	    iEventMgr       </Interface>
        <Interface>	    iFubenSpace     </Interface>
        <Interface>     iGameEntity     </Interface>
        <Interface>     iEntityRefresh     </Interface>
        <Interface>     iMonsterDungeon </Interface>
        <Interface>     iRoute          </Interface>
    </Interfaces>

    <Properties>
        <npcId>
            <Type>	OBJECT_ID						</Type>
            <Flags>	OTHER_CLIENTS					</Flags>
        </npcId>

        <npcCreepId>
            <Type>  OBJECT_ID    </Type>
            <Flags> CELL_PRIVATE    </Flags>
        </npcCreepId>

        <name>
            <Type>	UNICODE							</Type>
            <Flags>	OTHER_CLIENTS				</Flags>
        </name>

        <moveController>
            <Type>	UINT32						</Type>
            <Flags>	CELL_PRIVATE 			</Flags>
        </moveController>

        <bornPosition>
            <Type>	POSITION3D				</Type>
            <Flags>	CELL_PRIVATE 			</Flags>
        </bornPosition>

        <route>
            <Type>      PYTHON        </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>    []            </Default>
        </route>

        <thinkTimer>
            <Type>      TIMER_ID        </Type>
            <Flags>     CELL_PRIVATE    </Flags>
        </thinkTimer>

        <belongFestivalId>
            <Type>      UINT32           </Type>
            <Flags>     CELL_PRIVATE     </Flags>
            <Default>   0                </Default>
        </belongFestivalId>

        <danceTime>
            <Type>      TIMESTAMP   </Type>
            <Flags>     ALL_CLIENTS     </Flags>
            <Default>   0           </Default>
        </danceTime>

    </Properties>

    <CellMethods>
        <setAI>
            <Arg>        STRING        </Arg>
            <Arg>        PYTHON        </Arg>
        </setAI>

        <doDialogEvent> <Exposed/>
            <Arg>        UINT32        </Arg>
        </doDialogEvent>

    </CellMethods>

    <ClientMethods>
        <onDead>
            <Arg>        OBJECT_ID        </Arg>
        </onDead>
        <onBornAction>
        </onBornAction>

    </ClientMethods>
</root>
