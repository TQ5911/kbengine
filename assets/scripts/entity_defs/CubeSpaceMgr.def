<root>
    <Interfaces>
        <Interface>     iStaticSpaceMgr         </Interface>
        <Interface>     iCollectionBossForMgr   </Interface>
    </Interfaces>

    <Properties>
        <cubeArena>
            <Type>          CUBE_ARENA_DATA_INFO    </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </cubeArena>

        <cubeArenaTimerId>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </cubeArenaTimerId>
    </Properties>

    <CellMethods>
        <createTeleporterToCow>
            <Arg>       UINT8               </Arg>
        </createTeleporterToCow>

        <destroyChanMap>
        </destroyChanMap>

        <createChapMan>
            <Arg>       POSITION3D          </Arg>
            <Arg>       FLOAT               </Arg>
        </createChapMan>

        <callOnSpaceMgr>
            <Arg>       STRING          </Arg>
            <Arg>       PYTHON          </Arg>
        </callOnSpaceMgr>
    </CellMethods>
</root>
