<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>    iAICombatUnit    </Interface>
        <Interface>    iTimerCell    </Interface>
        <Interface>    iEventMgr     </Interface>
        <Interface>    iFubenSpace    </Interface>
        <Interface>    iBaseWithCell    </Interface>
        <Interface>    iClient          </Interface>
        <Interface>    iMonsterGrp      </Interface>
        <Interface>    iMonsterDungeon  </Interface>
        <Interface>    iGameEntity      </Interface>
    </Interfaces>

    <Properties>
        <avatarGbId>
            <Type>          OBJECT_ID               </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </avatarGbId>

        <name>
            <Type>	        UNICODE				    </Type>
            <Flags>	        OTHER_CLIENTS		    </Flags>
            <WitnessName>   true                    </WitnessName>
        </name>

        <school>
            <Type>          SCHOOL                  </Type>
            <Flags>         OTHER_CLIENTS           </Flags>
            <WitnessName>   true                    </WitnessName>
        </school>

        <sex>
            <Type>          SEX                 </Type>
            <Flags>         OTHER_CLIENTS       </Flags>
            <WitnessName>   true                </WitnessName>
        </sex>

        <appearance>
            <Type>          APPEARANCE_INFO         </Type>
            <Flags>         OTHER_CLIENTS           </Flags>
        </appearance>

        <moveController>
            <Type>	        UINT32				    </Type>
            <Flags>	        CELL_PRIVATE 			</Flags>
        </moveController>

        <hateTrapId>
            <Type>          UINT32                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </hateTrapId>
    
        <bornPosition>
            <Type>          POSITION3D              </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </bornPosition>

        <thinkTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </thinkTimer>
    </Properties>

    <BaseMethods>

    </BaseMethods>

    <CellMethods>
        <setAI>
            <Arg>        STRING        </Arg>
            <Arg>        PYTHON        </Arg>
        </setAI>
    </CellMethods>

    <ClientMethods>
        <onDead>
            <Arg>        OBJECT_ID        </Arg>
        </onDead>
    </ClientMethods>
</root>

