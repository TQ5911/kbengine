<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>    iAICombatUnit    </Interface>
        <Interface>    iTimerCell       </Interface>
        <Interface>    iEventMgr        </Interface>
        <Interface>    iFubenSpace      </Interface>
        <Interface>    iGameEntity      </Interface>
        <Interface>    iMonsterGrp      </Interface>
        <Interface>    iReplicaAvatar   </Interface>
    </Interfaces>

    <Properties>
        <avatarGbId>
            <Type>          PLAYER_GBID               </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </avatarGbId>

        <avatarId>
            <Type>          OBJECT_ID               </Type>
            <Flags>         OTHER_CLIENTS           </Flags>
            <WitnessName>     true                  </WitnessName>
        </avatarId>

        <replicaId>
            <Type>  OBJECT_ID                       </Type>
            <Flags> OTHER_CLIENTS                   </Flags>
            <WitnessName>     true                  </WitnessName>
        </replicaId>

        <arType>
            <Type>	        UINT8				    </Type>
            <Flags>	        OTHER_CLIENTS		    </Flags>
            <WitnessName>   true                    </WitnessName>
        </arType>

        <name>
            <Type>	        UNICODE				    </Type>
            <Flags>	        OTHER_CLIENTS		    </Flags>
            <WitnessName>   true                    </WitnessName>
        </name>

        <school>
            <Type>          SCHOOL                  </Type>
            <Flags>         OTHER_CLIENTS           </Flags>
            <WitnessName>   true                    </WitnessName>
        </school>

        <sex>
            <Type>          SEX                 </Type>
            <Flags>         OTHER_CLIENTS       </Flags>
            <WitnessName>   true                </WitnessName>
        </sex>

        <appearance>
            <Type>          APPEARANCE_INFO         </Type>
            <Flags>         OTHER_CLIENTS           </Flags>
        </appearance>

        <glyphEquipData>
            <Type>          GLYPH_EQUIP_INFO        </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </glyphEquipData>

    </Properties>

    <BaseMethods>

    </BaseMethods>

    <CellMethods>
        <setAI>
            <Arg>        STRING        </Arg>
            <Arg>        PYTHON        </Arg>
        </setAI>
    </CellMethods>

    <ClientMethods>
        <onBornAction> </onBornAction>

        <onDead>
            <Arg>        OBJECT_ID        </Arg>
        </onDead>
    </ClientMethods>
</root>

