<root>

    <Interfaces>
        <Interface> iBaseNoCell </Interface>
        <Interface> iGlobal     </Interface>
        <Interface> iTimerBase </Interface>
    </Interfaces>

    <Properties>
        <globalIdx>
            <Type>      UINT16     </Type>
            <Flags>     BASE        </Flags>
        </globalIdx>
        <role2box>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}      </Default>
        </role2box>

        <role2gbId>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}      </Default>
        </role2gbId>

        <gbId2box>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}      </Default>
        </gbId2box>

        <account2box>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}      </Default>
        </account2box>

        <dbId2box>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}      </Default>
        </dbId2box>

        <playersInfoCache>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
        </playersInfoCache>

        <avatarCounter>
            <Type>      PYTHON      </Type>
            <Flags>     BASE        </Flags>
        </avatarCounter>
    </Properties>

    <BaseMethods>
        <record>
            <Arg>           STRING    </Arg>
            <Arg>           UNICODE    </Arg>
            <Arg>           PLAYER_GBID </Arg>
            <Arg>           DBID </Arg>
            <Arg>           MAILBOX     </Arg>
            <Arg>           METHOD_NAME     </Arg> <!-- callbackFunc  -->
            <Arg>           METHOD_ARGS     </Arg> <!-- callbackArgs  -->
            <Arg>           PYTHON     </Arg>
        </record>

        <erase>
            <Arg>           STRING    </Arg>
            <Arg>           OBJECT_ID   </Arg>
            <Arg>           UNICODE    </Arg>
            <Arg>           PLAYER_GBID </Arg>
            <Arg>           DBID </Arg>
            <Arg>           UINT32 </Arg>
        </erase>

        <gmLookUpAvatar>
            <Arg> MAILBOX </Arg>
            <Arg> PLAYER_GBID </Arg>
            <Arg> STRING </Arg>
            <Arg> UINT8 </Arg>
            <Arg> BOOL </Arg>
        </gmLookUpAvatar>

        <doOnOthersBaseByAccountName>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
        </doOnOthersBaseByAccountName>

        <doOnOthersBase>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
        </doOnOthersBase>

        <doOnOthersCell>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
        </doOnOthersCell>

        <doOnOthersClient>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
            <Arg>           PYTHON      </Arg>
            <Arg>           METHOD_NAME </Arg>
            <Arg>           METHOD_ARGS </Arg>
        </doOnOthersClient>

        <isAllAvatarsOnline>
            <Arg>           ARRAY       <of>    PLAYER_GBID               </of>   </Arg>
            <Arg>           MAILBOX     </Arg>
        </isAllAvatarsOnline>

        <sendSysMsgToAvatar>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           INT32           </Arg>
            <Arg>           ARRAY   <of>    UNICODE     </of>       </Arg>
        </sendSysMsgToAvatar>

        <sendSysMsgToAvatars>
            <Arg>           ARRAY   <of>    PLAYER_GBID </of>     </Arg>
            <Arg>           INT32           </Arg>
            <Arg>           ARRAY   <of>    UNICODE     </of>       </Arg>
        </sendSysMsgToAvatars>

        <updateName>
            <Arg>           UNICODE         </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </updateName>

        <gmAddFriendsGetGbIds>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </gmAddFriendsGetGbIds>

        <syncOnlineNumToQueueServer>
        </syncOnlineNumToQueueServer>

        <playerRecvMail>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </playerRecvMail>

        <getFriendsBox>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           ARRAY   <of>    PLAYER_GBID </of>     </Arg>
        </getFriendsBox>

        <getPlayerInfoOffline>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITYCALL      </Arg>
        </getPlayerInfoOffline>

        <onGetMemberJobAndGuildCache>
            <Arg>   PY_TUPLE       </Arg>
            <Arg>   PYTHON         </Arg>
        </onGetMemberJobAndGuildCache>
    </BaseMethods>
</root>
