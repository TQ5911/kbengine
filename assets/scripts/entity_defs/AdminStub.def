        </doReplyCommand>

        <replyHttpCommand>
            <Arg>       STRING      </Arg>
            <Arg>       STRING      </Arg>
            <Arg>       INT32       </Arg>
            <Arg>       UNICODE     </Arg>
            <Arg>       PYTHON        </Arg>
        </replyHttpCommand>

    </BaseMethods>
</root>
