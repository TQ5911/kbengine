<root>
    <Properties>
        <mineWarCanAttack>
            <Type>          UINT8           </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0               </Default>
        </mineWarCanAttack>

        <mineWarCamp>
            <Type>          UINT8           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Default>       0               </Default>
            <WitnessName>   true            </WitnessName>
        </mineWarCamp>

        <myGuildInfo>
            <Type>      PYTHON         </Type>
            <Flags>     CELL_PRIVATE           </Flags>
        </myGuildInfo>
        <myGuildInfoBase>
            <Type>      PYTHON         </Type>
            <Flags>     BASE           </Flags>
        </myGuildInfoBase>
        
        <myMineList>
            <Type>      PYTHON         </Type>
            <Flags>     CELL_PRIVATE           </Flags>
        </myMineList>
        <myMineListBase>
            <Type>      PYTHON         </Type>
            <Flags>     BASE           </Flags>
        </myMineListBase>
        <MineRevenueDict>
            <Type>      PYTHON         </Type>
            <Flags>     BASE           </Flags>
        </MineRevenueDict>
        <mineWarState>
            <Type>      UINT8         </Type>
            <Flags>     CELL_PRIVATE           </Flags>
        </mineWarState>
        <mineWarStateBase>
            <Type>      UINT8         </Type>
            <Flags>     BASE           </Flags>
        </mineWarStateBase>

    </Properties>

    <BaseMethods>
        <reqSyncGuildData>
        </reqSyncGuildData>
        
        <onPlayerGetGuildInfo>
            <Arg>          MINE_WAR_GUILD_INFO         </Arg>
        </onPlayerGetGuildInfo>

        <onMineWarStateSync>
            <Arg>          UINT8         </Arg>
            <Arg>          TIMESTAMP         </Arg>
            <Arg>          TIMESTAMP         </Arg>
            <Arg>   ARRAY   <of>  LINE_NO   </of>   </Arg>
            <Arg>          PY_DICT         </Arg>
        </onMineWarStateSync>
        <onMineWarPreparePlayer>
            <Arg>          UINT8         </Arg>
            <Arg>          TIMESTAMP         </Arg>
        </onMineWarPreparePlayer>
        <onMineWarStartPlayer>
            <Arg>          UINT8         </Arg>
            <Arg>          TIMESTAMP         </Arg>
        </onMineWarStartPlayer>
        <onMineWarEndPlayer>
            <Arg>   ARRAY   <of>    PYTHON     </of>   </Arg>
        </onMineWarEndPlayer>

        <reqMineWarInfo> <Exposed/>
        </reqMineWarInfo>
        <reqMineWarShareBonus> <Exposed/>
            <Arg>          LINE_NO         </Arg>
            <Arg>         ARRAY   <of>  MINE_WAR_GUILD_SHARE_INFO   </of>   </Arg>
        </reqMineWarShareBonus>
        <reqMineWarGuildOwnerRank> <Exposed/>
            <Arg>          LINE_NO         </Arg>
            <Arg>          UINT8         </Arg>
        </reqMineWarGuildOwnerRank>
        <reqMineWarGuildPlayerRank> <Exposed/>
            <Arg>          LINE_NO         </Arg>
            <Arg>          UINT8         </Arg>
        </reqMineWarGuildPlayerRank>

        <reqMineWarCollectInfo> <Exposed/>
        </reqMineWarCollectInfo>

        <reqMineWarGuildMemberScore> <Exposed/>
            <Arg>          LINE_NO         </Arg>
        </reqMineWarGuildMemberScore>

        <reqMineWarFlagHp> <Exposed/>
            <Arg>          LINE_NO         </Arg>
        </reqMineWarFlagHp>

        <getMineWarInfo>
        </getMineWarInfo>

        <onMineWarKillCore>
            <Arg>          LINE_NO         </Arg>
        </onMineWarKillCore>
        <onMineWarHpWarning>
            <Arg>          SPACE_NO         </Arg>
            <Arg>          UINT8         </Arg>
        </onMineWarHpWarning>

        <onMineWarFlagBeDestroyed>
            <Arg>          LINE_NO         </Arg>
            <Arg>          GUILD_UUID         </Arg>
            <Arg>          UINT8         </Arg>
        </onMineWarFlagBeDestroyed>
        <onMineWarFlagAllDestroyed>
            <Arg>          LINE_NO         </Arg>
            <Arg>          UNICODE         </Arg>
            <Arg>          GUILD_UUID         </Arg>
        </onMineWarFlagAllDestroyed>
        <onMineWarFlagHpChangeWarning>
            <Arg>          LINE_NO         </Arg>
        </onMineWarFlagHpChangeWarning>
        <onMineWarFlagHpLowWarning>
            <Arg>          LINE_NO         </Arg>
        </onMineWarFlagHpLowWarning>

        <onMineWarLeaveGuild>
        </onMineWarLeaveGuild>

        <onMineWarGuildOwnerRankBase>
            <Arg>   MINE_WAR_GUILD_RANK_INFO   </Arg>
            <Arg>   ARRAY   <of>    MINE_WAR_GUILD_RANK_INFO     </of>   </Arg>
        </onMineWarGuildOwnerRankBase>

        <onMineWarGuildPlayerRankBase>
            <Arg>   MINE_WAR_GUILD_PLAYER_RANK_INFO   </Arg>
            <Arg>   ARRAY   <of>    MINE_WAR_GUILD_PLAYER_RANK_INFO     </of>   </Arg>
        </onMineWarGuildPlayerRankBase>

    </BaseMethods>
    <CellMethods>
        <onCellPlayerGetGuildInfo>
            <Arg>          MINE_WAR_GUILD_INFO         </Arg>
        </onCellPlayerGetGuildInfo>
        
        <syncMineWarInfo>
            <Arg>          UINT8         </Arg>
            <Arg>   ARRAY   <of>  LINE_NO   </of>   </Arg>
        </syncMineWarInfo>

        <getMineWarMonsterInfo> <Exposed/>
        </getMineWarMonsterInfo>

    </CellMethods>
    <ClientMethods>
        <showMineWarPrepare>
            <Arg>          UINT8         </Arg>
            <Arg>          INT16         </Arg>
        </showMineWarPrepare>
        <showMineWarStart>
            <Arg>          UINT8         </Arg>
            <Arg>          INT16         </Arg>
        </showMineWarStart>
        <showMineWarEnd>
        </showMineWarEnd>

        <onMineWarInfo>
            <Arg>   ARRAY   <of>    MINE_WAR_SINGLE_INFO     </of>   </Arg>
        </onMineWarInfo>
        <onMineWarGuildOwnerRank>
            <Arg>   MINE_WAR_GUILD_RANK_INFO   </Arg>
            <Arg>   ARRAY   <of>    MINE_WAR_GUILD_RANK_INFO     </of>   </Arg>
        </onMineWarGuildOwnerRank>
        <onMineWarGuildPlayerRank>
            <Arg>   MINE_WAR_GUILD_PLAYER_RANK_INFO   </Arg>
            <Arg>   ARRAY   <of>    MINE_WAR_GUILD_PLAYER_RANK_INFO     </of>   </Arg>
        </onMineWarGuildPlayerRank>
        <onMineWarEndInfo>
            <Arg>   LINE_NO         </Arg>
            <Arg>   UINT8           </Arg>
            <Arg>   UNICODE             </Arg>
            <Arg>   UINT8           </Arg>
        </onMineWarEndInfo>

        <onShowMineWarMonsterInfo>
            <Arg>   ENTITY_ID     </Arg>
            <Arg>   ENTITY_ID     </Arg>
            <Arg>   GUILD_UUID        </Arg>
            <Arg>   UINT8        </Arg>
            <Arg>   UNICODE      </Arg>
            <Arg>   UINT8        </Arg>
        </onShowMineWarMonsterInfo>

        <onMineWarShareBonusResult>
            <Arg>   BOOL        </Arg>
        </onMineWarShareBonusResult>

        <onGetMineWarCollectInfo>
            <Arg>   UINT16     </Arg>
            <Arg>   UINT8      </Arg>
        </onGetMineWarCollectInfo>
        
        <onGetMineWarGuildMemberScore>
            <Arg>   LINE_NO         </Arg>
            <Arg>   ARRAY   <of>    MINE_WAR_GUILD_MEMBER_SCORE_INFO     </of>   </Arg>
        </onGetMineWarGuildMemberScore>

        <onGetMineWarFlagHp>
            <Arg>          LINE_NO         </Arg>
            <Arg>          UINT8         </Arg>
        </onGetMineWarFlagHp>
    </ClientMethods>
</root>
