<root>
    <Properties>
        <safeBoxCache>
            <Type>          PY_DICT     </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
        </safeBoxCache>
    </Properties>

    <BaseMethods>
        <reqSafeBoxPage> <Exposed/>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
        </reqSafeBoxPage>

        <reqClaimSafeBoxItem> <Exposed/>
            <Arg>           UINT32         </Arg>
        </reqClaimSafeBoxItem>

        <reqClaimAllSafeBoxItems> <Exposed/>
        </reqClaimAllSafeBoxItems>

        <reqDeleteSafeBoxItem> <Exposed/>
            <Arg>           UINT32                          </Arg>
        </reqDeleteSafeBoxItem>

        <processPurchaseOrder>
            <Arg>           STRING          </Arg>   <!-- orderId -->
            <Arg>           LONGTIME        </Arg>   <!-- orderTime -->
            <Arg>           UINT32          </Arg>   <!-- itemId -->
            <Arg>           UINT32          </Arg>   <!-- itemCount -->
            <Arg>           DOUBLE          </Arg>   <!-- price -->
            <Arg>           BOOL            </Arg>   <!-- addToSafe -->
        </processPurchaseOrder>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onSafeBoxPage>
            <Arg>           ARRAY <of> CLI_SAFE_BOX_ITEM_VAL </of>  </Arg>   
            <Arg>           UINT32                                  </Arg>
            <Arg>           UINT32                                  </Arg>
            <Arg>           UINT32                                  </Arg>  
        </onSafeBoxPage>

        <onSafeBoxItemClaimed>
            <Arg>           UINT32                          </Arg>
        </onSafeBoxItemClaimed>

        <onNewSafeBoxItem>
            <Arg>  CLI_SAFE_BOX_ITEM_VAL </Arg>
        </onNewSafeBoxItem>

        <onClaimAllResult>
            <Arg>           ARRAY <of> UINT32 </of>         </Arg>
        </onClaimAllResult>

        <onSafeBoxItemDeleted>
            <Arg>           UINT32                          </Arg>
        </onSafeBoxItemDeleted>

        <onSafeBoxUnclaimedCount>
            <Arg>           UINT32                          </Arg>
            <Arg>           UINT32                          </Arg>
        </onSafeBoxUnclaimedCount>
    </ClientMethods>
</root>
