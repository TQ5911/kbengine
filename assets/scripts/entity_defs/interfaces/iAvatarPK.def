<root>
    <Properties>
        <pkModel>
            <Type>          UINT8                   </Type>
            <Flags>         ALL_CLIENTS             </Flags>
            <Persistent>    true                    </Persistent>
            <WitnessName>     true                  </WitnessName>
        </pkModel>

        <pkModelBefore>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Persistent>    true                    </Persistent>
        </pkModelBefore>

        <pkProtect>
            <Type>          UINT32                  </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Persistent>    true                    </Persistent>
        </pkProtect>

        <moralValue>
            <Type>          INT32                   </Type>
            <Flags>         ALL_CLIENTS             </Flags>
            <Persistent>    true                    </Persistent>
        </moralValue>

        <tGreyNameStart>
            <Type>          LONGTIME                </Type>
            <Flags>         ALL_CLIENTS             </Flags>
            <Persistent>    true                    </Persistent>
        </tGreyNameStart>

        <backPeaceTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </backPeaceTimer>

        <redNameKillTime>
            <Type>          PY_DICT                 </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Persistent>    true                    </Persistent>
        </redNameKillTime>

        <moralLevel>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </moralLevel>

        <tSwitchPKModel>
            <Type>          LONGTIME                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Persistent>    true                    </Persistent>
        </tSwitchPKModel>

        <refugeTime>
            <Type>          UINT32                  </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </refugeTime>

        <refugeDailyUsed>
            <Type>          UINT32                  </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </refugeDailyUsed>

        <refugeOpen>
            <Type>          UINT8                   </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </refugeOpen>

        <refugeConsumeStart>
            <Type>          LONGTIME                </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </refugeConsumeStart>

        <refugeDailyRefreshTs>
            <Type>          LONGTIME                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </refugeDailyRefreshTs>

        <refugeExpireTimerId>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </refugeExpireTimerId>
    </Properties>

    <CellMethods>
        <switchPKModel> <Exposed/>
            <Arg>           UINT8           </Arg>
        </switchPKModel>

        <setPKModel>
            <Arg>           UINT8           </Arg>
        </setPKModel>

        <setPKProtect> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           BOOL            </Arg>
        </setPKProtect>

        <declareWarToAvatar> <Exposed/>
            <Arg>           ENTITY_ID       </Arg>
        </declareWarToAvatar>

        <buyRefugeTime> <Exposed/>
            <Arg>           UINT8           </Arg>
        </buyRefugeTime>

        <openRefuge> <Exposed/>
        </openRefuge>

        <onBuyRefugeTimeCallback>
            <Arg>           BOOL            </Arg>
            <Arg>           PY_DICT         </Arg>
        </onBuyRefugeTimeCallback>
    </CellMethods>

    <ClientMethods>
        <onAddChallengeAvatar>
            <Arg>           ARRAY <of> PLAYER_GBID </of>     </Arg>
        </onAddChallengeAvatar>

        <onRemoveChallengeAvatar>
            <Arg>           PLAYER_GBID     </Arg>
        </onRemoveChallengeAvatar>
    </ClientMethods>
</root>
