<root>
    <Properties>
        <leftCubeTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </leftCubeTimes>

        <paidCubeTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </paidCubeTimes>

        <cubeUseCoinTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </cubeUseCoinTimes>

        <cubeUseItemTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </cubeUseItemTimes>

        <cubeRoomTimerId>
            <Type>          TIMER_ID                    </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
        </cubeRoomTimerId>

        <cubeEnterFloor>
            <Type>          UINT8                       </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
            <Persistent>    true                        </Persistent>
        </cubeEnterFloor>

        <fromCubeMapId>
            <Type>          MAP_ID                      </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
            <Persistent>    true                        </Persistent>
        </fromCubeMapId>

        <cubeRoomKickTimerId>
            <Type>          TIMER_ID                    </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
        </cubeRoomKickTimerId>

        <cubeQuota>
            <Type>          CUBE_QUOTA_DATA_INFO        </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Persistent>    true                        </Persistent>
        </cubeQuota>

        <cubePrayTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Default>       0                           </Default>
            <Persistent>    true                        </Persistent>
        </cubePrayTimes>

        <cubeRoomLeftTimeDic>
            <Type>          PY_DICT                     </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Persistent>    true                        </Persistent>
        </cubeRoomLeftTimeDic>
    </Properties>

    <BaseMethods>
        <beforeEnterCubeDecrementCnt>
            <Arg>           PYTHON                  </Arg>
        </beforeEnterCubeDecrementCnt>

        <reqUseItemAddCubeTimes> <Exposed/>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           BOOL                    </Arg>
        </reqUseItemAddCubeTimes>

        <useItemAddCubeTimes>
            <Arg>           UINT8                   </Arg>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           OP_UUID                 </Arg>
        </useItemAddCubeTimes>

        <addRoomDurationFailed>
            <Arg>           OP_UUID                 </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT16                  </Arg>
        </addRoomDurationFailed>

        <addRoomDurationFailedRewindTimes>
            <Arg>           OP_UUID                 </Arg>
        </addRoomDurationFailedRewindTimes>

        <autoRenewCubeRoom>
            <Arg>           CUBE_SWITCH             </Arg>
            <Arg>           PYTHON                  </Arg>
        </autoRenewCubeRoom>

        <afterEnterCubeDeductTimes>
            <Arg>           PY_DICT         </Arg>
        </afterEnterCubeDeductTimes>

        <cubePray> <Exposed/>
            <Arg>           UINT8                   </Arg>
        </cubePray>

        <onLogonEnterCubeGetSpaceBox>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg>
        </onLogonEnterCubeGetSpaceBox>

        <getCubeReadyLineCnt> <Exposed/>
        </getCubeReadyLineCnt>
    </BaseMethods>

    <CellMethods>
        <beginEnterCubeRoom>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           PYTHON                  </Arg>
        </beginEnterCubeRoom>

        <enterCube> <Exposed/>
            <Arg>           UINT8                   </Arg>
        </enterCube>

        <leaveCube> <Exposed/>
        </leaveCube>

        <reqChangeCubeAutoRenewSwitch> <Exposed/>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
        </reqChangeCubeAutoRenewSwitch>

        <addCubeRoomRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </addCubeRoomRewardRecord>

        <toClientCubeLoginData>
        </toClientCubeLoginData>

        <checkAddCubeRoomDurationCondition>
            <Arg>           UINT8                   </Arg>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           OP_UUID                 </Arg>
        </checkAddCubeRoomDurationCondition>

        <directlyAddCubeRoomDuration>
            <Arg>           STRING                  </Arg>
            <Arg>           PYTHON                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </directlyAddCubeRoomDuration>

        <setEnterCubeFloor> <Exposed/>
            <Arg>           UINT8                   </Arg>
        </setEnterCubeFloor>

        <followCaptainInCube> <Exposed/>
        </followCaptainInCube>

        <resetCubeCowDur>
        </resetCubeCowDur>

        <leaveCubeInternal>
            <Arg>           UINT8                   </Arg>
            <Arg>           BOOL                    </Arg>
        </leaveCubeInternal>

        <getCubeRoomLeftTime> <Exposed/>
        </getCubeRoomLeftTime>

        <randomCubeRoom> <Exposed/>
        </randomCubeRoom>

        <getArenaKingPos> <Exposed/>
        </getArenaKingPos>

        <getCubeKickLeftTime> <Exposed/>
            <Arg>           UINT8                   </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           LINE_NO                 </Arg>
        </getCubeKickLeftTime>

        <switchCubeLine> <Exposed/>
            <Arg>           LINE_NO                 </Arg>
        </switchCubeLine>

        <onCheckSwitchCubeLineResult>
            <Arg>           LINE_NO                 </Arg>
            <Arg>           BOOL                    </Arg>        
        </onCheckSwitchCubeLineResult>
    </CellMethods>

    <ClientMethods>
        <onCubeRoomEndTime>
            <Arg>           LONGTIME                </Arg>
            <Arg>           UINT8                </Arg>
        </onCubeRoomEndTime>

        <onCubeAutoRenewSwitch>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
        </onCubeAutoRenewSwitch>

        <onAddCubeRoomRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onAddCubeRoomRewardRecord>

        <onCubeLoginData>
            <Arg>           LONGTIME                </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
            <Arg>           UINT8                   </Arg>
        </onCubeLoginData>

        <onCubeRoomLeftTime>
            <Arg>           LONGTIME                </Arg>
        </onCubeRoomLeftTime>

        <onArenaKing>
            <Arg>           OBJECT_ID               </Arg>
        </onArenaKing>

        <onCubePrayResult>
            <Arg>           UINT8                   </Arg>
        </onCubePrayResult>

        <onCubeRoomKickLeftTime>
            <Arg>           LONGTIME                </Arg>
        </onCubeRoomKickLeftTime>

        <onCubeKickLeftTime>
            <Arg>           LONGTIME                </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           LINE_NO                 </Arg>
        </onCubeKickLeftTime>

        <onCubeReadyLineCnt>
            <Arg>           UINT8                   </Arg>      
        </onCubeReadyLineCnt>

        <onArenaKingPos>
            <Arg>           POSITION_ARG            </Arg>      
        </onArenaKingPos>
    </ClientMethods>
</root>
