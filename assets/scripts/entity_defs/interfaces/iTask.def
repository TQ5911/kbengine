<root>
    <Properties>
        <taskInfo>
            <Type>    TASK_INFO          </Type>
            <Flags>   BASE              </Flags>
            <Persistent>    true        </Persistent>
        </taskInfo>

        <checkAreaTgtTaskTimer>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </checkAreaTgtTaskTimer>
    </Properties>

    <BaseMethods>
        <reqSubmitTask><Exposed/>
            <Arg>   ARRAY    <of>    TASK_ID                  </of>   </Arg>
        </reqSubmitTask>
        <reqDeductTaskTargetItems><Exposed/>
            <Arg>       TASK_ID     </Arg>
        </reqDeductTaskTargetItems>
        <onCheckCellSubmitCondSucc>
            <Arg>           TASK_ID         </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UUID            </Arg>
        </onCheckCellSubmitCondSucc>
        <reqQuitTask><Exposed/>
            <Arg>       TASK_ID     </Arg>
        </reqQuitTask>

        <onCheckSingleTaskCellCondSucc>
            <Arg>       TASK_ID     </Arg>
            <Arg>       PYTHON     </Arg>
        </onCheckSingleTaskCellCondSucc>

        <onTaskAvatarDie>
            <Arg>           SPACE_NO         </Arg>
        </onTaskAvatarDie>

        <startTaskFailed>
            <Arg>       TASK_ID     </Arg>
            <Arg>       UINT8       </Arg>
        </startTaskFailed>

        <reqCompleteTaskNoTarget><Exposed/>
            <Arg>      TASK_ID          </Arg>
        </reqCompleteTaskNoTarget>

        <reqTaskCompleteTarget><Exposed/>
            <Arg>      TASK_ID          </Arg>
            <Arg>      UINT32           </Arg>
            <Arg>      UINT32           </Arg>
        </reqTaskCompleteTarget>

        <onCheckTaskCompleteActionTargetCallback>
            <Arg>      BOOL             </Arg>
            <Arg>      TASK_ID          </Arg>
            <Arg>      UINT32           </Arg>
            <Arg>      UINT32           </Arg>
        </onCheckTaskCompleteActionTargetCallback>

        <doBaseCommEvent>
            <Arg>       UINT8           </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       PY_LIST          </Arg>
            <Arg>       PY_DICT         </Arg>
        </doBaseCommEvent>

        <isTaskComplete>
            <Arg>       TASK_ID         </Arg>
            <Arg>       ENTITYCALL      </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       PYTHON          </Arg>
        </isTaskComplete>

        <getTaskCurrentState>
            <Arg>       TASK_ID         </Arg>
            <Arg>       ENTITYCALL      </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       PYTHON          </Arg>
        </getTaskCurrentState>

        <forceCompleteTaskNoCond>
            <Arg>       TASK_ID         </Arg>
        </forceCompleteTaskNoCond>

        <doCompleteTaskNoTarget>
            <Arg>       TASK_ID         </Arg>
        </doCompleteTaskNoTarget>

        <onTaskLeaveSpace>
            <Arg>       DUNGEON_NO      </Arg>
        </onTaskLeaveSpace>

        <reqDropTaskItem><Exposed/>
            <Arg>       GRIDID        </Arg>
            <Arg>       ITEM_ID       </Arg>
        </reqDropTaskItem>

        <reqEnterTaskTargetDungeon><Exposed/>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DUNGEON_NO      </Arg>
        </reqEnterTaskTargetDungeon>

        <taskCheckCounterTarget>
            <Arg>       UINT32         </Arg>
            <Arg>       PY_TUPLE    </Arg>
        </taskCheckCounterTarget>

        <baseTaskClaimedFailed>
            <Arg>       PYTHON          </Arg>
            <Arg>       TASK_ID         </Arg>
        </baseTaskClaimedFailed>

        <onTaskStepUpdate>
            <Arg>       UINT8           </Arg>
            <Arg>       TASK_ID         </Arg>
            <Arg>       METHOD_ARGS     </Arg>
        </onTaskStepUpdate>

        <reqTaskEnterSpace><Exposed/>
            <Arg>       TASK_ID         </Arg>
        </reqTaskEnterSpace>

        <onCheckSameMap>
            <Arg>      TASK_ID         </Arg>
            <Arg>      BOOL            </Arg>
        </onCheckSameMap>
    </BaseMethods>

    <CellMethods>
        <reqClaimTask><Exposed/>
            <Arg>       UINT8     </Arg>
            <Arg>       TASK_ID   </Arg>
            <Arg>       UNICODE   </Arg>
        </reqClaimTask>
        <reqUpdateTaskByTalkToNpc><Exposed/>
            <Arg>       UINT8           </Arg>
            <Arg>       OBJECT_ID       </Arg>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DIALOG_ID       </Arg>
        </reqUpdateTaskByTalkToNpc>
        <startClaimTask>
            <Arg>       TASK_ID         </Arg>
            <Arg>       METHOD_NAME     </Arg>
            <Arg>       METHOD_ARGS     </Arg>
            <Arg>       PYTHON          </Arg>
        </startClaimTask>
        <claimTaskFailed>
            <Arg>       TASK_ID         </Arg>
            <Arg>       PYTHON          </Arg>
            <Arg>       INT32          </Arg>
            <Arg>       PYTHON          </Arg>
        </claimTaskFailed>
        <claimTaskSuccCallback>
            <Arg>       TASK_ID         </Arg>
            <Arg>       UUID            </Arg>
        </claimTaskSuccCallback>
        <taskReachArea><Exposed/>
            <Arg>       TASK_ID   </Arg>
        </taskReachArea>
        <onAreaTargetTaskAdd>
            <Arg>       TASK_ID     </Arg>
            <Arg>       PYTHON      </Arg>
        </onAreaTargetTaskAdd>
        <removeAreaTargetTask>
            <Arg>       TASK_ID     </Arg>
            <Arg>       DUNGEON_NO  </Arg>
        </removeAreaTargetTask>
        <taskFailedLeaveArea><Exposed/>
            <Arg>       TASK_ID   </Arg>
        </taskFailedLeaveArea>
        <taskFailedEnterArea><Exposed/>
            <Arg>       TASK_ID   </Arg>
        </taskFailedEnterArea>

        <onTaskRwdLeaveDungeon>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DUNGEON_NO      </Arg>
            <Arg>       UINT8           </Arg>
        </onTaskRwdLeaveDungeon>

        <taskPreEnterSpace>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DUNGEON_NO      </Arg>
            <Arg>       PYTHON          </Arg>
            <Arg>       PYTHON          </Arg>
        </taskPreEnterSpace>

        <prepareStartPlayCinema>
            <Arg>       UINT32       </Arg>
        </prepareStartPlayCinema>

        <afterPlayCinema>
            <Arg>       UINT32       </Arg>
        </afterPlayCinema>

        <reqStartPlayCinema><Exposed/>
            <Arg>      REWARD_ID    </Arg>
        </reqStartPlayCinema>
        <cellCheckTaskSubmitCond>
            <Arg>      TASK_ID      </Arg>
            <Arg>       UUID        </Arg>
        </cellCheckTaskSubmitCond>

        <talkToNpc><Exposed/>
            <Arg>       OBJECT_ID       </Arg>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DIALOG_ID       </Arg>
            <Arg>       UINT8           </Arg>
        </talkToNpc>

        <talkToClientNpc><Exposed/>
            <Arg>       UINT32          </Arg>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DIALOG_ID       </Arg>
            <Arg>       UINT8           </Arg>
        </talkToClientNpc>

        <cinemaPlayEnd><Exposed/>
            <Arg>       UINT32          </Arg>
        </cinemaPlayEnd>

        <doCellCommEvent>
            <Arg>       UINT8           </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       PY_LIST          </Arg>
            <Arg>       PY_DICT         </Arg>
        </doCellCommEvent>

        <cellEnterTaskTargetDungeon>
            <Arg>       TASK_ID         </Arg>
            <Arg>       DUNGEON_NO      </Arg>
            <Arg>       PYTHON          </Arg>
        </cellEnterTaskTargetDungeon>
        <checkTaskCompleteActionTarget>
            <Arg>      TASK_ID          </Arg>
            <Arg>      UINT32           </Arg>
            <Arg>      UINT32           </Arg>
        </checkTaskCompleteActionTarget>
        <checkSameMap>
            <Arg>      TASK_ID         </Arg>
        </checkSameMap>
    </CellMethods>

    <ClientMethods>
        <onTaskUpdate>
            <Arg>  ARRAY <of>  TASK_CLIENT_VAL </of> </Arg>
        </onTaskUpdate>
        <onClaimTask>
            <Arg>  TASK_ID  </Arg>
            <Arg>  ARRAY <of>  TASK_CLIENT_VAL </of> </Arg>
        </onClaimTask>
        <onHookRewardTaskRefresh>
            <Arg>  ARRAY <of>  TASK_ID </of>  </Arg>
        </onHookRewardTaskRefresh>
        <onTasksRem>
            <Arg>  ARRAY <of>  TASK_ID </of> </Arg>
        </onTasksRem>
        <onHookRewardTaskWeeklyLimitRefresh>
            <!-- 悬赏任务每周已经完成的次数 -->
            <Arg>  UINT32  </Arg>
        </onHookRewardTaskWeeklyLimitRefresh>
        <onStartPlayCinema>
            <Arg>  UINT32  </Arg>
        </onStartPlayCinema>

        <onGetTaskReward>
            <Arg>  TASK_ID  </Arg>
            <Arg>  ARRAY <of>  AWARD_DISPLAY_SINGLE_VAL </of> </Arg>
        </onGetTaskReward>
    </ClientMethods>
</root>
