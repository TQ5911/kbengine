<root>
    <Interfaces>
    </Interfaces>

    <Properties>
        <crusadeInfo>
            <Type>  CRUSADE_DUNGEON_PLAY_MODE_PLAYER_OBJ   </Type>
            <Flags> BASE_AND_CLIENT  </Flags>
            <Persistent>true</Persistent>
        </crusadeInfo>

        <crusadeCoinTicketData>
            <Type>          COIN_TICKET_INFO_DATA   </Type>
            <Flags>         BASE                    </Flags>
        </crusadeCoinTicketData>
    </Properties>

    <CellMethods>
        <enterCrusadeDungeon>
            <Exposed/>
        </enterCrusadeDungeon>
        <autoStartCrusadeDungeon>
        </autoStartCrusadeDungeon>
    </CellMethods>

    <BaseMethods>
        <increaseCrusadeRewardNumber>
            <Exposed/>
            <Arg>   UINT16   </Arg>
            <Arg>   UINT16   </Arg>
        </increaseCrusadeRewardNumber>

        <useItemToIncreaseCrusadeRewardNumber>
            <Exposed/>
            <Arg>   UINT16   </Arg>
        </useItemToIncreaseCrusadeRewardNumber>

        <useCoinToIncreaseCrusadeRewardNumber>
            <Exposed/>
            <Arg>   UINT8   </Arg>
        </useCoinToIncreaseCrusadeRewardNumber>

        <onUseItemToIncreaseCrusadeRewardNumber>
            <Arg>   ITEM_ID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PYTHON      </Arg>
        </onUseItemToIncreaseCrusadeRewardNumber>

        <onEnterCrusadeDungeon>
            <Arg>           UUID                </Arg>
            <Arg>           SPACE_NO            </Arg>
            <Arg>           DUNGEON_NO          </Arg>
            <Arg>           MAILBOX             </Arg>
            <Arg>           PYTHON              </Arg>
        </onEnterCrusadeDungeon>

    </BaseMethods>

    <ClientMethods>
        <onTeammateConfirmCrusade>
            <Arg>   DUNGEON_NO      </Arg>
            <Arg>   LEVEL   </Arg>
        </onTeammateConfirmCrusade>
    </ClientMethods>

</root>

