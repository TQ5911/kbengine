<root>
    <Properties>
        <staticSpaces>
            <Type>      PY_DICT         </Type>
            <Flags>     BASE            </Flags>
        </staticSpaces>

        <loadWaitSet>
            <Type>      PYTHON          </Type>
            <Flags>     BASE            </Flags>
        </loadWaitSet>

        <doNextFlag>
            <Type>          UINT8           </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </doNextFlag>

        <deadApps>
            <Type>          PY_LIST         </Type>
            <Flags>         BASE            </Flags>
        </deadApps>

        <relivedCellapps>
            <Type>          PY_LIST         </Type>
            <Flags>         BASE            </Flags>
        </relivedCellapps>

        <missedSpaces>
            <Type>          PY_DICT         </Type>
            <Flags>         BASE            </Flags>
        </missedSpaces>
    </Properties>

    <BaseMethods>
        <broadcastAllSpaceMgrByTypes>
            <Arg>       PYTHON          </Arg>
            <Arg>       STRING          </Arg>
            <Arg>       PYTHON          </Arg>
        </broadcastAllSpaceMgrByTypes>

        <onCellappRelive>
            <Arg>       UINT8         </Arg>
        </onCellappRelive>

        <onStaticSpaceReady>
            <Arg>       SPACE_NO        </Arg>
        </onStaticSpaceReady>

        <onSpaceMgrReady>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       ENTITYCALL      </Arg>
        </onSpaceMgrReady>

        <onLoadGroupEntities>
            <Arg>       PY_DICT       </Arg>
        </onLoadGroupEntities>

        <onRefreshGroupEntities>
            <Arg>       PY_DICT       </Arg>
        </onRefreshGroupEntities>

        <onDestroyGroupEntities>
            <Arg>       PY_DICT       </Arg>
        </onDestroyGroupEntities>

        <onLoadEntitiesEnd>
            <Arg>       SPACE_NO        </Arg>
        </onLoadEntitiesEnd>

        <onSpaceCellAppDeath>
            <Arg>       SPACE_NO        </Arg>
        </onSpaceCellAppDeath>

        <handleCellappDeath>
            <Arg>       UINT8         </Arg>
        </handleCellappDeath>
    </BaseMethods>
</root>
