    <ClientMethods>
        <sendTeamStatisticData>
            <Arg>           UINT8          </Arg>
            <Arg>  ARRAY <of> TEAM_STATISTIC_PLAYER_VAL </of>   </Arg>
        </sendTeamStatisticData>
