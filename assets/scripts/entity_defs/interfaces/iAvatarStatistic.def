<?xml version="1.0" encoding="utf-8"?>
<root>
    <Properties>
    </Properties>

    <BaseMethods>
    </BaseMethods>

    <CellMethods>
        <reqGetTeamStatisticData> <Exposed/>
            <Arg>           UINT8          </Arg>
        </reqGetTeamStatisticData>
        <reqClearTeamStatisticData> <Exposed/>
        </reqClearTeamStatisticData>
        <onGetTeamStatisticData>
            <Arg>           UINT8          </Arg>
            <Arg>           UNICODE          </Arg>
