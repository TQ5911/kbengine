<root>
    <Properties>
    </Properties>

    <BaseMethods>
        <reqBindPhone> <Exposed/>
            <Arg>   UINT64            </Arg>
            <Arg>   UNICODE           </Arg>
        </reqBindPhone>

        <reqVerifyCode> <Exposed/>
            <Arg>   STRING           </Arg>
        </reqVerifyCode>

        <reqClaimPcLoginReward> <Exposed/>
        </reqClaimPcLoginReward>

        <reqQueryRecharge> <Exposed/>
        </reqQueryRecharge>

        <reqGetRechargeStageReward> <Exposed/>
            <Arg>   UINT8           </Arg>
            <Arg>   UINT32          </Arg>
        </reqGetRechargeStageReward>
    </BaseMethods>

    <ClientMethods>
        <bindPhoneReplay>
            <Arg>   BOOL                </Arg>
            <Arg>   UINT64              </Arg>
        </bindPhoneReplay>

        <claimPcLoginRewardInfo>
            <Arg>   UINT64              </Arg>
            <Arg>   UINT64              </Arg>
        </claimPcLoginRewardInfo>

        <queryRechargeAmountReplay>
            <Arg>   FLOAT               </Arg>
        </queryRechargeAmountReplay>

        <rechargeStageRewardInfo>
            <Arg>   ARRAY   <of>    UINT32  </of>   </Arg>
        </rechargeStageRewardInfo>
    </ClientMethods>
</root>