<root>
    <Properties>
        <storeData>
            <Type>          STORE_DATA_VAL        </Type>
            <Flags>         BASE             </Flags>
            <Persistent>    true             </Persistent>
        </storeData>

        <limitStoreRefreshDict>
            <Type>          PY_DICT          </Type>
            <Flags>         BASE             </Flags>
            <Persistent>    true             </Persistent>
        </limitStoreRefreshDict>
    </Properties>


    <BaseMethods>
        <reqGetStoreList><Exposed/>
            <Arg>   ARRAY <of> STOREID </of>  </Arg>
        </reqGetStoreList>

        <reqGetStoreLimitedItemList><Exposed/>
            <Arg>   STOREID  </Arg>
        </reqGetStoreLimitedItemList>

        <reqBuyItemsInStore><Exposed/>
            <Arg>       STOREID     </Arg>
            <Arg>       ITEMID      </Arg>
            <Arg>       UINT32      </Arg>
        </reqBuyItemsInStore>

        <reqBuyItemsInStoreWithSelection><Exposed/>
            <Arg>       STOREID     </Arg>
            <Arg>       ITEMID      </Arg>
            <Arg>       UINT32      </Arg>
            <Arg>       UINT8       </Arg>
        </reqBuyItemsInStoreWithSelection>

        <makeMallFlowLog>
            <Arg>       UINT64         </Arg>
            <Arg>       STOREID      </Arg>
            <Arg>       ITEM_ID      </Arg>
            <Arg>       UINT32       </Arg>
            <Arg>       ITEM_ID      </Arg>
            <Arg>       UINT32       </Arg>
        </makeMallFlowLog>
    </BaseMethods>


    <ClientMethods>
        <onGetStoreList>
            <Arg>   ARRAY <of> CLIENT_STORE_VAL </of>  </Arg>
        </onGetStoreList>

        <onGetStoreLimitedItemList>
            <Arg>       CLIENT_STORE_VAL    </Arg>
            <Arg>       LONGTIME            </Arg>
        </onGetStoreLimitedItemList>

        <onBuyStoreItems>
            <Arg>       STOREID     </Arg>
            <Arg>       ITEMID      </Arg>
            <Arg>       UINT32      </Arg>
            <Arg>       INT32       </Arg>
        </onBuyStoreItems>
    </ClientMethods>
</root>

