<root>
    <Properties>
        <raidProcessLock>
            <Type>      LONGTIME        </Type>
            <Flags>     CELL_PRIVATE    </Flags>
        </raidProcessLock>

        <raidInfo>
            <Type>      PLAYER_RAID_CACHE_VAL       </Type>
            <Flags>     CELL_PRIVATE    </Flags>
        </raidInfo>

        <raidId>
            <Type>      RAID_ID         </Type>
            <Flags>     ALL_CLIENTS     </Flags>
            <Persistent>    true            </Persistent>
            <WitnessName>   true            </WitnessName>
        </raidId>

        <raidUUIDBase>
            <Type>      RAID_ID         </Type>
            <Flags>     BASE           </Flags>
        </raidUUIDBase>

        <raidAuth>
            <Type>      UINT8         </Type>
            <Flags>     ALL_CLIENTS     </Flags>
        </raidAuth>

        <autoRaidMatchStartTime>
            <Type>          LONGTIME        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </autoRaidMatchStartTime>

        <autoRaidMatchTarget>
            <Type>          TEAMTARGET      </Type>
            <Flags>         OWN_CLIENT      </Flags>
            <Default>       0               </Default>
        </autoRaidMatchTarget>
    </Properties>

    <BaseMethods>
        <switchRaidMicsModeBase>
            <Arg>           TEAMID          </Arg>
            <Arg>           UINT8           </Arg>
        </switchRaidMicsModeBase>

        <turnOnRaidMicsBase>
            <Arg>           TEAMID          </Arg>
        </turnOnRaidMicsBase>

        <onRaidChanged>
            <Arg>           RAID_ID          </Arg>
        </onRaidChanged>
    </BaseMethods>

    <CellMethods>

        <!--获得团队申请记录-->
        <getRaidApplyJoinDic>
            <Exposed/>
        </getRaidApplyJoinDic>

        <!--手动清除所有团队申请记录-->
        <clearRaidApplyJoinDic>
            <Exposed/>
        </clearRaidApplyJoinDic>

        <onJoinListPlayerClearRaidApplyJoinDic>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   TEAMID      </Arg>
        </onJoinListPlayerClearRaidApplyJoinDic>

        <onClearRaidJoinRecords>
            <Arg>   PY_LIST     </Arg>
        </onClearRaidJoinRecords>

        <!--获取服务端团队成员属性缓存-->
        <getRaidAllMembersAttrs>
            <Exposed/>
            <Arg>   AVATARGBID_LIST     </Arg>
        </getRaidAllMembersAttrs>

        <!--个人创建团队-->
        <createRaidLonely>
            <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           BOOL            </Arg>
        </createRaidLonely>

        <!--当前队伍创建团队-->
        <createRaidWithTeam>
            <Exposed/>
            <Arg>   UINT8   </Arg>
        </createRaidWithTeam>

        <!--解散团队-->
        <disbandRaid>
            <Exposed/>
        </disbandRaid>

        <!--团长设置团队目标-->
        <setRaidTarget>
            <Exposed/>
            <Arg>  UINT32       </Arg>
            <Arg>  UINT32       </Arg>
            <Arg>  UNICODE      </Arg>
            <Arg>  STRING       </Arg>
            <Arg>  BOOL         </Arg>
        </setRaidTarget>

        <onSetRaidTargetAllMemberNotify>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   STRING          </Arg>
            <Arg>   STRING          </Arg>
            <Arg>   BOOL            </Arg>
        </onSetRaidTargetAllMemberNotify>

        <!--个人申请加入团队-->
        <applyJoinRaidLonely>
            <Exposed/>
            <Arg>   RAID_ID     </Arg>
            <Arg>   STRING      </Arg>
        </applyJoinRaidLonely>

        <onApplyJoinRaidLonelySucc>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PYTHON          </Arg>
        </onApplyJoinRaidLonelySucc>

        <onLeaderProcessApplyJoinRaidLonely>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_APPLY_JOIN_CLIENT_VAL     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onLeaderProcessApplyJoinRaidLonely>

        <!--组队申请加入团队-->
        <applyJoinRaidWithTeam>
            <Exposed/>
            <Arg>   RAID_ID     </Arg>
        </applyJoinRaidWithTeam>

        <onApplyJoinRaidWithTeamSucc>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onApplyJoinRaidWithTeamSucc>

        <onLeaderProcessApplyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_APPLY_JOIN_CLIENT_VAL     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onLeaderProcessApplyJoinRaidWithTeam>

        <!--团队回应加入团队申请-->
        <replyJoinRaid>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>  <!--对于个人申请, 是个人ID, 对于组队申请, 这里是队长ID-->
            <Arg>   BOOL        </Arg>
        </replyJoinRaid>

        <onJoinPlayerReplyJoinRaidLonely>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   PYTHON  </Arg>
        </onJoinPlayerReplyJoinRaidLonely>

        <onJoinPlayerReplyJoinRaidWithTeam>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   PYTHON      </Arg>
        </onJoinPlayerReplyJoinRaidWithTeam>

        <onJoinPlayerHandleReplyJoinRaidReject>
            <Arg>   RAID_ID     </Arg>
        </onJoinPlayerHandleReplyJoinRaidReject>

        <onJoinPlayerHandleReplyJoinRaidAccept>
            <Arg>   RAID_ID     </Arg>
        </onJoinPlayerHandleReplyJoinRaidAccept>

        <onCancelRaidJoinRequestSucc>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </onCancelRaidJoinRequestSucc>

        <!--团长/队长/队员 尝试邀请他人(AOI)入团-->
        <tryApplyInviteRaid>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE         </Arg>  <!--被邀请玩家姓名-->
        </tryApplyInviteRaid>

        <tryBeInvitedInRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PYTHON      </Arg>
        </tryBeInvitedInRaid>

        <tryApplyInviteRaidOffline>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE         </Arg>
        </tryApplyInviteRaidOffline>

        <!--团长/队长/队员 邀请其他单人入团-->
        <applyInviteRaidLonely>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE         </Arg>  <!--被邀请玩家姓名-->
        </applyInviteRaidLonely>

        <!--团长/队长/队员 邀请小队入团-->
        <applyInviteRaidWithTeam>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   UNICODE         </Arg>  <!--被邀请玩家姓名-->
        </applyInviteRaidWithTeam>

        <invitedPlayerOnApplyInvitedRaid>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE         </Arg>
            <Arg>   UNICODE         </Arg>
            <Arg>   PYTHON          </Arg>
        </invitedPlayerOnApplyInvitedRaid>

        <onReplyInviteRaidLonelyWithLonely>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT         </Arg>
        </onReplyInviteRaidLonelyWithLonely>

        <!--玩家回应单独邀请-->
        <replyInviteRaidLonely>
            <Exposed/>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UUID        </Arg>      <!--邀请记录ID, 服务端会发给客户端-->
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   BOOL        </Arg>
        </replyInviteRaidLonely>

        <!--玩家回应组队邀请-->
        <replyInviteRaidWithTeam>
            <Exposed/>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UUID        </Arg>      <!--邀请记录ID, 服务端会发给客户端-->
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   BOOL        </Arg>
        </replyInviteRaidWithTeam>

        <tryReplyInviteRaidFollowTeamCaptain>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </tryReplyInviteRaidFollowTeamCaptain>

        <!--任意团员离开团队-->
        <leaveRaid>
            <Exposed/>
        </leaveRaid>

        <onLeaveRaid>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onLeaveRaid>

        <!--团长/队长踢出成员-->
        <kickOutRaidMember>
            <Exposed/>
            <Arg>   UINT8   </Arg>          <!--团队中小队编号-->
            <Arg>   PLAYER_GBID     </Arg>
        </kickOutRaidMember>

        <onRaidLeaderKickOutRaidMember>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onRaidLeaderKickOutRaidMember>

        <onRaidDeputyKickOutRaidMember>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onRaidDeputyKickOutRaidMember>

        <onBeKickedOutRaidByRaidLeader>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON  </Arg>
        </onBeKickedOutRaidByRaidLeader>

        <onBeKickedOutRaidByRaidDeputy>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON  </Arg>
        </onBeKickedOutRaidByRaidDeputy>
        
        <onRaidTeamCaptainKickOutRaidMember>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onRaidTeamCaptainKickOutRaidMember>

        <onBeKickedOutRaidByRaidTeamCaptain>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON  </Arg>
        </onBeKickedOutRaidByRaidTeamCaptain>

        <!--团长转移团长-->
        <transferRaidLeader>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </transferRaidLeader>

        <transferRaidDeputy>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </transferRaidDeputy>

        <onTransferRaidLeaderAllMemberNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </onTransferRaidLeaderAllMemberNotify>

        <onTransferRaidDeputyAllMemberNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </onTransferRaidDeputyAllMemberNotify>

        <!--小队长队内移交队长-->
        <transferRaidTeamCaptain>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </transferRaidTeamCaptain>

        <onTransferRaidTeamCaptainAllMemberNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onTransferRaidTeamCaptainAllMemberNotify>

        <!--团长任命小队队长(除自己所在小队)-->
        <awardRaidTeamCaptain>
            <Exposed/>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </awardRaidTeamCaptain>

        <onAwardRaidTeamCaptainAllMemberNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>  <!-- 来源玩家GBID(应该是团长GBID)-->
            <Arg>   PLAYER_GBID     </Arg>  <!-- 被替换队长GBID-->
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>  <!--授予队长GBID-->
            <Arg>   PYTHON      </Arg>
        </onAwardRaidTeamCaptainAllMemberNotify>

        <!--移动(或交换)队伍成员-->
        <moveRaidTeamMember>
            <!--A 和 B 进行交换, 如果B的playerGBID为0, 则将A转移至B小队中的空位-->
            <Exposed/>
            <!--A-->
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <!--B-->
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </moveRaidTeamMember>

        <onMoveRaidTeamMemberSucc>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </onMoveRaidTeamMemberSucc>

        <!--团长发起全团检查-->
        <startRaidStandbyChecker>
            <Exposed/>
        </startRaidStandbyChecker>

        <!--团员回应全团检查-->
        <replyRaidStandbyChecker>
            <Exposed/>
            <Arg>   RAID_ID     </Arg>
            <Arg>   BOOL        </Arg>
        </replyRaidStandbyChecker>

        <onRefreshPlayerRaidCacheVal>
            <Arg>   PLAYER_RAID_CACHE_VAL    </Arg>
        </onRefreshPlayerRaidCacheVal>

        <onRefreshPlayerRaidMemberCacheVal>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   BOOL    </Arg>
        </onRefreshPlayerRaidMemberCacheVal>

        <!-- 开启团队麦功能 -->
        <switchRaidMicsMode>
            <Exposed/>
            <Arg> UINT8 </Arg>
        </switchRaidMicsMode>

        <!-- 团队成员打开麦克风 -->
        <turnOnRaidMics>
            <Exposed/>
        </turnOnRaidMics>

        <!-- 团队成员关闭麦克风 -->
        <turnOffRaidMics>
            <Exposed/>
        </turnOffRaidMics>

        <turnOnRaidMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </turnOnRaidMemberMics>

        <turnOffRaidMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </turnOffRaidMemberMics>

        <!-- 团长禁言团员 -->
        <blockRaidMemberMics>
            <Exposed/>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </blockRaidMemberMics>

        <!-- 团长解除团员禁言 -->
        <unblockRaidMemberMics>
            <Exposed/>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </unblockRaidMemberMics>

        <blockAllRaidMemberMics>
            <Exposed/>
        </blockAllRaidMemberMics>

        <unblockAllRaidMemberMics>
            <Exposed/>
        </unblockAllRaidMemberMics>

        <turnOffRaidMicsByForbidVoiceChat>
        </turnOffRaidMicsByForbidVoiceChat>
        
        <reqRaidPlayerAutoMatch>
            <Exposed/>
            <Arg>           TEAMTARGET       </Arg>
        </reqRaidPlayerAutoMatch>
        
        <reqRaidPlayerStopAutoMatch>
            <Exposed/>
        </reqRaidPlayerStopAutoMatch>
        
        <reqRaidAutoMatch>
            <Exposed/>
        </reqRaidAutoMatch>
        
        <reqRaidStopAutoMatch>
            <Exposed/>
        </reqRaidStopAutoMatch>

        <onMemJoinRaidByAutoMatch>
            <Arg>           PLAYER_GBID         </Arg>
        </onMemJoinRaidByAutoMatch>

        <onCellRaidPlayerStartAutoMatch>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
        </onCellRaidPlayerStartAutoMatch>

        <onCellRaidPlayerMatchedSucc>
        </onCellRaidPlayerMatchedSucc>

        <onCellRaidPlayerAutoMatchTimeout>
        </onCellRaidPlayerAutoMatchTimeout>        
        <onGetRaidListFinished>
            <Arg>           UINT32          </Arg>
            <Arg>           TEAMTARGET           </Arg>
        </onGetRaidListFinished>

        <reqGetRaidList><Exposed/>
            <Arg>           LONGTIME           </Arg>
            <Arg>           TEAMTARGET              </Arg>
        </reqGetRaidList>

        <onPlayerMatchedRaid>
            <Arg>           TEAMID           </Arg>
        </onPlayerMatchedRaid>

        <reqAddRaidMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITY_ID           </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </reqAddRaidMarkMember>
        <reqDelRaidMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
        </reqDelRaidMarkMember>
        <reqChangeRaidOnlyLeader> <Exposed/>
            <Arg>           BOOL            </Arg>
        </reqChangeRaidOnlyLeader>

        <reqJoinRaid> <Exposed/>
            <Arg> RAID_ID </Arg>
            <Arg> STRING  </Arg>
        </reqJoinRaid>

        <addRaidDungeonRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </addRaidDungeonRewardRecord>
    </CellMethods>

    <ClientMethods>

        <!--客户端获得当前申请列表回调-->
        <onGetRaidApplyJoinList>
            <Arg>   RAID_ID     </Arg>
            <Arg>   ARRAY  <of>     RAID_APPLY_JOIN_CLIENT_VAL  </of>   </Arg>
        </onGetRaidApplyJoinList>

        <!--客户端获取全量团队数据时调用-->
        <onGetRaidData>
            <Arg>   RAID_CLIENT_VAL     </Arg>
        </onGetRaidData>

        <!--客戶端清理团队数据时调用-->
        <onClearRaidData>
        </onClearRaidData>

        <!--创建团队后调用, 推送全量数据-->
        <onCreateRaid>
            <Arg>   RAID_CLIENT_VAL     </Arg>
        </onCreateRaid>

        <!--解散团队后调用-->
        <onDisbandRaid>
            <Arg>   RAID_ID     </Arg>
        </onDisbandRaid>

        <!--玩家退出登录后调用-->
        <onRaidAvatarOffline>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>  <!--团队小队编号-->
            <Arg>   PLAYER_GBID     </Arg>
        </onRaidAvatarOffline>

        <!--玩家重新登录后调用-->
        <onRaidAvatarLogin>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>  <!--团队小队编号-->
            <Arg>   PLAYER_GBID     </Arg>
        </onRaidAvatarLogin>

        <!--添加新成员后调用-->
        <onAddNewRaidMember>
            <Arg>   RAID_ID    </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   CLIENT_TEAM_MEMBER_VAL      </Arg>
        </onAddNewRaidMember>

        <!--设置新队长后调用-->
        <onSetRaidTeamCaptain>
            <Arg>   RAID_ID    </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onSetRaidTeamCaptain>

        <!--设置新团长后调用-->
        <onSetRaidLeader>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onSetRaidLeader>

        <onSetRaidDeputy>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onSetRaidDeputy>

        <!--有团队成员被移除后调用-->
        <onPopRaidTeamMember>
            <Arg>   RAID_ID    </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onPopRaidTeamMember>

        <!--团队成员相互转移后调用-->
        <onExchangeRaidTeamMember>
            <!--相互转移规则: A ~~ B -->
            <Arg>   RAID_ID     </Arg>
            <!--A-->
            <Arg>   UINT8  </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <!--B-->
            <Arg>   UINT8  </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onExchangeRaidTeamMember>

        <!--入团相关: START-->

        <!--清除所有入团申请后客户端回调-->
        <onClearRaidApplyJoinDic>
            <Arg>   RAID_ID     </Arg>
        </onClearRaidApplyJoinDic>

        <!--特定入团申请完成后客户端回调-->
        <onDelRaidApplyJoinRecord>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onDelRaidApplyJoinRecord>

        <!--申请入团后团长客户端回调-->
        <beNotifiedApplyJoinRaid>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_APPLY_JOIN_CLIENT_VAL  </Arg>
        </beNotifiedApplyJoinRaid>

        <!-- 尝试邀请玩家入团成功后客户端回调(一般用于弹窗) -->
        <onTryBeInvitedInRaid>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   UNICODE         </Arg>
            <Arg>   BOOL            </Arg>
        </onTryBeInvitedInRaid>

        <!--团长邀请入团后被邀请者(玩家/队长)回调-->
        <onBeInvitedRaidByLeader>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UUID            </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   PLAYER_GBID     </Arg>      <!--邀请者GBID-->
            <Arg>   UNICODE         </Arg>      <!--邀请者名字-->
            <Arg>   UNICODE         </Arg>      <!--团长名字-->
        </onBeInvitedRaidByLeader>

        <!--副团长邀请入团后被邀请者(玩家/队长)回调-->
        <onBeInvitedRaidByDeputy>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UUID            </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   PLAYER_GBID     </Arg>      <!--邀请者GBID-->
            <Arg>   UNICODE         </Arg>      <!--邀请者名字-->
            <Arg>   UNICODE         </Arg>      <!--团长名字-->
        </onBeInvitedRaidByDeputy>

        <!--队长邀请入团后被邀请者(玩家)回调-->
        <onBeInvitedRaidByTeamCaptain>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UUID            </Arg>
            <Arg>   PLAYER_GBID     </Arg>      <!--邀请者GBID-->
            <Arg>   UNICODE         </Arg>      <!--邀请者名字-->
            <Arg>   UNICODE         </Arg>      <!--团长名字-->
            <Arg>   UINT8           </Arg>
        </onBeInvitedRaidByTeamCaptain>

        <!--团员提议邀请入团后被邀请者(玩家/队长)回调-->
        <onBeInvitedRaidByMember>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UUID            </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   PLAYER_GBID     </Arg>      <!--邀请者GBID-->
            <Arg>   UNICODE         </Arg>      <!--邀请者名字-->
            <Arg>   UNICODE         </Arg>      <!--团长名字-->
        </onBeInvitedRaidByMember>

        <!--入团相关: END-->

        <!--客户端获取团队成员信息后回调-->
        <onGetRaidAllMembersAttrs>
            <Arg>   RAID_ID     </Arg>
            <Arg>   ARRAY   <of>    CLIENT_TEAM_MEMBER_VAL      </of>   </Arg>
        </onGetRaidAllMembersAttrs>

        <!--客户端设置新团队目标后回调-->
        <onSetRaidTarget>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMTARGET  </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   BOOL        </Arg>
        </onSetRaidTarget>

        <!--团长发起全团check后客户端回调-->
        <raidStandbyCheckNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UNICODE     </Arg>  <!--json格式, {playerGBID_1: true/false/null(确认/拒绝/未反馈)}-->
        </raidStandbyCheckNotify>

        <!--进入团队副本时发起全团check后客户端回调-->
        <raidEnterDungeonStandbyCheckNotify>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   UNICODE     </Arg>  <!--json格式, {playerGBID_1: true/false/null(确认/拒绝/未反馈)}-->
        </raidEnterDungeonStandbyCheckNotify>

        <!--使客户端更新此团员的check情况-->
        <onUpdateStandbyCheckData>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   BOOL        </Arg>
        </onUpdateStandbyCheckData>

        <!--最终检查情况, 全团广播, 客户端回调-->
        <onReplyRaidStandbyChecker>
            <Arg>   RAID_ID     </Arg>
            <Arg>   BOOL    </Arg>
        </onReplyRaidStandbyChecker>

        <onReplyRaidStandbyCheckerBeforeEnterDungeon>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   BOOL    </Arg>
        </onReplyRaidStandbyCheckerBeforeEnterDungeon>

        <onSwitchRaidMicsMode>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT8       </Arg>
        </onSwitchRaidMicsMode>

        <onSyncAllRaidMemberMiscStatus>
            <Arg>   RAID_ID     </Arg>
            <!-- on -->
            <Arg>   AVATARGBID_LIST     </Arg>
            <!-- off -->
            <Arg>   AVATARGBID_LIST     </Arg>
            <!-- block -->
            <Arg>   AVATARGBID_LIST     </Arg>
        </onSyncAllRaidMemberMiscStatus>

        <onTurnOnRaidMemberMics>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onTurnOnRaidMemberMics>

        <onTurnOffRaidMemberMics>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <!-- 是否因团长禁言被闭麦 -->
            <Arg>   BOOL        </Arg>
        </onTurnOffRaidMemberMics>

        <onUnblockRaidMemberMisc>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onUnblockRaidMemberMisc>

        <onBlockAllRaidMemberMics>
            <Arg>   PLAYER_GBID      </Arg>
            <Arg>   RAID_ID     </Arg>
        </onBlockAllRaidMemberMics>

        <onUnblockAllRaidMemberMics>
            <Arg>   PLAYER_GBID      </Arg>
            <Arg>   RAID_ID     </Arg>
        </onUnblockAllRaidMemberMics>

        <onRaidStopAutoMatch>
        </onRaidStopAutoMatch>

        <onRaidStartAutoMatch>
            <Arg>           LONGTIME           </Arg>
        </onRaidStartAutoMatch>

        <onRaidPlayerStartAutoMatch>
        </onRaidPlayerStartAutoMatch>

        <onRaidPlayerStopAutoMatch>
        </onRaidPlayerStopAutoMatch>

        <onGetRaidList>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
            <Arg>      ARRAY <of> RAID_CLIENT_VAL  </of>      </Arg>
        </onGetRaidList>
        <onGetAllRaidList>
            <Arg>           TEAMTARGET       </Arg>
        </onGetAllRaidList>

        <onChangeRaidMark>
            <Arg>           CLIENT_TEAM_MARK_INFO           </Arg>
        </onChangeRaidMark>

        <onJoinRaid>
            <Arg>   ERRNO       </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   STRING      </Arg> 
        </onJoinRaid>

        <onUpdateRaidMemberPos>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </onUpdateRaidMemberPos>

        <onUpdateRaidMemberScore>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UINT32          </Arg>
        </onUpdateRaidMemberScore>

        <onUpdateRaidMemberHP>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
        </onUpdateRaidMemberHP>

        <onUpdateRaidMemberLevel>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UINT32          </Arg>
        </onUpdateRaidMemberLevel>

        <onAddRaidDungeonRewardRecord>
            <Arg>           RAID_ID                                                 </Arg>
            <Arg>           PLAYER_GBID                                             </Arg>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onAddRaidDungeonRewardRecord>

        <onApplyJoinRaidLonelyFailed>
            <Arg>           UINT16       </Arg>
            <Arg>           RAID_ID       </Arg>
            <Arg>           UINT16       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           STRING       </Arg>
        </onApplyJoinRaidLonelyFailed>
    </ClientMethods>

</root>

