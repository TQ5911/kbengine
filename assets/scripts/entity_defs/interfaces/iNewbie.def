<root>
    <Properties>
        <newbieStep>
            <Type>          NEW_BIE_STEP            </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </newbieStep>

        <newbieGuideIds>
            <Type>          ARRAY   <of>    OBJECT_ID   </of>  </Type>
            <Flags>         BASE_AND_CLIENT         </Flags>
            <Persistent>    true                    </Persistent>
        </newbieGuideIds>

        <newbieGuideVals>
            <Type>          ARRAY   <of>    UINT8       </of>  </Type>
            <Flags>         BASE_AND_CLIENT         </Flags>
            <Persistent>    true                    </Persistent>
        </newbieGuideVals>

        <growthGuideRewards>
            <Type>          BIG_BIT_DATA_INFO       </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </growthGuideRewards>
    </Properties>

    <BaseMethods>
        <onNewbieDungeonReady>
            <Arg>           MAILBOX                 </Arg>
            <Arg>           MAILBOX                 </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg>
        </onNewbieDungeonReady>

        <setNewbieGuideId> <Exposed/>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           UINT8                   </Arg>
        </setNewbieGuideId>

        <takeGrowthGuideRewards> <Exposed/>
            <Arg>           ARRAY   <of>    UINT32  </of>   </Arg>
        </takeGrowthGuideRewards>
    </BaseMethods>

    <CellMethods>
        <onNewbieStepModify>
            <Arg>       NEW_BIE_STEP       </Arg>
        </onNewbieStepModify>

        <destroyFromNewbieDungeon>
            <Arg>       DUNGEON_NO       </Arg>
        </destroyFromNewbieDungeon>
    </CellMethods>

    <ClientMethods>
        <onNewbieGuideId>
            <Arg>       OBJECT_ID       </Arg>
            <Arg>       UINT8           </Arg>
        </onNewbieGuideId>

        <onGrowthGuideRewards>
            <Arg>           BIG_DATA_CLIENT         </Arg>
        </onGrowthGuideRewards>
    </ClientMethods>
</root>
