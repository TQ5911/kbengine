<?xml version="1.0" encoding="utf-8"?>
<root>
    <Properties>
        <sendWorldMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendWorldMsgTime>

        <sendPaidMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendPaidMsgTime>

        <sendSiegeWarMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendSiegeWarMsgTime>

        <sendGuildMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendGuildMsgTime>

        <sendTeamMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendTeamMsgTime>

        <sendNearbyMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendNearbyMsgTime>

        <sendRaidMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendRaidMsgTime>

        <sendMatchTeamGuildMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendMatchTeamGuildMsgTime>

        <sendMatchTeamRecruitMsgTime>
            <Type>          LONGTIME        </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </sendMatchTeamRecruitMsgTime>

        <chatChannel>
            <Type>          CHAT_CHANNEL    </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Persistent>    true            </Persistent>
        </chatChannel>

        <silentSpeakState>
            <Type>          UINT8    </Type>
            <Flags>         BASE     </Flags>
            <Default>       0        </Default>
            <Persistent>    true            </Persistent>
        </silentSpeakState>

        <silentSpeakTime>
            <Type>          LONGTIME    </Type>
            <Flags>         BASE     </Flags>
            <Default>       0        </Default>
            <Persistent>    true            </Persistent>
        </silentSpeakTime>

        <silentFriendSpeakTime>
            <Type>          LONGTIME    </Type>
            <Flags>         BASE     </Flags>
            <Default>       0        </Default>
            <Persistent>    true            </Persistent>
        </silentFriendSpeakTime>
    </Properties>

    <BaseMethods>
        <setChatChannel> <Exposed/>
            <Arg>          CHAT_CHANNEL     </Arg>
        </setChatChannel>

        <removeChatChannel> <Exposed/>
            <Arg>          CHAT_CHANNEL     </Arg>
        </removeChatChannel>

        <sendWorldChatMsg> <Exposed/>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendWorldChatMsg>

        <sendPaidChatMsg> <Exposed/>
            <Arg>           INT32                 </Arg>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendPaidChatMsg>

        <sendSiegeWarChatMsg> <Exposed/>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendSiegeWarChatMsg>

        <sendGuildChatMsg> <Exposed/>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendGuildChatMsg>

        <sendGuildPickChatMsg>
            <Arg>           UINT8         </Arg>
        </sendGuildPickChatMsg>

        <sendTeamChatMsg> <Exposed/>
            <Arg>           TEAMID          </Arg>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendTeamChatMsg>

        <sendNearbyChatMsg> <Exposed/>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendNearbyChatMsg>

        <sendRaidChatMsg>    <Exposed/>
            <Arg>           RAID_ID         </Arg>
            <Arg>           CHAT_MSG_DATA         </Arg>
        </sendRaidChatMsg>

        <queryItemLink> <Exposed/>
            <Arg>           UINT64              </Arg>
            <Arg>           ITEM_ID             </Arg>
            <Arg>           PLAYER_GBID         </Arg>
        </queryItemLink>

        <onFindLinkItemOwnerFail>
            <Arg>           ARRAY <of>  PLAYER_GBID     </of>         </Arg>
        </onFindLinkItemOwnerFail>

        <queryPlayerLink> <Exposed/>
            <Arg>           PLAYER_GBID      </Arg>
        </queryPlayerLink>

        <handleQueryPlayerLink>
            <Arg>           MAILBOX          </Arg>
        </handleQueryPlayerLink>

        <sendTeamMatchMessage> <Exposed/>
            <Arg>           TEAMID      </Arg>
            <Arg>           UNICODE     </Arg>
            <Arg>           UINT32      </Arg>
            <Arg>           UINT32      </Arg>
            <Arg>           UINT32      </Arg>
        </sendTeamMatchMessage>

        <sendRaidMatchMessage> <Exposed/>
            <Arg>           TEAMID      </Arg>
            <Arg>           UNICODE     </Arg>
            <Arg>           UINT32      </Arg>
            <Arg>           UINT32      </Arg>
            <Arg>           UINT32      </Arg>
        </sendRaidMatchMessage>

        <registerItemLink> <Exposed/>
            <Arg>           ARRAY <of>  ITEM_ID </of>          </Arg>
            <Arg>           ARRAY <of>  UINT64 </of>           </Arg>
        </registerItemLink>

        <onRecvChannelMsg>
            <Arg>           CHAT_CHANNEL                </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>           CHAT_MSG_DATA               </Arg>
        </onRecvChannelMsg>
    </BaseMethods>

    <CellMethods>
        <handleAvatarChannelMsg>
            <Arg>           CHAT_CHANNEL                </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>           CHAT_MSG_DATA               </Arg>
        </handleAvatarChannelMsg>
        <handleTeamChannelMatchTeamMsg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>           INT8                        </Arg>
            <Arg>           UNICODE                     </Arg>
        </handleTeamChannelMatchTeamMsg>
    </CellMethods>

    <ClientMethods>
        <onRecvAvatarChannelMsg>
            <Arg>           CHAT_CHANNEL                </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>           CHAT_MSG_DATA               </Arg>
        </onRecvAvatarChannelMsg>

        <onQueryItemLink>
            <Arg>           UINT64          </Arg>
            <Arg>           ITEM_VAL        </Arg>
        </onQueryItemLink>

        <onEventTips>
            <Arg>           INT32                       </Arg>
            <Arg>           ARRAY <of> UNICODE </of>    </Arg>
        </onEventTips>

        <onQueryPlayerLink>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
        </onQueryPlayerLink>
        <onAuctionSaleChatting>
            <Arg>   AUCTION_ITEM_UUID   </Arg>
            <Arg>   ITEM_ID             </Arg>
        </onAuctionSaleChatting>
    </ClientMethods>
</root>
