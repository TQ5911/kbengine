<root>
    <Properties>
        <monthlyLimit>
            <Type>          PY_DICT          </Type>
            <Flags>         BASE             </Flags>
            <Persistent>    true             </Persistent>
            <Default>       {}               </Default>
        </monthlyLimit>
    </Properties>

    <BaseMethods>
        <reqWorkshopMF> <Exposed/>
            <Arg>       ITEM_ID                     </Arg>
            <Arg>       UINT8                       </Arg>
            <Arg>       ARRAY <of> GRIDID </of>     </Arg>
            <Arg>       ARRAY <of> UINT16 </of>     </Arg>
        </reqWorkshopMF>
        <reqWorkshopMonthlyLimit> <Exposed/>
        </reqWorkshopMonthlyLimit>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onWorkshopMF>
            <Arg>  UINT8                                                   </Arg>
            <Arg>  ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
            <Arg>  ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onWorkshopMF>

        <onWorkshopMonthlyLimit>
            <Arg>  ARRAY       <of>        UINT32      </of>   </Arg>
            <Arg>  ARRAY       <of>        UINT16      </of>   </Arg>
        </onWorkshopMonthlyLimit>
    </ClientMethods>
</root>
