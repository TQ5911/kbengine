<root>
    <Properties>
        <dayReleaseRbNum>
            <Type>          INT8                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </dayReleaseRbNum>
        <dayFetchRbNum>
            <Type>          INT8                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </dayFetchRbNum>
        <redbagDayNo>
            <Type>          INT32                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       0                       </Default>
        </redbagDayNo>

        <releaseRedBagDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       {}                       </Default>
        </releaseRedBagDict>

        <fetchRedBagDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       {}                       </Default>
        </fetchRedBagDict>
    </Properties>

    <BaseMethods>
        <getRedBagRankList> <Exposed/>
        </getRedBagRankList>

        <getRedBagMyList> <Exposed/>
        </getRedBagMyList>

        <reqReleaseRedBag> <Exposed/>
            <Arg>           INT8            </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT32           </Arg>
            <Arg>           INT16           </Arg>
            <Arg>           STRING          </Arg>
        </reqReleaseRedBag>

        <onReleaseRedBag>
            <Arg>           INT64           </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           STRING          </Arg>
        </onReleaseRedBag>

        <onReleaseRedBagFail>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
        </onReleaseRedBagFail>

        <reqFetchRedBag> <Exposed/>
            <Arg>           INT64            </Arg>
        </reqFetchRedBag>

        <reqRedBagFetchInfo> <Exposed/>
            <Arg>           INT64            </Arg>
        </reqRedBagFetchInfo>

        <onFetchRedBag>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           RED_BAG_FETCH_CLIENT_VAL            </Arg>
        </onFetchRedBag>

        <markFetchRedBag>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
        </markFetchRedBag>

        <onDelRedBagCache>
            <Arg>           PY_LIST            </Arg>
        </onDelRedBagCache>

    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onGetRedBagRankList>
            <Arg>   ARRAY   <of>    RED_BAG_CLIENT_VAL  </of>        </Arg>
        </onGetRedBagRankList>

        <onGetRedBagMyList>
            <Arg>   ARRAY   <of>    RED_BAG_CLIENT_VAL  </of>        </Arg>
        </onGetRedBagMyList>

        <onShowRedBagInfo>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           RED_BAG_FETCH_CLIENT_VAL            </Arg>
        </onShowRedBagInfo>
    </ClientMethods>
</root>
