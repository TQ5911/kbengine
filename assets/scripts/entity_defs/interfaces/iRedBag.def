<root>
    <Properties>
        <releaseRedBagDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       {}                       </Default>
        </releaseRedBagDict>

        <fetchRedBagDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <Default>       {}                       </Default>
        </fetchRedBagDict>
        <rbVersion>
            <Type>          UINT32                   </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </rbVersion>
    </Properties>

    <BaseMethods>
        <getRedBagRankList> <Exposed/>
        </getRedBagRankList>

        <getRedBagMyList> <Exposed/>
        </getRedBagMyList>

        <reqReleaseRedBag> <Exposed/>
            <Arg>           INT8            </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT32           </Arg>
            <Arg>           INT16           </Arg>
            <Arg>           UNICODE          </Arg>
        </reqReleaseRedBag>

        <onReleaseRedBag>
            <Arg>           INT64           </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           UNICODE          </Arg>
        </onReleaseRedBag>

        <onReleaseRedBagFail>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
        </onReleaseRedBagFail>

        <reqFetchRedBag> <Exposed/>
            <Arg>           INT64            </Arg>
        </reqFetchRedBag>

        <reqRedBagFetchInfo> <Exposed/>
            <Arg>           INT64            </Arg>
        </reqRedBagFetchInfo>

        <onFetchRedBag>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           RED_BAG_FETCH_CLIENT_VAL            </Arg>
        </onFetchRedBag>

        <markFetchRedBag>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
        </markFetchRedBag>

        <onDelRedBagCache>
            <Arg>           PY_LIST            </Arg>
        </onDelRedBagCache>

        <reqRedBagPlayerInfo> <Exposed/>
        </reqRedBagPlayerInfo>

        <getRedBagRankListCB>
            <Arg>           UINT32            </Arg>
            <Arg>   ARRAY   <of>    RED_BAG_CLIENT_VAL  </of>        </Arg>
        </getRedBagRankListCB>

    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onGetRedBagRankList>
            <Arg>   ARRAY   <of>    RED_BAG_CLIENT_VAL  </of>        </Arg>
        </onGetRedBagRankList>

        <onGetRedBagMyList>
            <Arg>   ARRAY   <of>    RED_BAG_CLIENT_VAL  </of>        </Arg>
        </onGetRedBagMyList>

        <onShowRedBagInfo>
            <Arg>           INT64            </Arg>
            <Arg>           INT32            </Arg>
            <Arg>           RED_BAG_FETCH_CLIENT_VAL            </Arg>
        </onShowRedBagInfo>
        <onRedBagPlayerInfo>
            <Arg>           UINT8            </Arg>
            <Arg>           UINT8            </Arg>
        </onRedBagPlayerInfo>
        <onReleaseRedBagMsg>
            <Arg>           UINT64           </Arg>
            <Arg>           UINT8            </Arg>
            <Arg>           UINT8            </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           UNICODE          </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
        </onReleaseRedBagMsg>
    </ClientMethods>
</root>
