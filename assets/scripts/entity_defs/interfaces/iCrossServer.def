<root>
    <Properties>
        <crossServerToSpaceNo>
            <Type>          SPACE_NO                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </crossServerToSpaceNo>

        <crossServerFromSpaceNo>
            <Type>          SPACE_NO                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </crossServerFromSpaceNo>

        <crossServerDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
        </crossServerDict>

        <crossServerState>
            <Type>          UINT8                   </Type>
            <Flags>         BASE_AND_CLIENT         </Flags>
            <Default>       1                       </Default>
        </crossServerState>

        <cellCrossServerState>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       1                       </Default>
        </cellCrossServerState>

        <otherServerAvatarBox>
            <Type>          PYTHON                  </Type>
            <Flags>         BASE                    </Flags>
        </otherServerAvatarBox>

        <crossServerTickStartTime>
            <Type>          OBJECT_ID               </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </crossServerTickStartTime>

        <crossServerTickBackTime>
            <Type>          OBJECT_ID               </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </crossServerTickBackTime>

        <crossServerHeartbeatTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </crossServerHeartbeatTimer>

        <bagFnvHashCheckTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </bagFnvHashCheckTimer>

        <isInLocalServer>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       1                       </Default>
        </isInLocalServer>

        <endCrossServerTimerId>
            <Type>          OBJECT_ID               </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </endCrossServerTimerId>

        <checkCSTokenTimerId>
            <Type>          OBJECT_ID               </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </checkCSTokenTimerId>

        <goBackServerTimerId>
            <Type>          OBJECT_ID               </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </goBackServerTimerId>

        <serverOpenTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </serverOpenTime>
    </Properties>

    <BaseMethods>
        <onCrossServerResp>
            <Arg>           BOOL                    </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UINT16                  </Arg>
        </onCrossServerResp>

        <onReqGetAvatarPorperties>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
        </onReqGetAvatarPorperties>

        <onCrossServerSuc>
            <Arg>           PYTHON                  </Arg>
        </onCrossServerSuc>

        <onCrossServerHeartbeat>
        </onCrossServerHeartbeat>

        <onCrossServerHeartbeatBack>
        </onCrossServerHeartbeatBack>

        <gobackServer>
            <Arg>           UINT8                   </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
        </gobackServer>

        <crossServerCallBack>
            <Arg>           UINT8                   </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </crossServerCallBack>

        <onCrossServerEnd>
            <Arg>           UINT8                   </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
        </onCrossServerEnd>

        <onCrossServerSyncOtherInitedDataFromLocalServer>
            <Arg>           PYTHON                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </onCrossServerSyncOtherInitedDataFromLocalServer>

        <syncMethodCallToCrossClient>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToCrossClient>

        <beSyncMethodCallFromLocalClient>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromLocalClient>

        <syncMethodCallToLocalServerBase>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToLocalServerBase>

        <beSyncMethodCallFromCrossServerBase>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromCrossServerBase>

        <syncMethodCallToCrossServerBase>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToCrossServerBase>

        <beSyncMethodCallFromLocalServerBase>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromLocalServerBase>

        <syncMethodCallToLocalServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToLocalServerCell>

        <syncMethodCallToCrossServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToCrossServerCell>

        <beSyncMethodCallFromCrossServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromCrossServerCell>

        <beSyncMethodCallFromLocalServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromLocalServerCell>

        <onCheckCrossServerTokenResp>
            <Arg>           BOOL                    </Arg>
        </onCheckCrossServerTokenResp>

        <onMessagePre_localCross>
            <Arg>        INT32                        </Arg>
            <Arg>        ARRAY <of> UNICODE </of>     </Arg>
        </onMessagePre_localCross>

        <onPlayerGetExp_localCrossClient>
            <Arg>        BONUS_SRC      </Arg>
            <Arg>        EXP            </Arg>
            <Arg>        EXP            </Arg>
            <Arg>        EXP            </Arg>
        </onPlayerGetExp_localCrossClient>

        <onAvatarLevelUp_localCrossClient>
            <Arg>        LEVEL      </Arg>
            <Arg>        LEVEL      </Arg>
        </onAvatarLevelUp_localCrossClient>
        
        <onAfterSyncLeagueUUID>
            <Arg>        LEAGUE_UUID      </Arg>
            <Arg>        GUILD_UUID       </Arg>
        </onAfterSyncLeagueUUID>
    </BaseMethods>

    <CellMethods>
        <onCrossServerStateChanged>
            <Arg>           UINT8                   </Arg>
        </onCrossServerStateChanged>

        <onCrossServerSuc>
            <Arg>           UINT8                   </Arg>
        </onCrossServerSuc>

        <crossServerSyncOtherInitedDataFromLocalServerCell>
            <Arg>           PYTHON                  </Arg>
        </crossServerSyncOtherInitedDataFromLocalServerCell>

        <onCrossServerSyncOtherInitedDataToCrossServerCell>
            <Arg>           PYTHON                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </onCrossServerSyncOtherInitedDataToCrossServerCell>

        <syncMethodCallToLocalServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToLocalServerCell>

        <syncMethodCallToCrossServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </syncMethodCallToCrossServerCell>

        <beforeReqCrossServer>
            <Arg>           SERVER_ID               </Arg>
            <Arg>           UINT8                   </Arg>
        </beforeReqCrossServer>

        <beSyncMethodCallFromCrossServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromCrossServerCell>

        <beSyncMethodCallFromLocalServerCell>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </beSyncMethodCallFromLocalServerCell>

        <onAllianceWarStarted>
            <Arg>       LEAGUE_ENEMY_ROW_INFO                  </Arg>
        </onAllianceWarStarted>

        <onAllianceWarEnded>
            <Arg>       LEAGUE_ENEMY_END_INFO                  </Arg>
        </onAllianceWarEnded>
    </CellMethods>

    <ClientMethods>
        <onCrossServerTokenResp>
            <Arg>           UNICODE                 </Arg>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           SERVER_ID               </Arg>
        </onCrossServerTokenResp>

        <onGobackServer>
            <Arg>           SPACE_NO                </Arg>
        </onGobackServer>
    </ClientMethods>
</root>
