<root>
    <Interfaces>
        <Interface>         iRoute              </Interface>
    </Interfaces>

    <Properties>
        <autoCombat>
            <Type>          UINT8               </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Default>       0                   </Default>
        </autoCombat>

        <autoCombatSuspendReason>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
            <Persistent>    False                    </Persistent>
        </autoCombatSuspendReason>

        <autoCmbtDic>
            <Type>          PY_DICT             </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       {}                  </Default>
        </autoCmbtDic>

        <controlledByReasonDic>
            <Type>          PY_DICT             </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       {}                  </Default>
        </controlledByReasonDic>

        <setControlledByTimer>
            <Type>          TIMER_ID             </Type>
            <Flags>         CELL_PRIVATE         </Flags>
            <Default>       0                    </Default>
        </setControlledByTimer>

        <autoCombatInterval>
            <Type>          FLOAT               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
        </autoCombatInterval>

        <combatReturnInfo>
            <Type>          COMBAT_RETURN_IDLE_DATA_INFO        </Type>
            <Flags>         CELL_PRIVATE                        </Flags>
            <Persistent>    true                </Persistent>
        </combatReturnInfo>

        <fightBackTimerId>
            <Type>          TIMER_ID            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </fightBackTimerId>

        <fightBackTarget>
            <Type>          OBJECT_ID           </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </fightBackTarget>

        <autoCombatReliveReturnTimes>
            <Type>          UINT8               </Type>
            <Flags>         OWN_CLIENT          </Flags>
            <Default>       0                   </Default>
            <Persistent>    true                </Persistent>
        </autoCombatReliveReturnTimes>

        <autoCombatSkillFrequent>
            <Type>          BOOL               </Type>
            <Flags>         OWN_CLIENT         </Flags>
            <Default>       0                  </Default>
            <Persistent>    true               </Persistent>
        </autoCombatSkillFrequent>

        <doubleBarFlag>
            <Type>          BOOL               </Type>
            <Flags>         CELL_PRIVATE       </Flags>
            <Default>       0                  </Default>
        </doubleBarFlag>

        <lastDoubleBarTime>
            <Type>          INT64              </Type>
            <Flags>         CELL_PRIVATE       </Flags>
            <Default>       0                  </Default>
        </lastDoubleBarTime>
    </Properties>

    <BaseMethods>

    </BaseMethods>

    <CellMethods>
        <startAutoCombat><Exposed/>
            <Arg>   BOOL      </Arg>
        </startAutoCombat>

        <setAvatarActive><Exposed/>
        </setAvatarActive>

        <stopAutoCombat><Exposed/>
        </stopAutoCombat>

        <breakFollowAndAutoCombat><Exposed/>
        </breakFollowAndAutoCombat>

        <selectAutoCombatTarget><Exposed/>
            <Arg>        OBJECT_ID              </Arg>
        </selectAutoCombatTarget>

        <selectAutoCombatPriorityTarget><Exposed/>
            <Arg>           ARRAY   <of>    OBJECT_ID     </of>       </Arg>
        </selectAutoCombatPriorityTarget>

        <setAutoCombatReliveReturnTimes> <Exposed/>
            <Arg>        UINT8              </Arg>
        </setAutoCombatReliveReturnTimes>

        <onGetEnemyPosInfo>
            <Arg>        ENTITYCALL             </Arg>
            <Arg>        UINT8             </Arg>
        </onGetEnemyPosInfo>

        <setAutoCombatSkillFrequent> <Exposed/>
            <Arg>   BOOL      </Arg>
        </setAutoCombatSkillFrequent>

        <changeAutoCombatRange><Exposed/>
            <Arg>        UINT8                   </Arg>
            <Arg>        UINT8                   </Arg>
        </changeAutoCombatRange>

        <setDoubleBarFlag><Exposed/>
            <Arg>   BOOL      </Arg>
        </setDoubleBarFlag>
    </CellMethods>

    <ClientMethods>
        <onStartAutoCombat>
        </onStartAutoCombat>

        <onStopAutoCombat>
        </onStopAutoCombat>

        <onGetAutoCombatRange>
            <Arg>        UINT8                   </Arg>
            <Arg>        UINT8                   </Arg>
        </onGetAutoCombatRange>

        <onSetDoubleBarFlag>
            <Arg>   BOOL      </Arg>
        </onSetDoubleBarFlag>
    </ClientMethods>
</root>
