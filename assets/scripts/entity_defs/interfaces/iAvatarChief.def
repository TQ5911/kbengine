<root>
    <Interfaces>
    </Interfaces>

    <Properties>
        <chiefInfo>
            <Type>  CHIEF_DUNGEON_PLAY_MODE_PLAYER_OBJ   </Type>
            <Flags> BASE_AND_CLIENT  </Flags>
            <Persistent>true</Persistent>
        </chiefInfo>

        <chiefCoinTicketData>
            <Type>          COIN_TICKET_INFO_DATA   </Type>
            <Flags>         BASE                    </Flags>
        </chiefCoinTicketData>
    </Properties>

    <CellMethods>
    </CellMethods>

    <BaseMethods>
        <increaseChiefRewardNumber>
            <Exposed/>
            <Arg>   UINT16   </Arg>
            <Arg>   UINT16   </Arg>
            <Arg>   BOOL    </Arg>
        </increaseChiefRewardNumber>
        
        <useItemToIncreaseChiefRewardNumber>
            <Exposed/>
            <Arg>   UINT16   </Arg>
        </useItemToIncreaseChiefRewardNumber>

        <useCoinToIncreaseChiefRewardNumber>
            <Exposed/>
            <Arg>   UINT8   </Arg>
            <Arg>   BOOL    </Arg>
        </useCoinToIncreaseChiefRewardNumber>

        <onUseItemToIncreaseChiefRewardNumber>
            <Arg>   ITEM_ID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PYTHON      </Arg>
        </onUseItemToIncreaseChiefRewardNumber>

    </BaseMethods>

    <ClientMethods>
    </ClientMethods>

</root>

