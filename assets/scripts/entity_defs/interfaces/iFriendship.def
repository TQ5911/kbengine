<root>
    <Properties>
        <friendship>
            <Type>          FRIEND_SHIP             </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
            <CrossServer>   false                   </CrossServer>
        </friendship>

        <packetSendTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </packetSendTimer>

        <packetSendList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
        </packetSendList>

        <authPermission>
            <Type>          AUTH_PERMISSION_DATA_INFO   </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
            <CrossServer>   false                       </CrossServer>
        </authPermission>

        <authStatistics>
            <Type>          AUTH_STATISTICS_DATA_INFO   </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
            <CrossServer>   false                       </CrossServer>
        </authStatistics>

        <authExpireTimerId>
            <Type>          TIMER_ID                    </Type>
            <Flags>         BASE                        </Flags>
        </authExpireTimerId>

        <mainChnUIStatus>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
        </mainChnUIStatus>
    </Properties>

    <BaseMethods>
        <receiveFriendRequest>
            <Arg>           PYTHON                  </Arg>
            <Arg>           LONGTIME                </Arg>
        </receiveFriendRequest>

        <sendFriendRequest> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </sendFriendRequest>

        <acceptRequest> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </acceptRequest>

        <setMainChnUIStatus> <Exposed/>
            <Arg>           UINT8                   </Arg>
        </setMainChnUIStatus>

        <onAcceptFriendOffline>
            <Arg>       ARRAY   <of>    PLAYER_GBID     </of>   </Arg>
        </onAcceptFriendOffline>

        <onNotifyOnline>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           UINT8                   </Arg>
        </onNotifyOnline>

        <onGetFriendsBox>
            <Arg>       ARRAY   <of>    BOX_AND_GBID    </of>   </Arg>
        </onGetFriendsBox>

        <removeFriend> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </removeFriend>

        <removeRecent> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </removeRecent>

        <onFriendRemoveYou>
            <Arg>           PLAYER_GBID             </Arg>
        </onFriendRemoveYou>

        <searchFriend> <Exposed/>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UINT8                   </Arg>
        </searchFriend>

        <blockPlayer> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </blockPlayer>

        <removeFromBlock> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </removeFromBlock>

        <sendFriendMsg> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </sendFriendMsg>

        <rejectRequest> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </rejectRequest>

        <getFriendMsgs> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </getFriendMsgs>

        <removeFriendMsgs> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           MSG_TS                  </Arg>
        </removeFriendMsgs>

        <acceptAllRequest> <Exposed/>
        </acceptAllRequest>

        <rejectAllRequest> <Exposed/>
        </rejectAllRequest>

        <onRecvMsg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           MSG_TS                  </Arg>
            <Arg>           UNICODE                 </Arg>
        </onRecvMsg>

        <updateFriend> <Exposed/>
        </updateFriend>

        <onNotifyOffline>
            <Arg>           PLAYER_GBID             </Arg>
        </onNotifyOffline>

        <onNotifyFriendsNameChanged>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onNotifyFriendsNameChanged>

        <getAvatarInterInfo> <Exposed/>
            <Arg>           PLAYER_GBID           </Arg>
        </getAvatarInterInfo>

        <getInterInfoOffline>
            <Arg>   ARRAY       <of>    PLAYER_GBID         </of>    </Arg>
        </getInterInfoOffline>

        <getInterInfoOnline>
            <Arg>           PYTHON          </Arg>
        </getInterInfoOnline>

        <sendMyDetailInfoBase>
            <Arg>           ENTITYCALL              </Arg>
        </sendMyDetailInfoBase>

        <doGetAvatarInterInfoBase>
            <Arg>           ENTITYCALL              </Arg>
        </doGetAvatarInterInfoBase>

        <onRecvAuthRole>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onRecvAuthRole>

        <onAgreeAuthRole>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           DBID                    </Arg>
        </onAgreeAuthRole>

        <onAgreeAuthRoleSuccess>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           CHARACTER_VAL           </Arg>
            <Arg>           UNICODE                 </Arg>
        </onAgreeAuthRoleSuccess>

        <authorizeRole> <Exposed/>
            <Arg>           PLAYER_GBID                     </Arg>
            <Arg>           UINT8                           </Arg>
            <Arg>           AUTH_PERMISSION_DATA_INFO       </Arg>
        </authorizeRole>

        <dealAuthRole> <Exposed/>
            <Arg>           BOOL                    </Arg>
        </dealAuthRole>

        <stopAuthInAvatar> <Exposed/>
        </stopAuthInAvatar>

        <cancelAuthRole> <Exposed/>
        </cancelAuthRole>

        <modifyAuthPermission> <Exposed/>
            <Arg>           AUTH_PERMISSION_DATA_INFO       </Arg>
            <Arg>           UINT8                           </Arg>
        </modifyAuthPermission>

        <onUpdateExpRate>
            <Arg>           EXP                             </Arg>
            <Arg>           FLOAT                           </Arg>
        </onUpdateExpRate>

        <onAuthExpire>
        </onAuthExpire>

        <forceAuthOffline>
        </forceAuthOffline>

        <onAuthExpireChanged>
            <Arg>           LONGTIME                        </Arg>
        </onAuthExpireChanged>

        <doGetAuthOfflineTime>
            <Arg>           ENTITYCALL                      </Arg>
        </doGetAuthOfflineTime>

        <doInviteCheck>
            <Arg>           PLAYER_GBID           </Arg>
            <Arg>           UINT8                 </Arg>
            <Arg>           UINT8                 </Arg>
            <Arg>           BOOL                  </Arg>
        </doInviteCheck>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onUpdateFriendsFull>
            <Arg>       ARRAY   <of>    FRIEND_VAL              </of>   </Arg>
        </onUpdateFriendsFull>

        <onUpdateFriendsDiff>
            <Arg>       ARRAY   <of>    FRIEND_CLIENT_DIFF      </of>   </Arg>
        </onUpdateFriendsDiff>

        <onFriendRequests>
            <Arg>       ARRAY   <of>    FRIEND_REQUEST_VAL      </of>   </Arg>
        </onFriendRequests>

        <onRemoveFriends>
            <Arg>       ARRAY   <of>    PLAYER_GBID             </of>   </Arg>
        </onRemoveFriends>

        <onRemoveFriendRequests>
            <Arg>       ARRAY   <of>    PLAYER_GBID             </of>   </Arg>
        </onRemoveFriendRequests>

        <onSearchFriends>
            <Arg>       UINT8                                   </Arg>
            <Arg>       ARRAY   <of>    FRIEND_SEARCH_VAL       </of>   </Arg>
            <Arg>       UINT8                                   </Arg>
        </onSearchFriends>

        <onUpdateBlocks>
            <Arg>       ARRAY   <of>    FRIEND_BLOCK_VAL        </of>   </Arg>
        </onUpdateBlocks>

        <onRemoveBlocks>
            <Arg>       ARRAY   <of>    PLAYER_GBID             </of>   </Arg>
        </onRemoveBlocks>

        <onRemoveRecent>
            <Arg>       ARRAY   <of>    PLAYER_GBID             </of>   </Arg>
        </onRemoveRecent>

        <onRemoveStrangers>
            <Arg>       ARRAY   <of>    PLAYER_GBID             </of>   </Arg>
        </onRemoveStrangers>

        <onUpdateStrangerData>
            <Arg>       ARRAY   <of>    STRANGER_FRIEND_VAL     </of>   </Arg>
        </onUpdateStrangerData>

        <onUpdateRecentData>
            <Arg>       ARRAY   <of>    FRIEND_RECENT_VAL       </of>   </Arg>
        </onUpdateRecentData>

        <onGetFriendMsgs>
            <Arg>           UINT8                   </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>       ARRAY   <of>    FRIEND_CLIENT_MSG       </of>   </Arg>
        </onGetFriendMsgs>

        <onFriendMsgChanged>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           MSG_CNT                 </Arg>
            <Arg>           MSG_TS                  </Arg>
        </onFriendMsgChanged>

        <onGetInterInfoClient>
            <Arg>           AVATAR_INTER_VAL      </Arg>
        </onGetInterInfoClient>

        <onRecvAuthRoleClient>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onRecvAuthRoleClient>

        <onDealAuthResult>
            <Arg>           BOOL                    </Arg>
        </onDealAuthResult>

        <onClientAuthState>
            <Arg>           UINT8                   </Arg>
        </onClientAuthState>

        <onCancelAuthRole>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onCancelAuthRole>

        <onDailyUseMoneyChanged>
            <Arg>           MONEY                   </Arg>
        </onDailyUseMoneyChanged>

        <onAuthorizeRoleStart>
            <Arg>           PLAYER_GBID             </Arg>
        </onAuthorizeRoleStart>
    </ClientMethods>
</root>
