    <ClientMethods>

        <onDressEquipment>
            <Arg>      CLIENT_BODY_EQUIP_ITEM_VAL  </Arg>
        </onDressEquipment>

        <onUndressEquipment>
            <Arg>      UINT32     </Arg>
        </onUndressEquipment>

        <onEquipEnhanceSucc>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT32               </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT8                </Arg>
        </onEquipEnhanceSucc>

        <onEquipEnhanceFailed>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
        </onEquipEnhanceFailed>

        <onEquipBaseAttrWashingSucc>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
            <Arg>      CLI_EQUIP_ITEM_VAL   </Arg>
        </onEquipBaseAttrWashingSucc>

        <onEquipSpiritWashingSucc>
            <Arg>      UINT8            </Arg>
            <Arg>      GRIDID           </Arg>
            <Arg>      CLI_SPIRIT_INFO  </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      UINT32           </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      UINT8            </Arg>
        </onEquipSpiritWashingSucc>

        <onEquipGlyphWashingSucc>
            <Arg>      UINT8            </Arg>
            <Arg>      GRIDID           </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      CLI_GLYPH_INFO   </Arg>
            <Arg>      UINT32           </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      UINT8            </Arg>
        </onEquipGlyphWashingSucc>

        <onEquipBlessSucc>
            <Arg>      UINT8                        </Arg>
            <Arg>      GRIDID                       </Arg>
            <Arg>      ARRAY <of>  AFFIX_VAL </of>  </Arg>
            <Arg>      UINT8                        </Arg>
            <Arg>      UINT16                       </Arg>
            <Arg>      UINT32                       </Arg>
            <Arg>      UINT8                        </Arg>
            <Arg>      UINT8                        </Arg>
        </onEquipBlessSucc>

        <onEquipBackBlessSucc>
            <Arg>      UINT8                        </Arg>
            <Arg>      GRIDID                       </Arg>
            <Arg>      ARRAY <of>  AFFIX_VAL </of>  </Arg>
            <Arg>      UINT8                        </Arg>
            <Arg>      UINT16                       </Arg>
            <Arg>      UINT32                       </Arg>
        </onEquipBackBlessSucc>

        <onEquipDisassemble>
            <Arg>      UINT8                    </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UUID </of>    </Arg>
        </onEquipDisassemble>

        <onAvatarEquipSetChanged>
            <Arg>      ENTITY_ID        </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      UINT8            </Arg>
            <Arg>      BOOL             </Arg>
        </onAvatarEquipSetChanged>

        <onAffixWashingFailed>
        </onAffixWashingFailed>

        <onBodyEquipDailyUpdate>
            <Arg>      ARRAY <of> SLOT_ID </of>    </Arg>
        </onBodyEquipDailyUpdate>

        <onFirstUnlockEquipSet>
            <Arg>      UINT8    </Arg>
            <Arg>      BOOL     </Arg>
        </onFirstUnlockEquipSet>

        <onPickNewEquipDrop>
            <Arg>      EQUIP_DROP_TAKER_DATA_INFO   </Arg>
        </onPickNewEquipDrop>

        <onRemovePickEquipDrop>
            <Arg>      UNIQUE_ID                    </Arg>
        </onRemovePickEquipDrop>

        <onAddNewEquipDrop>
            <Arg>      EQUIP_DROP_DATA_INFO         </Arg>
        </onAddNewEquipDrop>

        <onRemoveEquipDrop>
            <Arg>      UNIQUE_ID                    </Arg>
        </onRemoveEquipDrop>

        <onInitEquipDropData>
            <Arg>      EQUIP_DROP_MGR_DATA_INFO     </Arg>
        </onInitEquipDropData>

        <onEquipDropStateChange>
            <Arg>      UNIQUE_ID                    </Arg>
            <Arg>      UINT8                        </Arg>
        </onEquipDropStateChange>

        <onEquipMakeSucc>
            <Arg>      CLI_EQUIP_ITEM_VAL   </Arg>
        </onEquipMakeSucc>

        <onEquipMakeFailed>
        </onEquipMakeFailed>

        <onEquipGlyphApplySucc>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT64  </Arg>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT32  </Arg>
        </onEquipGlyphApplySucc>

        <onEquipSpiritApplySucc>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT64  </Arg>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT32  </Arg>
