            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
        </equipDropInfo>

        <pickDropEquipLockTime>
            <Type>          LONGTIME            </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                   </Default>
        </pickDropEquipLockTime>

        <glyphEquipData>
            <Type>          GLYPH_EQUIP_INFO          </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Persistent>    true                </Persistent>
        </glyphEquipData>
    </Properties>

    <BaseMethods>
        <baseEquipDeductItems>
