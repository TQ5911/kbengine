        </onEquipBindValueWashingFailed>

        <onEquipUpgradeSucc>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT32               </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT8                </Arg>
        </onEquipUpgradeSucc>

        <onEquipUpgradeFailed>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
        </onEquipUpgradeFailed>

        <onEquipBroken>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
        </onEquipBroken>
    </ClientMethods>
</root>

