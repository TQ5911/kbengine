        <onEquipBindValueWashingSucc>
            <Arg>      UINT8                </Arg>
            <Arg>      GRIDID               </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT8                </Arg>
            <Arg>      UINT8                </Arg>
        </onEquipBindValueWashingSucc>

        <onEquipBindValueWashingFailed>
            <Arg>      UINT8                </Arg>
