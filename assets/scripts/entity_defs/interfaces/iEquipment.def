
<root>
    <Properties>
        <bodyEquipData>
            <Type>          BODY_EQUIP_INFO     </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Persistent>    true                </Persistent>
        </bodyEquipData>

        <baseEquipEncExtraTimesList>
            <Type>          PY_LIST         </Type>
            <Flags>         BASE            </Flags>
        </baseEquipEncExtraTimesList>

        <cellEquipEncExtraTimesList>
            <Type>          PY_LIST         </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </cellEquipEncExtraTimesList>

        <baseBodyEquipDressDataDic>
            <Type>          PY_DICT         </Type>
            <Flags>         BASE            </Flags>
        </baseBodyEquipDressDataDic>

        <equipDropData>
            <Type>          EQUIP_DROP_MGR_DATA_INFO    </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
        </equipDropData>

        <pickDropEquipLockTime>
            <Type>          LONGTIME            </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                   </Default>
        </pickDropEquipLockTime>

        <glyphEquipData>
            <Type>          GLYPH_EQUIP_INFO          </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Persistent>    true                </Persistent>
        </glyphEquipData>
    </Properties>

    <BaseMethods>
        <baseEquipDeductItems>
            <Arg>       PYTHON      </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       BONUS_SRC   </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       ENTITYCALL  </Arg>
            <Arg>       METHOD_NAME </Arg>
            <Arg>       METHOD_ARGS </Arg>
            <Arg>       BOOL        </Arg>
            <Arg>       BOOL        </Arg>
        </baseEquipDeductItems>

        <dressEquipment><Exposed/>
            <Arg>       UINT32      </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       SLOT_ID     </Arg>
        </dressEquipment>

        <dressEquipmentCB>
            <Arg>       UINT64      </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       PYTHON      </Arg>
        </dressEquipmentCB>

        <replaceEquipment>
            <Arg>       UINT64                  </Arg>
            <Arg>       UINT8                   </Arg>
            <Arg>       ITEM_VAL                </Arg>
        </replaceEquipment>

        <bagEquipEnhance>
            <Arg>       GRIDID                      </Arg>
            <Arg>       UUID                        </Arg>
            <Arg>       ARRAY <of> GRIDID </of>     </Arg>
            <Arg>       ARRAY <of> UINT16 </of>     </Arg>
            <Arg>       BOOL                        </Arg>
        </bagEquipEnhance>

        <bagEquipEnhanceDeductItemsCB>
            <Arg>       OP_STAT     </Arg>
            <Arg>       UINT16      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       GRIDID      </Arg>
            <Arg>       UUID        </Arg>
        </bagEquipEnhanceDeductItemsCB>

        <bagEquipUpgrade>
            <Arg>       GRIDID     </Arg>
            <Arg>       UUID       </Arg>
            <Arg>       GRIDID     </Arg>
            <Arg>       BOOL       </Arg>
        </bagEquipUpgrade>

        <bagEquipUpgradeDeductItemsCB>
            <Arg>       OP_STAT     </Arg>
            <Arg>       UINT16      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       GRIDID      </Arg>
        </bagEquipUpgradeDeductItemsCB>

        <bagEquipBindWashing>
            <Arg>       GRIDID     </Arg>
            <Arg>       UUID       </Arg>
            <Arg>       UINT32     </Arg>
        </bagEquipBindWashing>

        <undressEquipment><Exposed/>
            <Arg>       UINT32      </Arg>
        </undressEquipment>

        <cellUndressEquipmentFail>
            <Arg>   SLOT_ID     </Arg>
            <Arg>   UNICODE     </Arg>
        </cellUndressEquipmentFail>

        <cellUndressEquipmentSucc>
            <Arg>   ITEM_VAL     </Arg>
        </cellUndressEquipmentSucc>

        <bagEquipSpiritWashing>
            <Arg>      GRIDID                   </Arg>
            <Arg>      UUID                     </Arg>
            <Arg>      UINT8                    </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
        </bagEquipSpiritWashing>

        <bagEquipSpiritWashingDeductItemsCB>
            <Arg>      OP_STAT      </Arg>
            <Arg>      UINT16       </Arg>
            <Arg>      UINT16       </Arg>
            <Arg>      UUID         </Arg>
            <Arg>      GRIDID       </Arg>
            <Arg>      UINT8        </Arg>
        </bagEquipSpiritWashingDeductItemsCB>

        <bagEquipGlyphWashing>
            <Arg>      GRIDID                   </Arg>
            <Arg>      UUID                     </Arg>
            <Arg>      INT8                     </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
        </bagEquipGlyphWashing>

        <bagEquipGlyphWashingDeductItemsCB>
            <Arg>       OP_STAT     </Arg>
            <Arg>       UINT16      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       GRIDID      </Arg>
            <Arg>       UINT8       </Arg>
        </bagEquipGlyphWashingDeductItemsCB>

        <bagEquipBless>
            <Arg>      GRIDID                   </Arg>
            <Arg>      UUID                     </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
        </bagEquipBless>

        <bagEquipBlessDeductItemsCB>
            <Arg>       OP_STAT     </Arg>
            <Arg>       UINT16      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       GRIDID      </Arg>
        </bagEquipBlessDeductItemsCB>

        <bagEquipBackBless>
            <Arg>      GRIDID    </Arg>
            <Arg>      UUID      </Arg>
        </bagEquipBackBless>

        <bagEquipSell>
            <Arg>      UINT32   </Arg>
            <Arg>      UINT64   </Arg>
        </bagEquipSell>

        <bagEquipGlyphApply>
            <Arg>      GRIDID    </Arg>
            <Arg>      UUID      </Arg>
            <Arg>      INT8      </Arg>
        </bagEquipGlyphApply>

        <bagEquipSpiritApply>
            <Arg>      GRIDID    </Arg>
            <Arg>      UUID      </Arg>
            <Arg>      INT8      </Arg>
        </bagEquipSpiritApply>

        <reqMultiEquipDisassemble> <Exposed/>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UUID </of>  </Arg>
        </reqMultiEquipDisassemble>

        <gmBaseDressEquips>
            <Arg>      PY_LIST  </Arg>
        </gmBaseDressEquips>

        <updateAccountCharacterAppearance>
            <Arg>      PY_DICT  </Arg>
        </updateAccountCharacterAppearance>

        <makeEquipmentLostLog>
            <Arg>      UINT32       </Arg>
            <Arg>      ITEM_VAL     </Arg>
        </makeEquipmentLostLog>

        <makeEquipmentEnhanceLog>
            <Arg>      ITEM_ID      </Arg>
            <Arg>      UUID         </Arg>
            <Arg>      UINT8        </Arg>
            <Arg>      UINT8        </Arg>
            <Arg>      UINT8        </Arg>
            <Arg>      FLOAT        </Arg>
            <Arg>      BOOL         </Arg>
        </makeEquipmentEnhanceLog>

        <makeEquipmentAffixWashingLog>
            <Arg>      ITEM_ID       </Arg>
            <Arg>      UUID          </Arg>
            <Arg>      PY_DICT       </Arg>
        </makeEquipmentAffixWashingLog>

        <updateBodyEquipDressData>
            <Arg>      PY_DICT       </Arg>
        </updateBodyEquipDressData>

        <reqMakeEquipment> <Exposed/>
            <Arg>      ITEM_ID      </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
            <Arg>      INT8 </Arg>
        </reqMakeEquipment>

        <onDropEquipBase>
            <Arg>      UNIQUE_ID            </Arg>
            <Arg>      UINT32               </Arg>
            <Arg>      SPACE_NO             </Arg>
            <Arg>      POSITION_ARG         </Arg>
            <Arg>       PYTHON              </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       UNICODE             </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       OBJECT_ID           </Arg>
        </onDropEquipBase>

        <onGetBackDropEquip>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       BOOL                </Arg>
        </onGetBackDropEquip>

        <onTakeDropEquipSuccess>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       UINT32              </Arg>
        </onTakeDropEquipSuccess>

        <giveUpDropEquip> <Exposed/>
            <Arg>       UNIQUE_ID           </Arg>
        </giveUpDropEquip>

        <redeemEquipDrop> <Exposed/>
            <Arg>       UNIQUE_ID           </Arg>
        </redeemEquipDrop>

        <onRedeemResult>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT8               </Arg>
        </onRedeemResult>

        <onDropTypeChangeToAvatar>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT8               </Arg>
        </onDropTypeChangeToAvatar>

        <onGetDropTakeReward>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT32              </Arg>
        </onGetDropTakeReward>

        <onGetDropInfo>
            <Arg>       PYTHON              </Arg>
            <Arg>       PYTHON              </Arg>
        </onGetDropInfo>

        <takeEquipBase>
            <Arg>       UNIQUE_ID           </Arg>
        </takeEquipBase>

        <getTakerWaitReward> <Exposed/>
            <Arg>       UNIQUE_ID           </Arg>
        </getTakerWaitReward>

        <onGiveUpDropEquip>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT8               </Arg>
            <Arg>       PLAYER_GBID         </Arg>
        </onGiveUpDropEquip>

        <onFetchOtherGiveUpEquip>
            <Arg>      UNIQUE_ID                    </Arg>
            <Arg>      BLOB                         </Arg>
            <Arg>      UINT8                        </Arg>
            <Arg>      LONGTIME                     </Arg>
        </onFetchOtherGiveUpEquip>

        <onRemoveDropEquip>
            <Arg>      UNIQUE_ID           </Arg>
            <Arg>      UINT8               </Arg>
            <Arg>      UINT8               </Arg>
            <Arg>      OBJECT_ID           </Arg>
        </onRemoveDropEquip>

        <onOtherRemoveDropEquip>
            <Arg>      UNIQUE_ID           </Arg>
        </onOtherRemoveDropEquip>

        <onTakeDropEquipFailed>
            <Arg>      UNIQUE_ID           </Arg>
            <Arg>      UINT8               </Arg>
        </onTakeDropEquipFailed>

        <onDropEquipExpire>
            <Arg>      UNIQUE_ID           </Arg>
            <Arg>      UINT8               </Arg>
        </onDropEquipExpire>

        <onAddDropNotify>
        </onAddDropNotify>

        <onGetDropNotifyList>
            <Arg>      ARRAY <of> DROP_NOTIFY_DATA_INFO </of> </Arg>
        </onGetDropNotifyList>

        <gmGlyphWashingEquips>
            <Arg>   UINT32     </Arg>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT32     </Arg>
            <Arg>   UINT32     </Arg>
        </gmGlyphWashingEquips>
    </BaseMethods>

    <CellMethods>
        <reqSetEquipSuitHide> <Exposed/>
            <Arg>      BOOL    </Arg>
        </reqSetEquipSuitHide>
        <cellDressEquipment>
            <Arg>   UUID            </Arg>
            <Arg>   ITEM_VAL        </Arg>
            <Arg>   SLOT_ID         </Arg>
        </cellDressEquipment>

        <cellUndressEquipment>
            <Arg>   UINT32          </Arg>
        </cellUndressEquipment>

        <reqEquipEnhance> <Exposed/>
            <Arg>      UINT8                    </Arg>
            <Arg>      GRIDID                   </Arg>
            <Arg>      UINT64                   </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
            <Arg>      BOOL                     </Arg>
        </reqEquipEnhance>

        <cellEquipEnhance>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT16     </Arg>
            <Arg>   UUID       </Arg>
            <Arg>   UINT32     </Arg>
            <Arg>   UINT32     </Arg>
        </cellEquipEnhance>

        <unlockBodyEquips>
        </unlockBodyEquips>

        <reqEquipSpiritWashing> <Exposed/>
            <Arg>      UINT8                    </Arg>
            <Arg>      UINT32                   </Arg>
            <Arg>      UINT8                    </Arg>
            <Arg>      UINT64                   </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
        </reqEquipSpiritWashing>

        <cellEquipSpiritWashing>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT16      </Arg>
            <Arg>   UINT16      </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT64      </Arg>
            <Arg>   UINT8       </Arg>
        </cellEquipSpiritWashing>

        <reqEquipGlyphWashing> <Exposed/>
            <Arg>      UINT8                    </Arg>
            <Arg>      UINT16                   </Arg>
            <Arg>      UINT8                    </Arg>
            <Arg>      UINT64                   </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
        </reqEquipGlyphWashing>

        <cellEquipGlyphWashing>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT16      </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT64      </Arg>
            <Arg>   UINT8       </Arg>
        </cellEquipGlyphWashing>

        <reqEquipBless> <Exposed/>
            <Arg>      UINT8                    </Arg>
            <Arg>      UINT32                   </Arg>
            <Arg>      UINT64                   </Arg>
            <Arg>      ARRAY <of> GRIDID </of>  </Arg>
            <Arg>      ARRAY <of> UINT16 </of>  </Arg>
