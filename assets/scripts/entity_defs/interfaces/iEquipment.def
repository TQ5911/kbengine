
<root>
    <Properties>
        <bodyEquipData>
            <Type>          BODY_EQUIP_INFO     </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Persistent>    true                </Persistent>
        </bodyEquipData>

        <baseEquipEncExtraTimesList>
            <Type>          PY_LIST         </Type>
            <Flags>         BASE            </Flags>
        </baseEquipEncExtraTimesList>

        <cellEquipEncExtraTimesList>
            <Type>          PY_LIST         </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </cellEquipEncExtraTimesList>

        <baseBodyEquipDressDataDic>
