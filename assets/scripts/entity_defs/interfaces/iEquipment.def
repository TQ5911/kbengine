        <cellEquipBless>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT16      </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT64      </Arg>
        </cellEquipBless>

        <reqEquipBackBless> <Exposed/>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT32  </Arg>
            <Arg>      UINT64  </Arg>
        </reqEquipBackBless>

        <sendItemLinkInfoCell>
            <Arg>      ENTITYCALL   </Arg>
            <Arg>      UINT64       </Arg>
            <Arg>      UINT32       </Arg>
        </sendItemLinkInfoCell>

        <reqEquipGlyphApply> <Exposed/>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT16  </Arg>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT64  </Arg>
        </reqEquipGlyphApply>

        <reqEquipSpiritApply> <Exposed/>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT16  </Arg>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT64  </Arg>
        </reqEquipSpiritApply>

        <gmModifyEquipEnhanceLevel>
            <Arg>      UINT8   </Arg>
            <Arg>      UINT8   </Arg>
        </gmModifyEquipEnhanceLevel>

        <reqEquipBindValueWashing> <Exposed/>
            <Arg>      UINT8   </Arg>
            <Arg>      GRIDID  </Arg>
            <Arg>      UINT64  </Arg>
            <Arg>      UINT32  </Arg>
        </reqEquipBindValueWashing>

        <cellEquipBindValueWashing>
            <Arg>   UINT8      </Arg>
            <Arg>   UUID       </Arg>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT32     </Arg>
        </cellEquipBindValueWashing>

        <reqEquipUpgrade> <Exposed/>
            <Arg>      UINT8   </Arg>
            <Arg>      GRIDID  </Arg>
            <Arg>      UINT64  </Arg>
            <Arg>      GRIDID  </Arg>
            <Arg>      BOOL    </Arg>
        </reqEquipUpgrade>

        <cellEquipUpgrade>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT16     </Arg>
            <Arg>   UUID       </Arg>
            <Arg>   UINT32     </Arg>
        </cellEquipUpgrade>

        <gmGlyphWashingEquips>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT8      </Arg>
            <Arg>   UINT32     </Arg>
            <Arg>   UINT32     </Arg>
            <Arg>   UINT32     </Arg>
        </gmGlyphWashingEquips>
