    <CellMethods>
        <reqUseItems> <Exposed/>
            <Arg>        UINT8         </Arg>
            <Arg>        UINT32        </Arg>
            <Arg>        ITEM_ID       </Arg>
            <Arg>        OBJECT_ID     </Arg>
            <Arg>        UINT8         </Arg>
            <Arg>      ARRAY <of> UNICODE </of>     </Arg>
