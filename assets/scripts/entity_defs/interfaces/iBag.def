<root>
    <Properties>
        <bagData>
            <Type>    BAG_INFO          </Type>
            <Flags>   BASE              </Flags>
            <Persistent>    true        </Persistent>
        </bagData>

        <dailyAwardDict>
            <Type>    PYTHON            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </dailyAwardDict>

        <dailyUseLimitDic>
            <Type>          PYTHON      </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </dailyUseLimitDic>

        <pickedCollections>
            <Type>          PY_DICT      </Type>
            <Flags>         CELL_PRIVATE</Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </pickedCollections>

        <darkIron>
            <Type>          DARK_IRON       </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </darkIron>

        <appearanceCoin>
            <Type>          APPEARANCE_COIN </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </appearanceCoin>

        <coin>
            <Type>          SCOIN           </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </coin>

        <money>
            <Type>          MONEY_NUM             </Type>
            <Flags>         BASE_AND_CLIENT       </Flags>
            <Default>       0                     </Default>
            <Persistent>    true                  </Persistent>
        </money>

        <bindMoney>
            <Type>          MONEY_NUM             </Type>
            <Flags>         BASE_AND_CLIENT       </Flags>
            <Default>       0                     </Default>
            <Persistent>    true                  </Persistent>
        </bindMoney>

        <coinBillInfo>
            <Type>          PY_DICT         </Type>
            <Default>       {}              </Default>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </coinBillInfo>

        <shareAwardDic>
            <Type>          PY_DICT         </Type>
            <Default>       {}              </Default>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </shareAwardDic>

        <isNeedDisturb>
            <Type>          BOOL            </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </isNeedDisturb>

        <coinFraction>
            <Type>          UINT8           </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </coinFraction>

        <randomSynthesisDic>
            <Type>    PY_DICT            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </randomSynthesisDic>

        <drugsQuantityBase>
            <Type>          INT32           </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </drugsQuantityBase>

        <giftKeyRecordDic>
            <Type>    PY_DICT            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </giftKeyRecordDic>

        <title>
            <Type>          INT32         </Type>
            <Flags>         ALL_CLIENTS   </Flags>
            <Default>       0              </Default>
        </title>

        <titleMgr>
            <Type>          TITLE_MGR_DATA_INFO     </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </titleMgr>

        <currencyRecordDic>
            <Type>    PY_DICT            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </currencyRecordDic>
        
        <titleTimerId>
            <Type>    TIMER_ID          </Type>
            <Flags>   BASE              </Flags>
            <Default> 0                 </Default>
        </titleTimerId>
    </Properties>

    <BaseMethods>
        <recycleItems><Exposed/>
            <Arg>       UINT8       </Arg>
            <Arg>       GRIDID      </Arg>
            <Arg>       ITEMID      </Arg>
        </recycleItems>

        <recycleMultipleItems><Exposed/>
            <Arg>       UINT8       </Arg>
            <Arg>       ARRAY <of> GRIDID </of>     </Arg>
        </recycleMultipleItems>

        <reqBindItem><Exposed/>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT32      </Arg>
            <Arg>       ITEMID      </Arg>
        </reqBindItem>

        <reqBagSort><Exposed/>
            <Arg>       UINT8      </Arg>
        </reqBagSort>

        <unlockGrids><Exposed/>
            <Arg>       UINT8      </Arg>
        </unlockGrids>

        <afterUseItemDone>
            <Arg>      BOOL     </Arg>
            <Arg>      UINT64   </Arg>
            <Arg>      BOOL     </Arg>
        </afterUseItemDone>

        <baseUseItems>
            <Arg>        UINT32        </Arg>
            <Arg>        ITEM_ID       </Arg>
            <Arg>        UINT8         </Arg>
            <Arg>        PYTHON        </Arg>
            <Arg>        BOOL          </Arg>
        </baseUseItems>

        <addWealth>
            <Arg>       BONUS_SRC   </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       BOOL        </Arg>
        </addWealth>

        <addMallWealth>
            <Arg>       BONUS_SRC   </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       UUID        </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       PYTHON      </Arg>
            <Arg>       BOOL        </Arg>
        </addMallWealth>

        <dropAwards>
            <Arg>      BONUS_SRC    </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      UUID         </Arg>
            <Arg>      PYTHON       </Arg>
            <Arg>      PYTHON       </Arg>
        </dropAwards>

        <addAwards>
            <Arg>      BONUS_SRC    </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      UUID         </Arg>
            <Arg>      PYTHON       </Arg>
            <Arg>      PYTHON       </Arg>
        </addAwards>


        <addPressGameAwards>
            <Arg>      BONUS_SRC    </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      INT32        </Arg>
            <Arg>      UUID         </Arg>
            <Arg>      PYTHON       </Arg>
            <Arg>      PYTHON       </Arg>
            <Arg>      BOOL       </Arg>
            <Arg>      BOOL       </Arg>
        </addPressGameAwards>

        <openRewardCheckBase>
            <Arg>        UINT8         </Arg>
            <Arg>        UINT8         </Arg>
            <Arg>        PYTHON        </Arg>
            <Arg>        UINT32        </Arg>
        </openRewardCheckBase>

        <checkGatherCond>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       UNIQUE_ID  </Arg>
            <Arg>       PYTHON     </Arg>
            <Arg>       BOOL     </Arg>
        </checkGatherCond>

        <doApplyGatherPreCheck>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       GAME_ENTITY_ID  </Arg>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       BOOL       </Arg>
            <Arg>       SPACE_NO   </Arg>
        </doApplyGatherPreCheck>

        <baseDoApplyGather>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       GAME_ENTITY_ID  </Arg>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       BOOL       </Arg>
            <Arg>       SPACE_NO   </Arg>
            <Arg>       PYTHON     </Arg>
            <Arg>       UINT8     </Arg>
            <Arg>       UINT64     </Arg>
            <Arg>       PYTHON     </Arg>
        </baseDoApplyGather>

        <unlockBag>
            <Arg>   UINT8      </Arg>
            <Arg>   UNICODE    </Arg>
        </unlockBag>

        <getRewardByIdBase>
            <Arg>       REWARD_ID       </Arg>
            <Arg>       LEVEL            </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   ITEM_ID      </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>       UINT64      </Arg>
            <Arg>       PYTHON          </Arg>
        </getRewardByIdBase>

        <addSignInAwards><Exposed/>
            <Arg>      UINT32       </Arg>
        </addSignInAwards>

        <checkBaseUseTreasureBoxCond>
            <Arg>       PYTHON          </Arg>
            <Arg>       UINT32          </Arg>
            <Arg>       GRIDID          </Arg>
            <Arg>       ITEM_ID         </Arg>
            <Arg>       UINT32          </Arg>
            <Arg>       UINT32          </Arg>
        </checkBaseUseTreasureBoxCond>

        <checkRefrshTaskByItemBaseCond>
            <Arg>       UINT32          </Arg>
            <Arg>       TASK_ID         </Arg>
        </checkRefrshTaskByItemBaseCond>

        <exchangeItem><Exposed/>
            <Arg>        UINT32        </Arg>
            <Arg>        UINT32        </Arg>
            <Arg>        UINT32        </Arg>
        </exchangeItem>

        <sendItemLinkInfo>
            <Arg>       ENTITYCALL      </Arg>
            <Arg>       UINT64          </Arg>
            <Arg>       UINT32          </Arg>
        </sendItemLinkInfo>

        <checkModifyNameBase>
            <Arg>       UINT32         </Arg>
            <Arg>       UINT32         </Arg>
            <Arg>       ITEM_ID        </Arg>
            <Arg>       UNICODE        </Arg>
        </checkModifyNameBase>

        <reqGetOnlineTimeReward><Exposed/>
            <Arg>   UINT8      </Arg>
        </reqGetOnlineTimeReward>

        <makeItemFlowLog>
            <Arg>       INT8        </Arg>
            <Arg>       INT8        </Arg>
            <Arg>       ITEM_ID      </Arg>
            <Arg>       INT32       </Arg>
            <Arg>       UUID         </Arg>
            <Arg>       BONUS_SRC    </Arg>
        </makeItemFlowLog>

        <openNChoiceGift> <Exposed/>
            <Arg>        UINT32        </Arg>
            <Arg>        ITEM_ID       </Arg>
            <Arg>        ARRAY <of> STRING </of>     </Arg>
        </openNChoiceGift>

        <getItemUniqueId>
            <Arg>   ITEM_ID       </Arg>
        </getItemUniqueId>

        <reqAvatarCoinBill> <Exposed/>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT16                  </Arg>
            <Arg>           UINT16                  </Arg>
        </reqAvatarCoinBill>

        <reqShareReward> <Exposed/>
            <Arg>           UINT32                  </Arg>
        </reqShareReward>

        <reqCanShareReward> <Exposed/>
            <Arg>           UINT32                  </Arg>
        </reqCanShareReward>

        <doAwardOnKillMonster>
            <Arg>      PYTHON       </Arg>
            <Arg>      PYTHON       </Arg>
            <Arg>      PYTHON       </Arg>
        </doAwardOnKillMonster>

        <reqRandomSynthesis><Exposed/>
            <Arg>      UINT8        </Arg>
            <Arg>      ARRAY <of> RANDOM_SYNTHESIS_ITEM_INFO </of>     </Arg>
            <Arg>      UINT8        </Arg>
        </reqRandomSynthesis>

        <reqUpgradeSynthesis><Exposed/>
            <Arg>       UINT32      </Arg>
        </reqUpgradeSynthesis>

        <reqRandomUpgradeSynthesis><Exposed/>
            <Arg>      ARRAY <of> RANDOM_UPGRADE_SYNTHESIS_NUM_INFO </of>     </Arg>
        </reqRandomUpgradeSynthesis>
        
        <onUpdateCollectionGatherFlag>
            <Arg>       ENTITY_ID    </Arg>
            <Arg>       BOOL         </Arg>
        </onUpdateCollectionGatherFlag>

        <modifyNameBase>
            <Arg>       PENDING_USE_ID          </Arg>
            <Arg>       UNICODE                 </Arg>
        </modifyNameBase>

        <checkRenameBase>
