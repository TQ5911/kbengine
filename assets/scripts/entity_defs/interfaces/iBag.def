            <Exposed/>
            <Arg>   UINT8       </Arg>
        </cancelGather>

        <giveGatherAwardCell>
            <Arg>       OBJECT_ID       </Arg>
        </giveGatherAwardCell>

        <onSetPendingCheckRewardAndMaxUseNum>
            <Arg>   UINT16      </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   UINT32      </Arg>
        </onSetPendingCheckRewardAndMaxUseNum>

        <onPendingCheckItemFinished>
            <Arg>   UINT16      </Arg>
            <Arg>   UINT8       </Arg>
        </onPendingCheckItemFinished>

        <onPendingUseItemFinished>
            <Arg>   UINT16      </Arg>
            <Arg>   UINT8       </Arg>
        </onPendingUseItemFinished>

        <checkCollectionGatherFlag>
