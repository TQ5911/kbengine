            <Arg>        BOOL           </Arg>
        </onBaseAvatarGatherCheckSucc>

        <onDoApplyGatherPreCheck>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       GAME_ENTITY_ID  </Arg>
            <Arg>       OBJECT_ID  </Arg>
            <Arg>       BOOL       </Arg>
            <Arg>       SPACE_NO   </Arg>
            <Arg>       PYTHON     </Arg>
            <Arg>       BOOL       </Arg>
        </onDoApplyGatherPreCheck>

