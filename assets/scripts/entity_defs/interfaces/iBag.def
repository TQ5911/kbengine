    <ClientMethods>
        <onAddBagItems>
            <Arg>      UINT8        </Arg>
            <Arg>      UINT16        </Arg>
            <Arg>      ARRAY <of>   GRIDID </of>     </Arg>
            <Arg>      ARRAY <of>   ITEM_VAL       </of>     </Arg>
            <Arg>      ARRAY <of>   GRIDID </of>     </Arg>
            <Arg>      ARRAY <of>   CLI_EQUIP_ITEM_VAL    </of>     </Arg>
            <Arg>      ARRAY <of>   BAG_ITEM_BRIEF_VAL    </of>     </Arg>
        </onAddBagItems>
        <onBagItemsDailyUpdate>
            <Arg>      ARRAY <of> GRIDID </of>     </Arg>
        </onBagItemsDailyUpdate>
        <onUpdateGridItemsNum>
            <Arg>      UINT8  </Arg>
            <Arg>      ARRAY <of> BAG_GRID_INFO </of>  </Arg>
        </onUpdateGridItemsNum>
        <onUpdateGridItemsExpireTime>
            <Arg>      UINT8  </Arg>
            <Arg>      ARRAY <of> BAG_GRID_TIME_INFO </of>  </Arg>
        </onUpdateGridItemsExpireTime>

        <onUpdateGridItemsJson>
            <Arg>      UINT8        </Arg>
            <Arg>      GRIDID       </Arg>
            <Arg>      UINT64       </Arg>
            <Arg>      UNICODE      </Arg>
        </onUpdateGridItemsJson>

        <onUpdateItemCD>
            <Arg>      ITEM_ID        </Arg>
            <Arg>      UINT32         </Arg>
            <Arg>      LONGTIME       </Arg>
        </onUpdateItemCD>
        <onUnlockGrids>
            <Arg>      UINT8  </Arg>
            <Arg>      UINT32  </Arg>
        </onUnlockGrids>
        <onDropAward>
            <Arg>      INT32    </Arg>
            <Arg>      INT32    </Arg>
            <Arg>      ARRAY <of> AWARD_ITEM_VAL </of>  </Arg>
        </onDropAward>

        <onApplyGather>
            <Arg>      OBJECT_ID</Arg>
            <Arg>      INT32    </Arg>
        </onApplyGather>

        <onCancelGather>
            <Arg>      UINT8  </Arg>
        </onCancelGather>

        <onGatherSucc>
            <Arg>      OBJECT_ID</Arg>
        </onGatherSucc>

        <onBindItemSucc>
            <Arg>      UINT8      </Arg>
            <Arg>      UINT32     </Arg>
        </onBindItemSucc>

        <onUpdateDailyUseLimit>
            <Arg>       ITEM_ID     </Arg>
            <Arg>       UINT32      </Arg>
        </onUpdateDailyUseLimit>

        <onAddGatherRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onAddGatherRewardRecord>

        <onUpdateCollectionGatherFlag>
            <Arg>       ENTITY_ID    </Arg>
            <Arg>       BOOL         </Arg>
        </onUpdateCollectionGatherFlag>

        <onUpdateCollectionGatherPickTimes>
            <Arg>       ENTITY_ID    </Arg>
            <Arg>       UINT32       </Arg>
            <Arg>       UINT32       </Arg>
        </onUpdateCollectionGatherPickTimes>

        <syncIsFBTarget>
            <Arg>       ENTITY_ID    </Arg>
            <Arg>       BOOL         </Arg>
        </syncIsFBTarget>

        <onRandomSynthesis>
            <Arg>       ARRAY    <of>   BAG_ITEM_BRIEF_VAL    </of>     </Arg>
        </onRandomSynthesis>

        <onUpgradeSynthesis>
            <Arg>   ITEMID       </Arg>
        </onUpgradeSynthesis>

        <onGetSynthesisUpgradeNum>
            <Arg>       ARRAY    <of>   CLIENT_RANDOM_SYNTHESIS_NUM_VAL    </of>     </Arg>
        </onGetSynthesisUpgradeNum>

        <onUpdateSynthesisUpgradeNum>
            <Arg>       ARRAY    <of>   CLIENT_RANDOM_SYNTHESIS_NUM_VAL    </of>     </Arg>
        </onUpdateSynthesisUpgradeNum>

        <onLockItemSucc>
            <Arg>       UINT8       </Arg>
            <Arg>       GRIDID      </Arg>
            <Arg>       ITEM_ID     </Arg>
            <Arg>       INT8        </Arg>
        </onLockItemSucc>

        <onSellItemSucc>
            <Arg>       UINT8       </Arg>
            <Arg>       GRIDID      </Arg>
            <Arg>       ITEM_ID     </Arg>
            <Arg>       UINT32      </Arg>
        </onSellItemSucc>

        <onQueryCanShareReward>
            <Arg>       BOOL      </Arg>
        </onQueryCanShareReward>

        <onCheckGatherCondFailed>
        </onCheckGatherCondFailed>

        <onGetAllTitle>
            <Arg>       ARRAY <of> TITLE_VAL_INFO </of>     </Arg>
        </onGetAllTitle>

        <onAddTitles>
            <Arg>       ARRAY <of> TITLE_VAL_INFO </of>     </Arg>
        </onAddTitles>
    </ClientMethods>
</root>
