        <doAction>
            <Arg>       UINT32      </Arg>
            <Arg>       ITEM_ID     </Arg>
            <Arg>       UINT32      </Arg>
            <Arg>       UINT64      </Arg>
            <Arg>       PYTHON      </Arg>
        </doAction>

        <applyGather>
            <Exposed/>
            <Arg>        OBJECT_ID      </Arg>
        </applyGather>

        <applyFinishGather>
