<root>
    <Properties>
        <bagData>
            <Type>    BAG_INFO          </Type>
            <Flags>   BASE              </Flags>
            <Persistent>    true        </Persistent>
        </bagData>

        <dailyAwardDic>
            <Type>    PYTHON            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </dailyAwardDic>

        <dailyUseLimitDic>
            <Type>          PYTHON      </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </dailyUseLimitDic>

        <pickedCollections>
            <Type>          PY_DICT      </Type>
            <Flags>         CELL_PRIVATE</Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </pickedCollections>

        <darkIron>
            <Type>          DARK_IRON       </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </darkIron>

        <geniusQi>
            <Type>          GENIUS_QI       </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </geniusQi>

        <coin>
            <Type>          SCOIN           </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </coin>

        <money>
            <Type>          MONEY_NUM             </Type>
            <Flags>         BASE_AND_CLIENT       </Flags>
            <Default>       0                     </Default>
            <Persistent>    true                  </Persistent>
        </money>

        <coinBillInfo>
            <Type>          PY_DICT         </Type>
            <Default>       {}              </Default>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </coinBillInfo>

        <shareAwardDic>
            <Type>          PY_DICT         </Type>
            <Default>       {}              </Default>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </shareAwardDic>

        <isNeedDisturb>
            <Type>          BOOL            </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </isNeedDisturb>

        <coinFraction>
            <Type>          UINT8            </Type>
            <Flags>         BASE_AND_CLIENT </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </coinFraction>

        <randomSynthesisDic>
            <Type>    PY_DICT            </Type>
            <Flags>   BASE              </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </randomSynthesisDic>

        <drugsQuantityBase>
            <Type>          INT32           </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </drugsQuantityBase>
    </Properties>

    <BaseMethods>
