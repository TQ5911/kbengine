<root>
    <Properties>
        <achievementInfo>
            <Type>          ACHIEVEMENTS_DATA_INFO      </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
        </achievementInfo>

        <mapExploreInfo>
            <Type>          MAP_EXPLORE_DICT            </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
        </mapExploreInfo>
    </Properties>

    <BaseMethods>
        <takeAchievementRewards> <Exposed/>
            <Arg>   ARRAY    <of>    ACHIEVE_ID                  </of>   </Arg>
        </takeAchievementRewards>

        <triggerAchievement>
            <Arg>   ACHIEVE_TYPE                           </Arg>
        </triggerAchievement>

        <triggerAchievementWithCtx>
            <Arg>   ACHIEVE_TYPE                           </Arg>
            <Arg>   PYTHON                                 </Arg>
        </triggerAchievementWithCtx>

        <onCrossServerTriggerAchieveByType>
            <Arg>   ACHIEVE_TYPE                           </Arg>
            <Arg>   PYTHON                                 </Arg>
        </onCrossServerTriggerAchieveByType>

        <getMapExploreReward> <Exposed/>
            <Arg>   SPACE_NO         </Arg>
            <Arg>   INT32            </Arg>
        </getMapExploreReward>
    </BaseMethods>

    <CellMethods>

    </CellMethods>

    <ClientMethods>
        <onUpdateAchieveDatas>
            <Arg>   ARRAY <of>  ACHIEVEMENT_VAL_DATA_INFO   </of>   </Arg>
        </onUpdateAchieveDatas>

        <onTakeAchievementRewards>
            <Arg>   ARRAY <of>  ACHIEVE_ID                  </of>   </Arg>
            <Arg>   ACHIEVE_POINT                           </Arg>
        </onTakeAchievementRewards>

        <onUpdateMapExplore>
            <Arg>   ARRAY <of>  MAP_EXPLORE_DATA_INFO                  </of>   </Arg>
        </onUpdateMapExplore>
    </ClientMethods>
</root>



