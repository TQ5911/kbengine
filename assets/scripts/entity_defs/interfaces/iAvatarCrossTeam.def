<?xml version="1.0" encoding="utf-8"?>
<root>
    <Properties>
        <!-- 玩家所在跨服队伍缓存（无队伍为空）；不持久化，离线即退队，
             客户端可经 reqQueryCrossTeamInfo 主动向中心全量查询重建。
             运行时类型为 CrossTeamCacheVal 对象，下行客户端时调用其 toStreamSavedDic() 序列化为 CROSS_TEAM_CACHE_VAL。 -->
        <crossTeamInfo>
            <Type>          PYTHON                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </crossTeamInfo>

        <!-- 当前所在跨服队伍 teamId（0=无队），cell 入口互斥校验与状态同步用；
             同步至 own client 供客户端直接读取当前队伍 id。 -->
        <crossTeamId>
            <Type>          TEAMID                  </Type>
            <Flags>         ALL_CLIENTS             </Flags>
            <WitnessName>   true                    </WitnessName>
            <Default>       0                       </Default>
        </crossTeamId>

        <!-- 本服匹配中的目标（0=未匹配），本服匹配状态判重用（第一道拦截） -->
        <crossTeamMatchTarget>
            <Type>          TEAMTARGET              </Type>
            <Flags>         OWN_CLIENT              </Flags>
            <Default>       0                       </Default>
        </crossTeamMatchTarget>

        <!-- cell 侧跨服队伍状态同步定时器 -->
        <crossTeamStateSyncTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </crossTeamStateSyncTimer>

        <!-- 跨服队伍成员状态关注列表（小组下标，0 起始；运行时为 int list，None 取默认
             gameconst.CROSS_TEAM_WATCH_GROUPS_DEFAULT）：每秒拉取中心状态时按此过滤，
             客户端经 setCrossTeamWatchGroups 设置，空列表表示不更新任何成员状态 -->
        <crossTeamWatchGroups>
            <Type>          PYTHON                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </crossTeamWatchGroups>

        <!-- AOI 内队友实体 id 集合（自旧本服组队接口迁入；本服组队/团已废弃，只承载跨服队友）。
             由 Avatar.onEnteredView/onLeaveView 经 isTeammate 增量维护，
             跨服队全量落地/成员增删/离队时由 iCrossTeamCell 重建或清空 -->
        <teammateEntIdInAoiSet>
            <Type>          PY_SET                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       set()                   </Default>
        </teammateEntIdInAoiSet>

        <!-- 跨服队伍聊天上次发送时间（CD 控制，沿用本服队伍频道 CD） -->
        <sendCrossTeamMsgTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </sendCrossTeamMsgTime>

        <!-- base 侧跨服队伍 id 镜像（聊天等 base 方法用；由 cell 同步），
             同步至 own client 供客户端在 base 侧直接读取。 -->
        <crossTeamIdBase>
            <Type>          TEAMID                  </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </crossTeamIdBase>
    </Properties>

    <BaseMethods>
        <!-- Stub -> base：跨服队伍聊天批量下行（base 收到后拆包逐条推送给客户端） -->
        <onCrossTeamChatBatch>
            <Arg>           CROSS_TEAM_CHAT_MSG_LIST </Arg>
        </onCrossTeamChatBatch>

        <!-- 讨伐：Stub -> base 条件检查（次数/门票在 base 检查，战斗/传送转 cell） -->
        <checkCrossCrusadeCondition>
            <Arg>           TEAMID                  </Arg>
            <Arg>           UINT32                  </Arg>
        </checkCrossCrusadeCondition>

        <!-- 讨伐：Stub -> base 执行跨服迁移（extra 携带 CrossCrusadeContext） -->
        <crossCrusadeGo>
            <Arg>           PY_DICT                 </Arg>
        </crossCrusadeGo>

        <!-- 讨伐：跨服落地回调（跨服服上调用） -->
        <onEnterCrossCrusadeSpaceRemotely>
            <Arg>           UINT32                  </Arg>
            <Arg>           PY_DICT                 </Arg>
        </onEnterCrossCrusadeSpaceRemotely>

        <!-- 讨伐：镜像登录直进副本（CrossTeamStub 查得簿记后回调镜像 base，
             借 Space 实体直接建 cell 进副本克隆空间） -->
        <enterCrusadeDungeonOnLogon>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           PY_DICT                 </Arg>
        </enterCrusadeDungeonOnLogon>

        <!-- 讨伐：镜像登录直进副本失败兜底（CrossTeamStub -> 镜像 base，回退出生图落地） -->
        <onCrossCrusadeLogonEnterFail>
        </onCrossCrusadeLogonEnterFail>

        <!-- 讨伐：发奖包落地入口（跨服服镜像完成结算计算与展示后 -> 本服 base，
             经 syncMethodCallToLocalServerBase 动态分发；声明仅为接口留档，
             实际传输走 beSyncMethodCallFromCrossServerBase 的 PYTHON fnargs）。
             pack 结构见 iDungeonSettlement._doCrossTeamDungeonSettlement -->
        <onLocalServerCrossCrusadeSettlementApply>
            <Arg>           PY_DICT                 </Arg>
        </onLocalServerCrossCrusadeSettlementApply>

        <!-- 讨伐：进本落地埋点/活动计数（跨服服镜像 -> 本服 base，
             经 syncMethodCallToLocalServerBase 动态分发；声明仅为接口留档，
             实际传输走 beSyncMethodCallFromCrossServerBase 的 PYTHON fnargs） -->
        <onTrackTeamDungeonEnter>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           PY_DICT                 </Arg>
        </onTrackTeamDungeonEnter>

        <!-- 讨伐：本服幽灵回城落地完成（cell -> base），同步镜像的回程落点为主城 -->
        <onCrossGhostReturnCityDone>
            <Arg>           SPACE_NO                </Arg>
        </onCrossGhostReturnCityDone>

        <!-- 讨伐：回程落点改为主城（本服 base -> 跨服服镜像 base，
             经 syncMethodCallToCrossServerBase 动态分发；声明仅为接口留档） -->
        <setCrossGhostReturnSpaceNo>
            <Arg>           SPACE_NO                </Arg>
        </setCrossGhostReturnSpaceNo>

        <!-- Stub 下行中继：playerBox 失效时经 PlayerStub 到 base 再转 cell（args=(method, args)） -->
        <onCrossTeamCellRelay>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
        </onCrossTeamCellRelay>

        <!-- Guild base -> 目标 base：帮会邀请入团的目标侧检查（不在队/黑名单） -->
        <doCrossGuildInviteCheck>
            <Arg>           PY_DICT                 </Arg>
        </doCrossGuildInviteCheck>

        <!-- cell -> base：同步跨服队伍 id 镜像（聊天等 base 方法用） -->
        <syncCrossTeamIdToBase>
            <Arg>           TEAMID                  </Arg>
        </syncCrossTeamIdToBase>
    </BaseMethods>

    <CellMethods>
        <!-- 客户端 -> cell 入口 -->
        <applyCreateCrossTeam> <Exposed/>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           STRING                  </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           BOOL                    </Arg>
        </applyCreateCrossTeam>

        <!-- 设置跨服队伍成员状态关注列表（小组下标，0 起始）：客户端常态化只需本组
             成员状态，每秒拉取（syncCrossTeamState）按此过滤；空列表=不更新 -->
        <setCrossTeamWatchGroups> <Exposed/>
            <Arg>           ARRAY <of> INT8 </of>   </Arg>
        </setCrossTeamWatchGroups>

        <applyJoinCrossTeam> <Exposed/>
            <Arg>           TEAMID                  </Arg>
            <Arg>           STRING                  </Arg>
            <!-- 追加参数（对齐梳理 §2.3）：applySource 申请来源，枚举复用本服 TeamJoinType -->
            <Arg>           INT8                    </Arg>
        </applyJoinCrossTeam>

        <replyCrossTeamJoin> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           BOOL                    </Arg>
        </replyCrossTeamJoin>

        <applyInviteCrossTeam> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <!-- 追加参数（对齐梳理 §2.3）：被邀请人名字（本服冗余下发，客户端免查） -->
            <Arg>           UNICODE                 </Arg>
        </applyInviteCrossTeam>

        <!-- 邀请前目标条件判定（等级/战力/功能是否解锁）：发起人 cell 经 PlayerStub
             路由到被邀请人 cell 执行，inviterBox 为发起人 base 邮箱（ENTITYCALL），
             结果经 inviterBox.cell 回调 onCrossTeamInviteCheckResult -->
        <checkCrossTeamInviteCondition>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT32                  </Arg>
        </checkCrossTeamInviteCondition>

        <!-- 被邀请人 cell -> 发起人 cell：邀请条件判定结果回调
             （msgId=0 通过，正常发中心；否则为提示消息 id，发起人侧 showMsg） -->
        <onCrossTeamInviteCheckResult>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamInviteCheckResult>

        <replyCrossTeamInvite> <Exposed/>
            <Arg>           TEAMID                  </Arg>
            <Arg>           BOOL                    </Arg>
            <!-- 追加参数（对齐梳理 §2.3）：邀请人 gbId、邀请类型（枚举复用本服） -->
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </replyCrossTeamInvite>

        <!-- 无队邀请组队（InviteType.TEAM_UP，客户端仅邀请/应答两个动作，其余服务端闭环）：
             Stub -> cell 无队邀请到达，teamId 为邀请人预分配 id（建队复用/应答回传/试进队用） -->
        <onTeamUpInvite>
            <Arg>           CROSS_TEAM_INVITE_VAL   </Arg>
        </onTeamUpInvite>

        <!-- Stub -> cell 无队邀请应答到达（A 侧）：展示提示，同意时驱动服务端自动建队 -->
        <onTeamUpInviteReply>
            <Arg>           CROSS_TEAM_TEAM_UP_REPLY_VAL </Arg>
        </onTeamUpInviteReply>

        <!-- Stub -> cell 队伍就绪（B 侧）：命中已答应记录后服务端自动发起免审进队 -->
        <onTeamUpTeamReady>
            <Arg>           TEAMID                  </Arg>
            <Arg>           PLAYER_GBID             </Arg>
        </onTeamUpTeamReady>

        <!-- 流程内部进队（teamUpReqJoin）专用受理回执：与用户主动 reqJoin 的客户端透传通道
             onCrossTeamApplyJoinResult 隔离，静默+日志；参数口径与中心回包固定结构一致 -->
        <onTeamUpAutoJoinResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           STRING                  </Arg>
            <Arg>           INT32                   </Arg>
        </onTeamUpAutoJoinResult>

        <!-- 申请审批同意自证入队（队长 replyApply 同意后中心标记 Approved 并通知申请人
             所在服）：Stub -> cell 审批同意到达，cell 二次检查（互斥）后自动进队，
             中心为带 Approved 记录的申请人跳过密码与门槛校验 -->
        <onCrossTeamApplyApproved>
            <Arg>           TEAMID                  </Arg>
        </onCrossTeamApplyApproved>

        <!-- 自证入队（approvedReqJoin）专用受理回执：与用户主动 reqJoin 的客户端透传通道
             onCrossTeamApplyJoinResult 隔离，静默+日志；参数口径与中心回包固定结构一致 -->
        <onTeamApprovedJoinResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           STRING                  </Arg>
            <Arg>           INT32                   </Arg>
        </onTeamApprovedJoinResult>

        <!-- 邀请帮会成员入团（对应旧本服帮会邀请入团接口，仅跨服团队线可发起）：
             游戏服自闭环广播帮会邀请，不经组队中心；被邀请人接受后走申请审批流 -->
        <tryApplyInviteCrossGuild> <Exposed/>
        </tryApplyInviteCrossGuild>

        <!-- Guild base -> cell：帮会邀请入团落地（目标侧复核不在队后弹邀请窗，
             inviteInfo 为 CROSS_TEAM_INVITE_VAL 同构 dict） -->
        <doApplyCrossGuildInvite>
            <Arg>           PY_DICT                 </Arg>
        </doApplyCrossGuildInvite>

        <applyLeaveCrossTeam> <Exposed/>
        </applyLeaveCrossTeam>

        <applyKickCrossTeamMember> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </applyKickCrossTeamMember>

        <applyTransferCrossCaptain> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </applyTransferCrossCaptain>

        <applyDisbandCrossTeam> <Exposed/>
        </applyDisbandCrossTeam>

        <!-- 小队转团队（队长操作，本服 createRaidWithTeam 对应）：target 为新的团队线目标；
             成功后全员收全量 onCrossTeamInfoUpdate（含新 teamId/target/maxNum） -->
        <applyConvertCrossTeamToRaid> <Exposed/>
            <Arg>           TEAMTARGET              </Arg>
        </applyConvertCrossTeamToRaid>

        <!-- 修改队伍设置：门槛/介绍/满员自动进本/密码（队长操作，队长身份中心复核）；
             目标创建后不可改，不在本接口范围内；autoMatch 修改频率高，已拆分到 reqSetCrossTeamAutoMatch -->
        <reqSetCrossTeamSettings> <Exposed/>
            <Arg>           UINT32                  </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           BOOL                    </Arg>
            <!-- 追加参数（对齐梳理 §2.3）：密码（空串=取消密码转公开队） -->
            <Arg>           STRING                  </Arg>
        </reqSetCrossTeamSettings>

        <!-- 自动匹配开关（队长操作，修改频率高，与队伍目标拆分） -->
        <reqSetCrossTeamAutoMatch> <Exposed/>
            <Arg>           BOOL                    </Arg>
        </reqSetCrossTeamAutoMatch>

        <reqCrossTeamMatch> <Exposed/>
            <Arg>           TEAMTARGET              </Arg>
        </reqCrossTeamMatch>

        <reqStopCrossTeamMatch> <Exposed/>
        </reqStopCrossTeamMatch>

        <!-- Stub -> cell：撮合成功，cell 侧做二次检查并取玩家信息回调 Stub.doMatchJoin -->
        <onCrossTeamMatchSuccess>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
        </onCrossTeamMatchSuccess>

        <!-- 队伍列表查询（一波全量下发，问题记录#5）：回包不再走本协议，
             由 Stub 经 base streamStringProxy（StreamStringID.CROSS_TEAM_LIST_DATA）分片下发 -->
        <reqGetCrossTeamList> <Exposed/>
            <Arg>           TEAMTARGET              </Arg>
        </reqGetCrossTeamList>

        <switchCrossTeamMicsMode> <Exposed/>
            <Arg>           UINT8                   </Arg>
        </switchCrossTeamMicsMode>

        <!-- 禁麦/解除禁麦（队长操作）：block/unblock 合并为一个入口，blocked=True 禁麦 -->
        <reqSetCrossTeamMemberMicBlock> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           BOOL                    </Arg>
        </reqSetCrossTeamMemberMicBlock>

        <!-- 成员位置调整（队长操作）：交换两个成员位置，或将 src 移动到 dst 组末尾 -->
        <reqAdjustCrossTeamMemberPos> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </reqAdjustCrossTeamMemberPos>

        <!-- ================ 客户端接口对齐补充（跨服组队客户端接口对齐梳理.md §2） ================ -->

        <!-- 队伍预览（决策 D4）：按需查询指定队伍成员列表，不随列表下发；回包走 onCrossTeamPreview -->
        <reqGetCrossTeamPreview> <Exposed/>
            <Arg>           TEAMID                  </Arg>
        </reqGetCrossTeamPreview>

        <!-- 成员自己开/关麦（本服 turnOnTeamMics/turnOffTeamMics 对应） -->
        <turnOnCrossTeamMics> <Exposed/>
        </turnOnCrossTeamMics>

        <turnOffCrossTeamMics> <Exposed/>
        </turnOffCrossTeamMics>

        <!-- 语音房状态位图同步（对应旧本服语音房状态接口） -->
        <reqUpdateCrossTeamVoiceRoomState> <Exposed/>
            <Arg>           TEAMID                  </Arg>
            <Arg>           UINT8                   </Arg>
        </reqUpdateCrossTeamVoiceRoomState>

        <!-- 申请列表拉取（断线/换队长后重建）；回包走 onCrossTeamApplyList -->
        <reqGetCrossTeamApplyList> <Exposed/>
        </reqGetCrossTeamApplyList>

        <!-- 队伍标记三件套：接口落地，本轮回"暂未开放"（功能线后续实现） -->
        <reqAddCrossMarkMember> <Exposed/>
            <Arg>           UINT8                   </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           ENTITY_ID               </Arg>
            <Arg>           POSITION_ARG            </Arg>
        </reqAddCrossMarkMember>
        <reqDelCrossMarkMember> <Exposed/>
            <Arg>           UINT8                   </Arg>
            <Arg>           UINT8                   </Arg>
        </reqDelCrossMarkMember>
        <reqChangeCrossOnlyCaptain> <Exposed/>
            <Arg>           BOOL                    </Arg>
        </reqChangeCrossOnlyCaptain>

        <!-- 召集（本服 sendAllMemberFollowAsk 对应）：队长发起全员跟随确认，
             跟随本体由客户端实现，服务端仅经中心把召集指令广播到队长当前所在服
             （其余跟随预留接口已删除不做：reqCrossCaptainFollowInfo/cancelCrossAllMemberFollow/
             applyFollowCrossCaptain/confirmFollowCrossCaptain/cancelFollowCrossCaptain/
             replyFollowCrossCaptain） -->
        <sendCrossAllMemberFollowAsk> <Exposed/>
        </sendCrossAllMemberFollowAsk>

        <!-- 副团长/申请队长/快速入队/清空申请列表（原决策 7/D6/D9 空接口，均已实现；
             队禁言 reqUpdateCrossTeamSilentAttr / 自动接受申请 clientSetCrossAutoAskTeam
             确认不做，预留接口已删除） -->
        <!-- 任命/取消副团长（0=取消；决策 D9，唯一名额，权限细则功能期定） -->
        <reqSetCrossTeamDeputy> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </reqSetCrossTeamDeputy>
        <applyBecomeCrossCaptain> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
        </applyBecomeCrossCaptain>
        <replyBecomeCrossCaptain> <Exposed/>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           BOOL                    </Arg>
        </replyBecomeCrossCaptain>
        <!-- 免审批快速加入公开队（本服 reqJoinTeam 对应） -->
        <reqJoinCrossTeam> <Exposed/>
            <Arg>           TEAMID                  </Arg>
            <Arg>           STRING                  </Arg>
        </reqJoinCrossTeam>
        <clearCrossApplyJoinDic> <Exposed/>
        </clearCrossApplyJoinDic>

        <!-- 讨伐：队长发起（检查通过即进本，无确认弹窗） -->
        <applyStartCrossCrusade> <Exposed/>
        </applyStartCrossCrusade>

        <!-- 讨伐：客户端主动退出跨服副本（返回本服；进行中退出=退跨服队，已结算退出仅回本服） -->
        <applyExitCrossCrusade> <Exposed/>
        </applyExitCrossCrusade>

        <!-- base -> cell：讨伐条件检查的 cell 部分（战斗状态/传送条件） -->
        <checkCrossCrusadeConditionCell>
            <Arg>           TEAMID                  </Arg>
            <Arg>           UINT32                  </Arg>
            <Arg>           INT32                   </Arg>
        </checkCrossCrusadeConditionCell>

        <!-- 讨伐（本服链路）：本服模式本地进本驱动，内部方法不暴露客户端；
             CrossTeamStub.onCrusadeGo 本服分支（crossServerId==本机 serverId）逐本服成员
             经 base 调用（context 为 CrossCrusadeContext，含本服副本空间 spaceNo） -->
        <onCrossCrusadeGoLocal>
            <Arg>           PY_DICT                 </Arg>
        </onCrossCrusadeGoLocal>

        <!-- base -> cell：队伍镜像同步（cell 互斥校验/状态同步用） -->
        <onCrossTeamIdChange>
            <Arg>           TEAMID                  </Arg>
        </onCrossTeamIdChange>

        <!-- 跨服服侧：进入讨伐副本空间后构造跨服队友缓存 -->
        <onCrossCrusadeSpaceEnter>
            <Arg>           PY_DICT                 </Arg>
        </onCrossCrusadeSpaceEnter>

        <!-- CrossTeamStub -> Avatar cell 下行（优先 memberBoxes 直达，或经 base 中继转入） -->
        <onCrossTeamInfoUpdate>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamInfoUpdate>

        <!-- 创建队伍成功：复用全量缓存，额外回调客户端 -->
        <onCrossTeamCreateSuccess>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamCreateSuccess>

        <!-- 加入队伍成功：复用全量缓存，额外回调客户端 -->
        <onCrossTeamJoinSuccess>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamJoinSuccess>

        <onCrossTeamOpResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           TEAMTARGET              </Arg>
        </onCrossTeamOpResult>

        <!-- 入队申请受理回调（中心 uuid 回执：replyApplyNotify -> Stub 按 remoteCallCache 原路回调 -> cell 透传客户端） -->
        <onCrossTeamApplyJoinResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           STRING                  </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamApplyJoinResult>

        <onCrossTeamMatchTimeout>
            <Arg>           TEAMTARGET              </Arg>
        </onCrossTeamMatchTimeout>

        <!-- CrossTeamStub -> Avatar cell 增量推送 -->
        <onCrossTeamMemberAdd>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamMemberAdd>

        <onCrossTeamMemberRemove>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamMemberRemove>

        <!-- 自己被移出队伍：清空本地缓存并通知客户端离队原因 -->
        <onCrossTeamLeave>
            <Arg>           TEAMID                  </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamLeave>

        <onCrossTeamCaptainChange>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamCaptainChange>

        <!-- CrossTeamStub -> Avatar cell：申请成为队长的队伍频道消息（仅队长本人） -->
        <onCrossTeamBecomeCaptainApplyMsg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onCrossTeamBecomeCaptainApplyMsg>

        <onCrossTeamSettingsChange>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamSettingsChange>

        <!-- CrossTeamStub -> Avatar cell 增量推送：自动匹配开关变更（autoMatch 已从目标推送拆分） -->
        <onCrossTeamAutoMatchChange>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamAutoMatchChange>

        <onCrossTeamMicsModeChange>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMicsModeChange>

        <onCrossTeamMicBlockChange>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamMicBlockChange>

        <!-- CrossTeamStub -> Avatar cell 位置调整推送：参数与上行请求一致，客户端收到后刷新全量 -->
        <onCrossTeamMemberPosChange>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMemberPosChange>

        <onCrossTeamDisband>
            <Arg>           TEAMID                  </Arg>
        </onCrossTeamDisband>

        <!-- ================ 接口对齐补充：Stub -> cell 下行（对齐梳理 §3） ================ -->
        <onCrossTeamPreview>
            <Arg>           PY_DICT                 </Arg>
        </onCrossTeamPreview>

        <onCrossTeamApplyList>
            <Arg>           PYTHON                  </Arg>
        </onCrossTeamApplyList>

        <onCrossTeamApplyRemove>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamApplyRemove>

        <onCrossTeamMatchStart>
            <Arg>           LONGTIME                </Arg>
        </onCrossTeamMatchStart>

        <onCrossTeamMatchStop>
        </onCrossTeamMatchStop>

        <onCrossTeamMemberVoiceState>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMemberVoiceState>

        <!-- 成员改名广播落地（Stub -> cell）：teamId 校验当前队伍，防换队/离队后旧推送落地 -->
        <onCrossTeamMemberRename>
            <Arg>           TEAMID                  </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onCrossTeamMemberRename>

        <onCrossTeamDeputyChange>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamDeputyChange>

        <!-- 队伍标记变更（单条增量下发客户端；changeType 对齐本服 TeamMarkChangeType：
             1=ADD 3=DELETE 4=CAPTAIN 开关变更。DELETE 时 markInfo 为被删标记的完整快照
             （客户端按 type/index 摘除即可）；CAPTAIN 时 markInfo 为空、仅 onlyCaptainCanMark
             有效，且始终携带当前值供冗余校准） -->
        <onCrossTeamMarkChange>
            <Arg>           UINT8                   </Arg>
            <Arg>           CLIENT_TEAM_MARK_VAL    </Arg>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamMarkChange>

        <onCrossTeamFollowCaptainAsk>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           POSITION_ARG            </Arg>
        </onCrossTeamFollowCaptainAsk>

        <onCrossTeamRefreshDungeonCD>
            <Arg>           LONGTIME                </Arg>
        </onCrossTeamRefreshDungeonCD>

        <!-- 与中心断连重连后的对账入口（CrossTeamStub 经 broadcastToAllAvatar 广播）：
             按 gbId 分片过滤后，在队且不在跨服副本中的玩家经 base 向中心重查队伍数据 -->
        <onCrossTeamCenterReconnected>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamCenterReconnected>

        <!-- 玩家详情组包（跨服轨）：base/iFriendship.getAvatarInterInfo 链路调用，
             承接旧本服组队的玩家详情接口 -->
        <onGetCrossAvatarInterInfo>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           UNICODE                 </Arg>
        </onGetCrossAvatarInterInfo>

        <!-- ================ 跨服组队副本进本/退本 RPC 终点（自 iAvatarTeamDungeon.def/
             iAvatarRaidDungeon.def 迁入，方法名与参数签名保持不变，DungeonSpaceMgr.cell/
             CrossTeamDungeonStub 调用方零改动；旧 def 文件随旧组队系统整体删除，
             删除前同名声明并存由引擎按序覆盖、声明内容一致无副作用） ================ -->

        <!-- 小队线进本：CrossTeamDungeonStub._teamDoEnterDungeon ->
             DungeonSpaceMgr.cell.doEnterTeamDungeon -> 玩家 cell 本方法 -->
        <doEnterTeamDungeon>
            <Arg>           SPACE_NO           </Arg>
            <Arg>           UUID               </Arg>
            <Arg>           MAILBOX            </Arg>  <!--spaceBox-->
            <Arg>           MAILBOX            </Arg>  <!--spaceMgrBox-->
            <Arg>           PYTHON             </Arg>  <!--extra-->
        </doEnterTeamDungeon>

        <!-- GM 建本拉成员入本（测试用）：CrossTeamDungeonStub._gmEnterDungeon 经
             PlayerStub.doOnOthersCell 调用，成员各自补 src/结算字段后走既有进本链路 -->
        <gmEnterDungeonAsMember>
            <Arg>           DUNGEON_NO         </Arg>
            <Arg>           UINT8              </Arg>  <!--isRaid-->
            <Arg>           SPACE_NO           </Arg>
            <Arg>           UUID               </Arg>
            <Arg>           MAILBOX            </Arg>  <!--spaceBox-->
            <Arg>           MAILBOX            </Arg>  <!--spaceMgrBox-->
            <Arg>           PYTHON             </Arg>  <!--extra-->
        </gmEnterDungeonAsMember>

        <!-- 小队线进本传送执行（doEnterTeamDungeon 内部直连调用，声明仅为接口留档；
             state=0 恒成功，门票检查已由中心协调完成） -->
        <readyUseItemAndEnterTeamDungeon>
            <Arg>           UINT8              </Arg>
            <Arg>           SPACE_NO           </Arg>
            <Arg>           UUID               </Arg>
            <Arg>           MAILBOX            </Arg>  <!--spaceBox-->
            <Arg>           MAILBOX            </Arg>  <!--spaceMgrBox-->
            <Arg>           PYTHON             </Arg>  <!--extra-->
        </readyUseItemAndEnterTeamDungeon>

        <!-- 本服模式小队线完成踢人：CrossTeamDungeonStub._kickOutTeamDungeonFounders -> 玩家 cell -->
        <selfLeaveTeamDungeon>
            <Arg>   PYTHON  </Arg>  <!--src（KickoutFromDungeon，_extra 带 spaceNo）-->
        </selfLeaveTeamDungeon>

        <!-- 首领线进本：CrossTeamDungeonStub._raidDoEnterDungeon ->
             DungeonSpaceMgr.cell.enterRaidDunDirectly -> 玩家 cell 本方法
             （跨服队伍镜像标记 crossTeamId 为唯一放行依据） -->
        <doEnterRaidDungeonAfterCheck>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   MAILBOX     </Arg>  <!--spaceBox-->
            <Arg>   MAILBOX     </Arg>  <!--spaceMgrBox-->
            <Arg>   DUNGEON_SRC     </Arg>  <!--src（跨服链路为 DungeonFromClientSrc）-->
            <Arg>   PYTHON  </Arg>  <!--extraProps-->
        </doEnterRaidDungeonAfterCheck>

        <!-- 本服模式首领线踢人：CrossTeamDungeonStub._kickOutAllFounders -> 玩家 cell -->
        <selfLeaveRaidDungeon>
            <Arg>   PYTHON  </Arg>  <!--src（KickoutFromDungeon）-->
        </selfLeaveRaidDungeon>
    </CellMethods>

    <ClientMethods>
        <onCrossTeamInfoUpdate>
            <Arg>           CROSS_TEAM_CACHE_VAL    </Arg>
        </onCrossTeamInfoUpdate>

        <onCrossTeamMemberState>
            <Arg>           TEAMID                  </Arg>
            <Arg>           CROSS_TEAM_MEMBER_STATE_LIST </Arg>
        </onCrossTeamMemberState>

        <!-- 【已废弃】聊天下行改走本服通用频道结构 onRecvChannelMsg（对齐梳理 1.7 方案B），
             本接口保留仅为 SDK 兼容，服务端不再下发 -->
        <onCrossTeamChatMsg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UINT64                  </Arg>
        </onCrossTeamChatMsg>

        <onCrossTeamMatchTimeout>
            <Arg>           TEAMTARGET              </Arg>
        </onCrossTeamMatchTimeout>

        <onCrossTeamJoinApply>
            <Arg>           CROSS_TEAM_APPLY_VAL    </Arg>
        </onCrossTeamJoinApply>

        <onCrossTeamInvite>
            <Arg>           CROSS_TEAM_INVITE_VAL   </Arg>
        </onCrossTeamInvite>

        <!-- 无队邀请组队应答结果（InviteType.TEAM_UP）：纯展示（拒绝/对方已在队伍/同意提示），
             客户端不做任何后续动作，建队/进队全部服务端闭环 -->
        <onTeamUpInviteReply>
            <Arg>           CROSS_TEAM_TEAM_UP_REPLY_VAL </Arg>
        </onTeamUpInviteReply>

        <onCrossTeamOpResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
        </onCrossTeamOpResult>

        <!-- 入队申请受理回调（成功/失败统一）：cell 透传客户端，
             字段口径对齐本服 onApplyJoinRaidLonelyFailed -->
        <onCrossTeamApplyJoinResult>
            <Arg>           INT32                   </Arg>
            <Arg>           TEAMID                  </Arg>
            <Arg>           TEAMTARGET              </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           INT32                   </Arg>
            <Arg>           STRING                  </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamApplyJoinResult>

        <onCrossTeamCreateSuccess>
            <Arg>           CROSS_TEAM_CACHE_VAL    </Arg>
        </onCrossTeamCreateSuccess>

        <onCrossTeamJoinSuccess>
            <Arg>           CROSS_TEAM_CACHE_VAL    </Arg>
        </onCrossTeamJoinSuccess>

        <onCrossCrusadeAbort>
            <Arg>           INT32                   </Arg>
        </onCrossCrusadeAbort>

        <onCrossTeamMemberAdd>
            <Arg>           CROSS_TEAM_MEMBER_CACHE_VAL </Arg>
        </onCrossTeamMemberAdd>

        <onCrossTeamMemberRemove>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamMemberRemove>

        <!-- 自己被移出队伍：附离队原因 -->
        <onCrossTeamLeave>
            <Arg>           TEAMID                  </Arg>
            <Arg>           INT32                   </Arg>
        </onCrossTeamLeave>

        <onCrossTeamCaptainChange>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamCaptainChange>

        <!-- 申请成为队长提示（推给队长，附申请人基本身份信息；对齐本服 onApplyBecomeCaptainMsg） -->
        <onCrossBecomeCaptainAsk>
            <Arg>           CROSS_TEAM_BASIC_INFO_VAL   </Arg>
        </onCrossBecomeCaptainAsk>

        <onCrossTeamSettingsChange>
            <Arg>           CROSS_TEAM_SETTINGS_VAL   </Arg>
        </onCrossTeamSettingsChange>

        <!-- 自动匹配开关变更推送：参数与上行请求一致 -->
        <onCrossTeamAutoMatchChange>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamAutoMatchChange>

        <onCrossTeamMicsModeChange>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMicsModeChange>

        <onCrossTeamMicBlockChange>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamMicBlockChange>

        <!-- 位置调整推送：参数与上行请求一致，客户端收到后刷新全量队伍信息 -->
        <onCrossTeamMemberPosChange>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMemberPosChange>

        <onCrossTeamDisband>
            <Arg>           TEAMID                  </Arg>
        </onCrossTeamDisband>

        <!-- ================ 客户端接口对齐补充推送（对齐梳理 §3） ================ -->
        <!-- 队伍预览回包（决策 D4/注记 5）：复用 CROSS_TEAM_CACHE_VAL 结构 -->
        <onCrossTeamPreview>
            <Arg>           CROSS_TEAM_CACHE_VAL    </Arg>
        </onCrossTeamPreview>

        <onCrossTeamApplyList>
            <Arg>   ARRAY <of> CROSS_TEAM_APPLY_VAL </of>    </Arg>
        </onCrossTeamApplyList>

        <onCrossTeamApplyRemove>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamApplyRemove>

        <onCrossTeamMatchStart>
            <Arg>           LONGTIME                </Arg>
        </onCrossTeamMatchStart>

        <onCrossTeamMatchStop>
        </onCrossTeamMatchStop>

        <!-- 成员语音状态变更（决策 2 独立推送；UINT8 状态位图，语义同本服 reqUpdateVoiceRoomState） -->
        <onCrossTeamMemberVoiceState>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UINT8                   </Arg>
        </onCrossTeamMemberVoiceState>

        <!-- 成员改名通知（中心 renameMember 后 memberRenamePush 全队广播，客户端刷新成员名展示） -->
        <onCrossTeamMemberRename>
            <Arg>           PLAYER_GBID             </Arg>
            <Arg>           UNICODE                 </Arg>
        </onCrossTeamMemberRename>

        <!-- 副团长变更（空接口配套占位） -->
        <onCrossTeamDeputyChange>
            <Arg>           PLAYER_GBID             </Arg>
        </onCrossTeamDeputyChange>

        <!-- 队伍标记变更（单条增量下发客户端；changeType 对齐本服 TeamMarkChangeType：
             1=ADD 3=DELETE 4=CAPTAIN 开关变更。DELETE 时 markInfo 为被删标记的完整快照
             （客户端按 type/index 摘除即可）；CAPTAIN 时 markInfo 为空、仅 onlyCaptainCanMark
             有效，且始终携带当前值供冗余校准） -->
        <onCrossTeamMarkChange>
            <Arg>           UINT8                   </Arg>
            <Arg>           CLIENT_TEAM_MARK_VAL    </Arg>
            <Arg>           BOOL                    </Arg>
        </onCrossTeamMarkChange>

        <onCrossTeamFollowCaptainAsk>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           POSITION_ARG            </Arg>
        </onCrossTeamFollowCaptainAsk>

        <onCrossTeamRefreshDungeonCD>
            <Arg>           LONGTIME                </Arg>
        </onCrossTeamRefreshDungeonCD>

        <!-- 挑战次数不足提示（沿用旧组队客户端协议，原 iAvatarTeamDungeon.def 迁入）：
             onLackChallengeNum 发给进本发起者，携带次数不足成员名列表；
             onMemberNoRewardNum 发给次数不足的成员本人 -->
        <onLackChallengeNum>
            <Arg>           DUNGEON_NO              </Arg>
            <Arg>           ARRAY <of>  UNICODE </of> </Arg>
        </onLackChallengeNum>

        <onMemberNoRewardNum>
            <Arg>           DUNGEON_NO              </Arg>
        </onMemberNoRewardNum>
    </ClientMethods>

</root>
