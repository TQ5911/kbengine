        </pointIndex>

        <escortDistance>
            <Type>          UINT32          </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </escortDistance>

        <escortLeaveDistance>
            <Type>          UINT32          </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </escortLeaveDistance>

        <escortTrapId>
            <Type>        UINT32            </Type>
