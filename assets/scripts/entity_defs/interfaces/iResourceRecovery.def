<root>
    <Properties>
        <freeTicketUseInfo>
            <Type>          PY_DICT                     </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    True                        </Persistent>
            <Default>       {}                           </Default>
        </freeTicketUseInfo>
        <freeTickeRecoveryInfo>
            <Type>          PY_DICT                     </Type>
            <Flags>         BASE                        </Flags>
            <Default>       {}                          </Default>
        </freeTickeRecoveryInfo>
        <subType2FreeTicketInfo>
            <Type>          PY_DICT                     </Type>
            <Flags>         BASE                        </Flags>
            <Default>       {}                          </Default>
        </subType2FreeTicketInfo>

        <tRecoveryLastUpdateTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                </Flags>
            <Default>       0                 </Default>
            <Persistent>    true           </Persistent>
        </tRecoveryLastUpdateTime>
    </Properties>

    <BaseMethods>
        <reqFreeTicketRecovery> <Exposed/>
            <Arg>   UINT16       </Arg>
            <Arg>   UINT32       </Arg>
            <Arg>   UINT16       </Arg>
        </reqFreeTicketRecovery>

        <reqFreeTicketOneClickRecovery> <Exposed/>
            <Arg>   UINT16       </Arg>
            <Arg>   UINT16       </Arg>
        </reqFreeTicketOneClickRecovery>
        
        <onUpdateFreeTicketNumConfig>
            <Arg>   ARRAY   <of>    UINT16     </of>   </Arg>
        </onUpdateFreeTicketNumConfig>

        <onTryAddUseCoinTimesFreeTicket>
            <Arg>        UINT16      </Arg>
        </onTryAddUseCoinTimesFreeTicket>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onFreeTicketRecoveryInfo>
            <Arg>   UINT16       </Arg>
            <Arg>   ARRAY   <of>    FREE_TICKET_RECOVERY_CLIENT_VAL     </of>   </Arg>
            <Arg>   UINT16       </Arg>
        </onFreeTicketRecoveryInfo>

        <onFreeTicketOneClickRecoveryInfo>
            <Arg>   ARRAY   <of>    FREE_TICKET_ONE_CLICK_RECOVERY_CLIENT_VAL     </of>   </Arg>
        </onFreeTicketOneClickRecoveryInfo>

        <onUseCoinTimesTicketDatas>
            <Arg>  UINT16   </Arg>
            <Arg>  ARRAY <of>  COIN_TICKET_CLIENT_VAL </of>   </Arg>
        </onUseCoinTimesTicketDatas>
    </ClientMethods>
</root>
