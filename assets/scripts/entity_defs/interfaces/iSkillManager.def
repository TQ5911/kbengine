        </mulSpeed>
        <selectedTargetId>
            <Type>          INT32          </Type>
            <Flags>         ALL_CLIENTS     </Flags>
        </selectedTargetId>

        <effectEventCDInfo>
            <Type>          PY_DICT                 </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       {}                      </Default>
            <Persistent>    true                    </Persistent>
        </effectEventCDInfo>

        <adjAccuracy>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </adjAccuracy>
        <baseAccuracy>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </baseAccuracy>

        <adjEvasion>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </adjEvasion>
        <baseEvasion>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </baseEvasion>

        <skillTimerDic>
            <Type>          PY_DICT         </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </skillTimerDic>

        <checkShieldTimerId>
            <Type>          TIMER_ID            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
        </checkShieldTimerId>

        <skillForbidTagDic>
            <Type>              PY_DICT             </Type>
            <Flags>             CELL_PRIVATE        </Flags>
        </skillForbidTagDic>
    </Properties>

    <CellMethods>
        <addBuff>
            <Arg>        BUFFID        </Arg>
            <Arg>        LEVEL         </Arg>
            <Arg>        OBJECT_ID     </Arg>
        </addBuff>

        <removeBuff>
            <Arg>        BUFFID        </Arg>
            <Arg>        PYTHON        </Arg>
        </removeBuff>

        <modifyHP>
            <Arg>        INT32        </Arg>
            <Arg>        OBJECT_ID    </Arg>
            <Arg>        UINT8        </Arg>
            <Arg>        UINT32       </Arg>
        </modifyHP>

        <modifyMP>
            <Arg>        INT32        </Arg>
        </modifyMP>

        <setState>
            <Arg>        STATE        </Arg>
        </setState>

        <removeState>
            <Arg>        STATE        </Arg>
        </removeState>

        <cancelChargeSkill>
            <Exposed/>
            <Arg>        SKILLID        </Arg>
        </cancelChargeSkill>

        <addShield>
            <Arg>        BUFFID        </Arg>
            <Arg>        INT32        </Arg>
        </addShield>

        <removeShield>
            <Arg>        BUFFID        </Arg>
        </removeShield>

        <removeCreation>
            <Arg>        OBJECT_ID        </Arg>
        </removeCreation>

        <removeSummonById>
            <Arg>        OBJECT_ID        </Arg>
        </removeSummonById>

        <displacedBySkill>
            <Arg>        OBJECT_ID        </Arg>
            <Arg>        PYTHON           </Arg>
            <Arg>        FLOAT         </Arg>
            <Arg>        FLOAT         </Arg>
        </displacedBySkill>

        <getBuffInfo> <Exposed/>
            <Arg>        OBJECT_ID        </Arg>
        </getBuffInfo>

        <getAureoleInfo> <Exposed/>
            <Arg>        OBJECT_ID        </Arg>
        </getAureoleInfo>

        <onCloneDestroy>
            <Arg>        UINT32         </Arg>
        </onCloneDestroy>

        <reliveToPos>
            <Arg>           PYTHON         </Arg>
            <Arg>           PYTHON         </Arg>
            <Arg>           HP             </Arg>
            <Arg>           PYTHON         </Arg>
        </reliveToPos>

        <doActionOnChangeSlot>
            <Arg>           SKILLID        </Arg>
            <Arg>           LEVEL          </Arg>
            <Arg>           BOOL           </Arg>
            <Arg>           BOOL           </Arg>
            <Arg>           DOUBLETIME     </Arg>
        </doActionOnChangeSlot>

        <removeSkill>
            <Arg>           SKILLID        </Arg>
            <Arg>           BOOL           </Arg>
        </removeSkill>

        <changeMorphPreAddSkill>
            <Arg>          MORPH_STATE  </Arg>
        </changeMorphPreAddSkill>
    </CellMethods>

    <ClientMethods>
        <onAddSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        LEVEL          </Arg>
            <Arg>        UINT8          </Arg>
            <Arg>        DOUBLETIME     </Arg>
            <Arg>        FLOAT          </Arg>
            <Arg>        BOOL           </Arg>
        </onAddSkill>

        <onAddPassiveSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        LEVEL          </Arg>
        </onAddPassiveSkill>

        <onUseSkill>
            <Arg>        BOOL            </Arg>
            <Arg>        SKILLID         </Arg>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
            <Arg>        ARRAY <of> OBJECT_ID </of> </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
        </onUseSkill>

        <onUseCasting>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        SKILLID         </Arg>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
            <Arg>        ARRAY <of> OBJECT_ID </of> </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
        </onUseCasting>

        <onUseChanneling>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        SKILLID         </Arg>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
            <Arg>        ARRAY <of> OBJECT_ID </of> </Arg>
            <Arg>        INT32           </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
        </onUseChanneling>

        <onSkillDamage>
            <Arg>        SKILL_DAMAGE_INFO   </Arg>
        </onSkillDamage>

        <onOthersSkillDamage>
            <Arg>        INT32                      </Arg>
            <Arg>        ARRAY <of> OBJECT_ID </of> </Arg>
        </onOthersSkillDamage>

        <onAddAureole>
            <Arg>        CLIENT_AUREOLE_VAL   </Arg>
        </onAddAureole>

        <onRemoveAureole>
            <Arg>        AUREOLEID        </Arg>
        </onRemoveAureole>

        <onUpdateAureoles>
            <Arg>        CLIENT_AUREOLES   </Arg>
        </onUpdateAureoles>

        <onAddAureoleFromOthers>
            <Arg>        CLIENT_AUREOLE_VAL        </Arg>
        </onAddAureoleFromOthers>

        <onRemoveAureoleFromOthers>
            <Arg>        AUREOLEID        </Arg>
        </onRemoveAureoleFromOthers>

        <onUpdateAureolesFromOthers>
            <Arg>        AUREOLE_FROM_OTHERS   </Arg>
        </onUpdateAureolesFromOthers>

        <onMessage>
            <Arg>        INT32                        </Arg>
            <Arg>        ARRAY <of> UNICODE </of>     </Arg>
        </onMessage>

        <onBreakCastingSkill>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        SKILLID         </Arg>
            <Arg>        INT32           </Arg>
        </onBreakCastingSkill>

        <onBreakChannelingSkill>
            <Arg>        OBJECT_ID       </Arg>
            <Arg>        SKILLID         </Arg>
            <Arg>        INT32           </Arg>
        </onBreakChannelingSkill>

        <onUpdateBuffs>
            <Arg>        CLIENT_BUFFS   </Arg>
        </onUpdateBuffs>

        <onAddBuff>
            <Arg>        CLIENT_BUFF_VAL    </Arg>
        </onAddBuff>

        <onRemoveBuff>
            <Arg>        BUFFID             </Arg>
            <Arg>        ARRAY <of> UINT64 </of>      </Arg>
        </onRemoveBuff>

        <onUpdateBuff>
            <Arg>        CLIENT_BUFF_VAL    </Arg>
        </onUpdateBuff>

        <onGetBuffInfo>
            <Arg>        OBJECT_ID          </Arg>
            <Arg>        CLIENT_BUFFS       </Arg>
        </onGetBuffInfo>

        <onGetAureoleInfo>
            <Arg>        OBJECT_ID          </Arg>
            <Arg>        CLIENT_AUREOLES     </Arg>
        </onGetAureoleInfo>

        <onSetAddSkillCd>
            <Arg>        SKILLID          </Arg>
            <Arg>        FLOAT            </Arg>
            <Arg>        DOUBLETIME       </Arg>
            <Arg>        BOOL             </Arg>
            <Arg>        DOUBLETIMESTAMP  </Arg>
            <Arg>        INT8             </Arg>
            <Arg>        INT8             </Arg>
            <Arg>        BOOL             </Arg>
        </onSetAddSkillCd>

        <notifyCastingSkill>
            <Arg>        SKILLID         </Arg>
            <Arg>        DOUBLETIMESTAMP </Arg>
        </notifyCastingSkill>

        <onShooterSkillCanUse>
            <Arg>        SKILLID         </Arg>
            <Arg>        DOUBLETIME      </Arg>
            <Arg>        UINT8           </Arg>
        </onShooterSkillCanUse>

        <onExitShiftByConflict>
            <Arg>        POSITION3D         </Arg>
        </onExitShiftByConflict>

        <onStateChangedForce>
            <Arg>        UINT8              </Arg>
        </onStateChangedForce>

        <drawCube>
            <Arg>        POSITION3D         </Arg>
            <Arg>        POSITION3D         </Arg>
            <Arg>        FLOAT              </Arg>
            <Arg>        FLOAT              </Arg>
        </drawCube>

        <updateForbidSkillTags>
            <Arg>        ARRAY <of> UINT16 </of>     </Arg>
        </updateForbidSkillTags>
    </ClientMethods>
</root>
