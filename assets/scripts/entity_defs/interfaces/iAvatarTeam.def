<?xml version="1.0" encoding="utf-8"?>
<root>
    <Interfaces>
        <Interface> iAvatarStatistic   </Interface>
    </Interfaces>
    <Properties>
        <teamId>
            <Type>          TEAMID          </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Persistent>    true            </Persistent>
            <WitnessName>   true            </WitnessName>
        </teamId>

        <teamIdBase>
            <Type>          TEAMID          </Type>
            <Flags>         BASE            </Flags>
        </teamIdBase>

        <followCaptain>
            <Type>          UINT8           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
        </followCaptain>

        <teammateEntIdInAoiSet>
            <Type>          PY_SET          </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       set()           </Default>
        </teammateEntIdInAoiSet>

        <bTeamCaptain>
            <Type>          BOOL            </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </bTeamCaptain>

        <teamTimerId>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </teamTimerId>

        <replyTeamCaptainTimer>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </replyTeamCaptainTimer>

        <replyFollowCaptainTimer>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </replyFollowCaptainTimer>

        <teamInfo>
            <Type>          TEAM_INFO_CACHE </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </teamInfo>

        <followInfo>
            <Type>          PY_DICT         </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       {}              </Default>
        </followInfo>

        <teamFriends>
            <Type>          PY_LIST         </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       []              </Default>
        </teamFriends>

        <autoMatchStartTime>
            <Type>          LONGTIME        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </autoMatchStartTime>

        <autoMatchTarget>
            <Type>          TEAMTARGET      </Type>
            <Flags>         OWN_CLIENT      </Flags>
            <Default>       0               </Default>
        </autoMatchTarget>

        <autoAskTeam>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </autoAskTeam>
    </Properties>

    <BaseMethods>
        <beCheckedBaseByTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           PYTHON          </Arg>
        </beCheckedBaseByTeam>
        <notifyCaptainTeamMemOffline>
            <Arg>       TEAMID          </Arg>
            <Arg>       PLAYER_GBID     </Arg>
        </notifyCaptainTeamMemOffline>

        <switchTeamMicsModeBase>
            <Arg>           TEAMID          </Arg>
            <Arg>           UINT8           </Arg>
        </switchTeamMicsModeBase>

        <turnOnTeamMicsBase>
            <Arg>           TEAMID          </Arg>
        </turnOnTeamMicsBase>

        <onLeaveTeamBase>
        </onLeaveTeamBase>

        <onJoinTeamBase>
            <Arg>       TEAMID              </Arg>
        </onJoinTeamBase>
    </BaseMethods>

    <CellMethods>
        <applyCreateTeam> <Exposed/>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           BOOL            </Arg>
        </applyCreateTeam>

        <applyJoinTeam> <Exposed/>
            <Arg>           TEAMID          </Arg>
            <Arg>           STRING          </Arg>
        </applyJoinTeam>

        <onApplyJoinTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </onApplyJoinTeam>

        <replyJoinTeam> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyJoinTeam>

        <onReplyJoinTeam>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
        </onReplyJoinTeam>

        <onRemoveApplyJoinPlayer>
            <Arg>           TEAMID          </Arg>
        </onRemoveApplyJoinPlayer>

        <applyInviteTeam> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </applyInviteTeam>

        <replyInviteTeam> <Exposed/>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyInviteTeam>

        <onReplyInviteTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           PY_DICT         </Arg>
        </onReplyInviteTeam>

        <applyBecomeCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyBecomeCaptain>

        <applyLeaveTeam> <Exposed/>
        </applyLeaveTeam>

        <applyKickTeamMember> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyKickTeamMember>

        <applyTransferCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyTransferCaptain>

        <onTransferCaptain>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </onTransferCaptain>

        <replyBecomeCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyBecomeCaptain>

        <applyDisbandTeam> <Exposed/>
        </applyDisbandTeam>

        <onLeaveTeam>
        </onLeaveTeam>

        <onJoinTeam>
            <Arg>           TEAMID          </Arg>
        </onJoinTeam>

        <procJoinTeamMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           SEX             </Arg>
            <Arg>           SCORE           </Arg>
        </procJoinTeamMsg>

        <procInviteTeamMsg>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
        </procInviteTeamMsg>

        <procBecomeCaptainMsg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </procBecomeCaptainMsg>

        <onTeamDisband>
            <Arg>           BOOL            </Arg>
        </onTeamDisband>

        <procDirectJoinMsg>
            <Arg>           TEAMID          </Arg>
        </procDirectJoinMsg>

        <sendAllMemberFollowAsk> <Exposed/>
        </sendAllMemberFollowAsk>

        <reqCaptainFollowInfo> <Exposed/>
        </reqCaptainFollowInfo>

        <sendOneMemberFollowAsk> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </sendOneMemberFollowAsk>

        <cancelAllMemberFollow> <Exposed/>
        </cancelAllMemberFollow>

        <applyFollowTeamCaptain> <Exposed/>
        </applyFollowTeamCaptain>

        <confirmFollowTeamCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </confirmFollowTeamCaptain>

        <cancelFollowTeamCaptain> <Exposed/>
        </cancelFollowTeamCaptain>

        <selfCancelFollowTeamCaptain>
            <Arg>   STRING  </Arg>
        </selfCancelFollowTeamCaptain>

        <followCaptainToGuildSpaceFailed>
        </followCaptainToGuildSpaceFailed>

        <cellPlayerFollowToGuildSpaceFailed>
            <Arg>      ENTITYCALL      </Arg>
        </cellPlayerFollowToGuildSpaceFailed>

        <replyFollowTeamCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </replyFollowTeamCaptain>

        <onCaptainCancleFollowTeam>
        </onCaptainCancleFollowTeam>

        <requestCaptainFollowProps>
            <Arg>           MAILBOX         </Arg>
        </requestCaptainFollowProps>

        <onRequestCaptainFollowProps>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
            <Arg>           DUNGEON_SRC          </Arg>
        </onRequestCaptainFollowProps>

        <onAddTeamMemberCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITYCALL      </Arg>
        </onAddTeamMemberCell>

        <onAddTeamCell>
            <Arg>           TEAM_INFO       </Arg>
        </onAddTeamCell>

        <onDelTeamMemberCell>
            <Arg>           PLAYER_GBID     </Arg>
        </onDelTeamMemberCell>

        <onChangeCaptainCell>
            <Arg>           PLAYER_GBID     </Arg>
        </onChangeCaptainCell>

        <onUpdateOnlineCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITYCALL      </Arg>
        </onUpdateOnlineCell>

        <onFollowCaptainChangedCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </onFollowCaptainChangedCell>

        <onUpdateTeamMemberCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </onUpdateTeamMemberCell>

        <clearApplyJoinDic><Exposed/>
        </clearApplyJoinDic>

        <beCheckedCellByTeam>
            <Arg>           UINT8           </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           PYTHON          </Arg>
        </beCheckedCellByTeam>

        <onCheckResultFromMember>
            <Arg>           UINT8           </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </onCheckResultFromMember>

        <addTeamFriends>
            <Arg>   ARRAY       <of>    PLAYER_GBID          </of>    </Arg>
        </addTeamFriends>

        <onGetAvatarInterInfo>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           UNICODE         </Arg>
        </onGetAvatarInterInfo>

        <reqTeamAutoMatch><Exposed/>
        </reqTeamAutoMatch>

        <reqTeamStopAutoMatch><Exposed/>
        </reqTeamStopAutoMatch>

        <reqPlayerAutoMatch><Exposed/>
            <Arg>           TEAMTARGET       </Arg>
        </reqPlayerAutoMatch>
        <onPlayerMatchedTeam>
            <Arg>           TEAMID           </Arg>
        </onPlayerMatchedTeam>
        <reqPlayerStopAutoMatch><Exposed/>
        </reqPlayerStopAutoMatch>
        <onCellPlayerStartAutoMatch>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
        </onCellPlayerStartAutoMatch>
        <onPlayerMatchedSucc>
        </onPlayerMatchedSucc>
        <onPlayerAutoMatchTimeout>
        </onPlayerAutoMatchTimeout>
        <reqSetTeamTarget><Exposed/>
            <Arg>           UINT32           </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           UNICODE          </Arg>
            <Arg>           STRING           </Arg>
            <Arg>           BOOL             </Arg>
        </reqSetTeamTarget>
        <reqGetTeamInfo><Exposed/>
            <Arg>           TEAMID           </Arg>
        </reqGetTeamInfo>
        <reqGetTeamList><Exposed/>
            <Arg>           LONGTIME           </Arg>
            <Arg>           TEAMTARGET         </Arg>
        </reqGetTeamList>
        <checkInTeam>
            <Arg>      ENTITYCALL    </Arg>
            <Arg>      METHOD_NAME   </Arg>
            <Arg>      METHOD_ARGS   </Arg>
        </checkInTeam>

        <AddTeamCaptainFrdNtf>
            <Arg>           TEAMID            </Arg>
            <Arg>           PLAYER_GBID       </Arg>
        </AddTeamCaptainFrdNtf>

        <onNameChangeNotifyTeam>
        </onNameChangeNotifyTeam>

        <onTeamInviteOffline>
            <Arg>           PLAYER_GBID         </Arg>
        </onTeamInviteOffline>

        <onGetTeamListFinished>
            <Arg>           UINT32          </Arg>
            <Arg>           TEAMTARGET      </Arg>
        </onGetTeamListFinished>

        <onAskedFollowCaptain>
        </onAskedFollowCaptain>

        <onMemJoinTeamByAutoMatch>
            <Arg>           PLAYER_GBID         </Arg>
        </onMemJoinTeamByAutoMatch>

        <reqUpdateTeamSilentAttr><Exposed/>
            <Arg>       BOOL                 </Arg>
        </reqUpdateTeamSilentAttr>

        <clientSetAutoAskTeam><Exposed/>
            <Arg>        INT32        </Arg>
        </clientSetAutoAskTeam>

        <setAutoAskTeam>
            <Arg>        INT32              </Arg>
        </setAutoAskTeam>

        <removeAutoAskTeam>
            <Arg>        INT32              </Arg>
        </removeAutoAskTeam>

        <resetTryAddTeamCD>
        </resetTryAddTeamCD>

        <notifyTeamMemberLogon>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           BOOL            </Arg>
        </notifyTeamMemberLogon>

        <IDIPBanTeam>
            <Arg>           LONGTIME        </Arg>
            <Arg>           PYTHON          </Arg>
        </IDIPBanTeam>

        <!-- 开启小队麦功能 -->
        <switchTeamMicsMode>
            <Exposed/>
            <Arg> UINT8 </Arg>
        </switchTeamMicsMode>

        <!-- 小队成员打开麦克风 -->
        <turnOnTeamMics>
            <Exposed/>
        </turnOnTeamMics>

        <!-- 小队成员关闭麦克风 -->
        <turnOffTeamMics>
            <Exposed/>
        </turnOffTeamMics>

        <turnOnTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </turnOnTeamMemberMics>

        <turnOffTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </turnOffTeamMemberMics>

        <!-- 小队禁言团员 -->
        <blockTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </blockTeamMemberMics>

        <!-- 小队解除团员禁言 -->
        <unblockTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </unblockTeamMemberMics>

        <blockAllTeamMemberMics>
            <Exposed/>
        </blockAllTeamMemberMics>

        <unblockAllTeamMemberMics>
            <Exposed/>
        </unblockAllTeamMemberMics>

        <addFullHpByNpc>
        </addFullHpByNpc>

        <turnOffTeamMicsByForbidVoiceChat>
        </turnOffTeamMicsByForbidVoiceChat>

        <reqAddMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITY_ID           </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </reqAddMarkMember>
        <reqDelMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
        </reqDelMarkMember>
        <reqChangeOnlyCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </reqChangeOnlyCaptain>

        <reqJoinTeam> <Exposed/>
            <Arg> TEAMID  </Arg>
            <Arg> STRING  </Arg>
        </reqJoinTeam>

        <addTeamDungeonRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </addTeamDungeonRewardRecord>
    </CellMethods>

    <ClientMethods>
        <onApplyJoinTeamMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           SEX             </Arg>
            <Arg>           SCORE           </Arg>
        </onApplyJoinTeamMsg>

        <onApplyInviteTeamMsg>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
        </onApplyInviteTeamMsg>

        <onAddTeamMember>
            <Arg>           CLIENT_TEAM_MEMBER_VAL     </Arg>
        </onAddTeamMember>

        <onAddTeam>
            <Arg>           CLIENT_TEAM_INFO</Arg>
        </onAddTeam>

        <onLeaveTeam>
        </onLeaveTeam>

        <onTeamDisband>
        </onTeamDisband>

        <onRemoveFromApplyList>
            <Arg>           PLAYER_GBID     </Arg>
        </onRemoveFromApplyList>

        <onApplyBecomeCaptainMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </onApplyBecomeCaptainMsg>

        <onChangeCaptain>
            <Arg>           PLAYER_GBID     </Arg>
        </onChangeCaptain>

        <onNotifyApplyJoinInfo>
            <Arg>   ARRAY <of> APPLY_JOIN_INFO </of>    </Arg>
        </onNotifyApplyJoinInfo>

        <onFollowTeamCaptainAsk>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </onFollowTeamCaptainAsk>

        <onUpdateMemberAttr>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCORE           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           OUTFIT_ID       </Arg>
        </onUpdateMemberAttr>

        <onUpdateTeamMemberHp>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           HP              </Arg>
            <Arg>           HP              </Arg>
        </onUpdateTeamMemberHp>

        <onUpdateTeamMemberScore>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SCORE           </Arg>
        </onUpdateTeamMemberScore>

        <onUpdateTeamMemberPos>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </onUpdateTeamMemberPos>

        <onTeamAutoMatch>
            <Arg>           LONGTIME           </Arg>
        </onTeamAutoMatch>

        <onTeamStopAutoMatch>
        </onTeamStopAutoMatch>

        <onSetTeamTarget>
            <Arg>           TEAMID           </Arg>
            <Arg>           TEAMTARGET       </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           STRING           </Arg>
            <Arg>           BOOL             </Arg>
            <Arg>           UNICODE          </Arg>
        </onSetTeamTarget>
        <onApplyJoinTeamFailed>
            <Arg>           UINT16       </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           UINT16       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           STRING       </Arg>
        </onApplyJoinTeamFailed>
        <onGetTeamList>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
            <Arg>      ARRAY <of> CLIENT_TEAM_INFO  </of>      </Arg>
        </onGetTeamList>

        <onGetAllTeamList>
            <Arg>           TEAMTARGET       </Arg>
        </onGetAllTeamList>

        <onUnblockTeamMemberMisc>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onUnblockTeamMemberMisc>

        <onDelTeamMember>
            <Arg>           PLAYER_GBID     </Arg>
        </onDelTeamMember>

        <onChangeTeamMark>
            <Arg>           CLIENT_TEAM_MARK_INFO           </Arg>
        </onChangeTeamMark>

        <onAddTeamDungeonRewardRecord>
            <Arg>           TEAMID                                                  </Arg>
            <Arg>           PLAYER_GBID                                             </Arg>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onAddTeamDungeonRewardRecord>
    </ClientMethods>
</root>
