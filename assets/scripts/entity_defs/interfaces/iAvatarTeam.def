<?xml version="1.0" encoding="utf-8"?>
<root>
    <Properties>
        <teamId>
            <Type>          TEAMID          </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Persistent>    true            </Persistent>
            <WitnessName>   true            </WitnessName>
        </teamId>

        <joinType>
            <Type>          INT8            </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </joinType>

        <teamIdBase>
            <Type>          TEAMID          </Type>
            <Flags>         BASE            </Flags>
        </teamIdBase>

        <teammateEntIdInAoiSet>
            <Type>          PY_SET          </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       set()           </Default>
        </teammateEntIdInAoiSet>

        <bTeamCaptain>
            <Type>          BOOL            </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </bTeamCaptain>

        <teamTimerId>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </teamTimerId>

        <replyTeamCaptainTimer>
            <Type>          TIMER_ID        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </replyTeamCaptainTimer>

        <teamInfo>
            <Type>          TEAM_INFO_CACHE </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </teamInfo>

        <autoMatchStartTime>
            <Type>          LONGTIME        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
        </autoMatchStartTime>

        <autoMatchTarget>
            <Type>          TEAMTARGET      </Type>
            <Flags>         OWN_CLIENT      </Flags>
            <Default>       0               </Default>
        </autoMatchTarget>

        <autoAskTeam>
            <Type>          INT32           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
            <Default>       0               </Default>
            <Persistent>    true            </Persistent>
        </autoAskTeam>
    </Properties>

    <BaseMethods>
        <checkedBaseByTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           PYTHON          </Arg>
        </checkedBaseByTeam>
        <notifyCaptainTeamMemOffline>
            <Arg>       TEAMID          </Arg>
            <Arg>       PLAYER_GBID     </Arg>
        </notifyCaptainTeamMemOffline>

        <switchTeamMicsModeBase>
            <Arg>           TEAMID          </Arg>
            <Arg>           UINT8           </Arg>
        </switchTeamMicsModeBase>

        <turnOnTeamMicsBase>
            <Arg>           TEAMID          </Arg>
        </turnOnTeamMicsBase>

        <onLeaveTeamBase>
        </onLeaveTeamBase>

        <onJoinTeamBase>
            <Arg>       TEAMID              </Arg>
        </onJoinTeamBase>
    </BaseMethods>

    <CellMethods>
        <applyCreateTeam> <Exposed/>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           BOOL            </Arg>
        </applyCreateTeam>

        <applyJoinTeam> <Exposed/>
            <Arg>           TEAMID          </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           INT8            </Arg>
        </applyJoinTeam>

        <onApplyJoinTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </onApplyJoinTeam>

        <replyJoinTeam> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyJoinTeam>

        <onReplyJoinTeam>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           INT8            </Arg>
        </onReplyJoinTeam>

        <onRemoveApplyJoinPlayer>
            <Arg>           TEAMID          </Arg>
        </onRemoveApplyJoinPlayer>

        <applyInviteTeam> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </applyInviteTeam>

        <replyInviteTeam> <Exposed/>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
        </replyInviteTeam>

        <onReplyInviteTeam>
            <Arg>           BOOL            </Arg>
            <Arg>           PY_DICT         </Arg>
            <Arg>           UINT8           </Arg>
        </onReplyInviteTeam>

        <applyBecomeCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyBecomeCaptain>

        <applyLeaveTeam> <Exposed/>
        </applyLeaveTeam>

        <applyKickTeamMember> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyKickTeamMember>

        <applyTransferCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
        </applyTransferCaptain>

        <onTransferCaptain>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </onTransferCaptain>

        <replyBecomeCaptain> <Exposed/>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyBecomeCaptain>

        <applyDisbandTeam> <Exposed/>
        </applyDisbandTeam>

        <onLeaveTeam>
        </onLeaveTeam>

        <onJoinTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           INT8            </Arg>
        </onJoinTeam>

        <procJoinTeamMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           SEX             </Arg>
            <Arg>           SCORE           </Arg>
        </procJoinTeamMsg>

        <procInviteTeamMsg>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           SCORE           </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
        </procInviteTeamMsg>

        <processBecomeCaptainMsg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </processBecomeCaptainMsg>

        <onTeamDisband>
            <Arg>           BOOL            </Arg>
        </onTeamDisband>

        <sendAllMemberFollowAsk> <Exposed/>
        </sendAllMemberFollowAsk>

        <reqCaptainFollowInfo> <Exposed/>
        </reqCaptainFollowInfo>

        <cancelAllMemberFollow> <Exposed/>
        </cancelAllMemberFollow>

        <applyFollowTeamCaptain> <Exposed/>
        </applyFollowTeamCaptain>

        <confirmFollowTeamCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </confirmFollowTeamCaptain>

        <cancelFollowTeamCaptain> <Exposed/>
        </cancelFollowTeamCaptain>

        <replyFollowTeamCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </replyFollowTeamCaptain>

        <onAddTeamMemberToCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITYCALL      </Arg>
        </onAddTeamMemberToCell>

        <onAddTeamCell>
            <Arg>           TEAM_INFO       </Arg>
        </onAddTeamCell>

        <onDelTeamMemberCell>
            <Arg>           PLAYER_GBID     </Arg>
        </onDelTeamMemberCell>

        <onChangeCaptainCell>
            <Arg>           PLAYER_GBID     </Arg>
        </onChangeCaptainCell>

        <onUpdateOnlineCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITYCALL      </Arg>
        </onUpdateOnlineCell>

        <onUpdateTeamMemberCell>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </onUpdateTeamMemberCell>

        <clearApplyJoinDic><Exposed/>
        </clearApplyJoinDic>

        <checkedCellByTeam>
            <Arg>           UINT8           </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           PYTHON          </Arg>
        </checkedCellByTeam>

        <checkResultFromMember>
            <Arg>           UINT8           </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </checkResultFromMember>

        <onGetAvatarInterInfo>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           UNICODE         </Arg>
        </onGetAvatarInterInfo>

        <reqTeamAutoMatch><Exposed/>
        </reqTeamAutoMatch>

        <reqTeamStopAutoMatch><Exposed/>
        </reqTeamStopAutoMatch>

        <reqPlayerAutoMatch><Exposed/>
            <Arg>           TEAMTARGET       </Arg>
        </reqPlayerAutoMatch>
        <onPlayerMatchedTeam>
            <Arg>           TEAMID           </Arg>
        </onPlayerMatchedTeam>
        <reqPlayerStopAutoMatch><Exposed/>
        </reqPlayerStopAutoMatch>
        <cellPlayerStartAutoMatch>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
        </cellPlayerStartAutoMatch>
        <onPlayerMatchedSuccess>
        </onPlayerMatchedSuccess>
        <onPlayerAutoMatchTimeout>
        </onPlayerAutoMatchTimeout>
        <reqSetTeamTarget><Exposed/>
            <Arg>           UINT32           </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           UNICODE          </Arg>
            <Arg>           STRING           </Arg>
            <Arg>           BOOL             </Arg>
        </reqSetTeamTarget>
        <reqGetTeamInfo><Exposed/>
            <Arg>           TEAMID           </Arg>
        </reqGetTeamInfo>
        <reqGetTeamList><Exposed/>
            <Arg>           LONGTIME           </Arg>
            <Arg>           TEAMTARGET         </Arg>
        </reqGetTeamList>
        <checkInTeam>
            <Arg>      ENTITYCALL    </Arg>
            <Arg>      METHOD_NAME   </Arg>
            <Arg>      METHOD_ARGS   </Arg>
        </checkInTeam>

        <onNameChangeNotifyTeam>
        </onNameChangeNotifyTeam>

        <onTeamInviteOffline>
            <Arg>           PLAYER_GBID         </Arg>
        </onTeamInviteOffline>

        <onGetTeamListFinished>
            <Arg>           UINT32          </Arg>
            <Arg>           TEAMTARGET      </Arg>
        </onGetTeamListFinished>

        <reqUpdateTeamSilentAttr><Exposed/>
            <Arg>       BOOL                 </Arg>
        </reqUpdateTeamSilentAttr>

        <clientSetAutoAskTeam><Exposed/>
            <Arg>        INT32        </Arg>
        </clientSetAutoAskTeam>

        <resetTryAddTeamCD>
        </resetTryAddTeamCD>

        <notifyTeamMemberLogon>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           BOOL            </Arg>
        </notifyTeamMemberLogon>

        <IDIPBanTeam>
            <Arg>           LONGTIME        </Arg>
            <Arg>           PYTHON          </Arg>
        </IDIPBanTeam>

        <!-- 开启小队麦功能 -->
        <switchTeamMicsMode>
            <Exposed/>
            <Arg> UINT8 </Arg>
        </switchTeamMicsMode>

        <!-- 小队成员打开麦克风 -->
        <turnOnTeamMics>
            <Exposed/>
        </turnOnTeamMics>

        <!-- 小队成员关闭麦克风 -->
        <turnOffTeamMics>
            <Exposed/>
        </turnOffTeamMics>

        <!-- 小队禁言团员 -->
        <blockTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </blockTeamMemberMics>

        <!-- 小队解除团员禁言 -->
        <unblockTeamMemberMics>
            <Exposed/>
            <Arg>   PLAYER_GBID     </Arg>
        </unblockTeamMemberMics>

        <turnOffTeamMicsByForbidVoiceChat>
        </turnOffTeamMicsByForbidVoiceChat>

        <reqAddMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           ENTITY_ID           </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </reqAddMarkMember>
        <reqDelMarkMember> <Exposed/>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT8           </Arg>
        </reqDelMarkMember>
        <reqChangeOnlyCaptain> <Exposed/>
            <Arg>           BOOL            </Arg>
        </reqChangeOnlyCaptain>

        <reqJoinTeam> <Exposed/>
            <Arg> TEAMID  </Arg>
            <Arg> STRING  </Arg>
        </reqJoinTeam>

        <doApplyInviteTeam>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           UINT8           </Arg>
        </doApplyInviteTeam>
    </CellMethods>

    <ClientMethods>
        <onApplyJoinTeamMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           SEX             </Arg>
            <Arg>           SCORE           </Arg>
        </onApplyJoinTeamMsg>

        <onApplyInviteTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           UINT8           </Arg>
        </onApplyInviteTeam>

        <onAddTeamMember>
            <Arg>           CLIENT_TEAM_MEMBER_VAL     </Arg>
        </onAddTeamMember>

        <onAddTeam>
            <Arg>           CLIENT_TEAM_INFO</Arg>
        </onAddTeam>

        <onLeaveTeam>
        </onLeaveTeam>

        <onTeamDisband>
        </onTeamDisband>

        <onRemoveFromApplyList>
            <Arg>           PLAYER_GBID     </Arg>
        </onRemoveFromApplyList>

        <onApplyBecomeCaptainMsg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </onApplyBecomeCaptainMsg>

        <onChangeCaptain>
            <Arg>           PLAYER_GBID     </Arg>
        </onChangeCaptain>

        <onNotifyApplyJoinInfo>
            <Arg>   ARRAY <of> APPLY_JOIN_INFO </of>    </Arg>
        </onNotifyApplyJoinInfo>

        <onFollowTeamCaptainAsk>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </onFollowTeamCaptainAsk>

        <onUpdateMemberAttr>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCORE           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           OUTFIT_ID       </Arg>
        </onUpdateMemberAttr>

        <onUpdateTeamMemberHp>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           HP              </Arg>
            <Arg>           HP              </Arg>
        </onUpdateTeamMemberHp>

        <onUpdateTeamMemberScore>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SCORE           </Arg>
        </onUpdateTeamMemberScore>

        <onUpdateTeamMemberPos>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </onUpdateTeamMemberPos>

        <onUpdateTeamMemberPlayerName>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
        </onUpdateTeamMemberPlayerName>

        <onTeamAutoMatch>
            <Arg>           LONGTIME           </Arg>
        </onTeamAutoMatch>

        <onTeamStopAutoMatch>
        </onTeamStopAutoMatch>

        <onSetTeamTarget>
            <Arg>           TEAMID           </Arg>
            <Arg>           TEAMTARGET       </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           UINT32           </Arg>
            <Arg>           STRING           </Arg>
            <Arg>           BOOL             </Arg>
            <Arg>           UNICODE          </Arg>
        </onSetTeamTarget>
        <onApplyJoinTeamFailed>
            <Arg>           UINT16       </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           UINT16       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           STRING       </Arg>
            <Arg>           INT8         </Arg>
        </onApplyJoinTeamFailed>
        <onGetTeamList>
            <Arg>           LONGTIME         </Arg>
            <Arg>           TEAMTARGET       </Arg>
            <Arg>      ARRAY <of> CLIENT_TEAM_INFO  </of>      </Arg>
        </onGetTeamList>

        <onGetAllTeamList>
            <Arg>           TEAMTARGET       </Arg>
        </onGetAllTeamList>

        <onSwitchTeamMicsMode>
            <Arg>   TEAMID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT8       </Arg>
        </onSwitchTeamMicsMode>

        <onBlockTeamMemberMics>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onBlockTeamMemberMics>

        <onUnblockTeamMemberMics>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onUnblockTeamMemberMics>

        <onDelTeamMember>
            <Arg>           PLAYER_GBID     </Arg>
        </onDelTeamMember>

        <onChangeTeamMark>
            <Arg>           CLIENT_TEAM_MARK_INFO           </Arg>
        </onChangeTeamMark>

    </ClientMethods>
</root>
