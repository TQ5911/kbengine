<root>
    <Properties>
        <meridianData>
            <Type>    MERIDIAN_INFO          </Type>
            <Flags>   BASE              </Flags>
            <Persistent>    true        </Persistent>
        </meridianData>
    </Properties>

    <BaseMethods>
        <reqGetMeridianData> <Exposed/>
        </reqGetMeridianData>

        <reqLevelUpMeridianPoint> <Exposed/>
            <Arg>            UINT8               </Arg>
            <Arg>            UINT8               </Arg>
            <Arg>            UINT8               </Arg>
            <Arg>   ARRAY   <of>    MERIDIAN_ENHANCE_ITEM_INFO  </of>   </Arg>
        </reqLevelUpMeridianPoint>

        <reqEnhanceMeridianSlot> <Exposed/>
            <Arg>            UINT8               </Arg>
            <Arg>            UINT8               </Arg>
            <Arg>   ARRAY   <of>    MERIDIAN_ENHANCE_ITEM_INFO  </of>   </Arg>
        </reqEnhanceMeridianSlot>

    </BaseMethods>

    <CellMethods>
        <onMeridianAward>
            <Arg>      ARRAY    <of>    UINT32  </of>     </Arg>
        </onMeridianAward>
    </CellMethods>

    <ClientMethods>
        <onGetMeridianData>
            <Arg>            UINT8              </Arg>
            <Arg>            UINT8              </Arg>
            <Arg>   ARRAY   <of>    MERIDIAN_SLOT_INFO  </of>   </Arg>
        </onGetMeridianData>

        <onLeveUpMeridianPointTo>
            <Arg>            UINT8              </Arg>
            <Arg>            UINT8              </Arg>
            <Arg>            UINT8              </Arg>
        </onLeveUpMeridianPointTo>

        <onEnhanceMeridian>
            <Arg>            UINT8              </Arg>
        </onEnhanceMeridian>
        
    </ClientMethods>

</root>