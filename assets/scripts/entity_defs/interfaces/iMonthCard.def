<root>
    <Properties>
        <monthCardExpireTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE_AND_CLIENT         </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </monthCardExpireTime>

        <bigMonthCardExpireTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE_AND_CLIENT         </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </bigMonthCardExpireTime>

        <lastMonthCardDailyRewardTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE_AND_CLIENT      </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastMonthCardDailyRewardTime>

        <lastBigMonthCardDailyRewardTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE_AND_CLIENT      </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastBigMonthCardDailyRewardTime>

        <remainHangupMinutes>
            <Type>          UINT32               </Type>
            <Flags>         BASE_AND_CLIENT      </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </remainHangupMinutes>

        <lastMonthCardHangupGetTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastMonthCardHangupGetTime>

        <totalOfflineExp>
            <Type>          EXP             </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
            <Default>       0               </Default>
        </totalOfflineExp>

        <totalOfflineMinute>
            <Type>          UINT32          </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
            <Default>       0               </Default>
        </totalOfflineMinute>

        <lastMonthcardLoginTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastMonthcardLoginTime>
        <monthCardExpireTimeCell>
            <Type>          LONGTIME                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </monthCardExpireTimeCell>

        <bigMonthCardExpireTimeCell>
            <Type>          LONGTIME                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </bigMonthCardExpireTimeCell>
    </Properties>

    <BaseMethods>
        <addMonthCardByItem>
            <Arg>       UINT32       </Arg>
            <Arg>       UINT64       </Arg>
            <Arg>       PYTHON       </Arg>
        </addMonthCardByItem>

        <tryGetMonthCardDailyReward> <Exposed/>
            <Arg>       UINT8       </Arg>
        </tryGetMonthCardDailyReward>

        <reqGetOfflineExp> <Exposed/>
        </reqGetOfflineExp>

        <reqOfflineHangupData> <Exposed/>
        </reqOfflineHangupData>

        <clientBuyPremiumGoods> <Exposed/>
            <Arg>       UINT32       </Arg>
        </clientBuyPremiumGoods>
    </BaseMethods>

    <CellMethods>
        <syncMonthCardInfo>
            <Arg>       LONGTIME       </Arg>
            <Arg>       LONGTIME       </Arg>
        </syncMonthCardInfo>
    </CellMethods>

    <ClientMethods>
        <onOfflineHangupData>
            <Arg>       LONGTIME       </Arg>
            <Arg>       EXP            </Arg>
        </onOfflineHangupData>
    </ClientMethods>
</root>
