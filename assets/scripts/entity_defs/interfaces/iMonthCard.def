<root>
    <Properties>
        <monthCardExpireTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE_AND_CLIENT      </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </monthCardExpireTime>

        <lastMonthCardDailyRewardTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastMonthCardDailyRewardTime>

        <remainHangupMinutes>
            <Type>          UINT32               </Type>
            <Flags>         BASE_AND_CLIENT      </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </remainHangupMinutes>

        <lastMonthCardHangupGetTime>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </lastMonthCardHangupGetTime>

        <totalOfflineExp>
            <Type>          EXP             </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
            <Default>       0               </Default>
        </totalOfflineExp>

        <totalOfflineMinute>
            <Type>          UINT32          </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
            <Default>       0               </Default>
        </totalOfflineMinute>
    </Properties>

    <BaseMethods>
        <addMonthCardByItem>
            <Arg>       UINT32       </Arg>
            <Arg>       UINT64       </Arg>
            <Arg>       PYTHON       </Arg>
        </addMonthCardByItem>
        
        <tryGetMonthCardDailyReward> <Exposed/>
        </tryGetMonthCardDailyReward>

        <reqGetOfflineExp> <Exposed/>
        </reqGetOfflineExp>

        <reqOfflineHangupData> <Exposed/>
        </reqOfflineHangupData>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onOfflineHangupData>
            <Arg>       LONGTIME       </Arg>
            <Arg>       EXP            </Arg>
        </onOfflineHangupData>
    </ClientMethods>
</root>
