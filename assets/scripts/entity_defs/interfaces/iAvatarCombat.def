<root>
    <Interfaces>
        <Interface>       iSkillManager         </Interface>
        <Interface>       iSkillPropOwnClient   </Interface>
    </Interfaces>

    <Properties>
        <morphState>
            <Type>          MORPH_STATE                 </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
            <Default>       1                          </Default>
        </morphState>

        <summonSlotIdxBase>
            <Type>          SLOTID                      </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
            <Default>       0                           </Default>
        </summonSlotIdxBase>

        <summonSlotIdx>
            <Type>          SLOTID                      </Type>
            <Flags>         OWN_CLIENT                  </Flags>
            <Default>       0                           </Default>
        </summonSlotIdx>

        <buildDic>
            <Type>            BUILD_INFO                </Type>
            <Flags>           BASE                     </Flags>
            <Persistent>      true                </Persistent>
        </buildDic>

        <tmpTaskSkillIds>
            <Type>              PY_DICT             </Type>
            <Flags>             BASE                </Flags>
            <Default>           {}                  </Default>
            <Persistent>        true                </Persistent>
        </tmpTaskSkillIds>

        <bigWorldRouteController>
            <Type>  PYTHON  </Type>
            <Flags> CELL_PRIVATE        </Flags>
        </bigWorldRouteController>

        <exp>
            <Type>                 EXP                 </Type>
            <Flags>         OWN_CLIENT        </Flags>
            <Default>               0                  </Default>
            <Persistent>           true                </Persistent>
        </exp>

        <expAddRatioByTeam>
            <Type>                 UINT16               </Type>
            <Flags>                CELL_PRIVATE         </Flags>
            <Default>              0                    </Default>
            <Persistent>           true                 </Persistent>
        </expAddRatioByTeam>

        <dailyChaseExpFactorUpdateTime>
            <Type>          LONGTIME            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
            <Persistent>    true                </Persistent>
        </dailyChaseExpFactorUpdateTime>

        <statisticsDmg>
            <Type>          INT32               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
        </statisticsDmg>

        <statisticsHeal>
            <Type>          INT32               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
        </statisticsHeal>

        <statisticsHurt>
            <Type>          INT32               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
        </statisticsHurt>

        <statisticsDead>
            <Type>          INT32               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
        </statisticsDead>

        <regenTimer>
            <Type>     TIMER_ID                      </Type>
            <Flags>    CELL_PRIVATE                  </Flags>
        </regenTimer>

        <zedPoint>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
        </zedPoint>

        <maxZedPoint>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       4                   </Default>
        </maxZedPoint>

        <relationTypeList>
            <Type>          PYTHON              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       []                  </Default>
        </relationTypeList>

        <relationTypeDic>
            <Type>          PYTHON              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       {}                  </Default>
        </relationTypeDic>

        <awardFightPropDic>
            <Type>          PY_DICT             </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </awardFightPropDic>

        <dailyFreeReliveTimes>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
            <Persistent>    true                </Persistent>
            <Default>       0                    </Default>
        </dailyFreeReliveTimes>

        <totalPayFreeReliveTimes>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE          </Flags>
            <Default>       0                    </Default>
        </totalPayFreeReliveTimes>

        <mp>
            <Type>          MP          </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Persistent>    true            </Persistent>
            <DelaySync>     true            </DelaySync>
        </mp>

        <isClientOnGround>
            <Type>          BOOL                </Type>
            <Flags>         ALL_CLIENTS         </Flags>
        </isClientOnGround>

        <ultraSkillPower>
            <Type>          UINT8                       </Type>
            <Flags>         OWN_CLIENT                  </Flags>
        </ultraSkillPower>

        <instantPotionSlots>
            <Type>          INSTANT_POTION_SLOTS_DATA_INFO  </Type>
            <Flags>         BASE_AND_CLIENT                 </Flags>
            <Persistent>    true                            </Persistent>
        </instantPotionSlots>

        <healHpRatio>
            <Type>          HEAL_RATIO                      </Type>
            <Flags>         OWN_CLIENT                      </Flags>
            <Persistent>    true                            </Persistent>
            <Default>       50                              </Default>
        </healHpRatio>

        <healMpRatio>
            <Type>          HEAL_RATIO                      </Type>
            <Flags>         OWN_CLIENT                      </Flags>
            <Persistent>    true                            </Persistent>
            <Default>       50                              </Default>
        </healMpRatio>

        <autoDrinkPotionTimerId>
            <Type>          TIMER_ID                        </Type>
            <Flags>         BASE                            </Flags>
            <Default>       0                               </Default>
        </autoDrinkPotionTimerId>
        <expGrow>
            <Type>          FLOAT               </Type>
            <Flags>         OWN_CLIENT        </Flags>
        </expGrow>
        <adjExpGrow>
            <Type>          FLOAT               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
        </adjExpGrow>
        <copper>
            <Type>          FLOAT               </Type>
            <Flags>         OWN_CLIENT        </Flags>
        </copper>
        <adjCopper>
            <Type>          FLOAT               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
        </adjCopper>
        <medicineRate>
            <Type>          FLOAT          </Type>
            <Flags>         OWN_CLIENT   </Flags>
        </medicineRate>
        <adjMedicineRate>
            <Type>          FLOAT          </Type>
            <Flags>         CELL_PRIVATE   </Flags>
        </adjMedicineRate>
        <miningRate>
            <Type>          FLOAT          </Type>
            <Flags>         OWN_CLIENT   </Flags>
        </miningRate>
        <adjMiningRate>
            <Type>          FLOAT          </Type>
            <Flags>         CELL_PRIVATE   </Flags>
        </adjMiningRate>
        <gatherRate>
            <Type>          FLOAT          </Type>
            <Flags>         OWN_CLIENT   </Flags>
        </gatherRate>
        <adjGatherRate>
            <Type>          FLOAT          </Type>
            <Flags>         CELL_PRIVATE   </Flags>
        </adjGatherRate>

        <viewCrossServerSet>
            <Type>          PYTHON              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       set()               </Default>
        </viewCrossServerSet>
    </Properties>

    <CellMethods>
        <onCellCombatDailyUpdate>
            <Arg>            EXP            </Arg>
        </onCellCombatDailyUpdate>

        <doRelive>
            <Arg>        UINT8                        </Arg>
        </doRelive>

        <addExpByTask>
            <Arg>            EXP                      </Arg>
            <Arg>            REWARD_ID                </Arg>
            <Arg>            OP_UUID                  </Arg>
            <Arg>            BONUS_SRC                </Arg>
            <Arg>            STRING                   </Arg>
        </addExpByTask>

        <addExpByKill>
            <Arg>            EXP                      </Arg>
            <Arg>            LEVEL                    </Arg>
            <Arg>            OP_UUID                  </Arg>
            <Arg>            BONUS_SRC                </Arg>
            <Arg>            PYTHON                   </Arg>
        </addExpByKill>

        <addExpByWealthVal>
            <Arg>            EXP                      </Arg>
            <Arg>            REWARD_ID                </Arg>
            <Arg>            OP_UUID                  </Arg>
            <Arg>            BONUS_SRC                </Arg>
            <Arg>            PYTHON                   </Arg>
        </addExpByWealthVal>

        <addExpByMail>
            <Arg>            EXP                      </Arg>
            <Arg>            OP_UUID                  </Arg>
            <Arg>            BONUS_SRC                </Arg>
            <Arg>            STRING                   </Arg>
        </addExpByMail>

        <addExpByMonthCard>
            <Arg>            EXP                      </Arg>
            <Arg>            OP_UUID                  </Arg>
            <Arg>            BONUS_SRC                </Arg>
            <Arg>            STRING                   </Arg>
        </addExpByMonthCard>

        <clientSetIsOnGround>
            <Exposed/>
            <Arg>        BOOL         </Arg>
        </clientSetIsOnGround>

        <clientSetState>
            <Exposed/>
            <Arg>        STATE        </Arg>
        </clientSetState>

        <clientRemoveState>
            <Exposed/>
            <Arg>        STATE        </Arg>
        </clientRemoveState>

         <clientSetInteractState>
            <Exposed/>
            <Arg>        STATE        </Arg>
            <Arg>        UINT32       </Arg>
            <Arg>        TASK_ID      </Arg>
        </clientSetInteractState>

         <clientRemoveInteractState>
            <Exposed/>
            <Arg>        STATE        </Arg>
        </clientRemoveInteractState>

        <cancelCastingSkill>
            <Exposed/>
            <Arg>        SKILLID        </Arg>
        </cancelCastingSkill>

        <cancelChannelingSkill>
            <Exposed/>
            <Arg>        SKILLID        </Arg>
        </cancelChannelingSkill>

        <useTargetSkill>
            <Exposed/>
            <Arg>        SKILLID        </Arg>
            <Arg>        OBJECT_ID      </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
            <Arg>        INT32        </Arg>
        </useTargetSkill>

        <castingSkill>
            <Exposed/>
            <Arg>        SKILLID        </Arg>
            <Arg>        OBJECT_ID      </Arg>
            <Arg>        ARRAY <of> FLOAT </of>     </Arg>
        </castingSkill>

        <setSelectedTarget> <Exposed/>
            <Arg>          UINT32            </Arg>
        </setSelectedTarget>

        <checkOnUpdateSkills>
            <Arg>          PYTHON            </Arg>
            <Arg>          BOOL              </Arg>
            <Arg>          BOOL              </Arg>
        </checkOnUpdateSkills>

        <onChangeSkillLv>
            <Arg>          SKILLID           </Arg>
            <Arg>          LEVEL            </Arg>
        </onChangeSkillLv>

        <gmAddExp>
            <Arg>   EXP         </Arg>
            <Arg>   OP_UUID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT32      </Arg>
        </gmAddExp>

        <gmDeductExp>
            <Arg>   EXP         </Arg>
            <Arg>   OP_UUID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT32      </Arg>
        </gmDeductExp>

        <unlockDodgeSkill>
            <Arg>           LEVEL               </Arg>
            <Arg>           LEVEL               </Arg>
        </unlockDodgeSkill>

        <addAwardFightPropsCell>
            <Arg>       PYTHON          </Arg>
        </addAwardFightPropsCell>

        <preAwardOnKillMonster>
            <Arg> PYTHON </Arg>
            <Arg> PYTHON </Arg>
            <Arg> PYTHON </Arg>
            <Arg> PYTHON </Arg>
        </preAwardOnKillMonster>

        <doKillMonsterAwards>
            <Arg> PYTHON </Arg>
            <Arg> EXP    </Arg>
            <Arg> PYTHON </Arg>
            <Arg> PYTHON </Arg>
        </doKillMonsterAwards>

        <getBuffIdInfo> <Exposed/>
            <Arg>        OBJECT_ID        </Arg>
        </getBuffIdInfo>

        <updateCommonFlagCell> <Exposed/>
            <Arg>       UINT8           </Arg>
            <Arg>       UINT8           </Arg>
        </updateCommonFlagCell>

        <clientResetSkill> <Exposed/>
            <Arg>       SKILLID         </Arg>
        </clientResetSkill>

        <jump> <Exposed/>
            <Arg>       UINT8           </Arg>
        </jump>

        <setSkillAutoCombat> <Exposed/>
            <Arg>       SKILLID         </Arg>
            <Arg>       BOOL            </Arg>
        </setSkillAutoCombat>

        <dropAndDeath> <Exposed/>
        </dropAndDeath>

        <setBAutoHeal> <Exposed/>
            <Arg>       BOOL            </Arg>
            <Arg>       BOOL            </Arg>
        </setBAutoHeal>

        <setHealRatio> <Exposed/>
            <Arg>       HEAL_RATIO      </Arg>
            <Arg>       BOOL            </Arg>
        </setHealRatio>

        <setSummonSlotIdx>
            <Arg>          SLOTID       </Arg>
        </setSummonSlotIdx>

        <changeMorphPreAddSkill>
            <Arg>          MORPH_STATE  </Arg>
        </changeMorphPreAddSkill>

        <levelUpSkill> <Exposed/>
            <Arg>        SKILLID        </Arg>
            <Arg>        INT8           </Arg>
        </levelUpSkill>

        <setShowCompleteNum> <Exposed/>
            <Arg>        UINT8          </Arg>
        </setShowCompleteNum>
    </CellMethods>

    <BaseMethods>
        <setSummonSlotIdx> <Exposed/>
            <Arg>          SLOTID       </Arg>
        </setSummonSlotIdx>

        <setSummonSlotIdxAck>
            <Arg>          SLOTID       </Arg>
        </setSummonSlotIdxAck>

        <onAvatarLevelUpBase>
            <Arg>           LEVEL               </Arg>
            <Arg>           LEVEL               </Arg>
        </onAvatarLevelUpBase>

        <updateSkills> <Exposed/>
            <Arg>        ARRAY <of> SKILL_SLOT_INFO </of>        </Arg>
        </updateSkills>

        <baseLevelUpSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        SKILLID        </Arg>
            <Arg>        INT8           </Arg>
        </baseLevelUpSkill>

        <onCheckUpdateSkillRet>
            <Arg>          BOOL              </Arg>
            <Arg>          PYTHON            </Arg>
            <Arg>          BOOL              </Arg>
            <Arg>          BOOL              </Arg>
        </onCheckUpdateSkillRet>

        <unlockSkill>
            <Arg>       BOOL                    </Arg>
        </unlockSkill>

        <initSkillAfterHasSchool>
        </initSkillAfterHasSchool>

        <onChangeSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        SKILLID        </Arg>
        </onChangeSkill>

        <buildAddActiveSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        LEVEL          </Arg>
        </buildAddActiveSkill>

        <playerExpFlowLog>
            <Arg>   EXP         </Arg>
            <Arg>   LEVEL       </Arg>
            <Arg>   LEVEL       </Arg>
            <Arg>   LONGTIME    </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   UINT32      </Arg>
        </playerExpFlowLog>

        <playerDeadTlog>
            <Arg>        PY_DICT        </Arg>
        </playerDeadTlog>

        <playerReliveTlog>
            <Arg>        PY_DICT        </Arg>
        </playerReliveTlog>

        <changeMorphStateBase>
            <Arg>        MORPH_STATE    </Arg>
        </changeMorphStateBase>

        <setInstantPotionSlots> <Exposed/>
            <Arg>        INSTANT_POTION_DATA_INFO           </Arg>
        </setInstantPotionSlots>

        <unsetInstantPotionSlots> <Exposed/>
            <Arg>        UINT8           </Arg>
        </unsetInstantPotionSlots>

        <autoHealHp>
        </autoHealHp>

        <autoHealMp>
        </autoHealMp>
    </BaseMethods>

    <ClientMethods>
        <onDead>
            <Arg>        OBJECT_ID        </Arg>
        </onDead>

        <onUseStageSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        UINT8          </Arg>
            <Arg>        DOUBLETIME     </Arg>
        </onUseStageSkill>

        <onUpdateSkillLevel>
            <Arg>        ARRAY <of> SKILLID </of>     </Arg>
            <Arg>        ARRAY <of> LEVEL </of>     </Arg>
        </onUpdateSkillLevel>

        <dragSkillChangeBuildSkills>
            <Arg>        BLOB           </Arg>
        </dragSkillChangeBuildSkills>

        <sendAllSkills>
            <Arg>        CLIENT_SKILLS   </Arg>
        </sendAllSkills>

        <sendSkillBuilds>
            <Arg>        CLIENT_BUILD_INFO   </Arg>
        </sendSkillBuilds>

        <updateSkillsExtraLevel>
            <Arg>        UINT8                         </Arg>
            <Arg>        ARRAY <of> SKILLID </of>      </Arg>
            <Arg>        ARRAY <of> UINT8 </of>        </Arg>
        </updateSkillsExtraLevel>

        <onPlayerGetExp>
            <Arg>        BONUS_SRC      </Arg>
            <Arg>        EXP            </Arg>
            <Arg>        EXP            </Arg>
            <Arg>        EXP            </Arg>
        </onPlayerGetExp>

        <onRemoveCompleteWitness>
            <Arg>        ARRAY <of> OBJECT_ID </of>   </Arg>
        </onRemoveCompleteWitness>

        <onGetBuffIdInfo>
            <Arg>   OBJECT_ID          </Arg>
            <Arg>   ARRAY <of> CLIENT_BUFF_ID_VAL </of> </Arg>
        </onGetBuffIdInfo>

        <onHealItemResult>
            <Arg>        UINT32        </Arg>
            <Arg>        BOOL          </Arg>
        </onHealItemResult>

        <onChangeSkill>
            <Arg>        SKILLID        </Arg>
            <Arg>        SKILLID        </Arg>
        </onChangeSkill>

        <onSetInstantPotionSlots>
            <Arg>        INSTANT_POTION_DATA_INFO           </Arg>
        </onSetInstantPotionSlots>

        <onRemoveInstantPotionSlots>
            <Arg>        UINT8           </Arg>
        </onRemoveInstantPotionSlots>

        <onKillAvatar>
            <Arg>        UNICODE       </Arg>
        </onKillAvatar>
    </ClientMethods>
</root>
