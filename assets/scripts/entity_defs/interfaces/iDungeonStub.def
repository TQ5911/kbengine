<root>

    <Interfaces>
        <Interface> iBaseNoCell    </Interface>
        <Interface> iGlobal        </Interface>
        <Interface> iTimerBase     </Interface>
    </Interfaces>

    <Properties>
        <dungeonNo>
            <Type>      DUNGEON_NO  </Type>
            <Flags>     BASE        </Flags>
        </dungeonNo>

        <crtGenSpaceNo>
            <Type>      SPACE_NO    </Type>
            <Flags>     BASE        </Flags>
            <Default>   0           </Default>
        </crtGenSpaceNo>

        <argsCache>
            <Type>      PYTHON      </Type>
            <Flags>     BASE        </Flags>
            <Default>       {}              </Default>
        </argsCache>

        <rebornPosCache>
            <Type>      PYTHON      </Type>
            <Flags>     BASE        </Flags>
            <Default>       {}      </Default>
        </rebornPosCache>
    </Properties>

    <BaseMethods>
        <onDungeonSpaceGone>
            <Arg> SPACE_NO  </Arg>
            <Arg> UINT8     </Arg>
        </onDungeonSpaceGone>

        <destoryDungeonSpace>
            <Arg>       SPACE_NO     </Arg>
            <Arg>       UUID         </Arg>
            <Arg>       STRING       </Arg>
        </destoryDungeonSpace>

        <onDungeonSpaceReady>
            <Arg>       SPACE_NO     </Arg>
        </onDungeonSpaceReady>

        <onDunSpaceMgrReady>
            <Arg>       SPACE_NO     </Arg>
        </onDunSpaceMgrReady>

        <applyCreateDungeon>
            <Arg>       MAILBOX     </Arg>
            <Arg>       PLAYER_GBID </Arg>
            <Arg>       TEAMID      </Arg>
            <Arg>       PYTHON      </Arg>
        </applyCreateDungeon>

        <doEnterDungeon>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   SPACE_NO        </Arg>
            <Arg>   PYTHON          </Arg>
        </doEnterDungeon>

        <enterDungeonSpaceSuccess>
            <Arg>       SPACE_NO      </Arg>
            <Arg>       MAILBOX       </Arg>
            <Arg>       PLAYER_GBID   </Arg>
            <Arg>       TEAMID      </Arg>
            <Arg>       PYTHON      </Arg>
        </enterDungeonSpaceSuccess>

        <leaveDungeonSpaceSucc>
            <Arg>       SPACE_NO      </Arg>
            <Arg>       MAILBOX       </Arg>
            <Arg>       PLAYER_GBID   </Arg>
            <Arg>       TEAMID      </Arg>
            <Arg>       PYTHON      </Arg>
        </leaveDungeonSpaceSucc>

        <onAvatarDie>
            <Arg>       SPACE_NO      </Arg>
            <Arg>       MAILBOX       </Arg>
            <Arg>       PLAYER_GBID   </Arg>
        </onAvatarDie>

        <onAvatarOffline>
            <Arg>       SPACE_NO      </Arg>
            <Arg>       PLAYER_GBID   </Arg>
        </onAvatarOffline>

        <onReliveInDungeon>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           MAILBOX         </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           REBORN_TYPE     </Arg>
            <Arg>           UINT32          </Arg>
        </onReliveInDungeon>

        <onDungeonStarted>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       LONGTIME        </Arg>
        </onDungeonStarted>

        <onDungeonStartChallenge>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       LONGTIME        </Arg>
        </onDungeonStartChallenge>

        <sendBigWorldDungeonProps>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   SPACE_NO    </Arg>
        </sendBigWorldDungeonProps>

        <requestSpaceCell>
            <Arg>           MAILBOX         </Arg>
            <Arg>           SPACE_NO        </Arg>
        </requestSpaceCell>

        <onCreateNewRebornPos>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       VECTOR3        </Arg>
        </onCreateNewRebornPos>

        <getSettlementRankList>
            <Arg>            UINT8           </Arg>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            UUID            </Arg>
            <Arg>            MAILBOX         </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            UINT8           </Arg>
            <Arg>            UINT8           </Arg>
        </getSettlementRankList>
    </BaseMethods>
</root>
