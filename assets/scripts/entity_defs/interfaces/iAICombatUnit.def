<root>
    <Interfaces>
        <Interface>         iSkillManager       </Interface>
		<Interface>	        iSkillPropPriProp	</Interface>
    </Interfaces>

    <Properties>
        <aiVariables>
            <Type>            PYTHON              </Type>
            <Flags>           CELL_PRIVATE        </Flags>
            <Default>         {}                  </Default>
        </aiVariables>

        <aiEvents>
            <Type>            PYTHON              </Type>
            <Flags>           CELL_PRIVATE        </Flags>
            <Default>         {}                  </Default>
        </aiEvents>

        <aiEventListener>
            <Type>            PYTHON              </Type>
            <Flags>           CELL_PRIVATE        </Flags>
            <Default>         {}                  </Default>
        </aiEventListener>

        <aiName>
            <Type>            INT16              </Type>
            <Flags>           CELL_PRIVATE        </Flags>
        </aiName>

        <patrolRadii>
            <Type>	FLOAT						</Type>
            <Flags>	CELL_PRIVATE 			</Flags>
        </patrolRadii>

        <aiController>
            <Type>	PYTHON						</Type>
            <Flags>	CELL_PRIVATE 			</Flags>
        </aiController>

        <isBoss>
            <Type>  BOOL    </Type>
            <Flags> ALL_CLIENTS     </Flags>
            <Default>  0  </Default>
        </isBoss>

        <isBossHasSetFlag>
            <Type>      BOOL                </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   0                   </Default>
        </isBossHasSetFlag>

        <bornState>
            <Type>      UINT8           </Type>
            <Default>   0               </Default>
            <Flags>     OTHER_CLIENTS   </Flags>
        </bornState>

        <canBeAttack>
            <Type>      BOOL                </Type>
            <Default>   True                </Default>
            <Flags>     CELL_PRIVATE        </Flags>
        </canBeAttack>

        <isCanBeAttackHasSet>
            <Type>      BOOL                </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   0                   </Default>
        </isCanBeAttackHasSet>

        <speedStateRatio>
            <Type>      FLOAT                </Type>
            <Default>    1.0                </Default>
            <Flags>     CELL_PRIVATE        </Flags>
        </speedStateRatio>

        <exclusiveGBID>
            <Type>      PLAYER_GBID         </Type>
            <Default>   0                   </Default>
            <Flags>     CELL_PRIVATE        </Flags>
        </exclusiveGBID>

        <moveAni>
            <Type>          UINT8               </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </moveAni>

        <stopByFuben>
            <Type>          BOOL                </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </stopByFuben>

        <nextKeepDistanceTime>
            <Type>          LONGTIME            </Type>
            <Default>       0                   </Default>
            <Flags>         CELL_PRIVATE        </Flags>
        </nextKeepDistanceTime>

        <beHateCounter>
            <Type>          HATE_COUNTER_DATA_INFO      </Type>
            <Flags>         CELL_PRIVATE                </Flags>
        </beHateCounter>

        <warningTimerId>
            <Type>          UINT32              </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </warningTimerId>

        <firstHateTargetId>
            <Type>          OBJECT_ID           </Type>
            <Flags>         OTHER_CLIENTS        </Flags>
            <Default>       0                   </Default>
        </firstHateTargetId>
    
        <route>
            <Type>      PYTHON          </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>    []             </Default>
        </route>

        <thinkTimer>
            <Type>      TIMER_ID        </Type>
            <Flags>     CELL_PRIVATE    </Flags>
        </thinkTimer>

        <bornPosition>
            <Type>          POSITION3D              </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </bornPosition>

        <hateTrapId>
            <Type>          UINT32                  </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </hateTrapId>

        <moveController>
            <Type>	        UINT32				    </Type>
            <Flags>	        CELL_PRIVATE 			</Flags>
        </moveController>

        <siegeWarCamp>
            <Type>          INT32           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Default>       0               </Default>
            <WitnessName>   true            </WitnessName>
        </siegeWarCamp>
    </Properties>

    <BaseMethods>

    </BaseMethods>

    <CellMethods>

        <boardMessageToAvatarsInRange>
            <Arg>       INT32       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>     </Arg>
            <Arg>       UINT16      </Arg>
            <Arg>       UINT8       </Arg>
        </boardMessageToAvatarsInRange>

    </CellMethods>

    <ClientMethods>
        <aiChatToPlayer>
            <Arg>       UINT32      </Arg>
            <Arg>       UINT32      </Arg>
        </aiChatToPlayer>
    </ClientMethods>
</root>

