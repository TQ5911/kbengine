<root>
    <Properties>
        <outfitExpireTimerId>
            <Type>          TIMER_ID        </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    false           </Persistent>
        </outfitExpireTimerId>

        <!-- 已获得的外观数据 -->
        <outfitInfo>
            <Type>          OUTFIT_INFO     </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </outfitInfo>

        <purchasedOutfitIds>
            <Type>          PY_DICT         </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </purchasedOutfitIds>

        <purchasedappearanceIds>
            <Type>          PY_DICT         </Type>
            <Flags>         BASE            </Flags>
            <Persistent>    true            </Persistent>
        </purchasedappearanceIds>
    </Properties>


    <BaseMethods>
        <reqEnableOutfit> <Exposed/>
            <Arg>       UINT8           </Arg>
            <Arg>       OUTFIT_ID       </Arg>
        </reqEnableOutfit>

        <reqBuyOutfit> <Exposed/>
            <Arg>       UINT32          </Arg>
        </reqBuyOutfit>

        <reqPurchasedOutfitIds> <Exposed/>
        </reqPurchasedOutfitIds>

        <updateAccountCharacterOutfit>
            <Arg>       STRING          </Arg>
            <Arg>       OUTFIT_ID       </Arg>
        </updateAccountCharacterOutfit>

        <addOutfitByReason>
            <Arg>       UINT8           </Arg>
            <Arg>       OUTFIT_ID       </Arg>
            <Arg>       TIMESTAMP       </Arg>
            <Arg>       UINT32          </Arg>
        </addOutfitByReason>

        <addAppearanceByReason>
            <Arg>       UINT32          </Arg>
            <Arg>       UINT8           </Arg>
            <Arg>       OUTFIT_ID       </Arg>
            <Arg>       TIMESTAMP       </Arg>
            <Arg>       UINT32          </Arg>
        </addAppearanceByReason>
    </BaseMethods>

    <CellMethods>
        <enableOutfit>
            <Arg>       UINT8           </Arg>
            <Arg>       OUTFIT_ID       </Arg>
        </enableOutfit>

        <reqDisableOutfit> <Exposed/>
            <Arg>       UINT8           </Arg>
            <Arg>       OUTFIT_ID       </Arg>
        </reqDisableOutfit>

        <checkOutfitExpired>
            <Arg>  PYTHON   </Arg>
        </checkOutfitExpired>

        <updatePropByMount>
            <Arg>       OUTFIT_ID       </Arg>
            <Arg>       BOOL            </Arg>
        </updatePropByMount>

        <updatePropByAppearance>
            <Arg>       UINT32       </Arg>
            <Arg>       BOOL         </Arg>
        </updatePropByAppearance>

        <appearanceOnLogin>
            <Arg>       PY_DICT           </Arg>
        </appearanceOnLogin>
    </CellMethods>

    <ClientMethods>
        <onUpdateOutfitData>
            <Arg>      ARRAY <of> CLIENT_OUTFIT_VAL    </of>    </Arg>
        </onUpdateOutfitData>

        <onPurchasedOutfitIds>
            <Arg>      ARRAY <of> UINT32    </of>    </Arg>
        </onPurchasedOutfitIds>
    </ClientMethods>
</root>
