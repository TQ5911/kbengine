<root>
    <Properties>
        <siegeWarCamp>
            <Type>          INT32           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Default>       0               </Default>
            <WitnessName>   true            </WitnessName>
        </siegeWarCamp>

        <siegeWarCanAttack>
            <Type>          INT32           </Type>
            <Flags>         CELL            </Flags>
            <Default>       1               </Default>
        </siegeWarCanAttack>
        
        <siegeWarUnionGuildUUID>
            <Type>          GUILD_UUID      </Type>
            <Flags>         BASE            </Flags>
            <Default>       0               </Default>
        </siegeWarUnionGuildUUID>

        <siegeWarGuildCache>
            <Type>          PYTHON          </Type>
            <Flags>         CELL            </Flags>
            <Default>       0               </Default>
        </siegeWarGuildCache>
    </Properties>

    <BaseMethods>
        <onUpdateSiegeWarState>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onUpdateSiegeWarState>

        <siegeWarSignUpBidding> <Exposed/>
        </siegeWarSignUpBidding>

        <querySiegeWarSignUpState> <Exposed/>
        </querySiegeWarSignUpState>

        <subscribeSiegeWarBiddingState> <Exposed/>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </subscribeSiegeWarBiddingState>

        <siegeWarTryBidding> <Exposed/>
            <Arg>          INT32                        </Arg>
        </siegeWarTryBidding>

        <onSiegeWarDeclareWar> <Exposed/>
            <Arg>          BOOL                         </Arg>
            <Arg>          UNICODE                      </Arg>
        </onSiegeWarDeclareWar>

        <querySiegeWarDefenderAndOffensive> <Exposed/>
        </querySiegeWarDefenderAndOffensive>

        <querySiegeWarBiddingWinnerData> <Exposed/>
        </querySiegeWarBiddingWinnerData>
        
        <cityDataRequest> <Exposed/>
        </cityDataRequest>

        <onSiegeWarSpaceEnter> <Exposed/>
        </onSiegeWarSpaceEnter>

        <enterCrossServerSiegeWarSpace> <Exposed/>
        </enterCrossServerSiegeWarSpace>

        <leaveCrossServerSiegeWarSpace> <Exposed/>
        </leaveCrossServerSiegeWarSpace>

        <siegeWarDefenseDeclaration> <Exposed/>
            <Arg>          UNICODE                      </Arg>
        </siegeWarDefenseDeclaration>

        <onEnterCrossSiegeWarSpaceRemotely>
            <Arg>          SERVER_ID                    </Arg>
            <Arg>          PYTHON                       </Arg>
        </onEnterCrossSiegeWarSpaceRemotely>

        <useCityOfficerPrivilege> <Exposed/>
            <Arg>          INT32                        </Arg>
            <Arg>          PLAYER_GBID                  </Arg>
        </useCityOfficerPrivilege>

        <changeCityMoneyToGuildMoney> <Exposed/>
            <Arg>          INT64                        </Arg>
        </changeCityMoneyToGuildMoney>

        <appointCityOfficer> <Exposed/>
            <Arg>          INT32                        </Arg>
            <Arg>          PLAYER_GBID                  </Arg>
        </appointCityOfficer>

        <querySiegeWarCityFundUseRecord> <Exposed/>
        </querySiegeWarCityFundUseRecord>

        <onSiegeWarSearchTarget> <Exposed/>
            <Arg>          UNICODE                      </Arg>
        </onSiegeWarSearchTarget>

        <biddingFailRedPointCheck> <Exposed/>
        </biddingFailRedPointCheck>

        <onCanChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          INT64                        </Arg>
        </onCanChangeCityMoneyToGuildMoneyResult>

        <onSiegeWarDeclareWarGuildResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onSiegeWarDeclareWarGuildResult>

        <onSiegeWarDeclareWarCrossServerResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarDeclareWarCrossServerResult>

        <onQuerySiegeWarSignUped>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onQuerySiegeWarSignUped>

        <onCityBattleTokenDeducted>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onCityBattleTokenDeducted>

        <onSiegeWarSignUpBiddingResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarSignUpBiddingResult>

        <onSiegeWarBiddingDataUpdate>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarBiddingDataUpdate>

        <onQuerySiegeWarDefenderAndOffensiveResult>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResult>

        <onQuerySiegeWarDefenderAndOffensiveResultFromGuildStub>
            <Arg>           PY_LIST                      </Arg>
            <Arg>           UNICODE                      </Arg>
            <Arg>           UNICODE                      </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResultFromGuildStub>

        <onQuerySiegeWarBiddingWinnerDataResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
        </onQuerySiegeWarBiddingWinnerDataResult>

        <onCityDataResponse>
            <Arg>           PY_LIST              </Arg>
        </onCityDataResponse>

        <syncCitySimpleData>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          LONGTIME                     </Arg>
        </syncCitySimpleData>

        <onCheckCanEnterSiegeWarSpace>
            <Arg>          INT32                        </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>           INT32                   </Arg>
        </onCheckCanEnterSiegeWarSpace>

        <onGetWarGuildUUIDBeforeEnter>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onGetWarGuildUUIDBeforeEnter>

        <onGetSiegeWarGuildCacheData>
            <Arg>      PY_DICT       </Arg>
        </onGetSiegeWarGuildCacheData>

        <onPrivilegeResponse>
            <Arg>          INT32                  </Arg>
            <Arg>          INT32                  </Arg>
        </onPrivilegeResponse>
    </BaseMethods>

    <CellMethods>
        <leaveSiegeWarSpace> <Exposed/>
        </leaveSiegeWarSpace>

        <siegewarMinimapSignalChange> <Exposed/>
            <Arg>      SIEGEWAR_MINIMAP_SIGNAL_VAL      </Arg>
        </siegewarMinimapSignalChange>

        <requestSiegeWarScoreData> <Exposed/>
            <Arg>          INT32                        </Arg>
        </requestSiegeWarScoreData>

        <enterSiegeWarSpace> <Exposed/>
        </enterSiegeWarSpace>

        <gmEnterSiegeWarSpace>
        </gmEnterSiegeWarSpace>
        
        <beginEnterSiegeWarSpace>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg> 
            <Arg>           BOOL                    </Arg> 
        </beginEnterSiegeWarSpace>

        <setSiegeWarCamp>
            <Arg>          INT32                        </Arg>
        </setSiegeWarCamp>

        <onSiegeWarMsg>
            <Arg>      UINT64        </Arg>
            <Arg>      PY_LIST       </Arg>
        </onSiegeWarMsg>

        <onPlayerLoginGetCityBuff>
            <Arg>      PY_DICT       </Arg>
        </onPlayerLoginGetCityBuff>

        <onAddCityBuff>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
        </onAddCityBuff>

        <setSiegeWrGuildCache>
            <Arg>          PYTHON                       </Arg>
        </setSiegeWrGuildCache>

        <crossServerSiegeWarLeave>
        </crossServerSiegeWarLeave>

        <onSiegeWarChatMsg>
            <Arg>           CHAT_CHANNEL                </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>           UNICODE                     </Arg>
            <Arg>           ENTITYCALL                  </Arg>
        </onSiegeWarChatMsg>
    </CellMethods>

    <ClientMethods>
        <onSiegeWarMinimapSignalChange>
            <Arg>        ARRAY <of> SIEGEWAR_MINIMAP_SIGNAL_VAL </of>       </Arg>
        </onSiegeWarMinimapSignalChange>

        <onSiegeWarLoginDataChanged>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarLoginDataChanged>
        
        <onQuerySiegeWarSignUped>
            <Arg>          BOOL                         </Arg>
        </onQuerySiegeWarSignUped>

        <onSiegeWarSignUpBiddingResult>
            <Arg>          BOOL                         </Arg>
        </onSiegeWarSignUpBiddingResult>

        <onSiegeWarBiddingDataUpdate>
            <Arg>        INT32                          </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
        </onSiegeWarBiddingDataUpdate>

        <onSiegeWarDeclareWarResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarDeclareWarResult>

        <onQuerySiegeWarDefenderAndOffensiveResult>
            <Arg>       ARRAY   <of>    SIEGEWAR_GUILD_VAL </of>    </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResult>

        <onQuerySiegeWarBiddingWinnerDataResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
        </onQuerySiegeWarBiddingWinnerDataResult>

        <onSiegeWarMinimapInfoUpdate>
            <Arg>          UNICODE                      </Arg>
        </onSiegeWarMinimapInfoUpdate>

        <onSiegeWarEnterDataUpdate>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarEnterDataUpdate>

        <onSiegeWarScoreData>
            <Arg>       INT32                                       </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_SCORE_VAL </of>    </Arg>
            <Arg>       SIEGEWAR_SCORE_VAL                          </Arg>
        </onSiegeWarScoreData>

        <onSiegeWarBattleEnd>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          SCHOOL                       </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_BATTLE_END_DATA_VAL </of>    </Arg>
            <Arg>          PLAYER_GBID                                      </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          SCHOOL                                           </Arg>
            <Arg>          SEX                                              </Arg>
        </onSiegeWarBattleEnd>

        <cityRecentActivityResponse>
            <Arg>          ENTITYCALL                                       </Arg>
            <Arg>          ARRAY <of> CITY_RECENT_ACTIVITY_VAL </of>        </Arg>
        </cityRecentActivityResponse>

        <onCityDataResponse>
            <Arg>          PLAYER_GBID                                      </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          SCHOOL                                           </Arg>
            <Arg>          SEX                                              </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          GUILD_UUID                                       </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          INT64                                            </Arg>
            <Arg>          INT64                                            </Arg>
            <Arg>          LONGTIME                                         </Arg>
            <Arg>          ARRAY <of> CITY_RECENT_ACTIVITY_VAL </of>        </Arg>
            <Arg>          ARRAY <of> CITY_OFFICER_LIST        </of>        </Arg>
            <Arg>          LONGTIME                                         </Arg>
            <Arg>          LONGTIME                                         </Arg>
            <Arg>          ARRAY <of> CITY_ORDER_REMAIN_TIMES_VAL </of>     </Arg>
        </onCityDataResponse>

        <onChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                                             </Arg>
            <Arg>          INT64                                            </Arg>
        </onChangeCityMoneyToGuildMoneyResult>

        <onQuerySiegeWarCityFundUseRecordResult>
            <Arg>          ARRAY <of> CITY_FUND_RECORD_VAL </of>        </Arg>
        </onQuerySiegeWarCityFundUseRecordResult>

        <onSiegeWarSearchTargetResult>
            <Arg>       UINT8                                   </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_SEARCH_VAL       </of>   </Arg>
        </onSiegeWarSearchTargetResult>

        <onSyncCitySimpleData>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSyncCitySimpleData>

        <onYuxiFlagChange>
            <Arg>          BOOL                         </Arg>
        </onYuxiFlagChange>

        <biddingFailRedPointSync>
            <Arg>          BOOL                         </Arg>
        </biddingFailRedPointSync>
    </ClientMethods>
</root>
