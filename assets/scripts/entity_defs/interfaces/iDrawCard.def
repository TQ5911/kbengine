<?xml version="1.0" encoding="utf-8"?>
<root>
    <Properties>
        <drawCardInfo>
            <Type>          PET_DRAW_CARD_INFO      </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </drawCardInfo>

        <drawCardRecord>
            <Type>          PET_DRAW_CARD_RECORD    </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </drawCardRecord>
    </Properties>

    <BaseMethods>
        <reqRandomSummonPet> <Exposed/>
            <Arg>   UINT32      </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   UINT16      </Arg>
        </reqRandomSummonPet>

        <reqGetGuaranteedPetEgg> <Exposed/>
            <Arg>   UINT32      </Arg>
        </reqGetGuaranteedPetEgg>

        <reqPetDrawCardRecord> <Exposed/>
            <Arg>   UINT32      </Arg>
        </reqPetDrawCardRecord>

        <reqOpenPetCard> <Exposed/>
            <Arg>   UINT16      </Arg>
        </reqOpenPetCard>

        <reqOpenPetCards> <Exposed/>
            <Arg>   UINT16      </Arg>
        </reqOpenPetCards>

        <triggerTimeLimitGuaranteedReward>
            <Arg>   ARRAY <of> UINT32 </of>    </Arg>
        </triggerTimeLimitGuaranteedReward>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
        <onGetDrawCardInfo>
            <Arg>   ARRAY <of> CLI_DRAW_CARD_INFO </of>    </Arg>
        </onGetDrawCardInfo>

        <onUpdateDrawCardInfo>
            <Arg>   CLI_DRAW_CARD_INFO       </Arg>
        </onUpdateDrawCardInfo>

        <onRandomSummonPet>
            <Arg>   ARRAY <of> ITEM_ID </of>    </Arg>
        </onRandomSummonPet>

        <onGetGuaranteedPetEgg>
            <Arg>   UINT32      </Arg>
            <Arg>   ITEM_ID     </Arg>
            <Arg>   UINT32      </Arg>
        </onGetGuaranteedPetEgg>
    </ClientMethods>
</root>
