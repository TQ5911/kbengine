<root>
    <Interfaces>
    </Interfaces>

    <Properties>
    </Properties>

    <CellMethods>
        <onRegisterMineWarSpaceMgr>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       TIMESTAMP      </Arg>
        </onRegisterMineWarSpaceMgr>

        <transferAllAvatarInSpace>
            <Arg>       LINE_TYPE        </Arg>
            <Arg>       GUILD_UUID     </Arg>
        </transferAllAvatarInSpace>
        <onMineWarStateChange>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       UINT8          </Arg>
        </onMineWarStateChange>
        <onMineWarDayChange>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       TIMESTAMP      </Arg>
        </onMineWarDayChange>

        <addMineWarMonsterOnInit>
            <Arg>       UINT8          </Arg>
            <Arg>       MAILBOX         </Arg>
        </addMineWarMonsterOnInit>
        <removeMineWarMonsterWhenDie>
            <Arg>       UINT8          </Arg>
        </removeMineWarMonsterWhenDie>

        <onSyncGuildMineWarResult>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       UNICODE        </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       UNICODE        </Arg>
            <Arg>       PY_DICT        </Arg>
            <Arg>       BOOL        </Arg>
        </onSyncGuildMineWarResult>

        <onSyncMineWarGuildInfo>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       UNICODE        </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       UINT8          </Arg>
            <Arg>       UNICODE        </Arg>
            <Arg>       PY_DICT        </Arg>
        </onSyncMineWarGuildInfo>

        <onMineWarGuildDisbanded>
            <Arg>       GUILD_UUID     </Arg>
            <Arg>       UINT8          </Arg>
        </onMineWarGuildDisbanded>

        <onMineWarFlagChangeAttack>
            <Arg>       BOOL          </Arg>
        </onMineWarFlagChangeAttack>
    </CellMethods>
</root>
