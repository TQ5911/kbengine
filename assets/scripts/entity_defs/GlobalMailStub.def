<root>
    <Interfaces>
        <Interface>     iBaseNoCell     </Interface>
        <Interface>     iGlobal         </Interface>
        <Interface>     iTimerBase      </Interface>
    </Interfaces>

    <Properties>
        <mailList>
            <Type>  ARRAY <of>  GLOBAL_MAIL_VAL </of>  </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </mailList>
        <lastSendTime>
            <Type>          LONGTIME            </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </lastSendTime>
        <delayMailList>
            <Type>  ARRAY <of>  GLOBAL_MAIL_VAL </of>  </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </delayMailList>
    </Properties>

    <BaseMethods>
        <sendGlobalMail>
            <Arg>   MAILID                      </Arg>
            <Arg>   PYTHON                      </Arg>
            <Arg>   ARRAY <of> UNICODE </of>    </Arg>
            <Arg>   UNICODE                     </Arg>
            <Arg>   UNICODE                     </Arg>
            <Arg>   LONGTIME                    </Arg>
            <Arg>   LONGTIME                    </Arg>
            <Arg>   LONGTIME                    </Arg>
            <Arg>   LEVEL                       </Arg>
            <Arg>   LEVEL                       </Arg>
            <Arg>   CHANNEL                     </Arg>
            <Arg>   UINT16                      </Arg>
            <Arg>   UINT16                      </Arg>
        </sendGlobalMail>

        <gmGetGlobalMailList>
            <Arg>   ENTITYCALL  </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   UINT32      </Arg>
        </gmGetGlobalMailList>

        <gmDeleteOneGlobalMail>
            <Arg>   MAIL_GBID  </Arg>
        </gmDeleteOneGlobalMail>
    </BaseMethods>
</root>
