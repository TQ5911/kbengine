<root>
    <Interfaces>
        <Interface> iBaseNoCell        </Interface>
        <Interface> iGlobal            </Interface>
        <Interface> iTimerBase         </Interface>
        <Interface> iCycleEvent      </Interface>
    </Interfaces>

    <Properties>
        <mineMapData>
            <Type>      MINE_WAR_DATA_INFO         </Type>
            <Flags>     BASE           </Flags>
            <Persistent>   true        </Persistent>
        </mineMapData>
    </Properties>

    <BaseMethods>
        <registerMineWarSpaceMgr>
            <Arg>          LINE_NO         </Arg>
            <Arg>          MAILBOX         </Arg>
        </registerMineWarSpaceMgr>

        <playerGetMineWarState>
            <Arg>          MAILBOX         </Arg>
            <Arg>          GUILD_UUID      </Arg>
        </playerGetMineWarState>

        <onMineWarFlagBeKill>
            <Arg>          LINE_NO         </Arg>
            <Arg>          UNICODE        </Arg>
            <Arg>          UNICODE        </Arg>
        </onMineWarFlagBeKill>

        <playerGetMineWarInfo>
            <Arg>          MAILBOX         </Arg>
            <Arg>          GUILD_UUID      </Arg>
        </playerGetMineWarInfo>

        <doShareGuildMineWarBonusToMember>
            <Arg>          LINE_NO         </Arg>
            <Arg>          PLAYER_GBID         </Arg>
            <Arg>         ARRAY   <of>  MINE_WAR_GUILD_SHARE_INFO   </of>   </Arg>
            <Arg>          MAILBOX         </Arg>
        </doShareGuildMineWarBonusToMember>

        <doGetMineWarGuildMemberScore>
            <Arg>          LINE_NO         </Arg>
            <Arg>          MAILBOX         </Arg>
            <Arg>          GUILD_UUID      </Arg>
        </doGetMineWarGuildMemberScore>

        <doGetMineWarGuildOwnerRank>
            <Arg>          LINE_NO         </Arg>
            <Arg>          MAILBOX         </Arg>
            <Arg>          MINE_WAR_GUILD_INFO         </Arg>
            <Arg>          UINT8         </Arg>
        </doGetMineWarGuildOwnerRank>
        <doGetMineWarGuildPlayerRank>
            <Arg>          LINE_NO         </Arg>
            <Arg>          MAILBOX         </Arg>
            <Arg>          PLAYER_GBID         </Arg>
            <Arg>          UNICODE         </Arg>
            <Arg>          MINE_WAR_GUILD_INFO         </Arg>
            <Arg>          UINT8         </Arg>
        </doGetMineWarGuildPlayerRank>

        <doOnMineWarKillCoreForGuild>
            <Arg>          LINE_NO         </Arg>
            <Arg>          MAILBOX         </Arg>
            <Arg>          MINE_WAR_GUILD_INFO         </Arg>
        </doOnMineWarKillCoreForGuild>

        <addMineWarScore>
            <Arg>          LINE_NO         </Arg>
            <Arg>          PLAYER_GBID     </Arg>
            <Arg>          UNICODE         </Arg>
            <Arg>          GUILD_UUID      </Arg>
            <Arg>          UNICODE         </Arg>
            <Arg>          UINT8         </Arg>
            <Arg>          UINT8         </Arg>
            <Arg>          INT32         </Arg>
            <Arg>          UINT8         </Arg> 
        </addMineWarScore>

        <playerCollectAward>
            <Arg>          LINE_NO         </Arg>
            <Arg>          INT32         </Arg>
        </playerCollectAward>

        <SyncMineWarFlagHp>
            <Arg>          LINE_NO         </Arg>
            <Arg>          INT32         </Arg>
        </SyncMineWarFlagHp>

        <doMineWarGuildDisbanded>
            <Arg>          GUILD_UUID      </Arg>
        </doMineWarGuildDisbanded>
    </BaseMethods>
</root>
