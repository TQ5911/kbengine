<root>
    <Interfaces>
        <Interface>     iCell                   </Interface>
        <Interface>     iSpaceMgr               </Interface>
        <Interface>     iTimerCell              </Interface>
        <Interface>     iMineWarSpaceMgr        </Interface>
    </Interfaces>

    <Properties>
        <worldLineSceneState>
            <Type>          SCENE_STATE             </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </worldLineSceneState>

        <worldBossGid>
            <Type>          GAME_ENTITY_ID          </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </worldBossGid>

        <afterDeadSetSceneTimer>
            <Type>          TIMER_ID                </Type>
            <Flags>         CELL_PRIVATE            </Flags>
            <Default>       0                       </Default>
        </afterDeadSetSceneTimer>
    </Properties>

    <CellMethods>
        <onGetCreateBossTime>
            <Arg>           LONGTIME                    </Arg>
        </onGetCreateBossTime>
    </CellMethods>
</root>
