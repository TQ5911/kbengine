<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
    </Interfaces>

    <Properties>
        <createBossTimeDic>
            <Type>          PY_DICT             </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    True                </Persistent>
        </createBossTimeDic>
    </Properties>

    <BaseMethods>
        <getBossCreateTime>
            <Arg>           SPACE_NO            </Arg>
            <Arg>           ENTITYCALL          </Arg>
        </getBossCreateTime>

        <addCreateWorldBossTimer>
            <Arg>           SPACE_NO            </Arg>
            <Arg>           LONGTIME            </Arg>
        </addCreateWorldBossTimer>

        <onWorldBossDeadAddTimer>
            <Arg>           SPACE_NO            </Arg>
            <Arg>           LONGTIME            </Arg>
        </onWorldBossDeadAddTimer>
    </BaseMethods>
</root>
