<root>
    <Interfaces>
        <Interface> iBaseNoCell        </Interface>
        <Interface> iGlobal            </Interface>
        <Interface> iTimerBase         </Interface>
        <Interface> iLinePlayersStub   </Interface>
        <Interface> iLineSpaceStub     </Interface>
    </Interfaces>

    <Properties>
        <lineReadRecoverList>
            <Type>      PY_LIST         </Type>
            <Default>   []              </Default>
            <Flags>     BASE            </Flags>
        </lineReadRecoverList>

    </Properties>

    <BaseMethods>
