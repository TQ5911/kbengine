<root>
    <Interfaces>
        <Interface>     iBaseNoCell                     </Interface>
        <Interface>     iGlobal                         </Interface>
        <Interface>     iTimerBase                      </Interface>
        <Interface>     iCityOwnerMgr                   </Interface>
        <Interface>     iCycleEvent                     </Interface>
    </Interfaces>
    
    <Properties>
        <siegeWarState>
            <Type>          INT32                   </Type>
            <Flags>         BASE                    </Flags>
        </siegeWarState>

        <siegeWarStateEndTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
        </siegeWarStateEndTime>

        <declareWarTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
        </declareWarTime>

        <officialWarStartTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
        </officialWarStartTime>

        <nowBiddingCnt>
            <Type>          INT32                   </Type>
            <Flags>         BASE                    </Flags>
        </nowBiddingCnt>

        <firstBiddingPrice>
            <Type>          INT32                   </Type>
            <Flags>         BASE                    </Flags>
        </firstBiddingPrice>

        <firstBiddingGuildName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </firstBiddingGuildName>

        <firstBiddingServerName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </firstBiddingServerName>

        <firstBiddingAvatarName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </firstBiddingAvatarName>

        <secondBiddingGuildName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </secondBiddingGuildName>

        <firstBiddingGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
        </firstBiddingGuildUUID>

        <secondBiddingGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
        </secondBiddingGuildUUID>

        <avatarGBID>
            <Type>          PLAYER_GBID              </Type>
            <Flags>         BASE                    </Flags>
        </avatarGBID>

        <avatarServerID>
            <Type>          SERVER_ID               </Type>
            <Flags>         BASE                    </Flags>
        </avatarServerID>

        <avatarName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </avatarName>

        <biddingGuildList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       []                      </Default>
        </biddingGuildList>

        <biddingNameList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       []                      </Default>
        </biddingNameList>

        <biddingCntList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       []                      </Default>
        </biddingCntList>

        <warOffensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </warOffensiveGuildUUID>

        <warDefensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
        </warDefensiveGuildUUID>

        <warOffensiveGuildName>
            <Type>           UNICODE                </Type>
            <Flags>         BASE                    </Flags>
        </warOffensiveGuildName>

        <warDefensiveGuildName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </warDefensiveGuildName>

        <haveCityOwner>
            <Type>          BOOL                    </Type>
            <Flags>         BASE                    </Flags>
            <Default>       false                   </Default>
        </haveCityOwner>

        <hasResetSpace>
            <Type>          BOOL                    </Type>
            <Flags>         BASE                    </Flags>
        </hasResetSpace>

        <offensiveJunXuQiXieLevelData>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       {}                      </Default>
        </offensiveJunXuQiXieLevelData>

        <defensiveJunXuQiXieLevelData>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Default>       {}                      </Default>
        </defensiveJunXuQiXieLevelData>

        <cityDefenseDeclaration>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </cityDefenseDeclaration>

        <cityOffensiveDeclaration>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
        </cityOffensiveDeclaration>
    </Properties>

    <BaseMethods>
        <getSiegeWarState>
            <Arg>           INT32    </Arg>
        </getSiegeWarState>

        <doBidding>
            <Arg>           INT32                       </Arg>
            <Arg>           PLAYER_GBID                 </Arg>
            <Arg>           UNICODE                     </Arg>
            <Arg>           INT32                       </Arg>
            <Arg>           UNICODE                     </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           UNICODE                     </Arg>
        </doBidding>

        <onSiegeWarDeclareWar>
            <Arg>           INT32                       </Arg>
            <Arg>           ENTITYCALL                  </Arg>
            <Arg>           BOOL                        </Arg>
            <Arg>           PLAYER_GBID                 </Arg>
            <Arg>           UNICODE                     </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           UNICODE                     </Arg>
            <Arg>           UNICODE                     </Arg>
        </onSiegeWarDeclareWar>

        <onCrossSiegeWarEnd>
            <Arg>           PY_LIST                     </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           GUILD_UUID                  </Arg>
        </onCrossSiegeWarEnd>

        <gmChangeSiegeWarState>
            <Arg>           INT32                       </Arg>
            <Arg>           LONGTIME                    </Arg>
            <Arg>           PYTHON                      </Arg>
        </gmChangeSiegeWarState>

        <onSyncJunXuQiXieLevel>
            <Arg>           PY_DICT                     </Arg>
            <Arg>           PY_DICT                     </Arg>
        </onSyncJunXuQiXieLevel>

        <changeDeclaration>
            <Arg>           BOOL                        </Arg>
            <Arg>           PLAYER_GBID                 </Arg>
            <Arg>           UNICODE                     </Arg>
        </changeDeclaration>

        <onSiegeWarRename>
            <Arg>           PLAYER_GBID                 </Arg>
            <Arg>           UNICODE                     </Arg>
        </onSiegeWarRename>

        <onGuildRename>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           UNICODE                     </Arg>
        </onGuildRename>

        <tryLoadSiegeWarDataFromCrossData>
        </tryLoadSiegeWarDataFromCrossData>

        <onLoadSiegeWarDataFromCrossData>
            <Arg>           BOOL                        </Arg>
            <Arg>           PYTHON                      </Arg>
        </onLoadSiegeWarDataFromCrossData>

        <onSaveSiegeWarDataFromCrossData>
            <Arg>           BOOL                        </Arg>
        </onSaveSiegeWarDataFromCrossData>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
    </ClientMethods>
</root>
