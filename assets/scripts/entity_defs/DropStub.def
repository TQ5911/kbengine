<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
        <Interface> iCentralStub                </Interface>
    </Interfaces>

    <Properties>
        <remoteCallCache>
            <Type>          PY_DICT             </Type>
            <Flags>         BASE                </Flags>
        </remoteCallCache>
    </Properties>

    <BaseMethods>
        <dropEquipItem>
            <Arg>       SERVER_ID           </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       UINT32              </Arg>
            <Arg>       SERVER_ID           </Arg>
            <Arg>       OBJECT_ID           </Arg>
            <Arg>       BOOL                </Arg>
        </dropEquipItem>

        <takeDropEquip>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       SERVER_ID           </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       LONGTIME            </Arg>
        </takeDropEquip>

        <giveUpDropEquip>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </giveUpDropEquip>

        <doGetTakeReward>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </doGetTakeReward>

        <doGetDropInfo>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </doGetDropInfo>

        <doRedeemEquipDrop>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </doRedeemEquipDrop>

        <sendRepairDropMail>
            <Arg>       UNIQUE_ID           </Arg>
        </sendRepairDropMail>

        <updateCollEndTime>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       LONGTIME            </Arg>
        </updateCollEndTime>

        <doCheckDropExpire>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </doCheckDropExpire>
        
        <setTakeEquipRedeemPrice>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       UINT32              </Arg>
        </setTakeEquipRedeemPrice>

        <doCheckRedeemExpire>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       ENTITYCALL          </Arg>
        </doCheckRedeemExpire>

        <doGetBackEquip>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT32              </Arg>
        </doGetBackEquip>

        <custodyEquipItem>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       UINT32              </Arg>
            <Arg>       BLOB                </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       SERVER_ID           </Arg>
            <Arg>       LONGTIME            </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       SERVER_ID           </Arg>
        </custodyEquipItem>

        <checkDropReturnExpire>
        </checkDropReturnExpire>

        <setDropEquipPayPrice>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       UNIQUE_ID           </Arg>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       UINT32              </Arg>
            <Arg>       DOUBLE              </Arg>
        </setDropEquipPayPrice>
   </BaseMethods>
</root>
