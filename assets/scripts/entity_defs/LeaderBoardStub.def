<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
        <Interface> iCycleEvent                 </Interface>
    </Interfaces>

    <Properties>
        <leaderBoardType>
            <Type>          UINT8                                           </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
        </leaderBoardType>

        <dynamicWorldLevel>
            <Type>          LEVEL                                           </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
        </dynamicWorldLevel>

        <peakOnlineNum>
            <Type>          UINT32                                          </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
            <Default>       0                                               </Default>
        </peakOnlineNum>

        <yesterdayPeakOnlineNum>
            <Type>          UINT32                                          </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
            <Default>       0                                               </Default>
        </yesterdayPeakOnlineNum>

        <peakOnlineDate>
            <Type>          UINT32                                          </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
            <Default>       0                                               </Default>
        </peakOnlineDate>

        <crossWorldLevel>
            <Type>          LEVEL                                           </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
            <Default>       0                                               </Default>
        </crossWorldLevel>

        <leaderBoardCache>
            <Type>          PY_DICT         </Type>
            <Flags>         BASE            </Flags>
        </leaderBoardCache>

        <leaderBoardList>
            <Type>          LEADER_BOARD_LIST_DATA_INFO                     </Type>
            <Flags>         BASE                                            </Flags>
            <Persistent>    true                                            </Persistent>
        </leaderBoardList>

        <leaderBoardIdx>
            <Type>          LEADER_BOARD_IDX                                </Type>
            <Flags>         BASE                                            </Flags>
        </leaderBoardIdx>
    </Properties>

    <BaseMethods>
        <onGetLeaderBoardCache>
            <Arg>           PYTHON                                  </Arg>
        </onGetLeaderBoardCache>

        <onFirstCreate>
        </onFirstCreate>

        <doGetLeaderBoardGuildList>
            <Arg>           ENTITYCALL                              </Arg>
            <Arg>           LEADER_BOARD_IDX                        </Arg>
            <Arg>           GUILD_UUID                              </Arg>
            <Arg>           LEADER_BOARD_PAGE                       </Arg>
        </doGetLeaderBoardGuildList>

        <doGetLeaderBoardList>
            <Arg>           ENTITYCALL                              </Arg>
            <Arg>           PLAYER_GBID                             </Arg>
            <Arg>           LEADER_BOARD_IDX                        </Arg>
            <Arg>           SCHOOL                                  </Arg>
            <Arg>           LEADER_BOARD_PAGE                       </Arg>
        </doGetLeaderBoardList>

        <getDynamicWorldLevel>
            <Arg>          ENTITYCALL                  </Arg>
        </getDynamicWorldLevel>

        <gmSetDynamicWorldLevel>
            <Arg>          LEVEL                       </Arg>
        </gmSetDynamicWorldLevel>

        <onReqServerWorldLevel>
            <Arg>          SERVER_ID                   </Arg>
        </onReqServerWorldLevel>

        <onAckServerWorldLevel>
            <Arg>          SERVER_ID                   </Arg>
            <Arg>          LEVEL                       </Arg>
        </onAckServerWorldLevel>

        <onSyncCrossWorldLevel>
            <Arg>          LEVEL                       </Arg>
        </onSyncCrossWorldLevel>

        <getScoreRushRankSelf>
            <Arg>          ENTITYCALL                  </Arg>
            <Arg>          PLAYER_GBID                 </Arg>
        </getScoreRushRankSelf>

        <getScoreRushRankList>
            <Arg>          ENTITYCALL                  </Arg>
            <Arg>          PLAYER_GBID                 </Arg>
            <Arg>          LEADER_BOARD_PAGE           </Arg>
        </getScoreRushRankList>

        <gmFinalizeScoreRank>
            <Arg>          UINT8                       </Arg>
        </gmFinalizeScoreRank>
    </BaseMethods>
</root>
