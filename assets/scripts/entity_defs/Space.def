<?xml version="1.0" encoding="utf-8"?>
<root>
    <Interfaces>
        <Interface>   iBase  </Interface>
        <Interface>   iCell  </Interface>
        <Interface>	   iTimerCell    </Interface>
        <Interface>	   iFubenSpace    </Interface>
    </Interfaces>

    <Properties>
        <spaceid>
            <Type>          SPACE_ID            </Type>
            <Flags>         BASE            </Flags>
        </spaceid>

        <spaceno>
            <Type>          SPACE_NO            </Type>
            <Flags>         BASE            </Flags>
        </spaceno>

        <spacetype>
            <Type>          UINT16        </Type>
            <Flags>         BASE          </Flags>
            <Default>       1             </Default>
        </spacetype>

        <chunkAlready>
            <Type>      BOOL        </Type>
            <Flags>     BASE        </Flags>
            <Default>   0       </Default>
        </chunkAlready>

        <notifiedSpaceReady>
            <Type>      BOOL        </Type>
            <Flags>     BASE        </Flags>
            <Default>   0       </Default>
        </notifiedSpaceReady>

        <cellappIndex>
            <!--this property use in KBEngine.createCellEntityInNewSpace-->
            <Type>  UINT32  </Type>
            <Flags> BASE    </Flags>
            <Default>   0   </Default>
        </cellappIndex>

        <spaceWeight>
            <!--this property use in KBEngine.createCellEntityInNewSpace-->
            <Type>  UINT32  </Type>
            <Flags> BASE    </Flags>
            <Default>   0   </Default>
        </spaceWeight>

        <spaceMap>
            <Type>      PATH        </Type>
            <Flags>     CELL_PRIVATE    </Flags>
        </spaceMap>

        <onLoseCellReason>
            <Type>          UINT8       </Type>
            <Flags>         BASE        </Flags>
            <Default>       0           </Default>
        </onLoseCellReason>

        <lineStubIdx>
            <Type>          UINT16                   </Type>
            <Flags>         CELL_PRIVATE          </Flags>
            <Default>       0                       </Default>
        </lineStubIdx>

        <dungeonId>
            <Type>          DUNGEON_NO          </Type>
            <Flags>         CELL_PRIVATE          </Flags>
            <Default>       0                       </Default>
        </dungeonId>

    </Properties>

    <BaseMethods>
        <initCellField>
            <Arg>       SPACE_ID    </Arg>
        </initCellField>

        <entireConstruct>
            <Arg>       SPACE_ID    </Arg>
        </entireConstruct>

        <setBaseAppData>
            <Arg>           STRING    </Arg>
            <Arg>           PYTHON    </Arg>
        </setBaseAppData>
    </BaseMethods>

    <CellMethods>
        <createCellLocally>
            <Arg>           ENT_TYPE        </Arg>
            <Arg>           POSITION_ARG    </Arg>
            <Arg>           DIRECTION_ARG   </Arg>
            <Arg>           PYTHON          </Arg>
        </createCellLocally>

        <destroyMySpace>
        </destroyMySpace>

        <onEntireConstruct>
        </onEntireConstruct>

        <removeEntityById>
            <Arg>       STRING          </Arg>
        </removeEntityById>

        <setHomeCompByteMap>
            <Arg>       MAILBOX         </Arg>
            <Arg>       INT32           </Arg>
            <Arg>       INT32           </Arg>
            <Arg>       UINT16          </Arg>
            <Arg>       UINT16          </Arg>
            <Arg>       ARRAY   <of>    UINT8      </of>   </Arg>
        </setHomeCompByteMap>

        <updateSpaceWeight>
            <Arg>       UINT32          </Arg>
        </updateSpaceWeight>

        <doLoadEntities>
            <Arg>       OBJECT_ID       </Arg>
        </doLoadEntities>

        <callOnSpaceMgr>
            <Arg>       STRING          </Arg>
            <Arg>       PYTHON          </Arg>
        </callOnSpaceMgr>

        <callOnSpace>
            <Arg>       STRING          </Arg>
            <Arg>       PYTHON          </Arg>
        </callOnSpace>
    </CellMethods>

</root>
