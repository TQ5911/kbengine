<root>
    <Interfaces>
        <Interface>     iBaseWithCell           </Interface>
        <Interface>     iCell                   </Interface>
        <Interface>     iSpaceMgr               </Interface>
        <Interface>     iTimerCell              </Interface>
    </Interfaces>

    <Properties>
        <dungeonPlayMode>
            <Type>      PYTHON                              </Type>
            <Flags>     CELL_PRIVATE                        </Flags>
        </dungeonPlayMode>

        <dungeonStage>
            <Type>      DUNGEON_STAGE      </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </dungeonStage>

        <dungeonStageStartT>
            <Type>      LONGTIME      </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </dungeonStageStartT>

        <dungeonPlayerReliveRecordDic>
            <Type> PY_DICT </Type>
            <Flags> CELL_PRIVATE </Flags>
            <Default> {} </Default>
        </dungeonPlayerReliveRecordDic>

        <dungeonCompleteDelayNotifyTimer>
            <Type> UINT64 </Type>
            <Flags> CELL_PRIVATE </Flags>
            <Default> 0 </Default>
        </dungeonCompleteDelayNotifyTimer>

        <dungeonStatisticRecords>
            <Type>      PYTHON              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   {}                  </Default>
        </dungeonStatisticRecords>
        
        <dungeonStatisticSortedRecords>
            <Type>      PYTHON              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   {}                  </Default>
        </dungeonStatisticSortedRecords>

        <dungeonStatisticBatchCount>
            <Type>      UINT32              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   0                   </Default>
        </dungeonStatisticBatchCount>

        <dungeonSettlementDataCache>
            <Type>      PYTHON              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   {}                  </Default>
        </dungeonSettlementDataCache>

        <guildBox>
            <Type>      MAILBOX             </Type>
            <Flags>     CELL_PRIVATE        </Flags>
        </guildBox>

        <opUUID>
            <Type>      INT64               </Type>
            <Flags>     CELL_PRIVATE        </Flags>
        </opUUID>

        <dungeonExtraDatas>
            <Type>      PYTHON          </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>   {}              </Default>
        </dungeonExtraDatas>

        <dungeonRewardDatas>
            <Type>      PYTHON          </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>   {}              </Default>
        </dungeonRewardDatas>

        <dungeonAutoBattleTimes>
            <Type>      PYTHON          </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>   {}              </Default>
        </dungeonAutoBattleTimes>
    </Properties>

    <BaseMethods>
    </BaseMethods>

    <CellMethods>
        <onDungeonStarted>
            <Arg>   LONGTIME    </Arg>
        </onDungeonStarted>

        <onSingleDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            INT32           </Arg>
        </onSingleDungeonCompleted>

        <onTeamDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            TEAMID          </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            INT8            </Arg>
        </onTeamDungeonCompleted>

        <finishGuildDungeonTask>
        </finishGuildDungeonTask>

        <onRaidDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            RAID_ID         </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            PY_DICT         </Arg>
            <Arg>            PY_LIST         </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            INT8            </Arg>
        </onRaidDungeonCompleted>

        <onGuildBossDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            GUILD_UUID      </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            INT64           </Arg>
            <Arg>            INT8            </Arg>
        </onGuildBossDungeonCompleted>

        <doEnterTeamDungeon>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PYTHON                  </Arg>
        </doEnterTeamDungeon>

        <enterRaidDungeonDirectly>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   DUNGEON_SRC             </Arg>
            <Arg>   PYTHON                  </Arg>
        </enterRaidDungeonDirectly>

        <cancelCompleteDelayNotifyTimer>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   UINT16                  </Arg>
        </cancelCompleteDelayNotifyTimer>

        <doEnterGuildBossDungeon>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PYTHON                  </Arg>
        </doEnterGuildBossDungeon>

        <onDungeonStatisticData>
            <Arg>      UINT16                                       </Arg>
            <Arg>      UINT16                                       </Arg>
            <Arg>      SPACE_NO                                     </Arg>
            <Arg>      GUILD_UUID                                   </Arg>
            <Arg>      UINT32                                       </Arg>
            <Arg>      ARRAY <of> DUNGEON_STATISTIC_DATA </of>      </Arg>
        </onDungeonStatisticData>

        <setGuildBox>
            <Arg>   MAILBOX   </Arg>
            <Arg>   INT64     </Arg>
        </setGuildBox>

        <dungeonCompleted>
        </dungeonCompleted>

        <notifyDungeonExtarData>
            <Arg>   PLAYER_GBID                         </Arg>
            <Arg>   DUNGEON_EXTRA_DATA                  </Arg>
        </notifyDungeonExtarData>

        <onGetSettlementRankList>
            <Arg>            UINT8           </Arg>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            UUID            </Arg>
            <Arg>            MAILBOX         </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            UINT8           </Arg>
            <Arg>            UINT8           </Arg>
        </onGetSettlementRankList>

        <onNotifySettlementResult>
            <Arg>   MAILBOX                                                </Arg>
            <Arg>   UINT8                                                  </Arg>
            <Arg>   SPACE_NO                                               </Arg>
            <Arg>   DUNGEON_NO                                             </Arg>
            <Arg>   UUID                                                   </Arg>
            <Arg>   UUID                                                   </Arg>
            <Arg>   UINT8                                                  </Arg>
            <Arg>   PYTHON                                                 </Arg>
            <Arg>   ARRAY <of>  BAG_ITEM_BRIEF_VAL </of>                   </Arg>
            <Arg>   ARRAY <of>  BAG_ITEM_BRIEF_VAL </of>                   </Arg>
            <Arg>   ARRAY <of>  BAG_ITEM_BRIEF_VAL </of>                   </Arg>
        </onNotifySettlementResult>

        <recordAutoFightTimes>
            <Arg>       PLAYER_GBID  </Arg>
            <Arg>       INT16        </Arg>
            <Arg>       INT16        </Arg>
        </recordAutoFightTimes>
    </CellMethods>
</root>
