<root>
    <Interfaces>
        <Interface>     iBaseWithCell           </Interface>
        <Interface>     iCell                   </Interface>
        <Interface>     iSpaceMgr               </Interface>
        <Interface>     iTimerCell              </Interface>
    </Interfaces>

    <Properties>
        <dungeonPlayMode>
            <Type>      PYTHON                              </Type>
            <Flags>     CELL_PRIVATE                        </Flags>
        </dungeonPlayMode>

        <dungeonStage>
            <Type>      DUNGEON_STAGE      </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </dungeonStage>

        <dungeonStageStartT>
            <Type>      LONGTIME      </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </dungeonStageStartT>

        <dungeonPlayerReliveRecordDic>
            <Type> PY_DICT </Type>
            <Flags> CELL_PRIVATE </Flags>
            <Default> {} </Default>
        </dungeonPlayerReliveRecordDic>

        <dungeonGoodManColl>
            <Type> PYTHON </Type>
            <Flags> CELL_PRIVATE </Flags>
            <Default> set() </Default>
        </dungeonGoodManColl>

        <dungeonGoodManActId>
            <Type>      ACTIVITY_ID        </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </dungeonGoodManActId>

        <dungeonCompleteDelayNotifyTimer>
            <Type> UINT64 </Type>
            <Flags> CELL_PRIVATE </Flags>
            <Default> 0 </Default>
        </dungeonCompleteDelayNotifyTimer>

        <dungeonStatisticData>
            <Type> TEAM_STATISTIC_CLIENT_VAL1 </Type>
            <Flags> CELL_PRIVATE </Flags>
        </dungeonStatisticData>

        <dungeonStatisticRecords>
            <Type>      PYTHON              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   {}                  </Default>
        </dungeonStatisticRecords>
        
        <dungeonSettlementDataCache>
            <Type>      PYTHON              </Type>
            <Flags>     CELL_PRIVATE        </Flags>
            <Default>   {}                  </Default>
        </dungeonSettlementDataCache>

        <guildBox>
            <Type>      MAILBOX             </Type>
            <Flags>     CELL_PRIVATE        </Flags>
        </guildBox>
    </Properties>

    <BaseMethods>
    </BaseMethods>

    <CellMethods>
        <onDungeonStarted>
            <Arg>   LONGTIME    </Arg>
        </onDungeonStarted>

        <onSingleDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            PLAYER_GBID     </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            INT32           </Arg>
        </onSingleDungeonCompleted>

        <onTeamDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            TEAMID          </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            PLAYER_GBID     </Arg>
        </onTeamDungeonCompleted>

        <onRaidDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            RAID_ID         </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            FLOAT           </Arg>
            <Arg>            PY_DICT         </Arg>
            <Arg>            PY_LIST         </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            PLAYER_GBID     </Arg>
        </onRaidDungeonCompleted>

        <onGuildBossDungeonCompleted>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            GUILD_UUID      </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            INT32           </Arg>
            <Arg>            INT64           </Arg>
        </onGuildBossDungeonCompleted>

        <doEnterTeamDungeon>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PYTHON                  </Arg>
        </doEnterTeamDungeon>

        <enterRaidDungeonDirectly>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   DUNGEON_SRC             </Arg>
            <Arg>   PYTHON                  </Arg>
        </enterRaidDungeonDirectly>

        <cancelCompleteDelayNotifyTimer>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   UINT16                  </Arg>
        </cancelCompleteDelayNotifyTimer>

        <onGetTeamStatisticData>
            <Arg>   TEAM_STATISTIC_CLIENT_VAL1   </Arg>
        </onGetTeamStatisticData>

        <doEnterGuildBossDungeon>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PLAYER_GBID             </Arg>
            <Arg>   UUID                    </Arg>
            <Arg>   MAILBOX                 </Arg>
            <Arg>   PYTHON                  </Arg>
        </doEnterGuildBossDungeon>

        <notifyDungeonStatisticRecords>
            <Arg>      UINT16                                      </Arg>
            <Arg>      ARRAY <of> DUNGEON_STATISTIC_DATA </of>     </Arg>
        </notifyDungeonStatisticRecords>

        <setGuildBox>
            <Arg>   MAILBOX                 </Arg>
        </setGuildBox>

        <dungeonCompleted>
        </dungeonCompleted>
    </CellMethods>
</root>
