<root>
    <Interfaces>
        <Interface>     iBaseNoCell     </Interface>
        <Interface>     iGlobal         </Interface>
        <Interface>     iTimerBase      </Interface>
    </Interfaces>

     <Properties>
        <redbagDict>
            <Type>      RED_BAG_DATA_INFO       </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </redbagDict>
        <lastReleaseTime>
            <Type>          LONGTIME            </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </lastReleaseTime>
        <fetchDict>
            <Type>      PY_DICT                 </Type>
            <Flags>         BASE                </Flags>
            <Default>       {}               </Default>
        </fetchDict>
    </Properties>


    <BaseMethods>
        <doGetRedBagRankList>
            <Arg>          MAILBOX         </Arg>
            <Arg>           GUILD_UUID           </Arg>
            <Arg>          PY_LIST         </Arg>
        </doGetRedBagRankList>
        <doGetRedBagList>
            <Arg>          MAILBOX         </Arg>
            <Arg>          PY_LIST         </Arg>
            <Arg>          PY_LIST         </Arg>
        </doGetRedBagList>
        <doCreateRedBag>
            <Arg>          MAILBOX         </Arg>
            <Arg>           INT64           </Arg>
            <Arg>           PLAYER_GBID           </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           GUILD_UUID           </Arg>
            <Arg>           INT8           </Arg>
            <Arg>           INT8           </Arg>
            <Arg>           INT32           </Arg>
            <Arg>           INT16           </Arg>
            <Arg>           STRING          </Arg>
        </doCreateRedBag>
            
        <doFetchRedBag>
            <Arg>          MAILBOX         </Arg>
            <Arg>           INT64           </Arg>
            <Arg>           PLAYER_GBID           </Arg>
            <Arg>           GUILD_UUID           </Arg>
            <Arg>           UNICODE           </Arg>
        </doFetchRedBag>

        <showData>
        </showData>

	</BaseMethods>

	<CellMethods>

	</CellMethods>

	<ClientMethods>

	</ClientMethods>

</root>