<root>

    <Interfaces>
        <Interface> iBaseNoCell </Interface>
        <Interface> iGlobal    </Interface>
        <Interface>       iTimerBase    </Interface>
    </Interfaces>

    <Properties>
        <teamDic>
            <Type>      PY_DICT      </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}        </Default>
        </teamDic>
    </Properties>

    <BaseMethods>
        <createTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           PY_DICT         </Arg>
        </createTeam>

        <applyJoinTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           PY_DICT         </Arg>
            <Arg>           BOOL            </Arg>
        </applyJoinTeam>

        <addTeamMember>
            <Arg>           TEAMID          </Arg>
            <Arg>           PY_DICT         </Arg>
        </addTeamMember>

        <applyInviteTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </applyInviteTeam>

        <replyInviteTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PY_DICT         </Arg>
        </replyInviteTeam>

        <leaveTeam>
            <Arg>           UINT32          </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </leaveTeam>

        <kickTeamMember>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </kickTeamMember>

        <transferCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </transferCaptain>

        <applyBecomeCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </applyBecomeCaptain>

       <replyBecomeCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </replyBecomeCaptain>

        <cancelTeamJoinRequest>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </cancelTeamJoinRequest>

        <replyJoinTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyJoinTeam>

        <getTeamInfoOnLogin>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
        </getTeamInfoOnLogin>

        <notifyPlayerLogon>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           BOOL            </Arg>
        </notifyPlayerLogon>

        <logonEnterLine>
            <Arg>           LINE_TYPE       </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PYTHON          </Arg>
        </logonEnterLine>

        <logonEnterMyHome>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PYTHON          </Arg>
        </logonEnterMyHome>

        <logonEnterGuildSpace>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           GUILD_UUID      </Arg>
            <Arg>           PYTHON          </Arg>
        </logonEnterGuildSpace>

        <disbandTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
        </disbandTeam>

        <onPlayerIsOffline>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </onPlayerIsOffline>

        <askAllMemberFollow>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </askAllMemberFollow>

        <askOneMemberFollow>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </askOneMemberFollow>

        <cancelAllMemberFollow>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </cancelAllMemberFollow>

        <followTeamCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </followTeamCaptain>

        <cancelFollowTeamCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </cancelFollowTeamCaptain>

        <updateMemberAttr>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </updateMemberAttr>

        <updateMemberVolatileAttr>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </updateMemberVolatileAttr>

        <updateOnlineState>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </updateOnlineState>

        <updateTeamFollowQueue>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </updateTeamFollowQueue>

        <teamFollowersCellDo>
            <Arg>           TEAMID          </Arg>
            <Arg>           METHOD_NAME     </Arg>
            <Arg>           METHOD_ARGS     </Arg>
        </teamFollowersCellDo>

        <isAllMembersFollowDo>
            <Arg>           TEAMID          </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           METHOD_NAME     </Arg>
            <Arg>           METHOD_ARGS     </Arg>
        </isAllMembersFollowDo>

        <!--dungeon mixin part-->
        <createTeamDungeon>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   DUNGEON_NO      </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   PYTHON          </Arg>
        </createTeamDungeon>

        <onCreateTeamDungeon>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PYTHON      </Arg>
        </onCreateTeamDungeon>

        <enterGuildBanditDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
            <Arg>   GUILD_UUID  </Arg>
            <Arg>   OBJECT_ID   </Arg>
        </enterGuildBanditDungeon>

        <enterTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamDungeon>

        <enterTeamCrusadeDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamCrusadeDungeon>

        <enterTeamDungeonDirectly>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamDungeonDirectly>

        <onEnterDungeonFailedSpaceNotFound>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   PYTHON      </Arg>
        </onEnterDungeonFailedSpaceNotFound>

        <onEnterTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
        </onEnterTeamDungeon>

        <leaveTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
        </leaveTeamDungeon>

        <destroyTeamDungeonDelay>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PYTHON      </Arg>
        </destroyTeamDungeonDelay>
        
        <TeamDungeonCompletedAfter>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   BOOL        </Arg>
        </TeamDungeonCompletedAfter>
        
        <onDestroyTeamDungeon>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
        </onDestroyTeamDungeon>

        <onAvatarOffline>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   DUNGEON_NO      </Arg>
        </onAvatarOffline>

        <onTeammateBeConfirmedTimeout>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </onTeammateBeConfirmedTimeout>

        <!--dungeon mixin part end-->

        <clearApplyJoinDic>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           TEAMID       </Arg>
        </clearApplyJoinDic>

        <requestStartTeamDuel>
            <Arg>           TEAMID       </Arg>
            <Arg>           MAILBOX      </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           MAILBOX      </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           BOOL         </Arg>
        </requestStartTeamDuel>

        <beRequestedStartTeamDuel>
            <Arg>           TEAMID       </Arg>
            <Arg>           MAILBOX      </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           UNICODE      </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           MAILBOX      </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           BOOL         </Arg>
        </beRequestedStartTeamDuel>

        <onTeamDuelSpaceReady>
            <Arg>           TEAMID       </Arg>
            <Arg>           SPACE_NO     </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           UUID         </Arg>
            <Arg>           UINT8        </Arg>
            <Arg>           UUID         </Arg>
            <Arg>           UNICODE      </Arg>
        </onTeamDuelSpaceReady>

        <beginEnterTeamDuelSpace>
            <Arg>           TEAMID       </Arg>
            <Arg>           PLAYER_GBID  </Arg>
        </beginEnterTeamDuelSpace>

        <onTeamDuelCompelted>
            <Arg>           TEAMID       </Arg>
            <Arg>           SPACE_NO     </Arg>
            <Arg>           UINT8        </Arg>
        </onTeamDuelCompelted>

        <sendChatMsgFromTeamMember>
            <Arg>           TEAMID       </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO      </Arg>
            <Arg>           UNICODE      </Arg>
        </sendChatMsgFromTeamMember>

        <getTeamMemberInfo>
            <Arg>           ENTITYCALL       </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           METHOD_NAME     </Arg>
            <Arg>           METHOD_ARGS     </Arg>
        </getTeamMemberInfo>

        <addTeamBanditKiller>
            <Arg>           TEAMID          </Arg>
            <Arg>           OBJECT_ID       </Arg>
            <Arg>           UINT8           </Arg>
            <Arg>           UINT16          </Arg>
            <Arg>           LINE_NO         </Arg>
        </addTeamBanditKiller>

        <addTeamGuildBandit>
            <Arg>           TEAMID          </Arg>
            <Arg>           GUILD_UUID      </Arg>
            <Arg>           OBJECT_ID       </Arg>
        </addTeamGuildBandit>

        <delTeamGuildBandit>
            <Arg>           TEAMID          </Arg>
            <Arg>           OBJECT_ID       </Arg>
        </delTeamGuildBandit>

        <delTeamBanditKiller>
            <Arg>           TEAMID       </Arg>
            <Arg>           OBJECT_ID    </Arg>
            <Arg>           UINT8        </Arg>
        </delTeamBanditKiller>

        <teamPrepareAutoMatch>
            <Arg>           TEAMID       </Arg>
            <Arg>           GUILD_UUID   </Arg>
        </teamPrepareAutoMatch>

        <teamPrepareStopAutoMatch>
            <Arg>           TEAMID       </Arg>
        </teamPrepareStopAutoMatch>

        <newPlayerMatched>
            <Arg>           TEAMID       </Arg>
            <Arg>           PY_DICT      </Arg>
        </newPlayerMatched>

        <onTeamAutoMatchTimeout>
            <Arg>           TEAMID       </Arg>
        </onTeamAutoMatchTimeout>

        <setTeamTarget>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           TEAMTARGET   </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UNICODE      </Arg>
            <Arg>           STRING       </Arg>
            <Arg>           BOOL         </Arg>
            <Arg>           GUILD_UUID   </Arg>
        </setTeamTarget>

        <getTeamInfo>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           TEAMID       </Arg>
        </getTeamInfo>

        <getTeamList>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           TEAMTARGET   </Arg>
            <Arg>           LONGTIME     </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
        </getTeamList>

        <checkActivedGuildBandit>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           OBJECT_ID    </Arg>
        </checkActivedGuildBandit>

       <killMonster>
            <Arg>           TEAMID       </Arg>
            <Arg>           SPACE_NO     </Arg>
            <Arg>           MONSTER_ID   </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           PLAYER_GBID  </Arg>
       </killMonster>

        <!--raid mixin start-->
        <createRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </createRaidWithTeam>

        <applyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON  </Arg>
        </applyJoinRaidWithTeam>

        <replyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   PY_LIST     </Arg>
            <Arg>   PYTHON  </Arg>
        </replyJoinRaidWithTeam>

        <raidApplyInvitedRaid>
            <Arg>   TEAMTARGET  </Arg>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PYTHON      </Arg>
        </raidApplyInvitedRaid>

        <onReplyInviteRaidWithTeamFail>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID </Arg>
            <Arg>   ERRNO  </Arg>
            <Arg>   PYTHON  </Arg>
        </onReplyInviteRaidWithTeamFail>

        <!--raid mixin ended-->

        <getOpenedGuildBandit>
            <Arg>   TEAMID          </Arg>
            <Arg>   ENTITYCALL      </Arg>
            <Arg>   ENTITYCALL      </Arg>
        </getOpenedGuildBandit>

        <updateTeamSilentFlag>
            <Arg>   TEAMID          </Arg>
            <Arg>   BOOL            </Arg>
        </updateTeamSilentFlag>

        <sendTeamMemberMessage>
            <Arg>   TEAMID          </Arg>
            <Arg>   INT32           </Arg>
            <Arg>   PY_LIST           </Arg>
        </sendTeamMemberMessage>

        <sendTeamMemberMessage_localCross>
            <Arg>   TEAMID          </Arg>
            <Arg>   INT32           </Arg>
            <Arg>   PY_LIST           </Arg>
        </sendTeamMemberMessage_localCross>

        <switchTeamMicsMode>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </switchTeamMicsMode>

        <turnOnTeamMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOnTeamMics>

        <turnOffTeamMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOffTeamMics>

        <blockTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </blockTeamMemberMics>

        <unblockTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockTeamMemberMics>

        <blockAllTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PYTHON      </Arg>
        </blockAllTeamMemberMics>

        <unblockAllTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockAllTeamMemberMics>

        <debugAllTeamInfo>
        </debugAllTeamInfo>

        <challengeDunNotifyMsg>
            <Arg>   TEAMID      </Arg>
            <Arg>   OBJECT_ID   </Arg>
            <Arg>   ARRAY   <of>    PLAYER_GBID     </of>   </Arg>
        </challengeDunNotifyMsg>

        <reCreateOrJoinTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PY_DICT         </Arg>
        </reCreateOrJoinTeam>

        <getCaptainName>
            <Arg>       TEAMID          </Arg>
            <Arg>       MAILBOX         </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       ENTITY_ID       </Arg>
        </getCaptainName>

        <reqAddMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UNICODE     </Arg>
            <Arg>       PLAYER_GBID     </Arg>
            <Arg>       ENTITY_ID           </Arg>
            <Arg>       POSITION_ARG    </Arg>
            <Arg>       MAILBOX     </Arg>
        </reqAddMarkMember>
        <reqDelMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
        </reqDelMarkMember>
        <reqChangeOnlyCaptain>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
        </reqChangeOnlyCaptain>
        <onMarkMonsterDead>
            <Arg>       OBJECT_ID       </Arg>
        </onMarkMonsterDead>
        <reqJoinTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PY_DICT     </Arg>
        </reqJoinTeam>

        <addTeamDungeonRewardRecord>
            <Arg>           TEAMID                                                  </Arg>
            <Arg>           PLAYER_GBID                                             </Arg>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </addTeamDungeonRewardRecord>

        <clearTeamDungeonRewardRecord>
            <Arg>       TEAMID          </Arg>
            <Arg>       PLAYER_GBID     </Arg>
        </clearTeamDungeonRewardRecord>

        <teamDungeonFinished>
            <Arg>           TEAMID          </Arg>
        </teamDungeonFinished>

        <addTeamStatisticPlayerVal>
            <Arg>       TEAMID          </Arg>
            <Arg>       PLAYER_GBID     </Arg>
            <Arg>       UINT8           </Arg>
            <Arg>       UINT32          </Arg>
        </addTeamStatisticPlayerVal>

        <getTeamStatisticData>
            <Arg>       MAILBOX        </Arg>
            <Arg>       TEAMID          </Arg>
            <Arg>       UINT8           </Arg>
        </getTeamStatisticData>

        <setInDungeon>
            <Arg>       TEAMID          </Arg>
        </setInDungeon>

        <getTeamStatisticFinalData>
            <Arg>       MAILBOX        </Arg>
            <Arg>       TEAMID          </Arg>
        </getTeamStatisticFinalData>
    </BaseMethods>
</root>
