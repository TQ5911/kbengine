<root>

    <Interfaces>
        <Interface> iBaseNoCell </Interface>
        <Interface> iGlobal    </Interface>
        <Interface>       iTimerBase    </Interface>
    </Interfaces>

    <Properties>
        <teamDict>
            <Type>      PY_DICT      </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}        </Default>
        </teamDict>
    </Properties>

    <BaseMethods>
        <createTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           TEAMTARGET      </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UINT32          </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           PY_DICT         </Arg>
        </createTeam>

        <applyJoinTeam>
            <Arg>           TEAMID          </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           PY_DICT         </Arg>
            <Arg>           BOOL            </Arg>
            <Arg>           INT8            </Arg>
            <Arg>           PYTHON          </Arg>
        </applyJoinTeam>

        <addTeamMemberInStub>
            <Arg>           TEAMID          </Arg>
            <Arg>           PY_DICT         </Arg>
        </addTeamMemberInStub>

        <applyInviteTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           LEVEL           </Arg>
            <Arg>           SCHOOL          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
            <Arg>           PYTHON          </Arg>
        </applyInviteTeam>

        <replyInviteTeamInStub>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PY_DICT         </Arg>
            <Arg>           UINT8           </Arg>
        </replyInviteTeamInStub>

        <leaveTeam>
            <Arg>           UINT32          </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </leaveTeam>

        <kickTeamMember>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </kickTeamMember>

        <doTransferCaptain>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </doTransferCaptain>

        <doApplyBecomeCaptain>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </doApplyBecomeCaptain>

       <replyBecomeCaptainInStub>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </replyBecomeCaptainInStub>

        <cancelTeamJoinRequest>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
        </cancelTeamJoinRequest>

        <replyJoinTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </replyJoinTeam>

        <fetchTeamInfoOnLogin>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
        </fetchTeamInfoOnLogin>

        <notifyPlayerLogon>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           BOOL            </Arg>
        </notifyPlayerLogon>

        <teamLogonEnterLine>
            <Arg>           LINE_TYPE       </Arg>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PYTHON          </Arg>
        </teamLogonEnterLine>

        <doDisbandTeam>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           TEAMID          </Arg>
        </doDisbandTeam>

        <onPlayerIsOffline>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </onPlayerIsOffline>

        <askAllMemberFollowTeamStub>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           SPACE_NO        </Arg>
            <Arg>           POSITION_ARG    </Arg>
        </askAllMemberFollowTeamStub>

        <updateMemberAttr>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </updateMemberAttr>

        <updateMemberVolatileAttr>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PYTHON          </Arg>
        </updateMemberVolatileAttr>

        <updateOnlineState>
            <Arg>           ENTITYCALL      </Arg>
            <Arg>           TEAMID          </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           BOOL            </Arg>
        </updateOnlineState>

        <!--dungeon mixin part-->
        <createTeamDungeon>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   DUNGEON_NO      </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   PYTHON          </Arg>
        </createTeamDungeon>

        <afterCreateTeamDungeon>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PYTHON      </Arg>
        </afterCreateTeamDungeon>

        <enterTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamDungeon>

        <enterTeamCrusadeDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamCrusadeDungeon>

        <enterTeamDungeonDirectly>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterTeamDungeonDirectly>

        <onEnterDungeonFailedSpaceNotFound>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   PYTHON      </Arg>
        </onEnterDungeonFailedSpaceNotFound>

        <onEnterTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
        </onEnterTeamDungeon>

        <leaveTeamDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   BOOL        </Arg>
        </leaveTeamDungeon>

        <destroyTeamDungeonDelay>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PYTHON      </Arg>
        </destroyTeamDungeonDelay>
        
        <onDestroyTeamDungeon>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
        </onDestroyTeamDungeon>

        <onAvatarOffline>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   DUNGEON_NO      </Arg>
        </onAvatarOffline>

        <onTeammateBeConfirmedTimeout>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </onTeammateBeConfirmedTimeout>

        <!--dungeon mixin part end-->

        <clearApplyJoinDicInStub>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           TEAMID       </Arg>
        </clearApplyJoinDicInStub>

        <sendChatMsgFromTeamMember>
            <Arg>           TEAMID       </Arg>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           CHAT_CHANNEL_AVATAR_INFO      </Arg>
            <Arg>           CHAT_MSG_DATA      </Arg>
        </sendChatMsgFromTeamMember>

        <fetchTeamMemberInfo>
            <Arg>           ENTITYCALL       </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           METHOD_NAME     </Arg>
            <Arg>           METHOD_ARGS     </Arg>
        </fetchTeamMemberInfo>

        <teamPrepareAutoMatch>
            <Arg>           TEAMID       </Arg>
        </teamPrepareAutoMatch>

        <doTeamPrepareStopAutoMatch>
            <Arg>           TEAMID       </Arg>
        </doTeamPrepareStopAutoMatch>

        <newPlayerMatched>
            <Arg>           TEAMID       </Arg>
            <Arg>           PY_DICT      </Arg>
        </newPlayerMatched>

        <setTeamTarget>
            <Arg>           PLAYER_GBID  </Arg>
            <Arg>           TEAMID       </Arg>
            <Arg>           TEAMTARGET   </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UNICODE      </Arg>
            <Arg>           STRING       </Arg>
            <Arg>           BOOL         </Arg>
        </setTeamTarget>

        <getTeamInfo>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           TEAMID       </Arg>
        </getTeamInfo>

        <getTeamList>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           TEAMTARGET   </Arg>
            <Arg>           LONGTIME     </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
        </getTeamList>

        <!--raid mixin start-->
        <createRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </createRaidWithTeam>

        <applyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON  </Arg>
        </applyJoinRaidWithTeam>

        <replyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   PY_LIST     </Arg>
            <Arg>   PYTHON  </Arg>
        </replyJoinRaidWithTeam>

        <raidApplyInvitedRaid>
            <Arg>   TEAMTARGET  </Arg>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   SCORE           </Arg>
            <Arg>   LEVEL           </Arg>
            <Arg>   PYTHON      </Arg>
        </raidApplyInvitedRaid>

        <onReplyInviteRaidAndTeamFail>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID </Arg>
            <Arg>   ERRNO  </Arg>
            <Arg>   PYTHON  </Arg>
        </onReplyInviteRaidAndTeamFail>

        <!--raid mixin ended-->
        <updateTeamSilentFlag>
            <Arg>   TEAMID          </Arg>
            <Arg>   BOOL            </Arg>
        </updateTeamSilentFlag>

        <sendTeamMemberMsg>
            <Arg>   TEAMID          </Arg>
            <Arg>   INT32           </Arg>
            <Arg>   PY_LIST           </Arg>
        </sendTeamMemberMsg>

        <sendTeamMemberMessage_localCross>
            <Arg>   TEAMID          </Arg>
            <Arg>   INT32           </Arg>
            <Arg>   PY_LIST           </Arg>
        </sendTeamMemberMessage_localCross>

        <switchTeamMicsMode>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </switchTeamMicsMode>

        <turnOnTeamMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOnTeamMics>

        <turnOffTeamMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOffTeamMics>

        <blockTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </blockTeamMemberMics>

        <unblockTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockTeamMemberMics>

        <blockAllTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PYTHON      </Arg>
        </blockAllTeamMemberMics>

        <unblockAllTeamMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockAllTeamMemberMics>

        <debugAllTeamInfo>
        </debugAllTeamInfo>

        <challengeDunNotifyMsg>
            <Arg>   TEAMID      </Arg>
            <Arg>   OBJECT_ID   </Arg>
            <Arg>   ARRAY   <of>    PLAYER_GBID     </of>   </Arg>
        </challengeDunNotifyMsg>

        <getCaptainName>
            <Arg>       TEAMID          </Arg>
            <Arg>       MAILBOX         </Arg>
            <Arg>       UNICODE         </Arg>
            <Arg>       ENTITY_ID       </Arg>
        </getCaptainName>

        <reqAddMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UNICODE     </Arg>
            <Arg>       PLAYER_GBID     </Arg>
            <Arg>       ENTITY_ID           </Arg>
            <Arg>       POSITION_ARG    </Arg>
            <Arg>       MAILBOX     </Arg>
        </reqAddMarkMember>
        <reqDelMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
        </reqDelMarkMember>
        <reqChangeOnlyCaptain>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
        </reqChangeOnlyCaptain>
        <onMarkMonsterDead>
            <Arg>       OBJECT_ID       </Arg>
        </onMarkMonsterDead>
        <reqJoinTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PY_DICT     </Arg>
        </reqJoinTeam>

        <teamDungeonFinished>
            <Arg>           TEAMID          </Arg>
        </teamDungeonFinished>

        <setInDungeon>
            <Arg>       TEAMID          </Arg>
            <Arg>       BOOL             </Arg>
        </setInDungeon>

        <refreshLastDungeonFinishedTime>
            <Arg>       TEAMID          </Arg>
            <Arg>       LONGTIME        </Arg>  
        </refreshLastDungeonFinishedTime>

        <modifyPlayerName>
            <Arg>   MAILBOX     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   UNICODE     </Arg>
        </modifyPlayerName>

        <broadcastToAllMembers>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PY_LIST     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   METHOD_NAME </Arg>
            <Arg>   METHOD_ARGS </Arg>
        </broadcastToAllMembers>

        <onTeamDungeonCompletedCB>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PYTHON      </Arg>
        </onTeamDungeonCompletedCB>
    </BaseMethods>
</root>
