<root>
    <Interfaces>
        <Interface>iBaseNoCell</Interface>
        <Interface>iGlobal</Interface>
        <Interface>iTimerBase</Interface>
    </Interfaces>

    <Properties>
        <raidDict>
            <Type>  PY_DICT     </Type>
            <Flags>     BASE    </Flags>
            <Default>   {}  </Default>
        </raidDict>

        <raidTeamMembersJoinRecordsDic>
            <Type>  PY_DICT     </Type>
            <Flags> BASE    </Flags>
            <Default>   {}  </Default>
        </raidTeamMembersJoinRecordsDic>

        <raidTeamMembersInviteRecordsDic>
            <Type>  PY_DICT     </Type>
            <Flags> BASE        </Flags>
            <Default>   {}      </Default>
        </raidTeamMembersInviteRecordsDic>

        <raidStandbyCheckerDict>
            <Type>  PY_DICT     </Type>
            <Flags> BASE        </Flags>
            <Default>   {}      </Default>
        </raidStandbyCheckerDict>
    </Properties>

    <BaseMethods>
        <refreshRaidCache>
            <Arg>   RAID_ID             </Arg>
            <Arg>   AVATARGBID_LIST     </Arg>
            <Arg>   PYTHON              </Arg>
        </refreshRaidCache>

        <clearRaidJoinRecords>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_LIST         </Arg>
        </clearRaidJoinRecords>

        <getRaidApplyJoinDic>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
        </getRaidApplyJoinDic>

        <clearRaidApplyJoinDic>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
        </clearRaidApplyJoinDic>

        <updateRaidMemberCacheVal>
            <Arg>   RAID_ID         </Arg>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT         </Arg>
        </updateRaidMemberCacheVal>

        <getRaidAllMembersAttrs>
            <Arg>   MAILBOX             </Arg>
            <Arg>   PLAYER_GBID         </Arg>
            <Arg>   RAID_ID             </Arg>
            <Arg>   AVATARGBID_LIST     </Arg>
            <Arg>   PYTHON              </Arg>
        </getRaidAllMembersAttrs>

        <createRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PY_LIST     </Arg>
            <Arg>   PYTHON      </Arg>
        </createRaid>

        <createRaidLonely>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   UINT8           </Arg>
            <Arg>   PY_LIST         </Arg>
            <Arg>   PYTHON          </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UNICODE         </Arg>
            <Arg>   STRING          </Arg>
            <Arg>   BOOL            </Arg>
        </createRaidLonely>

        <disbandRaid>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PYTHON          </Arg>
        </disbandRaid>

        <applyJoinRaidLonely>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT         </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PYTHON          </Arg>
            <Arg>   STRING          </Arg>
            <Arg>   BOOL            </Arg>
            <Arg>   INT8            </Arg>
        </applyJoinRaidLonely>

        <applyJoinRaidWithTeam>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   TEAMID          </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PY_LIST         </Arg>
            <Arg>   PYTHON          </Arg>
        </applyJoinRaidWithTeam>

        <replyJoinRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   BOOL    </Arg>
            <Arg>   PYTHON  </Arg>
        </replyJoinRaid>

        <onReplyJoinRaidLonely>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   PYTHON      </Arg>
        </onReplyJoinRaidLonely>

        <onTeamReplyJoinRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   ERROR   </Arg>
            <Arg>   PYTHON  </Arg>
        </onTeamReplyJoinRaidWithTeam>

        <onReplyJoinRaidWithTeam>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   PYTHON      </Arg>
        </onReplyJoinRaidWithTeam>

        <cancelRaidJoinRequest>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8      </Arg>
            <Arg>   PYTHON      </Arg>
        </cancelRaidJoinRequest>

        <raidLeaderApplyInvitedRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidLeaderApplyInvitedRaid>

        <raidDeputyApplyInvitedRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidDeputyApplyInvitedRaid>

        <raidCaptainApplyInvitedRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidCaptainApplyInvitedRaid>

        <raidMemberApplyInvitedRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidMemberApplyInvitedRaid>

        <replyInviteRaidLonely>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </replyInviteRaidLonely>

        <replyInviteRaidWithTeam>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UUID    </Arg>
            <Arg>   TEAMID  </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PY_DICT     </Arg>
            <Arg>   BOOL    </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </replyInviteRaidWithTeam>

        <leaveRaid>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PYTHON          </Arg>
        </leaveRaid>

        <raidLeaderKickOutRaidMember>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidLeaderKickOutRaidMember>

        <raidDeputyKickOutRaidMember>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidDeputyKickOutRaidMember>

        <raidTeamCaptainKickOutRaidMember>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </raidTeamCaptainKickOutRaidMember>

        <transferRaidLeader>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON          </Arg>
            <Arg>   BOOL            </Arg>
        </transferRaidLeader>

        <transferRaidDeputy>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON          </Arg>
            <Arg>   BOOL            </Arg>
            <Arg>   BOOL            </Arg>
        </transferRaidDeputy>

        <transferRaidTeamCaptain>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </transferRaidTeamCaptain>

        <awardRaidTeamCaptain>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </awardRaidTeamCaptain>

        <moveRaidTeamMember>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON  </Arg>
        </moveRaidTeamMember>

        <setRaidTarget>
            <Arg>   MAILBOX         </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID         </Arg>
            <Arg>   TEAMTARGET      </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UNICODE         </Arg>
            <Arg>   STRING          </Arg>
            <Arg>   BOOL            </Arg>
        </setRaidTarget>

        <startRaidStandbyChecker>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </startRaidStandbyChecker>

        <replyRaidStandbyChecker>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   BOOL        </Arg>
            <Arg>   PYTHON      </Arg>
        </replyRaidStandbyChecker>

        <onAvatarClientDeath>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onAvatarClientDeath>

        <onAvatarOffline>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PLAYER_GBID     </Arg>
        </onAvatarOffline>

        <onAvatarLogin>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
        </onAvatarLogin>

        <onPlayerIsOffline>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           PLAYER_GBID     </Arg>
            <Arg>           UNICODE         </Arg>
        </onPlayerIsOffline>

        <broadRaidChatMsg>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   CHAT_CHANNEL_AVATAR_INFO    </Arg>
            <Arg>   CHAT_MSG_DATA     </Arg>
            <Arg>   PYTHON      </Arg>
        </broadRaidChatMsg>

        <switchRaidMicsMode>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   PYTHON      </Arg>
        </switchRaidMicsMode>

        <turnOnRaidMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOnRaidMics>

        <turnOffRaidMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </turnOffRaidMics>

        <blockRaidMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </blockRaidMemberMics>

        <unblockRaidMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockRaidMemberMics>

        <blockAllRaidMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </blockAllRaidMemberMics>

        <unblockAllRaidMemberMics>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PYTHON      </Arg>
        </unblockAllRaidMemberMics>

        <!--Raid Dungeon Start-->

        <clearRaidDungeonInfo>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
        </clearRaidDungeonInfo>

        <onRaidDungeonCompletedCB>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
        </onRaidDungeonCompletedCB>

        <createAndEnterRaidDungeonPreCheck>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   DUNGEON_SRC     </Arg>
            <Arg>   PYTHON      </Arg>
        </createAndEnterRaidDungeonPreCheck>

        <createAndEnterRaidDungeonPostCheck>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   MAILBOX     </Arg>  <!--spaceBox-->
            <Arg>   MAILBOX     </Arg>  <!--spaceMgrBox-->
            <Arg>   DUNGEON_SRC     </Arg>
            <Arg>   PYTHON  </Arg>
        </createAndEnterRaidDungeonPostCheck>

        <onLoadRaidDungeonSpaceReady>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   SPACE_NO    </Arg>
            <Arg>   UUID        </Arg>
            <Arg>   MAILBOX     </Arg>  <!--spaceBox-->
            <Arg>   MAILBOX     </Arg>  <!--spaceMgrBox-->
            <Arg>   PYTHON  </Arg>
        </onLoadRaidDungeonSpaceReady>

        <!--Raid Dungeon Ended-->

        <queryEliteMonsteBelongName>
            <Arg>   MAILBOX     </Arg>
            <Arg>   RAID_ID     </Arg>
        </queryEliteMonsteBelongName>

        <broadRaidMemMessage>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PY_LIST     </Arg>
        </broadRaidMemMessage>

        <broadRaidMemMessage_localCross>
            <Arg>   RAID_ID     </Arg>
            <Arg>   UINT32      </Arg>
            <Arg>   PY_LIST     </Arg>
        </broadRaidMemMessage_localCross>

        <askAllMemberFollowRaidStub>
            <Arg>       MAILBOX         </Arg>
            <Arg>       RAID_ID         </Arg>
            <Arg>       PLAYER_GBID     </Arg>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       POSITION_ARG    </Arg>
        </askAllMemberFollowRaidStub>

        <raidPrepareAutoMatch>
            <Arg>           RAID_ID       </Arg>
        </raidPrepareAutoMatch>

        <raidPrepareStopAutoMatch>
            <Arg>           RAID_ID       </Arg>
        </raidPrepareStopAutoMatch>

        <newRaidPlayerMatched>
            <Arg>           RAID_ID      </Arg>
            <Arg>           PY_DICT      </Arg>
        </newRaidPlayerMatched>

        <getRaidList>
            <Arg>           ENTITYCALL   </Arg>
            <Arg>           UINT8        </Arg>
            <Arg>           LONGTIME     </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
            <Arg>           UINT32       </Arg>
        </getRaidList>

        <enterRaidChiefDungeon>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   DUNGEON_NO  </Arg>
            <Arg>   PYTHON      </Arg>
        </enterRaidChiefDungeon>

        <addTeamMarkDataFromTeam>
            <Arg>       RAID_ID      </Arg>
            <Arg>       CLIENT_TEAM_MARK_INFO        </Arg>
        </addTeamMarkDataFromTeam>
        <reqAddRaidMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UNICODE     </Arg>
            <Arg>       PLAYER_GBID     </Arg>
            <Arg>       ENTITY_ID           </Arg>
            <Arg>       POSITION_ARG    </Arg>
            <Arg>       MAILBOX     </Arg>
        </reqAddRaidMarkMember>
        <reqDelRaidMarkMember>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
            <Arg>       UINT8       </Arg>
        </reqDelRaidMarkMember>
        <reqChangeRaidOnlyLeader>
            <Arg>       TEAMID      </Arg>
            <Arg>       MAILBOX        </Arg>
            <Arg>       UINT8       </Arg>
        </reqChangeRaidOnlyLeader>
        <onMarkMonsterDead>
            <Arg>       OBJECT_ID       </Arg>
        </onMarkMonsterDead>

        <reqJoinRaid>
            <Arg>   MAILBOX     </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   STRING      </Arg>
            <Arg>   PY_DICT     </Arg>
        </reqJoinRaid>
        
        <setInDungeon>
            <Arg>       RAID_ID          </Arg>
            <Arg>       BOOL             </Arg>
        </setInDungeon>

        <refreshLastDungeonFinishedTime>
            <Arg>       TEAMID          </Arg>
            <Arg>       LONGTIME        </Arg>  
        </refreshLastDungeonFinishedTime>

        <modifyPlayerName>
            <Arg>   MAILBOX     </Arg>
            <Arg>   TEAMID      </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   UNICODE     </Arg>
            <Arg>   UNICODE     </Arg>
        </modifyPlayerName>

        <broadcastToAllMembers>
            <Arg>   MAILBOX     </Arg>
            <Arg>   PLAYER_GBID </Arg>
            <Arg>   RAID_ID     </Arg>
            <Arg>   PY_LIST     </Arg>
            <Arg>   UINT8       </Arg>
            <Arg>   METHOD_NAME </Arg>
            <Arg>   METHOD_ARGS </Arg>
        </broadcastToAllMembers>
    </BaseMethods>
</root>
