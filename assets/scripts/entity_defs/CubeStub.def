<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
        <Interface> iMultiStaticSpace           </Interface>
        <Interface> iMultiStaticSpacePlayer     </Interface>
    </Interfaces>

    <Properties>
        <randomRooms>
            <Type>      PY_LIST         </Type>
            <Flags>     BASE            </Flags>
        </randomRooms>

        <randomWeights>
            <Type>      PY_LIST         </Type>
            <Flags>     BASE            </Flags>
        </randomWeights>

        <cubeNo>
            <Type>      CUBE_NO         </Type>
            <Flags>     BASE            </Flags>
        </cubeNo>

        <maxReadyLineNo>
            <Type>      LINE_NO         </Type>
            <Flags>     BASE            </Flags>
        </maxReadyLineNo>

        <cubeRooms>
            <Type>      PY_DICT         </Type>
            <Flags>     BASE            </Flags>
        </cubeRooms>

        <randomTeleporterPool>
            <Type>      PY_LIST         </Type>
            <Flags>     BASE            </Flags>
        </randomTeleporterPool>

        <curChapManMapId>
            <Type>      MAP_ID          </Type>
            <Flags>     BASE            </Flags>
            <Default>   0               </Default>
        </curChapManMapId>
    </Properties>

    <BaseMethods>
        <doEnterCube>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       MAP_ID              </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       PYTHON              </Arg>
        </doEnterCube>

        <doEnterCubeReady>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       PYTHON              </Arg>
        </doEnterCubeReady>

        <onEnterCubeSuccess>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       SPACE_NO            </Arg>
        </onEnterCubeSuccess>

        <onLeaveCube>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       SPACE_NO            </Arg>
            <Arg>       SPACE_NO            </Arg>
        </onLeaveCube>

        <logonEnterCube>
            <Arg>       ENTITYCALL          </Arg>
            <Arg>       PLAYER_GBID         </Arg>
            <Arg>       PYTHON              </Arg>
        </logonEnterCube>

        <onAvatarOffline>
            <Arg>       PLAYER_GBID         </Arg>
        </onAvatarOffline>

        <gmEnterTargetRoom>
             <Arg>       ENTITYCALL          </Arg>
             <Arg>       PLAYER_GBID         </Arg>
             <Arg>       SPACE_NO            </Arg>
        </gmEnterTargetRoom>

        <enterRandomRoom>
             <Arg>       ENTITYCALL             </Arg>
             <Arg>       PLAYER_GBID            </Arg>
             <Arg>       PYTHON                 </Arg>
             <Arg>       SPACE_NO               </Arg>
             <Arg>       ARRAY  <of>    UINT8   </of>   </Arg>
        </enterRandomRoom>

        <doGetCubeReadyLineCnt>
             <Arg>       ENTITYCALL             </Arg>
             <Arg>       MAP_ID                 </Arg>
        </doGetCubeReadyLineCnt>

        <checkSwitchCubeLine>
             <Arg>       ENTITYCALL             </Arg>
             <Arg>       LINE_NO                </Arg>
             <Arg>       MAP_ID                 </Arg>
        </checkSwitchCubeLine>

        <doSwitchCubeLine>
             <Arg>       ENTITYCALL             </Arg>
             <Arg>       PLAYER_GBID            </Arg>
             <Arg>       LINE_NO                </Arg>
             <Arg>       PYTHON                 </Arg>
             <Arg>       MAP_ID                 </Arg>
        </doSwitchCubeLine>

        <onFightingPlayersCntSync>
            <Arg>       SPACE_NO       </Arg>
            <Arg>       INT32          </Arg>
        </onFightingPlayersCntSync>
    </BaseMethods>
</root>
