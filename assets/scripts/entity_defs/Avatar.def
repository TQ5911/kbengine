        <idipIncomeDict>
            <Type>          PY_DICT     </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </idipIncomeDict>

        <streamDic>
            <Type>          PY_DICT             </Type>
            <Flags>         BASE                </Flags>
        </streamDic>

        <baseSpaceNo>
            <Type>          SPACE_NO             </Type>
            <Flags>         BASE                 </Flags>
        </baseSpaceNo>

        <!--
        <BASE_PROPS>
            <Type>      ARRAY   <of>    BASE_PROPS_VAL     </of>  <size> 1</size>       </Type>
            <Flags>         BASE                </Flags>
            <Persistent>    true                </Persistent>
        </BASE_PROPS>

        <BASE_CLIENT_PROPS>
            <Type>      ARRAY   <of>    CLI_BASE_PROPS_VAL     </of>  <size> 1</size>       </Type>
            <Flags>         BASE_AND_CLIENT                </Flags>
            <Persistent>    true                </Persistent>
        </BASE_CLIENT_PROPS>

        <CELL_PROPS>
            <Type>      ARRAY   <of>    CELL_PROPS_VAL     </of>  <size> 1</size>       </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Persistent>    true                </Persistent>
        </CELL_PROPS>

        <CELL_CLIENT_PROPS>
            <Type>      ARRAY   <of>    CLI_CELL_PROPS_VAL     </of>  <size> 1</size>       </Type>
            <Flags>         OWN_CLIENT          </Flags>
            <Persistent>    true                </Persistent>
