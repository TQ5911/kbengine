<root>
    <Volatile>
        <position/>
        <!--<position> 0 </position> Don't update-->
        <yaw/>
        <!--<pitch> 20 </pitch>-->
        <optimized> false </optimized>
    </Volatile>

    <Interfaces>
        <Interface>         iTimerBase                  </Interface>
        <Interface>         iTimerCell                  </Interface>
        <Interface>         iEventMgr                   </Interface>
        <Interface>         iMonsterGrp                 </Interface>
        <Interface>         iAvatarCombat               </Interface>
        <Interface>         iFubenSpace                 </Interface>
        <Interface>         iMail                       </Interface>
        <Interface>         iBag                        </Interface>
        <Interface>         iEquipment                  </Interface>
        <Interface>         iAvatarVariable             </Interface>
        <Interface>         iCycleEvent                 </Interface>
        <Interface>         iAvatarTeam                 </Interface>
        <Interface>         iAvatarTeamDungeon          </Interface>
        <Interface>         iAvatarSingleDungeon        </Interface>
        <Interface>         iTask                       </Interface>
        <Interface>         iAutoCombat                 </Interface>
        <Interface>         iAvatarScore                </Interface>
        <Interface>         iAvatarPet                  </Interface>
        <Interface>         iFriendship                 </Interface>
        <Interface>         iClient                     </Interface>
        <Interface>         iChat                       </Interface>
        <Interface>         iAvatarLine                 </Interface>
        <Interface>         iFlowControllerBase         </Interface>
        <Interface>         iAvatarPK                   </Interface>
        <Interface>         iAvatarRaid                 </Interface>
        <Interface>         iAvatarRaidDungeon          </Interface>
        <Interface>         iAvatarComplexTeleport      </Interface>
        <Interface>         iMount                      </Interface>
        <Interface>         iOutfit                     </Interface>
        <Interface>         iAvatarCrusade              </Interface>
        <Interface>         iRelive                     </Interface>
        <Interface>         iCube                       </Interface>
        <Interface>         iStore                      </Interface>
        <Interface>         iGuild                      </Interface>
        <Interface>         iPay                        </Interface>
        <Interface>         iCrossServer                </Interface>
        <Interface>         iHolidayPay                 </Interface>
        <Interface>         iDrawCard                   </Interface>
        <Interface>         iCollectible                </Interface>
        <Interface>         iGuildTrain                 </Interface>
        <Interface>         iWarehouse                  </Interface>
        <Interface>         iLeaderBoard                </Interface>
        <Interface>         iAvatarCoinAuction          </Interface>
        <Interface>         iAchievement                </Interface>
        <Interface>         iEnemy                      </Interface>
        <Interface>         iWonderLand                 </Interface>
        <Interface>         iActivity                   </Interface>
        <Interface>         iSiegeWar                   </Interface>
        <Interface>         iDuel                       </Interface>
        <Interface>         iWelfareSignIn              </Interface>
        <Interface>         iAvatarChief                </Interface>
        <Interface>         iNewbie                     </Interface>
        <Interface>         iWorkshop                   </Interface>
        <Interface>         iRedBag                     </Interface>
        <Interface>         iDateData                   </Interface>
        <Interface>         iMeridian                   </Interface>
        <Interface>         iMonthCard                  </Interface>
    </Interfaces>

    <Properties>
        <name>
            <Type>     UNICODE                      </Type>
            <Flags>    ALL_CLIENTS                  </Flags>
            <DatabaseLength>  20   </DatabaseLength>
            <Index>    INDEX                        </Index>
            <Persistent>    true                    </Persistent>
            <WitnessName>   true                    </WitnessName>
        </name>

        <accountName>
            <Type>     UNICODE                      </Type>
            <Flags>    BASE_AND_CLIENT              </Flags>
            <Index>            INDEX                </Index>
            <Persistent>    true                    </Persistent>
            <DatabaseLength>  50                    </DatabaseLength>
        </accountName>

        <accountType>
            <Type>          UINT8       </Type>
            <Flags>         BASE        </Flags>
            <Persistent>    true        </Persistent>
        </accountType>

        <accountDBID>
            <Type>          DBID        </Type>
            <Flags>         BASE        </Flags>
            <Persistent>    true        </Persistent>
        </accountDBID>

        <mainAccountCache>
            <Type>          ACCOUNT_CACHE_DATA_INFO     </Type>
            <Flags>         BASE                        </Flags>
        </mainAccountCache>

        <subAccountCache>
            <Type>          ACCOUNT_CACHE_DATA_INFO     </Type>
            <Flags>         BASE                        </Flags>
        </subAccountCache>

        <roleAccount>
            <Type>     STRING                      </Type>
            <Flags>    CELL_PRIVATE                  </Flags>
            <Persistent>    False                    </Persistent>
        </roleAccount>

        <dbId>
            <Type>    DBID                            </Type>
            <Flags>    CELL_PRIVATE                        </Flags>
        </dbId>

        <gbId>
            <Type>    PLAYER_GBID                        </Type>
            <Flags>    ALL_CLIENTS                            </Flags>
            <WitnessName>     true                       </WitnessName>
        </gbId>

        <gbID>
            <Type>    PLAYER_GBID                        </Type>
            <Flags>    BASE                            </Flags>
            <Index>    UNIQUE                            </Index>
            <Persistent>    true                    </Persistent>
        </gbID>

        <school>
            <Type>          SCHOOL                 </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Default>    1                    </Default>
            <Persistent>    true                </Persistent>
            <WitnessName>   true                </WitnessName>
        </school>

        <sex>
            <Type>          SEX                 </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Default>    1                    </Default>
            <Persistent>    true                </Persistent>
            <WitnessName>   true                </WitnessName>
        </sex>

        <birthInDB>
            <Type>    LONGTIME                            </Type>
            <Flags>    BASE                        </Flags>
            <Persistent>    true                    </Persistent>
        </birthInDB>

        <areaId>
            <Type>     UINT32                      </Type>
            <Flags>    CELL_PRIVATE                  </Flags>
            <Persistent>    true                    </Persistent>
        </areaId>

        <novice>
            <Type>    BOOL                            </Type>
            <Flags>    CELL_PRIVATE                        </Flags>
            <Default>    1                    </Default>
            <Persistent>    true                    </Persistent>
        </novice>

        <gmMode>
            <Type>         UINT8                    </Type>
            <Flags>        BASE_AND_CLIENT          </Flags>
            <Persistent>   true                     </Persistent>
        </gmMode>

        <gmModeCell>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </gmModeCell>

        <gmModeBase>
            <Type>          UINT8                   </Type>
            <Flags>         BASE                    </Flags>
        </gmModeBase>

        <gmGroup>
            <Type>          UINT8                   </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </gmGroup>

        <gmGroupCell>
            <Type>          UINT8                   </Type>
            <Flags>         CELL_PRIVATE            </Flags>
        </gmGroupCell>

        <kickState>
            <Type>     UINT8        </Type>
            <Flags>    BASE        </Flags>
            <Default>    0         </Default>
        </kickState>

        <relogCnt>
            <Type>     UINT32        </Type>
            <Flags>    BASE         </Flags>
        </relogCnt>

        <destroyTimer>
            <Type>     TIMER_ID    </Type>
            <Flags>    BASE        </Flags>
        </destroyTimer>

        <isDestroying>
            <Type>          BOOL        </Type>
            <Flags>         BASE        </Flags>
        </isDestroying>

        <isDestroyingCell>
            <Type>          BOOL        </Type>
            <Flags>         BASE        </Flags>
        </isDestroyingCell>

        <teleportLock>
            <Type>          UINT8           </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </teleportLock>

        <teleportLockRlsT>
            <Type>          LONGTIME        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </teleportLockRlsT>

        <teleportGlobalLockRlsT>
            <Type>          LONGTIME        </Type>
            <Flags>         CELL_PRIVATE    </Flags>
        </teleportGlobalLockRlsT>

        <isBotBase>
            <Type>          BOOL                 </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </isBotBase>

        <isBotCell>
            <Type>          BOOL                 </Type>
            <Flags>         CELL_PRIVATE          </Flags>
        </isBotCell>

        <tLastOfflineBase>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
            <Index>         INDEX                </Index>
        </tLastOfflineBase>

        <tLogin>
            <Type>          LONGTIME             </Type>
            <Flags>         CELL_PRIVATE         </Flags>
        </tLogin>

        <tLoginBase>
            <Type>          LONGTIME             </Type>
            <Flags>         BASE                 </Flags>
            <Default>       0                    </Default>
            <Persistent>    true                 </Persistent>
        </tLoginBase>

        <cellDataCache>
            <Type>          PYTHON               </Type>
            <Flags>         BASE                 </Flags>
            <Default>       {}                   </Default>
        </cellDataCache>

        <lastSpaceNo>
            <Type>          SPACE_NO             </Type>
            <Flags>         CELL_PRIVATE         </Flags>
        </lastSpaceNo>

        <appearance>
            <Type>          APPEARANCE_INFO     </Type>
            <Flags>         ALL_CLIENTS         </Flags>
            <Persistent>    true                </Persistent>
        </appearance>

        <tempMiscPropsBase>
            <Type>     PY_DICT                  </Type>
            <Flags>    BASE                  </Flags>
            <Default>   {}                    </Default>
        </tempMiscPropsBase>

        <miscPropsBase>
            <Type>     PY_DICT                  </Type>
            <Flags>    BASE                  </Flags>
            <Default>   {}                    </Default>
            <DatabaseLength>  512000   </DatabaseLength>
            <Persistent>    true                    </Persistent>
        </miscPropsBase>

        <avatarFlag>
            <Type>          UINT8                   </Type>
            <Flags>         BASE                    </Flags>
            <Default>       0                       </Default>
            <Persistent>    true                    </Persistent>
        </avatarFlag>

