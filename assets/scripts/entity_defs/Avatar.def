            <Flags>     BASE            </Flags>
            <Default>   0               </Default>
        </offlineReason>

        <idipBanDict>
            <Type>          PY_DICT     </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
            <Persistent>    true        </Persistent>
        </idipBanDict>

        <idipBanDataDict>
            <Type>          PY_DICT     </Type>
            <Flags>         BASE        </Flags>
            <Default>       {}          </Default>
