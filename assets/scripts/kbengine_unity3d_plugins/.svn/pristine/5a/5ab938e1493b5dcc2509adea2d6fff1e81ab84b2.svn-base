	public class DATATYPE_CLIENT_MAIL_VAL : DATATYPE_BASE
	{
		private DATATYPE_MAIL_ATTACH attach_DataType = new DATATYPE_MAIL_ATTACH();
		private DATATYPE__CLIENT_MAIL_VAL_despArgs_ArrayType_ChildArray despArgs_DataType = new DATATYPE__CLIENT_MAIL_VAL_despArgs_ArrayType_ChildArray();

		public class DATATYPE__CLIENT_MAIL_VAL_despArgs_ArrayType_ChildArray : DATATYPE_BASE
		{
			public List<string> createFromStreamEx(MemoryStream stream)
			{
				UInt32 size = stream.readUint32();
				List<string> datas = new List<string>();

				while(size > 0)
				{
					--size;
					datas.Add(stream.readUnicode());
				};

				return datas;
			}

			public void addToStreamEx(Bundle stream, List<string> v)
			{
				stream.writeUint32((UInt32)v.Count);
				for(int i=0; i<v.Count; ++i)
				{
					stream.writeUnicode(v[i]);
				};
			}
		}

		public CLIENT_MAIL_VAL createFromStreamEx(MemoryStream stream)
		{
			CLIENT_MAIL_VAL datas = new CLIENT_MAIL_VAL();
			datas.mailGBID = stream.readUint64();
			datas.mailId = stream.readUint32();
			datas.toGBID = stream.readUint64();
			datas.fromGBID = stream.readUint64();
			datas.globalMailGBID = stream.readUint64();
			datas.attach = attach_DataType.createFromStreamEx(stream);
			datas.readStat = stream.readUint8();
			datas.attachStat = stream.readUint8();
			datas.createTime = stream.readUint32();
			datas.expiredTime = stream.readUint32();
			datas.despArgs = despArgs_DataType.createFromStreamEx(stream);
			datas.title = stream.readUnicode();
			datas.cont = stream.readUnicode();
			return datas;
		}

		public void addToStreamEx(Bundle stream, CLIENT_MAIL_VAL v)
		{
			stream.writeUint64(v.mailGBID);
			stream.writeUint32(v.mailId);
			stream.writeUint64(v.toGBID);
			stream.writeUint64(v.fromGBID);
			stream.writeUint64(v.globalMailGBID);
			attach_DataType.addToStreamEx(stream, v.attach);
			stream.writeUint8(v.readStat);
			stream.writeUint8(v.attachStat);
			stream.writeUint32(v.createTime);
			stream.writeUint32(v.expiredTime);
			despArgs_DataType.addToStreamEx(stream, v.despArgs);
			stream.writeUnicode(v.title);
			stream.writeUnicode(v.cont);
		}
	}



