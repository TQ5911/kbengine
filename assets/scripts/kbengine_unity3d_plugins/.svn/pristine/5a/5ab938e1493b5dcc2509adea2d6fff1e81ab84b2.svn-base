	public class DATATYPE_GUILD_CLIENT_DATA : DATATYPE_BASE
	{
		private DATATYPE_GUILD_JOIN_COND_DATA_INFO joinCond_DataType = new DATATYPE_GUILD_JOIN_COND_DATA_INFO();
		private DATATYPE_GUILD_BUILDING_DATA_INFO building_DataType = new DATATYPE_GUILD_BUILDING_DATA_INFO();
		private DATATYPE_JUN_XU_ARCHITECTURE_DATA_INFO junXuArchitecture_DataType = new DATATYPE_JUN_XU_ARCHITECTURE_DATA_INFO();
		public GUILD_CLIENT_DATA createFromStreamEx(MemoryStream stream)
		{
			GUILD_CLIENT_DATA datas = new GUILD_CLIENT_DATA();
			datas.name = stream.readUnicode();
			datas.desc = stream.readUnicode();
			datas.guildUUID = stream.readUint64();
			datas.dspFlag = stream.readUint8();
			datas.guildLevel = stream.readUint32();
			datas.guildExp = stream.readUint64();
			datas.guildMoney = stream.readUint32();
			datas.joinCond = joinCond_DataType.createFromStreamEx(stream);
			datas.guildFund = stream.readUint32();
			datas.icon = stream.readUint8();
			datas.building = building_DataType.createFromStreamEx(stream);
			datas.yuXi = stream.readUint8();
			datas.siegeWarSignUped = stream.readUint8();
			datas.junXuArchitecture = junXuArchitecture_DataType.createFromStreamEx(stream);
			datas.cityBattleToken = stream.readUint32();
			return datas;
		}

		public void addToStreamEx(Bundle stream, GUILD_CLIENT_DATA v)
		{
			stream.writeUnicode(v.name);
			stream.writeUnicode(v.desc);
			stream.writeUint64(v.guildUUID);
			stream.writeUint8(v.dspFlag);
			stream.writeUint32(v.guildLevel);
			stream.writeUint64(v.guildExp);
			stream.writeUint32(v.guildMoney);
			joinCond_DataType.addToStreamEx(stream, v.joinCond);
			stream.writeUint32(v.guildFund);
			stream.writeUint8(v.icon);
			building_DataType.addToStreamEx(stream, v.building);
			stream.writeUint8(v.yuXi);
			stream.writeUint8(v.siegeWarSignUped);
			junXuArchitecture_DataType.addToStreamEx(stream, v.junXuArchitecture);
			stream.writeUint32(v.cityBattleToken);
		}
	}



