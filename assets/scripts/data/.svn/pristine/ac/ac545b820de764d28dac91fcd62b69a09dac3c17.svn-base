    # 是否结算护盾，0不结算，1结算，默认结算

    arg1 = target.getProp("fullHp") * arg1

    result = attackByValueShare(self, target, context, arg1, arg2, arg3, arg4)

    return result

def attackByValueShare(self, target, context, *args):
    arg1 = args[0] if len(args) >= 1 else 0
    # 伤害数值
    arg2 = args[4] if len(args) >= 5 else 0
    # 属性类型，0无属性，1水，2雷，3火，4混沌
    arg3 = args[5] if len(args) >= 6 else 1
    # 攻击类型，1物理攻击，2法术攻击
    arg4 = args[1] if len(args) >= 2 else 1
    # 是否结算护盾，0不结算，1结算，默认结算

    if not target:
        return combatSkill.DamageResult()

    if target.IsMonster:
        if not hasattr(context, "ignoreMaxDamage"):
            maxDamage = creep_base.datas.get(target.monsterId, {}).get("MaxDamage", -1)
            if maxDamage > 0:
                arg1 = min(arg1, maxDamage)
    result = combatSkill.DamageResult()
    result.dmg = arg1
    result.hurtDmg = arg1
    result.hpSuck = 0
    result.dmgType = 0
    result.atkType = 0
    result.calcShield = arg4

    return result

