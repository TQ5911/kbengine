def moralEffect(self, target):
    # 红名状态对伤害的影响（红名玩家伤害降低，攻击方造成易伤）
    import PKData_moralValueEffect as PKMVE

    if not target:
        return 1.0

    attacker_moral = None
    if self.IsAvatar:
        attacker_moral = self.moralLevel
    elif self.IsSummon or self.IsCreation:
        hostRole = KBEngine.entities.get(self.hostId, None)
        if hostRole and hostRole.IsAvatar:
            attacker_moral = hostRole.moralLevel

    target_moral = None
    if target.IsAvatar:
        target_moral = target.moralLevel
    elif target.IsSummon or target.IsCreation:
        hostRole = KBEngine.entities.get(target.hostId, None)
        if hostRole and hostRole.IsAvatar:
            target_moral = hostRole.moralLevel

    if attacker_moral is not None and target_moral is not None:
        AtkEffect = PKMVE.datas[attacker_moral]['PVPDmgReduced']
        DefEffect = PKMVE.datas[target_moral]['DmgFromOtherPVPIncreased']
        # print('AtkEffect------------',AtkEffect,'DefEffect------------',DefEffect)
        return (1-AtkEffect) * (1 + DefEffect)

    return 1.0

def regenByNum(self, target, context, *args):
    # 按数值治疗，不会结算暴击、攻击力、治疗加成等计算参数

    arg1 = args[0] if len(args) >= 1 else 0
    # 治疗绝对值
    arg2 = args[1] if len(args) >= 2 else 0
    # 是否溢出，0溢出，1不溢出，默认溢出
    arg3 = args[2] if len(args) >= 3 else 1
    # 是否参与治疗衰减，1参与，0不参与，默认参与

    result = regenByValueShare(self, target, context, arg1, arg2, arg3)

    return result

def regenByValueShare(self, target, context, *args):
    arg1 = args[0] if len(args) >= 1 else 0
    # 治疗数值
    arg2 = args[1] if len(args) >= 2 else 0
    # 是否溢出，0溢出，1不溢出，默认溢出
    arg3 = args[2] if len(args) >= 3 else 1
    # 是否参与治疗衰减，1参与，0不参与，默认参与

    if not target:
        return combatSkill.RegenResult()

    regenNum = min(arg1, target.getProp("fullMp") - target.getProp("mp"))
    if arg2 == 1:
        arg1 = regenNum

    result = combatSkill.RegenResult()
    result.regenVal = arg1
    result.isCrit = False
    result.doSkillRegenCorrection = arg3

    return result

