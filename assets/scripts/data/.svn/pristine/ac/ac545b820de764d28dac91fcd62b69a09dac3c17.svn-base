def attackShare(self, target, context, *args):
    arg1 = args[0] if len(args) >= 1 else 1.0
    # 攻击力比例伤害
    arg2 = args[1] if len(args) >= 2 else 0.0
    # 附带额外伤害
    arg3 = args[2] if len(args) >= 3 else 0.0
    # 吸血比例
    arg4 = args[3] if len(args) >= 4 else 0
    # 0计算暴击概率，1必然不暴击，2必然暴击
    arg5 = args[4] if len(args) >= 5 else 0
    # 属性类型，0无属性，1水，2雷，3火，4混沌
    arg6 = args[5] if len(args) >= 6 else None
    # 攻击类型，1物理攻击，2法术攻击
    arg7 = args[6] if len(args) >= 7 else 1
    # 是否结算护盾，0不结算，1结算，默认结算
    arg8 = args[7] if len(args) >= 8 else 0
    # 忽视防御的百分比，不填默认为0，即不忽视
    arg9 = args[8] 
    # 命中传入进来
    if not target:
        return combatSkill.DamageResult()

    skill = self._getSkillByActionContext(context)
    buff = self._getBuffByActionContext(context)

    realHurt = 0
    dodgeDmgRatio = 1.0
    fatalDmgRatio = 1.0
    bIsHit = True
    bCrit = False

    # 命中判定
    bIsHit = arg9

    # 闪避倍率计算（命中100%，未命中0%）
    if bIsHit:
        dodgeDmgRatio = 1.0

        # 暴击判定
        bCrit = isCrit(self, target, arg4)

        # 暴击伤害倍率计算
        if bCrit:
            fatalDmgRatio = fatalDmg(self, target)
        else:
            fatalDmgRatio = 1.0
    else:
        dodgeDmgRatio = 0
        
    if arg6 is not None:
        classTag = arg6
    else:
        if skill:
            classTag = skill.getClassTag(self)
        elif buff:
            classTag = buff.getClassTag(self)
        elif self.IsCreation:
            import creation_creation
            classTag = creation_creation.datas.get(context.creationId, {}).get('classTag', 0)
        else:
            classTag = 1

    # 随机大小攻
    realAtk = randomAtk(self, classTag)

    dmgAvoidance = armorAvoidance(self, target, classTag, arg8)

    # 对象伤害倍率计算
    realDmgRatioEx = realDmgRatio(self, target)

    # 善恶值对伤害影响
    moralEffectRatio = moralEffect(self, target)

    # 实际伤害计算
    realHurt =max((((realAtk - dmgAvoidance) * arg1 + arg2) * fatalDmgRatio * realDmgRatioEx + self.getProp("realDmg") - target.getProp("realDmgDef") + realAtk * self.getProp("extraDmg") - dmgAvoidance * target.getProp("extraDmgDef"))* moralEffectRatio,0.1 * realAtk + 1) * dodgeDmgRatio
    if target.IsMonster:
        if not hasattr(context, "ignoreMaxDamage"):
            maxDamage = creep_base.datas.get(target.monsterId, {}).get("MaxDamage", -1)
            if maxDamage > 0:
                realHurt = min(realHurt, maxDamage)
# 承伤统计
    hurtDmg = realHurt

    realHurt = realHurt

    # 吸血计算
    bloodSuck = realHurt * arg3

    result = combatSkill.DamageResult()
    result.dmg = realHurt
    result.hurtDmg = hurtDmg
    result.hpSuck = bloodSuck
    result.dmgType = arg5
    result.calcShield = arg7
    if bCrit:
        result.atkType = 2
    elif bIsHit:
        result.atkType = 0
    else:
        result.atkType = 1
        result.calcShield = 0

    return result

def attackByNum(self, target, context, *args):
    # 按数值扣血，不会结算防御、暴击等免伤和伤害相关参数

    arg1 = args[0] if len(args) >= 1 else 0
    # 伤害绝对值
    arg2 = args[4] if len(args) >= 5 else 0
    # 属性类型，0无属性，1水，2雷，3火，4混沌
    arg3 = args[5] if len(args) >= 6 else 1
    # 攻击类型，1物理攻击，2法术攻击
    arg4 = args[1] if len(args) >= 2 else 1
    # 是否结算护盾，0不结算，1结算，默认结算

    result = attackByValueShare(self, target, context, arg1, arg2, arg3, arg4)

    return result

def attackByPct(self, target, context, *args):
    # 按百分比扣血，不会结算防御、暴击等免伤和伤害相关参数

    arg1 = args[0] if len(args) >= 1 else 0.0
    # 最大生命值的百分比
