    # 是否溢出，0溢出，1不溢出，默认溢出
    arg4 = args[3] if len(args) >= 4 else 1
    # 是否参与治疗衰减，1参与，0不参与，默认参与

    # result = healShare(self, target, context, arg1, arg2, 0, arg3, arg4)
    # 暂定所有治疗都不需要暴击
    result = healShare(self, target, context, arg1, arg2, 1, arg3, arg4)

    return result

def noFatalHeal(self, target, context, *args):
    # 必然不暴击

    arg1 = args[0] if len(args) >= 1 else 0.0
    # 攻击力比例治疗量
    arg2 = args[1] if len(args) >= 2 else 0.0
