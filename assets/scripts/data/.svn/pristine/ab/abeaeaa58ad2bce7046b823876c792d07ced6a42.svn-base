def _13080061(self, target, context):
    buffLv = self.getBuffLv(64004953)
    is_in_lightning_area = self.isLightningArea()
    #第一次不做
    if context.args.tickCount and context.args.tickCount == 1:
        return
    if is_in_lightning_area:
        if buffLv < 10:
            # 如果在闪电区域且buff层数小于10，直接提升buff层数
            self.overleapBuff(self, context, 64004953, 10, -1)
            self.overleapBuff(self, context, 64004953, 10, -1)
        elif buffLv == 10:
            # 如果buff层数等于10，添加新的buff
            if not self.hasBuff(64004952):
                self.addBuff(64004952, 1,self.id)
    elif buffLv > 0:
        if buffLv > 1:
            # 如果不在闪电区域且buff层数大于1，减少buff层数
            self.changeBuffLevel(64004953, -1, self.id)
        else:
            # 如果不在闪电区域且buff层数等于1，移除buff
            self.removeBuff(64004953)

# 64004952定时器
