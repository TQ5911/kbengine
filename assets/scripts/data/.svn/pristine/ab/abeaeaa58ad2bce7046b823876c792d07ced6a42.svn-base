def _13080038(self, target, context):
    buffLv = context.args.ActionParam[0]
    if buffLv > 1:
        attribute = self.getConfigData()['attribute']
        for e in self.entitiesInRange(30, 'Avatar'):
            self.noFatalAttack(e, context, 1 * buffLv, 0, attribute)

def _13080039(self, target, context):
    #第一个参数目标有某buff，第二个参数，给目标上某BUFF，第3个参数范围,
    buffSrc = context.getSrcEntity()
    if not buffSrc:
        return
    for e in self.entitiesInRange(context.args.ActionParam[2], 'Avatar'):
        if e is not self:
            if context.args.ActionParam[0] == 0 and not e.hasBuff(context.args.ActionParam[1]):
                buffSrc.addBuffBySkill(e, context, context.args.ActionParam[1])
                return
            if e.hasBuff(context.args.ActionParam[0]) and not e.hasBuff(context.args.ActionParam[1]):
                buffSrc.addBuffBySkill(e, context, context.args.ActionParam[1])
                buffSrc.removeBuffBySkill(e, context, context.args.ActionParam[0])
                return

def _13080040(self, target, context):
    #第一个参数目标有某buff，第二个参数，给目标上某BUFF，第3个参数是目标身上有某buff则移除，,第4个参数范围,
    buffSrc = context.getSrcEntity()
    if not buffSrc:
        return
    for e in self.entitiesInRange(context.args.ActionParam[3], 'Avatar'):
        if e is not self:
            if e.hasBuff(context.args.ActionParam[2]):
                buffSrc.removeBuffBySkill(e, context, context.args.ActionParam[2])
            if e.hasBuff(context.args.ActionParam[0]):
                buffSrc.addBuffBySkill(e, context, context.args.ActionParam[1])
                buffSrc.removeBuffBySkill(e, context, context.args.ActionParam[0])

def _13080041(self, target, context):
    if self.hasBuff(64020034):
        self.removeBuffBySkill(self, context, 64020073)
        return
    if self.getProp("hp") < self.getProp("fullHp") * 0.3:
        self.addBuffBySkill(self, context, 64020034, 1)
        self.removeBuffBySkill(self, context, 64020073)

