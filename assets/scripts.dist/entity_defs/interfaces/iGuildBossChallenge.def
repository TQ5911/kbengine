<root>
    <Properties>
        <guildBossDungeonID>
            <Type>          UINT32           </Type>
            <Flags>         CELL_PRIVATE     </Flags>
            <Default>       0                </Default>
        </guildBossDungeonID>
    </Properties>

    <BaseMethods>
        <enterBossChallengeDungeon>
            <Arg>   UINT16   </Arg>
        </enterBossChallengeDungeon>
    </BaseMethods>

    <CellMethods>
        <openGuildDungeon> <Exposed/>
            <Arg>   INT64    </Arg>
            <Arg>   UINT8    </Arg>
            <Arg>   UINT16   </Arg>
        </openGuildDungeon>

        <cancelGuildDungeonOrder> <Exposed/>
            <Arg>   UINT16   </Arg>
        </cancelGuildDungeonOrder>

        <getChangllengeDataInfo> <Exposed/>
            <Arg>   UINT16   </Arg>
        </getChangllengeDataInfo>

        <enterBossChallengeDungeon> <Exposed/>
            <Arg>   UINT16   </Arg>
        </enterBossChallengeDungeon>

        <leaveBossChallengeDungeon> <Exposed/>
            <Arg>   UINT16   </Arg>
        </leaveBossChallengeDungeon>

        <getGuildBossHP> <Exposed/>
            <Arg>   UINT16  </Arg>
        </getGuildBossHP>
        
        <setGuildBossDungeonID>
            <Arg> UINT32 </Arg>
        </setGuildBossDungeonID>

        <clearGuildBossDungeonID>
            <Arg> UINT32 </Arg>
        </clearGuildBossDungeonID>

        <doEnterGuildBossDungeon>
            <Arg>           SPACE_NO            </Arg>
            <Arg>           UUID                </Arg>
            <Arg>           MAILBOX             </Arg>
            <Arg>           MAILBOX             </Arg>
            <Arg>           PYTHON              </Arg>
        </doEnterGuildBossDungeon>

        <doLeaveGuildBossDungeon>
            <Arg>           PYTHON              </Arg>
        </doLeaveGuildBossDungeon>
    </CellMethods>

    <ClientMethods>
        <onOpenGuildDungeon>
            <Arg>   UINT32  </Arg>
            <Arg>   UINT8   </Arg>
            <Arg>   UINT16  </Arg>
        </onOpenGuildDungeon>

        <onCancelGuildDungeonOrder>
            <Arg> UINT32 </Arg>
        </onCancelGuildDungeonOrder>

        <onGetChagllengeDataInfo>
            <Arg> CLI_GUILD_CHALLENGE_DATA_INFO </Arg>
        </onGetChagllengeDataInfo>

        <onGetGuildBossHP>
            <Arg>   UINT16  </Arg>
            <Arg>   INT32   </Arg>
            <Arg>   INT32   </Arg>
        </onGetGuildBossHP>

        <onEnterGuildDungeon>
            <Arg>   UINT32  </Arg>
            <Arg>   INT32   </Arg>
        </onEnterGuildDungeon>
    </ClientMethods>
</root>
