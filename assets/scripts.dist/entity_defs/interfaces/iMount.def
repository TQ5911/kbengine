<root>
    <Properties>
        <delayAddMountSpeedBuffTimer>
            <Type>          TIMER_ID            </Type>
            <Flags>         CELL_PRIVATE        </Flags>
            <Default>       0                   </Default>
        </delayAddMountSpeedBuffTimer>
    </Properties>

    <BaseMethods>
        <doAddMount>
            <Arg>       UINT16          </Arg>
            <Arg>       OUTFIT_ID       </Arg>
            <Arg>       DOUBLE          </Arg>
        </doAddMount>

        <setCurMount> <Exposed/>
            <Arg>       OUTFIT_ID       </Arg>
        </setCurMount>
    </BaseMethods>

    <CellMethods>
        <setCurMountCell>
            <Arg>       OUTFIT_ID       </Arg>
        </setCurMountCell>

        <enterRiding> <Exposed/>
            <Arg>       BOOL            </Arg>
        </enterRiding>

        <exitRiding> <Exposed/>
        </exitRiding>

        <setFollowRideFlag> <Exposed/>
            <Arg>       BOOL            </Arg>
        </setFollowRideFlag>

        <enterRidingByAction>
        </enterRidingByAction>
    </CellMethods>

    <ClientMethods>
        <onRideMount>
            <Arg>       BOOL            </Arg>
            <Arg>       BOOL            </Arg>
        </onRideMount>

        <onRideMountCast>
        </onRideMountCast>

        <onGetFollowRideFlag>
            <Arg>       BOOL            </Arg>
        </onGetFollowRideFlag>
    </ClientMethods>
</root>