<root>
    <Properties>
        <welfareSignInInfos>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </welfareSignInInfos>

        <welfareLevelInfos>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </welfareLevelInfos>
    </Properties>

    <BaseMethods>
        <reqWelfareSignIn> <Exposed/>
            <Arg>   UINT8            </Arg>
            <Arg>   STRING           </Arg>
        </reqWelfareSignIn>

        <reqLevelWelfare> <Exposed/>
            <Arg>   INT32            </Arg>
            <Arg>   STRING           </Arg>
        </reqLevelWelfare>
    </BaseMethods>

    <ClientMethods>
        <onGetWelfareSignInInfo>
            <Arg>   WELFARE_SIGN_IN_INFO    </Arg> 
            <Arg>   STRING                  </Arg>
        </onGetWelfareSignInInfo>

        <onGetLevelWelfareInfo> <Exposed/>
            <Arg>   UINT64           </Arg>
            <Arg>   STRING           </Arg>
        </onGetLevelWelfareInfo>
    </ClientMethods>
</root>