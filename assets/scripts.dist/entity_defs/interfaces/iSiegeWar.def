<root>
    <Properties>
        <siegeWarCamp>
            <Type>          INT32           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Default>       0               </Default>
            <WitnessName>   true            </WitnessName>
        </siegeWarCamp>
    </Properties>

    <BaseMethods>
        <onUpdateSiegeWarState>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onUpdateSiegeWarState>

        <siegeWarSignUpBidding> <Exposed/>
        </siegeWarSignUpBidding>

        <querySiegeWarSignUpState> <Exposed/>
        </querySiegeWarSignUpState>

        <subscribeSiegeWarBiddingState> <Exposed/>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </subscribeSiegeWarBiddingState>

        <siegeWarTryBidding> <Exposed/>
            <Arg>          INT32                        </Arg>
        </siegeWarTryBidding>

        <onSiegeWarDeclareWar> <Exposed/>
            <Arg>          BOOL                         </Arg>
        </onSiegeWarDeclareWar>

        <querySiegeWarDefenderAndOffensive> <Exposed/>
        </querySiegeWarDefenderAndOffensive>

        <querySiegeWarBiddingWinnerData> <Exposed/>
        </querySiegeWarBiddingWinnerData>
        
        <cityRecentActivityRequest> <Exposed/>
        </cityRecentActivityRequest>

        <onSiegeWarSpaceEnter> <Exposed/>
        </onSiegeWarSpaceEnter>

        <useCityOfficerPrivilege> <Exposed/>
            <Arg>          INT32                        </Arg>
            <Arg>          PLAYER_GBID                  </Arg>
        </useCityOfficerPrivilege>

        <changeCityMoneyToGuildMoney> <Exposed/>
            <Arg>          INT64                        </Arg>
        </changeCityMoneyToGuildMoney>

        <onCanChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          INT64                        </Arg>
        </onCanChangeCityMoneyToGuildMoneyResult>

        <onSiegeWarDeclareWarGuildResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onSiegeWarDeclareWarGuildResult>

        <onSiegeWarDeclareWarCrossServerResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarDeclareWarCrossServerResult>

        <onQuerySiegeWarSignUped>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </onQuerySiegeWarSignUped>

        <onSiegeWarSignUpBiddingResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarSignUpBiddingResult>

        <onSiegeWarBiddingFail>
            <Arg>          INT32                        </Arg>
        </onSiegeWarBiddingFail>

        <onSiegeWarBiddingDataUpdate>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarBiddingDataUpdate>

        <onQuerySiegeWarDefenderAndOffensiveResult>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResult>

        <onQuerySiegeWarDefenderAndOffensiveResultFromGuildStub>
            <Arg>           PY_LIST                      </Arg>
            <Arg>           UNICODE                      </Arg>
            <Arg>           UNICODE                      </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResultFromGuildStub>

        <onQuerySiegeWarBiddingWinnerDataResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
        </onQuerySiegeWarBiddingWinnerDataResult>

        <appointCityOfficer>
            <Arg>          INT32                        </Arg>
            <Arg>          PLAYER_GBID                  </Arg>
        </appointCityOfficer>

        <onCityDataResponse>
            <Arg>           PY_LIST              </Arg>
        </onCityDataResponse>

        <syncCitySimpleData>
            <Arg>          UNICODE                      </Arg>
            <Arg>          LONGTIME                     </Arg>
        </syncCitySimpleData>
    </BaseMethods>

    <CellMethods>
        <leaveSiegeWarSpace> <Exposed/>
        </leaveSiegeWarSpace>

        <siegewarMinimapSignalChange> <Exposed/>
            <Arg>      SIEGEWAR_MINIMAP_SIGNAL_VAL      </Arg>
        </siegewarMinimapSignalChange>

        <requestSiegeWarScoreData> <Exposed/>
            <Arg>          INT32                        </Arg>
        </requestSiegeWarScoreData>

        <enterSiegeWarSpace> <Exposed/>
        </enterSiegeWarSpace>

        <gmEnterSiegeWarSpace>
        </gmEnterSiegeWarSpace>
        
        <beginEnterSiegeWarSpace>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg> 
        </beginEnterSiegeWarSpace>

        <setSiegeWarCamp>
            <Arg>          INT32                        </Arg>
        </setSiegeWarCamp>

        <onSiegeWarMsg>
            <Arg>      UINT64        </Arg>
            <Arg>      PY_LIST       </Arg>
        </onSiegeWarMsg>

        <onPlayerLoginGetCityBuff>
            <Arg>      PY_DICT       </Arg>
        </onPlayerLoginGetCityBuff>
    </CellMethods>

    <ClientMethods>
        <onSiegeWarMinimapSignalChange>
            <Arg>        ARRAY <of> SIEGEWAR_MINIMAP_SIGNAL_VAL </of>       </Arg>
        </onSiegeWarMinimapSignalChange>

        <onSiegeWarLoginDataChanged>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarLoginDataChanged>
        
        <onQuerySiegeWarSignUped>
            <Arg>          BOOL                         </Arg>
        </onQuerySiegeWarSignUped>

        <onSiegeWarSignUpBiddingResult>
            <Arg>          BOOL                         </Arg>
        </onSiegeWarSignUpBiddingResult>

        <onSiegeWarBiddingDataUpdate>
            <Arg>        INT32                          </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
        </onSiegeWarBiddingDataUpdate>

        <onSiegeWarDeclareWarResult>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarDeclareWarResult>

        <onQuerySiegeWarDefenderAndOffensiveResult>
            <Arg>       ARRAY   <of>    SIEGEWAR_GUILD_VAL </of>    </Arg>
        </onQuerySiegeWarDefenderAndOffensiveResult>

        <onQuerySiegeWarBiddingWinnerDataResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
        </onQuerySiegeWarBiddingWinnerDataResult>

        <onSiegeWarMinimapInfoUpdate>
            <Arg>          UNICODE                      </Arg>
        </onSiegeWarMinimapInfoUpdate>

        <onSiegeWarEnterDataUpdate>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSiegeWarEnterDataUpdate>

        <onSiegeWarScoreData>
            <Arg>       INT32                                       </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_SCORE_VAL </of>    </Arg>
            <Arg>       SIEGEWAR_SCORE_VAL                          </Arg>
        </onSiegeWarScoreData>

        <onSiegeWarBattleEnd>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          SCHOOL                       </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_BATTLE_END_DATA_VAL </of>    </Arg>
            <Arg>          PLAYER_GBID                                      </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          SCHOOL                                           </Arg>
            <Arg>          SEX                                              </Arg>
        </onSiegeWarBattleEnd>

        <cityRecentActivityResponse>
            <Arg>          ENTITYCALL                                       </Arg>
            <Arg>          ARRAY <of> CITY_RECENT_ACTIVITY_VAL </of>        </Arg>
        </cityRecentActivityResponse>

        <onCityDataResponse>
            <Arg>          PLAYER_GBID                                      </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          SCHOOL                                           </Arg>
            <Arg>          SEX                                              </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          GUILD_UUID                                       </Arg>
            <Arg>          UNICODE                                          </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          INT32                                            </Arg>
            <Arg>          INT64                                            </Arg>
            <Arg>          INT64                                            </Arg>
            <Arg>          LONGTIME                                         </Arg>
            <Arg>          ARRAY <of> CITY_RECENT_ACTIVITY_VAL </of>        </Arg>
            <Arg>          ARRAY <of> CITY_OFFICER_LIST        </of>        </Arg>
            <Arg>          LONGTIME                                         </Arg>
            <Arg>          LONGTIME                                         </Arg>
        </onCityDataResponse>

        <onChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                         </Arg>
        </onChangeCityMoneyToGuildMoneyResult>

        <onQuerySiegeWarCityFundUseRecordResult>
            <Arg>          ARRAY <of> CITY_FUND_RECORD_VAL </of>        </Arg>
        </onQuerySiegeWarCityFundUseRecordResult>

        <onSiegeWarSearchTargetResult>
            <Arg>       UINT8                                   </Arg>
            <Arg>       ARRAY   <of>    SIEGEWAR_SEARCH_VAL       </of>   </Arg>
        </onSiegeWarSearchTargetResult>

        <onSyncCitySimpleData>
            <Arg>          UNICODE                      </Arg>
            <Arg>          LONGTIME                     </Arg>
        </onSyncCitySimpleData>

        <onYuxiFlagChange>
            <Arg>          BOOL                         </Arg>
        </onYuxiFlagChange>
    </ClientMethods>
</root>
