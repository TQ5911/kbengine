<root>
    <Properties>
        <staticSpaces>
            <Type>      PY_DICT         </Type>
            <Flags>     BASE            </Flags>
        </staticSpaces>

        <loadWaitSet>
            <Type>      PYTHON          </Type>
            <Flags>     BASE            </Flags>
        </loadWaitSet>
    </Properties>

    <BaseMethods>
        <onStaticSpaceReady>
            <Arg>       SPACE_NO        </Arg>
        </onStaticSpaceReady>

        <onSpaceMgrReady>
            <Arg>       SPACE_NO        </Arg>
            <Arg>       ENTITYCALL      </Arg>
        </onSpaceMgrReady>

        <onLoadGroupEntities>
            <Arg>       PY_DICT       </Arg>
        </onLoadGroupEntities>

        <onRefreshGroupEntities>
            <Arg>       PY_DICT       </Arg>
        </onRefreshGroupEntities>

        <onLoadEntitiesEnd>
            <Arg>       SPACE_NO        </Arg>
        </onLoadEntitiesEnd>

        <onSpaceCellAppDeath>
            <Arg>       SPACE_NO        </Arg>
        </onSpaceCellAppDeath>
    </BaseMethods>
</root>
