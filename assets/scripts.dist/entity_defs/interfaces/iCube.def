<root>
    <Properties>
        <leftCubeTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </leftCubeTimes>

        <cubeUseCoinTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </cubeUseCoinTimes>

        <cubeUseItemTimes>
            <Type>          UINT8                       </Type>
            <Flags>         BASE_AND_CLIENT             </Flags>
            <Persistent>    true                        </Persistent>
        </cubeUseItemTimes>

        <cubeRoomTimerId>
            <Type>          TIMER_ID                    </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
        </cubeRoomTimerId>

        <cubeRoomLeftTime>
            <Type>          LONGTIME                    </Type>
            <Flags>         CELL_PRIVATE                </Flags>
            <Default>       0                           </Default>
            <Persistent>    true                        </Persistent>
        </cubeRoomLeftTime>
    </Properties>

    <BaseMethods>
        <beforeEnterCubeDecrementCnt>
            <Arg>           BOOL                    </Arg>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           PYTHON                  </Arg>
        </beforeEnterCubeDecrementCnt>

        <reqUseItemAddCubeTimes> <Exposed/>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           BOOL                    </Arg>
        </reqUseItemAddCubeTimes>

        <useItemAddCubeTimes>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT8                   </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           UINT8                   </Arg>   
        </useItemAddCubeTimes>

        <addRoomDurationFailed>
            <Arg>           OP_UUID                 </Arg>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT16                  </Arg>
        </addRoomDurationFailed>

        <addRoomDurationFailedRewindTimes>
        </addRoomDurationFailedRewindTimes>

        <autoRenewCubeRoom>
            <Arg>           CUBE_SWITCH             </Arg>
        </autoRenewCubeRoom>

        <afterEnterCubeDeductTimes>
        </afterEnterCubeDeductTimes>

        <onLogonEnterCubeGetSpaceBox>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
        </onLogonEnterCubeGetSpaceBox>
    </BaseMethods>

    <CellMethods>
        <beginEnterCubeRoom>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           OBJECT_ID               </Arg>
            <Arg>           SPACE_NO                </Arg>
            <Arg>           PYTHON                  </Arg>       
        </beginEnterCubeRoom>

        <enterCube> <Exposed/>
            <Arg>           UINT8                   </Arg>   
        </enterCube>

        <leaveCube> <Exposed/>
        </leaveCube>

        <reqChangeCubeAutoRenewSwitch> <Exposed/>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
        </reqChangeCubeAutoRenewSwitch>

        <addCubeRoomRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </addCubeRoomRewardRecord>

        <toClientCubeLoginData>
        </toClientCubeLoginData>

        <checkAddCubeRoomDurationCondition>
            <Arg>           ITEM_ID                 </Arg>
            <Arg>           UINT8                   </Arg>
        </checkAddCubeRoomDurationCondition>

        <directlyAddCubeRoomDuration>
            <Arg>           STRING                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </directlyAddCubeRoomDuration>
    </CellMethods>

    <ClientMethods>
        <onCubeRoomEndTime>
            <Arg>           LONGTIME                </Arg>
        </onCubeRoomEndTime>
        
        <onCubeAutoRenewSwitch>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
        </onCubeAutoRenewSwitch>

        <onAddCubeRoomRewardRecord>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onAddCubeRoomRewardRecord>

        <onCubeLoginData>
            <Arg>           LONGTIME                </Arg>
            <Arg>           BOOL                    </Arg>
            <Arg>           CUBE_SWITCH             </Arg>
            <Arg>           ARRAY       <of>        BAG_ITEM_BRIEF_VAL      </of>   </Arg>
        </onCubeLoginData>
    </ClientMethods>
</root>
