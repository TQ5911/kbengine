<root>
    <Properties>
        <avatarVarDic>
            <Type>          PY_DICT               </Type>
            <Flags>         BASE                  </Flags>
            <Default>       {}                    </Default>
            <Persistent>    true                </Persistent>
        </avatarVarDic>
        <spaceVarDic>
            <Type>          PY_DICT               </Type>
            <Flags>         BASE                  </Flags>
            <Default>       {}                    </Default>
        </spaceVarDic>
    </Properties>

    <BaseMethods>
        <setAvatarVariable>
            <Arg>       VALUE_ID      </Arg>
            <Arg>       INT32         </Arg>
            <Arg>       UUID          </Arg>
            <Arg>       VALUE_SRC     </Arg>
            <Arg>       STRING        </Arg>
        </setAvatarVariable>
        <setAvatarVariableByTag>
            <Arg>       UNICODE       </Arg>
            <Arg>       INT32         </Arg>
            <Arg>       UUID          </Arg>
            <Arg>       VALUE_SRC     </Arg>
            <Arg>       STRING        </Arg>
        </setAvatarVariableByTag>
        <incAvatarVariable>
            <Arg>       VALUE_ID      </Arg>
            <Arg>       INT32         </Arg>
            <Arg>       UUID          </Arg>
            <Arg>       VALUE_SRC     </Arg>
            <Arg>       STRING        </Arg>
        </incAvatarVariable>
        <incAvatarVariableByTag>
            <Arg>       UNICODE       </Arg>
            <Arg>       INT32         </Arg>
            <Arg>       UUID          </Arg>
            <Arg>       VALUE_SRC     </Arg>
            <Arg>       STRING        </Arg>
        </incAvatarVariableByTag>
        <syncSpaceVariable>
            <Arg>       SPACE_NO      </Arg>
            <Arg>       PY_DICT       </Arg>
        </syncSpaceVariable>
        <checkAvatarVariable>
            <Arg>       VALUE_ID      </Arg>
            <Arg>       METHOD_NAME   </Arg>
            <Arg>       METHOD_ARGS   </Arg>
        </checkAvatarVariable>
    </BaseMethods>

    <CellMethods>

    </CellMethods>

    <ClientMethods>
        <onGetVariableData>
            <Arg>      ARRAY <of> VALUE_ID </of>  </Arg>
            <Arg>      ARRAY <of> INT32    </of>  </Arg>
        </onGetVariableData>
        <onVariableChanged>
            <Arg>      ARRAY <of> VALUE_ID </of>  </Arg>
            <Arg>      ARRAY <of> INT32    </of>  </Arg>
        </onVariableChanged>
    </ClientMethods>
</root>

