    <CellMethods>
        <flowCtrlIsTaskCompleteCallback>
            <Arg>   UINT8    </Arg>
            <Arg>   TASK_ID     </Arg>
            <Arg>   UINT16      </Arg>
            <Arg>   UINT8    </Arg>  <!--期望值-->
            <Arg>   BOOL    </Arg>  <!-- 是否检查一次 -->
        </flowCtrlIsTaskCompleteCallback>

        <flowCtrlOnTaskComplete>
            <Arg>   TASK_ID     </Arg>
        </flowCtrlOnTaskComplete>

        <flowCtrlOnTaskFailed>
            <Arg>   TASK_ID     </Arg>
        </flowCtrlOnTaskFailed>

        <flowCtrlOnTaskInProgress>
            <Arg>   TASK_ID     </Arg>
        </flowCtrlOnTaskInProgress>

        <flowCtrlDungeonMonsterReleaseComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonMonsterReleaseComplete>

        <flowCtrlDungeonNPCReleaseComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonNPCReleaseComplete>

        <flowCtrlDungeonCollectionReleaseComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonCollectionReleaseComplete>

        <flowCtrlDungeonBuffPointReleaseComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonBuffPointReleaseComplete>

        <flowCtrlDungeonAirWallReleaseComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonAirWallReleaseComplete>

        <flowCtrlDungeonTeleporterCreatedComplete>
            <Arg>   PY_LIST     </Arg>
        </flowCtrlDungeonTeleporterCreatedComplete>

        <flowCtrlMonsterHpMonitorTrigger>
            <Arg>   GAME_ENTITY_ID  </Arg>
            <Arg>   HP              </Arg>
            <Arg>   HP              </Arg>
            <Arg>   HP              </Arg>
        </flowCtrlMonsterHpMonitorTrigger>

        <flowCtrlMonsterRestNumIncreased>
            <Arg>   GAME_ENTITY_ID  </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
        </flowCtrlMonsterRestNumIncreased>

        <flowCtrlMonsterRestNumDecreased>
            <Arg>   GAME_ENTITY_ID  </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
        </flowCtrlMonsterRestNumDecreased>

        <flowCtrlDungeonMonsterKillNumIncreased>
            <Arg>   GAME_ENTITY_ID  </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
        </flowCtrlDungeonMonsterKillNumIncreased>

        <flowCtrlDungeonMonsterKillNumIncreasedByCreepbaseId>
            <Arg>   OBJECT_ID       </Arg>
            <Arg>   UINT32          </Arg>
            <Arg>   UINT32          </Arg>
        </flowCtrlDungeonMonsterKillNumIncreasedByCreepbaseId>

        <flowCtrlOnCheckDungeonEntityKillNumber>
            <Arg> UINT64 </Arg>
            <Arg> FLOW_CTRL_SYMBOL </Arg>
            <Arg> UINT32 </Arg>
            <Arg> UINT32 </Arg>
            <Arg> BOOL </Arg>
            <Arg> FLOW_CTRL_EID </Arg>
            <Arg> PYTHON </Arg>
            <Arg> BOOL </Arg>
        </flowCtrlOnCheckDungeonEntityKillNumber>

        <flowCtrlOnCheckDungeonAllEntityKillNumber>
            <Arg> FLOW_CTRL_SYMBOL </Arg>
            <Arg> UINT32 </Arg>
            <Arg> UINT32 </Arg>
            <Arg> FLOW_CTRL_EID </Arg>
            <Arg> PYTHON </Arg>
            <Arg> BOOL </Arg>
        </flowCtrlOnCheckDungeonAllEntityKillNumber>

        <flowCtrlDunAnyPlayerHpMonitorTrigger>
            <Arg>   HP              </Arg>
            <Arg>   HP              </Arg>
            <Arg>   HP              </Arg>
        </flowCtrlDunAnyPlayerHpMonitorTrigger>

        <flowCtrrlDungeonEntityReleaseCompleteByEventId>
            <Arg>   PY_LIST     </Arg>
            <Arg>   UINT32      </Arg>
        </flowCtrrlDungeonEntityReleaseCompleteByEventId>

    </CellMethods>

    <ClientMethods>

    </ClientMethods>

