<root>
    <Properties>
        <trainDic>
            <Type>          PY_DICT                     </Type>
            <Flags>         BASE                        </Flags>
            <Persistent>    true                        </Persistent>
        </trainDic>
    </Properties>

    <BaseMethods>
        <resetGuildTrain> <Exposed/>
        </resetGuildTrain>

        <upgradeTrainLevel> <Exposed/>
            <Arg>       OBJECT_ID       </Arg>
            <Arg>       LEVEL           </Arg>
        </upgradeTrainLevel>

        <onCheckUpgradeTrainLevelResult>
            <Arg>       BOOL            </Arg>
            <Arg>       PYTHON          </Arg>
        </onCheckUpgradeTrainLevelResult>
    </BaseMethods>

    <CellMethods>
        <onUpgradeTrainLevel>
            <Arg>       OBJECT_ID       </Arg>
            <Arg>       LEVEL           </Arg>
            <Arg>       SCORE           </Arg>
        </onUpgradeTrainLevel>

        <onResetGuildTrain>
            <Arg>       PYTHON          </Arg>
        </onResetGuildTrain>
    </CellMethods>

    <ClientMethods>
        <onGuildTrainsInit>
            <Arg>       ARRAY       <of>    TRAIN_DATA      </of>   </Arg>
        </onGuildTrainsInit>

        <onUpdateGuildTrains>
            <Arg>       ARRAY       <of>    TRAIN_DATA      </of>   </Arg>
        </onUpdateGuildTrains>

        <onGuildTrainResetClient>
        </onGuildTrainResetClient>
    </ClientMethods>
</root>
