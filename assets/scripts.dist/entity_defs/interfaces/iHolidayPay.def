            <Type>          HOLIDAYPAY_INFO         </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>    true                    </Persistent>
        </holidayPayInfo>
    </Properties>

    <CellMethods>
    </CellMethods>

    <BaseMethods>
    </BaseMethods>

    <ClientMethods>
        <onSendHolidayPayInfo>
