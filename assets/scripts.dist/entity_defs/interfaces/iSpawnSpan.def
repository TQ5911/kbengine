<root>
    <Properties>
        <spawnSpan>
            <Type>              UINT32   </Type>
            <Flags>             CELL_PRIVATE    </Flags>
            <Default>           0       </Default>
        </spawnSpan>

        <spawnSpanTimerDict>
            <Type>  PY_DICT   </Type>
            <Flags>     CELL_PRIVATE    </Flags>
            <Default>    {}    </Default>
        </spawnSpanTimerDict>
    </Properties>

    <CellMethods>
        <createRefreshTimer>
            <Arg>   FLOAT   </Arg>
            <Arg>   PYTHON  </Arg>
            <Arg>   STRING  </Arg>
        </createRefreshTimer>
    </CellMethods>
</root>
