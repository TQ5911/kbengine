<root>
    <Properties>
        <currStatisticSpaceNo>
            <Type>      SPACE_NO           </Type>
            <Flags>     CELL_PRIVATE       </Flags>
            <Default>   0                  </Default>
        </currStatisticSpaceNo>
    </Properties>

    <BaseMethods>
        <onGetStatistics>
            <Arg>          UINT8          </Arg>
            <Arg>          PYTHON         </Arg>
        </onGetStatistics>

        <onGetStatisticsDetail>
            <Arg>          UINT8          </Arg>
            <Arg>          UINT8          </Arg>
            <Arg>          UINT8          </Arg>
            <Arg>          UINT8          </Arg>
            <Arg>          PYTHON         </Arg>
        </onGetStatisticsDetail>

	</BaseMethods>

	<CellMethods>
        <reqStartGetStatistics> <Exposed/>
            <Arg>          UINT8         </Arg>
        </reqStartGetStatistics>

        <reqStopGetStatistics> <Exposed/>
        </reqStopGetStatistics>

        <reqGetStatisticsDetail> <Exposed/>
            <Arg>          UINT8         </Arg>
        </reqGetStatisticsDetail>

        <reqClearStatistics> <Exposed/>
            <Arg>          UINT8         </Arg>
        </reqClearStatistics>

	</CellMethods>

	<ClientMethods>
        <onGetStatisticsClient>
            <Arg>          UINT8          </Arg>
            <Arg>   ARRAY   <of>    STATISTIC_PLAYER_VAL    </of>   </Arg>
        </onGetStatisticsClient>

        <onGetStatisticsDetailClient>
            <Arg>          UINT8          </Arg>
            <Arg>          UINT8          </Arg>
            <Arg>          UINT8          </Arg>
            <Arg>   ARRAY   <of>    STATISTIC_PLAYER_VAL    </of>   </Arg>
        </onGetStatisticsDetailClient>

	</ClientMethods>

</root>