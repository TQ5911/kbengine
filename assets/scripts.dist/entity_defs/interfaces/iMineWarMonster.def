<root>
    <Properties>
        <mineWarMonsterType>
            <Type>              UINT8   </Type>
            <Flags>             CELL_PRIVATE    </Flags>
            <Default>           0       </Default>
        </mineWarMonsterType>
        <mineWarCanAttack>
            <Type>              UINT8    </Type>
            <Flags>             CELL_PRIVATE    </Flags>
            <Default>           0       </Default>
        </mineWarCanAttack>
        <mineWarGuildId>
            <Type>              GUILD_UUID   </Type>
            <Flags>             CELL_PRIVATE    </Flags>
            <Default>           0       </Default>
        </mineWarGuildId>
        <mineWarCamp>
            <Type>          UINT8           </Type>
            <Flags>         ALL_CLIENTS     </Flags>
            <Default>       0               </Default>
            <WitnessName>   true            </WitnessName>
        </mineWarCamp>
    </Properties>

    <CellMethods>

        <onMineWarStateChange>
            <Arg>          GUILD_UUID         </Arg>
            <Arg>          UINT8              </Arg>
            <Arg>          UINT8              </Arg>
        </onMineWarStateChange>

    </CellMethods>
</root>