<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
    </Interfaces>
    
    <Properties>
        <siegeWarState>
            <Type>          INT32                   </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </siegeWarState>

        <siegeWarStateEndTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </siegeWarStateEndTime>

        <offensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </offensiveGuildUUID>

        <defensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </defensiveGuildUUID>

        <offensiveName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </offensiveName>

        <defensiveName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </defensiveName>

        <officialWarStartTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </officialWarStartTime>

        <avatarGBID>
            <Type>          PLAYER_GBID             </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </avatarGBID>

        <cityBuffDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </cityBuffDict>

        <officerBuffDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </officerBuffDict>

        <cityDataList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       []                      </Default>
        </cityDataList>

        <cityFundUseRecord>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       []                      </Default>
        </cityFundUseRecord>

        <cityOwnerGuildName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOwnerGuildName>

        <lastSiegeWarEndTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       0                       </Default>
        </lastSiegeWarEndTime>
    </Properties>

    <BaseMethods>
        <getSiegeWarState>
            <Arg>          ENTITYCALL                    </Arg>
        </getSiegeWarState>

        <setSiegeWarState>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </setSiegeWarState>

        <doBidding>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </doBidding>

        <onBiddingResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          BOOL                         </Arg>
        </onBiddingResult>

        <onSiegeWarBiddingFailAvatarOffline>
            <Arg>          PY_LIST                      </Arg>
            <Arg>          INT32                        </Arg>
        </onSiegeWarBiddingFailAvatarOffline>
        
        <onSiegeWarBiddingDataUpdate>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
            <Arg>        LONGTIME                       </Arg>
            <Arg>        PLAYER_GBID                    </Arg>
        </onSiegeWarBiddingDataUpdate>
        
        <onQuerySiegeWarBiddingWinnerData>
            <Arg>          ENTITYCALL                    </Arg>
        </onQuerySiegeWarBiddingWinnerData>

        <onSiegeWarBiddingAvatarSubscribed>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          BOOL                         </Arg>
        </onSiegeWarBiddingAvatarSubscribed>

        <handleBiddingResult>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
        </handleBiddingResult>

        <handleBiddingResultGetGuildBox>
            <Arg>          ENTITYCALL                    </Arg>
        </handleBiddingResultGetGuildBox>

        <onSiegeWarDeclareWar>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          BOOL                          </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          GUILD_UUID                    </Arg>
        </onSiegeWarDeclareWar>

        <onSiegeWarDeclareWarCrossServerResult>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          BOOL                          </Arg>
            <Arg>          INT32                         </Arg>
        </onSiegeWarDeclareWarCrossServerResult>

        <onSiegeWarDeclareWarOfficial>
            <Arg>          UNICODE                       </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          LONGTIME                      </Arg>
        </onSiegeWarDeclareWarOfficial>

        <onQuerySiegeWarDefenderAndOffensive>
            <Arg>          ENTITYCALL                    </Arg>
        </onQuerySiegeWarDefenderAndOffensive>

        <onSiegeWarDeclareWarOfficialGetGuildBox>
            <Arg>          ENTITYCALL                    </Arg>
        </onSiegeWarDeclareWarOfficialGetGuildBox>

        <onCrossSiegeWarEnd>
            <Arg>           PY_LIST                     </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           GUILD_UUID                  </Arg>
        </onCrossSiegeWarEnd>

        <onSiegeWarWinnerGetGuildBox>
            <Arg>          ENTITYCALL                                       </Arg>
        </onSiegeWarWinnerGetGuildBox>

        <removeCityOwnerFlag>
            <Arg>          ENTITYCALL                                       </Arg>
        </removeCityOwnerFlag>

        <onSiegeWarGuildWinnerData>
            <Arg>           PY_LIST                     </Arg>
        </onSiegeWarGuildWinnerData>

        <cityRecentActivityRequest>
            <Arg>          ENTITYCALL                                       </Arg>
        </cityRecentActivityRequest>

        <cityRecentActivityResponse>
            <Arg>          ENTITYCALL                                       </Arg>
            <Arg>          ARRAY <of> CITY_RECENT_ACTIVITY_VAL </of>        </Arg>
        </cityRecentActivityResponse>

        <onCityOfficerChange>
            <Arg>          PY_LIST                      </Arg>
            <Arg>          PY_LIST                      </Arg>
        </onCityOfficerChange>

        <onAddCityBuff>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
        </onAddCityBuff>

        <onPlayerLoginGetCityBuff>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onPlayerLoginGetCityBuff>

        <onCitySendReward>
            <Arg>          INT32                         </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onCitySendReward>

        <onCityAddBuffToTarget>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onCityAddBuffToTarget>

        <onCityDataChange>
            <Arg>          PY_LIST                      </Arg>
            <Arg>          PY_LIST                      </Arg>
        </onCityDataChange>

        <onCityDataRequest>
            <Arg>          ENTITYCALL                    </Arg>
        </onCityDataRequest>

        <onChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                          </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          INT64                         </Arg>
        </onChangeCityMoneyToGuildMoneyResult>

        <querySiegeWarCityFundUseRecord>
            <Arg>          ENTITYCALL                    </Arg>
        </querySiegeWarCityFundUseRecord>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
    </ClientMethods>
</root>
