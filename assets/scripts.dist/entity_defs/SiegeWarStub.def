<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
    </Interfaces>

    <Properties>
        <siegeWarState>
            <Type>          INT32                   </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </siegeWarState>

        <siegeWarStateEndTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </siegeWarStateEndTime>

        <offensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </offensiveGuildUUID>

        <defensiveGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </defensiveGuildUUID>

        <offensiveJunXuQiXieLevelData>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </offensiveJunXuQiXieLevelData>

        <defensiveJunXuQiXieLevelData>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </defensiveJunXuQiXieLevelData>

        <offensiveName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </offensiveName>

        <defensiveName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </defensiveName>

        <officialWarStartTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </officialWarStartTime>

        <avatarGBID>
            <Type>          PLAYER_GBID             </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </avatarGBID>

        <nameList>
            <Type>          ARRAY   <of>    UNICODE   </of>     </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </nameList>

        <guildNameList>
            <Type>          ARRAY   <of>    UNICODE   </of>     </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </guildNameList>

        <cntList>
            <Type>        ARRAY <of> INT32   </of>       </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cntList>

        <signUpDelayTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       0                       </Default>
        </signUpDelayTime>

        <cityBuffDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </cityBuffDict>

        <offlineBuffCache>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </offlineBuffCache>

        <officerBuffDict>
            <Type>          PY_DICT                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       {}                      </Default>
        </officerBuffDict>

        <cityDataList>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       []                      </Default>
        </cityDataList>

        <cityFundUseRecord>
            <Type>          PY_LIST                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       []                      </Default>
        </cityFundUseRecord>

        <cityOwnerUUID>
            <Type>          PLAYER_GBID             </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOwnerUUID>

        <cityOwnerName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOwnerName>

        <cityOwnerGuildName>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOwnerGuildName>

        <cityOwnerGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOwnerGuildUUID>

        <lastSiegeWarEndTime>
            <Type>          LONGTIME                </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
            <Default>       0                       </Default>
        </lastSiegeWarEndTime>

        <firstBiddingGuildUUID>
            <Type>          GUILD_UUID              </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </firstBiddingGuildUUID>

        <cityDefenseDeclaration>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityDefenseDeclaration>

        <cityOffensiveDeclaration>
            <Type>          UNICODE                 </Type>
            <Flags>         BASE                    </Flags>
            <Persistent>	true					</Persistent>
        </cityOffensiveDeclaration>
    </Properties>

    <BaseMethods>
        <getSiegeWarState>
            <Arg>          ENTITYCALL                    </Arg>
        </getSiegeWarState>

        <setSiegeWarState>
            <Arg>          UINT8                        </Arg>
            <Arg>          LONGTIME                     </Arg>
        </setSiegeWarState>

        <doBidding>
            <Arg>          ENTITYCALL                   </Arg>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
        </doBidding>

        <onBiddingResult>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          BOOL                         </Arg>
            <Arg>          INT32                        </Arg>
        </onBiddingResult>

        <onSiegeWarBiddingDataUpdate>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> UNICODE </of>       </Arg>
            <Arg>        ARRAY <of> INT32   </of>       </Arg>
            <Arg>        LONGTIME                       </Arg>
            <Arg>        PLAYER_GBID                    </Arg>
            <Arg>        GUILD_UUID                     </Arg>
        </onSiegeWarBiddingDataUpdate>

        <onQuerySiegeWarBiddingWinnerData>
            <Arg>          ENTITYCALL                    </Arg>
        </onQuerySiegeWarBiddingWinnerData>

        <onSiegeWarBiddingAvatarSubscribed>
            <Arg>          PLAYER_GBID                  </Arg>
            <Arg>          BOOL                         </Arg>
        </onSiegeWarBiddingAvatarSubscribed>

        <handleBiddingResult>
            <Arg>          UNICODE                      </Arg>
            <Arg>          GUILD_UUID                   </Arg>
            <Arg>          UNICODE                      </Arg>
            <Arg>          INT32                        </Arg>
            <Arg>          UNICODE                      </Arg>
        </handleBiddingResult>

        <handleBiddingResultGetGuildBox>
            <Arg>          ENTITYCALL                    </Arg>
        </handleBiddingResultGetGuildBox>

        <onSiegeWarDeclareWar>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          BOOL                          </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          UNICODE                       </Arg>
        </onSiegeWarDeclareWar>

        <onSiegeWarDeclareWarCrossServerResult>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          BOOL                          </Arg>
            <Arg>          INT32                         </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onSiegeWarDeclareWarCrossServerResult>

        <onSiegeWarDeclareWarOfficial>
            <Arg>          UNICODE                       </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          UNICODE                       </Arg>
            <Arg>          LONGTIME                      </Arg>
            <Arg>          UNICODE                       </Arg>
        </onSiegeWarDeclareWarOfficial>

        <onQuerySiegeWarDefenderAndOffensive>
            <Arg>          ENTITYCALL                    </Arg>
        </onQuerySiegeWarDefenderAndOffensive>

        <onCrossSiegeWarEnd>
            <Arg>           PY_LIST                     </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           GUILD_UUID                  </Arg>
            <Arg>           GUILD_UUID                  </Arg>
        </onCrossSiegeWarEnd>

        <onSiegeWarWinnerGetGuildBox>
            <Arg>          ENTITYCALL                                       </Arg>
        </onSiegeWarWinnerGetGuildBox>

        <removeCityOwnerFlag>
            <Arg>          ENTITYCALL                                       </Arg>
        </removeCityOwnerFlag>

        <onSiegeWarGuildWinnerData>
            <Arg>           PY_LIST                     </Arg>
        </onSiegeWarGuildWinnerData>

        <onCityOfficerChange>
            <Arg>          PY_LIST                      </Arg>
            <Arg>          PY_LIST                      </Arg>
        </onCityOfficerChange>

        <onAddCityBuff>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
        </onAddCityBuff>

        <onPlayerLoginGetCityBuff>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onPlayerLoginGetCityBuff>

        <onCitySendReward>
            <Arg>          INT32                         </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onCitySendReward>

        <onCityAddBuffToTarget>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </onCityAddBuffToTarget>

        <onCityDataChange>
            <Arg>          PY_LIST                      </Arg>
            <Arg>          PY_LIST                      </Arg>
        </onCityDataChange>

        <onCityDataRequest>
            <Arg>          PLAYER_GBID                   </Arg>
        </onCityDataRequest>

        <onChangeCityMoneyToGuildMoneyResult>
            <Arg>          BOOL                          </Arg>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          INT64                         </Arg>
            <Arg>          INT64                         </Arg>
        </onChangeCityMoneyToGuildMoneyResult>

        <doChangeCityMoneyToGuildMoney>
            <Arg>          ENTITYCALL                    </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          INT64                         </Arg>
        </doChangeCityMoneyToGuildMoney>

        <querySiegeWarCityFundUseRecord>
            <Arg>          ENTITYCALL                    </Arg>
        </querySiegeWarCityFundUseRecord>

        <addCityBuffOffline>
            <Arg>          PLAYER_GBID                   </Arg>
            <Arg>          BUFFID                        </Arg>
            <Arg>          LONGTIME                      </Arg>
            <Arg>          PLAYER_GBID                   </Arg>
        </addCityBuffOffline>

        <onJunXuQiXieLevelSync>
            <Arg>          GUILD_UUID                    </Arg>
            <Arg>          PY_DICT                       </Arg>
        </onJunXuQiXieLevelSync>

        <changeDeclaration>
            <Arg>           BOOL                        </Arg>
            <Arg>           PLAYER_GBID                 </Arg>
            <Arg>           UNICODE                     </Arg>
        </changeDeclaration>
    </BaseMethods>

    <CellMethods>
    </CellMethods>

    <ClientMethods>
    </ClientMethods>
</root>
