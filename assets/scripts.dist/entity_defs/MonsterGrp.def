<root>
    <Volatile>
		<position/>
		<!--<position> 0 </position> Don't update-->
		<yaw/>
		<!--<pitch> 20 </pitch>-->
		<optimized> false </optimized>
	</Volatile>

	<Interfaces>
		<Interface>	   iCell    </Interface>
        <Interface>    iBaseWithCell    </Interface>
        <Interface>    iTimerBase       </Interface>
		<Interface>	   iTimerCell    </Interface>
		<Interface>	   iEventMgr     </Interface>
        <Interface>    iSpawnSpan   </Interface>
        <Interface>    iGameEntity  </Interface>
	</Interfaces>

    <Properties>
        <groupId>
            <Type>            OBJECT_ID          </Type>
            <Flags>           CELL_PRIVATE       </Flags>
            <Default>            0               </Default>
        </groupId>

        <groupName>
            <Type>            UNICODE            </Type>
            <Flags>           CELL_PRIVATE      </Flags>
        </groupName>

        <monsterIDs>
            <Type>             PYTHON            </Type>
            <Flags>            CELL_PRIVATE      </Flags>
            <Default>             []             </Default>
        </monsterIDs>

        <monsterTypeMap>
            <Type>             PYTHON            </Type>
            <Flags>            CELL_PRIVATE      </Flags>
            <Default>             {}             </Default>
        </monsterTypeMap>

        <bornRadius>
            <Type> FLOAT    </Type>
            <Flags>   CELL_PRIVATE  </Flags>
            <Default>   0.0  </Default>
        </bornRadius>

        <args>
            <Type>            PYTHON             </Type>
            <Flags>           CELL_PRIVATE       </Flags>
            <Default>             []             </Default>
        </args>

    </Properties>

    <BaseMethods>

        <createMonstersFromGrp>
            <Arg>       PYTHON          </Arg>
        </createMonstersFromGrp>

    </BaseMethods>

    <CellMethods>
        <sync>
            <Arg>           OBJECT_ID              </Arg>
            <Arg>           STRING          </Arg>
            <Arg>           PYTHON               </Arg>
            <Arg>           PYTHON             </Arg>
        </sync>

        <initFromBase>
            <Arg>           PYTHON          </Arg>
        </initFromBase>

        <canBeDestroy>
        </canBeDestroy>

    </CellMethods>
</root>
