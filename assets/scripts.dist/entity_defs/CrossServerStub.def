<root>
    <Interfaces>
        <Interface> iBaseNoCell                 </Interface>
        <Interface> iGlobal                     </Interface>
        <Interface> iTimerBase                  </Interface>
    </Interfaces>

    <Properties>
        <accountDic>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}          </Default>
        </accountDic>
    </Properties>

    <BaseMethods>
        <onGetSwitchServerData>
            <Arg>       BLOB                        </Arg>
        </onGetSwitchServerData>
        
        <onReqCrossServer>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UINT16                  </Arg>
            <Arg>           PYTHON                  </Arg>
        </onReqCrossServer>

        <checkCrossServerToken>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           ENTITYCALL              </Arg>
            <Arg>           METHOD_NAME             </Arg>
            <Arg>           METHOD_ARGS             </Arg>
        </checkCrossServerToken>

        <onGobackServer>
            <Arg>           UNICODE                 </Arg>
        </onGobackServer>

        <onEndCrossServer>
            <Arg>           UNICODE                 </Arg>
        </onEndCrossServer>

        <onCheckCrossServerToken>
            <Arg>           UNICODE                 </Arg>
            <Arg>           UNICODE                 </Arg>
            <Arg>           PYTHON                  </Arg>
        </onCheckCrossServerToken>

        <onGmModifyAllServertimeInCrossGroup>
            <Arg>           PYTHON                  </Arg>
            <Arg>           UNICODE                 </Arg>
        </onGmModifyAllServertimeInCrossGroup>

        <onGmModifyAllServertimeInCrossGroupResp>
            <Arg>           PYTHON                  </Arg>
            <Arg>           UNICODE                 </Arg>
        </onGmModifyAllServertimeInCrossGroupResp>
    </BaseMethods>
</root>
