<root>

    <Interfaces>
        <Interface> iDungeonStub </Interface>
        <Interface> iDungeonStubMonsterMixin </Interface>
    </Interfaces>

    <Properties>
        <spaces>
            <Type>          PY_DICT        </Type>
            <Flags>         BASE           </Flags>
            <Default>       {}             </Default>
        </spaces>

        <creatingRaidDic>
            <Type>      PY_DICT     </Type>
            <Flags>     BASE        </Flags>
            <Default>   {}          </Default>
        </creatingRaidDic>

    </Properties>

    <BaseMethods>
        <releaseRaidDungeonCreatingLock>
            <Arg>   RAID_ID         </Arg>
        </releaseRaidDungeonCreatingLock>

        <completeRaidDungeon>
            <Arg>            SPACE_NO        </Arg>
            <Arg>            RAID_ID         </Arg>
            <Arg>            BOOL            </Arg>
            <Arg>            UINT32          </Arg>
        </completeRaidDungeon>
    </BaseMethods>
</root>
