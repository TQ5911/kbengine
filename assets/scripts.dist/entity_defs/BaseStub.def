<?xml version="1.0" encoding="utf-8"?>
<root>

    <Interfaces>
        <Interface> iBaseNoCell </Interface>
        <Interface> iGlobal </Interface>
        <Interface> iTimerBase </Interface>
    </Interfaces>

    <Properties>
        <checkLoaded>
            <Type>                  BOOL                    </Type>
            <Flags>                 BASE            </Flags>
            <Default>               0                       </Default>
        </checkLoaded>

        <spaceCreated>
            <Type>                  ARRAY <of> SPACE_NO </of>                     </Type>
            <Flags>                 BASE            </Flags>
            <Default>               []              </Default>
        </spaceCreated>

        <gameReady>
            <Type>                  BOOL                    </Type>
            <Flags>                 BASE            </Flags>
            <Default>               0                       </Default>
        </gameReady>

        <preparingEntTypes>
            <Type>                  PYTHON          </Type>
            <Flags>                 BASE            </Flags>
            <Default>               []              </Default>
        </preparingEntTypes>

        <lineReady>
            <Type>                  PYTHON          </Type>
            <Flags>                 BASE            </Flags>
            <Default>               {}              </Default>
        </lineReady>

        <worldRefreshEntityReady>
            <Type>                  PYTHON          </Type>
            <Flags>                 BASE            </Flags>
            <Default>               {}              </Default>
        </worldRefreshEntityReady>

        <lineEntityReadyNum>
            <Type>                  PYTHON           </Type>
            <Flags>                 BASE             </Flags>
            <Default>               {}               </Default>
        </lineEntityReadyNum>

        <stubReadyBaseapps>
            <Type>                  PYTHON           </Type>
            <Flags>                 BASE             </Flags>
            <Default>               {}               </Default>
        </stubReadyBaseapps>

        <airWallLoadCount>
            <Type>                  UINT8            </Type>
            <Flags>                 BASE             </Flags>
            <Default>               0                </Default>
        </airWallLoadCount>
    </Properties>

    <BaseMethods>
        <halfPrepare>
            <Arg>           ENT_TYPE    </Arg>          <!-- global base type -->
        </halfPrepare>

        <fullPrepare>
            <Arg>           ENT_TYPE    </Arg>          <!-- global base type -->
        </fullPrepare>

        <onLineReady>
            <Arg>           LINE_TYPE    </Arg>
            <Arg>           BOOL         </Arg>
        </onLineReady>

        <onLineEntityReady>
            <Arg>           SPACE_NO    </Arg>
        </onLineEntityReady>

        <onNewCellappStarted>
            <Arg>           UINT8      </Arg>
        </onNewCellappStarted>

        <initSpecialSpaceOnNewCellappStarted>
            <Arg>           UINT8      </Arg>
        </initSpecialSpaceOnNewCellappStarted>

        <onBaseappGetAllStubs>
            <Arg>           UINT8      </Arg>
        </onBaseappGetAllStubs>

        <onCellAppLoadAirWallFinished>
        </onCellAppLoadAirWallFinished>

        <sendOfficialMessage>
            <Arg>           LONGTIME      </Arg>
            <Arg>           LONGTIME      </Arg>
            <Arg>           UNICODE      </Arg>
            <Arg>           UINT16      </Arg>
            <Arg>           STRING      </Arg>
            <Arg>           UINT64      </Arg>
        </sendOfficialMessage>

        <stopOfficialMessage>
            <Arg>           UINT64      </Arg>
        </stopOfficialMessage>
    </BaseMethods>
</root>
