# ============================================================================
#  centralService 部署环境变量
#
#  用法：cp deploy.env.example deploy.env  然后按目标机器填写。
#  deploy.env 包含数据库口令等敏感信息，已在 .gitignore 中排除，勿提交。
#  修改后执行 ./deploy/install.sh 重新渲染配置并重启服务。
# ============================================================================

# ----------------------------------------------------------------------------
# 安装路径与运行身份
# ----------------------------------------------------------------------------
# 所有服务的安装根目录（本机/本地模式）。每个服务一个同名子目录：
#   <INSTALL_ROOT>/maple/maple       二进制
#   <INSTALL_ROOT>/maple/maple.json  配置
#   <INSTALL_ROOT>/maple/maple.log   业务日志
#   <INSTALL_ROOT>/data              各服务共享数据（服务里以 ../data 访问）
# 注意：服务目录名必须等于服务名，否则程序读不到 <服务名>.json 会启动失败；
#      末级目录名（这里是 bin）不受此约束，它只是服务的上级目录。
# 远程部署（--ansible）时本变量不生效，用下面的 ANSIBLE_REMOTE_PREFIX。
INSTALL_ROOT=/home/fengyan/Server/centralService/bin

# 服务进程以哪个用户运行。
# 默认用部署账号 fengyan：更新二进制/改配置都是 fengyan 在做，属主与运行身份一致，
# 就不会出现「推上去的文件属主不对、服务读不到 0600 配置」。
# 生产环境建议改成专用账号（centralsvc），并把 ANSIBLE_USER 加进该组。
SERVICE_USER=fengyan
SERVICE_GROUP=fengyan

# systemd 单元文件名前缀，最终生成 centralsvc-<服务名>.service
UNIT_PREFIX=centralsvc

# 单元的 ProtectHome 取值。留空 = 由脚本按安装根目录自动决定：
#   安装目录在 /home、/root、/run/user 下  -> no（必须关，否则 systemd 把 /home
#      挂成空 tmpfs，execve 找不到二进制，表现为 status=203/EXEC 且无任何日志）
#   其它路径（如 /opt/centralService）      -> true
# 想显式指定就填 true / no / read-only / tmpfs。
SYSTEMD_PROTECT_HOME=

# ----------------------------------------------------------------------------
# Ansible 远程部署模式（开发机 → 部署机）
# 适用于 ./deploy/install.sh --ansible 的场景
# 本地模式部署时以下变量可忽略
# ----------------------------------------------------------------------------
# Ansible 主机组或 host pattern（必须是 inventory 里能解析出来的）
#   直接指定 IP : ANSIBLE_HOSTS=172.16.41.49     （脚本自动用内联 inventory，无需文件）
#   inventory 组: ANSIBLE_HOSTS=tmp              （必须有 inventory 定义这个组）
ANSIBLE_HOSTS=tmp

# inventory 文件。留空时按 ANSIBLE_HOSTS 的形态自动判断；
# 存在 deploy/ansible/hosts 时会自动使用它。
# 样例：cp deploy/ansible/hosts.example deploy/ansible/hosts
ANSIBLE_INVENTORY=

# 远程部署机 SSH 用户（该用户需要有**免密** sudo 权限）
ANSIBLE_USER=fengyan

# sudo 口令文件。目标机的 sudo 需要密码时才用；留空表示走免密 sudo。
# 不要用 ansible 的 -K 交互输入：本脚本一轮要调几十次 ansible，每次都会重新提示。
ANSIBLE_BECOME_PASSWORD_FILE=

# 远程安装根目录（必须与 INSTALL_ROOT 区分开！）
# 注意：远程部署机上该目录的写入权限属于 ANSIBLE_USER，
#       而服务实际以 SERVICE_USER 运行，所以两者不一致时 ANSIBLE_USER
#       要能写入该目录给 SERVICE_USER 读（推荐把 ANSIBLE_USER 加入 SERVICE_GROUP）。
#       默认 SERVICE_USER=fengyan 与 ANSIBLE_USER 同账号，就没有这个问题。
ANSIBLE_REMOTE_PREFIX=/home/fengyan/Server/centralService/bin

# 服务时区
TIMEZONE=Asia/Shanghai

# ----------------------------------------------------------------------------
# MySQL（各服务独立库，up.sh 按各自配置里的 db 名建库导表）
# ----------------------------------------------------------------------------
# 格式 host:port，port 可省略（默认 3306）
MYSQL_ADDR=127.0.0.1:3306
MYSQL_USER=fengyan
MYSQL_PASSWD=CHANGE_ME_IN_PRODUCTION

# ----------------------------------------------------------------------------
# Redis（admin / router / queueServer / centralLogin / orderService /
#        crossTeamServer / auction / leaseServer 使用）
# ----------------------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_USER=
REDIS_PASSWD=

# ----------------------------------------------------------------------------
# 运营上报（企业微信机器人）。留空表示关闭上报。
# ----------------------------------------------------------------------------
REPORT_ADDR=

# ----------------------------------------------------------------------------
# 进程运行时行为
# ----------------------------------------------------------------------------
# crash = panic 时 dump core，便于事后定位；也可设为 all 或留空
GOTRACEBACK=crash

# systemd 启动超时（秒）。服务需要建连 MySQL/Redis，超过该时间视为失败。
START_TIMEOUT=90
# 优雅停机超时（秒）。进程收到 SIGTERM 后会删 pid 文件再退出。
STOP_TIMEOUT=30
# 崩溃后重启间隔（秒）
RESTART_SEC=3

# ----------------------------------------------------------------------------
# 日志：全部落在服务自己的目录里，比如 maple -> <安装根>/maple/maple.log
# ----------------------------------------------------------------------------
# 渲染配置时把 logPath 统一改写成 <服务名>.log（相对 WorkingDirectory）。
# 仓库里的原始值不统一（drop.log / login.log / ./admin.log ...），
# 统一后每个服务的日志就在自己目录下，且文件名等于服务名。设为 0 保留原值。
LOG_IN_SERVICE_DIR=1

# 进程 stdout/stderr 去向：
#   file    -> 追加到 <安装根>/<服务名>/<服务名>.out.log（不进 journald）
#              需要 systemd >= 240 才认 append:，更老的版本改回 journal
#   journal -> 只进 journald（journalctl -u centralsvc-<服务名>）
LOG_STDOUT_MODE=file

# logrotate 保留份数。安装时会写 /etc/logrotate.d/centralsvc。
LOG_ROTATE_KEEP=7