# ============================================================================
#  centralService systemd 单元模板
#
#  由 install.sh 为每个服务渲染成一份具体的 centralsvc-<服务名>.service，
#  所以这里用 @SERVICE@ 占位符，而不是 systemd 原生的 %i 实例占位符。
#
#  ⚠ 两个必须保留的设定，删掉会导致服务起不来：
#
#   1. WorkingDirectory 必须是 @INSTALL_ROOT@/@SERVICE@
#      程序按「当前工作目录」找配置、相对路径日志和 pid 文件：
#        - 配置文件名 = 可执行文件所在目录名 + ".json"  (src/common/utils.go)
#        - logPath 是相对路径                            (src/appLog/AppLog.go)
#        - pid 文件写在 CWD                              (src/common/Pidfile.go)
#      WorkingDirectory 一旦不对，程序读不到 <服务名>.json 直接退出。
#
#   2. ExecStart 的二进制路径必须和目录名同名
#      配置名是从可执行文件路径推导的，不是从配置文件名猜的。
# ============================================================================

[Unit]
Description=centralService @SERVICE@ (@DESCRIPTION@)
Documentation=file://@INSTALL_ROOT@/@SERVICE@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@

# 见文件头说明 1：目录名必须等于服务名
WorkingDirectory=@INSTALL_ROOT@/@SERVICE@

# 见文件头说明 2：二进制文件名必须等于服务名
ExecStart=@INSTALL_ROOT@/@SERVICE@/@SERVICE@ --instid=0

# ---- 启动前清理残留 pid 文件 ---------------------------------------------
# 崩溃 / panic / OOM / SIGKILL 时 DelPidFile() 不会被调用（它只在 ExitProgram()
# 里，而 ExitProgram 仅由信号处理器触发），pid 文件必然残留；下次启动 WritePidFile()
# 发现文件已存在就直接 os.Exit(2)（src/base/init.go:72-76），于是 Restart=always
# 每隔 RestartSec 秒把服务拉起来、又立刻退出 —— 服务一直不可用，日志被刷满。
# 更麻烦的是那次退出发生在 StartListenKillSignal() 之前，信号处理器没注册，
# 连 systemctl stop 都清不掉，只能手工 rm。
#
# 这里在启动前清掉"进程已死"的残留 pid 文件，三个注意点：
#   1) 只有 /proc/<pid> 不存在（进程已死）或文件为空时才删，活进程的 pid 文件保留，
#      防重复启动的语义没有丢；
#   2) 前缀的 - 表示这条命令失败也不阻断启动 —— 兜底逻辑不能反过来拖累主程序；
#   3) systemd 会对命令行做 $ 变量展开，所以脚本里的 $ 一律写成 $$。
# pid 文件名里的 0 对应上面 --instid=0，改 instid 时两处要一起改。
ExecStartPre=-/bin/sh -c 'f=@INSTALL_ROOT@/@SERVICE@/@SERVICE@_0.pid; p=$$(cat "$$f" 2>/dev/null); if [ -z "$$p" ] || [ ! -d "/proc/$$p" ]; then rm -f "$$f"; fi; exit 0'

Environment=TZ=@TIMEZONE@
Environment=GOTRACEBACK=@GOTRACEBACK@

# 进程已实现 SIGHUP/SIGINT/SIGTERM/SIGQUIT 优雅退出并清理 pid 文件
# (src/common/Pidfile.go)，直接用默认 SIGTERM 即可
KillSignal=SIGTERM
TimeoutStartSec=@START_TIMEOUT@
TimeoutStopSec=@STOP_TIMEOUT@

Restart=always
RestartSec=@RESTART_SEC@
# 反复崩溃时不要疯狂重启，给运维留出介入时间
StartLimitIntervalSec=0

# GOTRACEBACK=crash 时 panic 会生成 core，core 落在 WorkingDirectory
# （即服务目录内），与服务日志放一起，不用去别处找
LimitCORE=infinity

# stdout/stderr 去向由 deploy.env 的 LOG_STDOUT_MODE 决定：
#   file    -> 追加到 <服务目录>/<服务名>.out.log（下面的占位符会被替换成
#              append:... 形式；用 append 而不是 file:，避免每次重启都清空）
#   journal -> 交给 journald（journalctl -u centralsvc-<服务名>）
# 业务日志另由 lumberjack 写在工作目录下（<服务名>.log），与这里互不干扰。
StandardOutput=@STDOUT_TARGET@
StandardError=@STDERR_TARGET@
SyslogIdentifier=centralsvc-@SERVICE@

# ---- 基础加固 -------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
# 由 install.sh 按安装根目录自动决定（见 common.sh 的 protect_home_value）：
# 装到 /home、/root、/run/user 下时必须为 no，否则 /home 会被空 tmpfs 盖住，
# execve 找不到二进制 → status=203/EXEC。可用 SYSTEMD_PROTECT_HOME 覆盖。
ProtectHome=@PROTECT_HOME@
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
# 业务需要读工作目录下的数据文件与 ../data 共享配置
ReadWritePaths=@INSTALL_ROOT@
UMask=0027

[Install]
WantedBy=multi-user.target